+	assert ((0xa8080000 + len(full) + 0x1fffff) & ~0x1fffff) + lx_size <= 0xb4539000, 'recovery Image overlaps the DTB'
 open(out, 'wb').write(gzip.compress(bytes(full), mtime=0) + open(dtb, 'rb').read())
 print(f'kernel RAM {phys:#x}+{size:#x}, framebuffer {fb:#x}+{fb_size:#x}, image {len(full)} bytes')
