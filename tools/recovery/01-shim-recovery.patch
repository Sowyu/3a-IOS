 # The image runs wherever ABL puts it with no relocation pass: only the header's image_size may be absolute.
-abs=$(${CROSS}readelf -r out/loader.o out/console.o out/ufs.o $probe_obj | grep -c ABS64 || true)
+abs=$(${CROSS}readelf -r out/loader.o out/console.o out/ufs.o $probe_obj $rec_obj | grep -c ABS64 || true)
