 mkdir -p out
-for f in start.S loader.c console.c ufs.c $probe_src; do
+for f in start.S loader.c console.c ufs.c $probe_src $rec_src; do
 	${CROSS}gcc $CFLAGS -c $f -o out/${f%.*}.o
