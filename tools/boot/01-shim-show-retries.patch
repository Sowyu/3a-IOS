+/* Show boot_a's slot flags. A failed read only logs and the boot goes on, except a timeout: DMA may still be live. */
+static const char *show_slot_flags(void)
+{
+	static const uint8_t rd[10] = { 0x28, 0, 0, 0, 0, 2, 0, 0, 1, 0 };	/* READ(10) LBA 2: entries 0..31 */
+	static const char name[] = { 'b', 0, 'o', 0, 'o', 0, 't', 0, '_', 0, 'a', 0, 0, 0 };
+	const volatile uint8_t *e = data + 10 * 128;				/* boot_a is entry 10 of LUN 4 */
+	uint32_t rc = scsi(4, rd, sizeof(rd), data, BLOCK);
+
+	if (rc == 1)
+		return "slot flags read timed out";
+	for (unsigned i = 0; !rc && i < sizeof(name); i++)
+		if (e[56 + i] != name[i])
+			rc = 5;
+	con_hex2("SLOT", "rc=", rc, "attr=", rc ? 0 : e[54]);
+	if (!rc && !(e[54] & 0x40) && (e[54] >> 3 & 7) <= 2) {		/* not successful, 2 or fewer normal boots left */
+		con_show();
+		con_hex("BOOTS LEFT", e[54] >> 3 & 7);
+		con_str("SLOT", "reflash boot_a from the Mac soon");
+		delay_ms(5000);
+	}
+	return 0;
+}
+
