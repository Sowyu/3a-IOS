+/*
+ * 2151: whether this pass reads a report. Default: on IRQ low, a latched edge, every pass while touched, and every 100 ms
+ * (ticks counts idle passes, as before). Pace mode while touched: on a latched edge only, as Linux reads on the IRQ, so the
+ * report is whole, or once nothing was read for the fallback time. A pass is at_irq_us there, so a report waits about
+ * 0.25 ms for its read instead of about half the 3 ms read-and-wait cycle, and the reads land on the report's own rhythm.
+ */
+static bool
+at_read_due(bool pace, bool active, bool low, bool edge, uint64_t since_read, uint64_t fallback, unsigned *ticks, unsigned period)
+{
+	if (pace && active) {
+		return edge || since_read >= fallback;
+	}
+	return low || edge || active || (++*ticks % period) == 0;
+}
 
