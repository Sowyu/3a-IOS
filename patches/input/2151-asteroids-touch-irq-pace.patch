+/* 2151 sweettouchirq bit 4: one line per touch, from the first contact to the last lift (the first 40, then every 25th) */
 static void
+at_touch_stats(uint32_t was, bool edge, uint64_t seen)
+{
+	uint64_t now = mach_absolute_time();
+	if (!(at_irq_mode & AT_IRQ_STATS)) {
+		return;
+	}
+	if (!was && at.active) {
+		at.s_t0 = seen;
+		at.s_read = 0;
+		at.s_reads = at.s_fallback = at.s_edges = 0;
+		at.s_events = (uint32_t)__builtin_popcount(at.active);        /* the downs that started it, already sent */
+	}
+	if (!was && !at.active) {
+		return;
+	}
+	++at.s_reads;
+	at.s_read += now - seen;
+	if (!edge && was && (at_irq_mode & AT_IRQ_PACE)) {
+		++at.s_fallback;
+	}
+	if (was && !at.active) {
+		uint64_t ms, read_ns;
+		++at.sessions;
+		absolutetime_to_nanoseconds(now - at.s_t0, &ms);
+		absolutetime_to_nanoseconds(at.s_read / at.s_reads, &read_ns);
+		ms /= NSEC_PER_MSEC;
+		if (at.sessions <= 40 || at.sessions % 25 == 0) {
+			printf("SWEET TOUCH: touch %u: %llu ms, %u reads (%u fallback), %u IRQ edges (%llu per s), %u events, "
+			    "noticed to sent %llu us (mode %u)\n", at.sessions, ms, at.s_reads, at.s_fallback, at.s_edges,
+			    ms ? (uint64_t)at.s_edges * 1000 / ms : 0, at.s_events, read_ns / NSEC_PER_USEC, at_irq_mode);
+		}
+	}
+}
