+/* 2151: sweethid_touch_us=N publishes the digitizer's real report period (1000..20000 us) instead of the base class's 10 ms */
+UInt32
+SweetHIDTouch::getReportInterval()
+{
+	UInt32 us = 0;
+	PE_parse_boot_argn("sweethid_touch_us", &us, sizeof(us));
+	return us >= 1000 && us <= 20000 ? us : IOHIDEventService::getReportInterval();
