--- a/iokit/Kernel/arm/SweetFbScale.h
+++ b/iokit/Kernel/arm/SweetFbScale.h
@@ -26,6 +26,26 @@
 	}
 	*wait = (uint32_t)(deadline - now);
 	return deadline;
+}
+
+/*
+ * 2153: the tick's phase against the panel. wait_us runs from a tick to the latch of the frame it flipped; the panel latches at
+ * its own vsync, so a tick just after one waits most of a period. A late tick restarts its schedule right after a latch, which
+ * is why ast66-70 waited 7 ms at p50. Returns how far to move the next tick, at most step_us either way, so the wait settles at
+ * lead_us: later when it waits longer, earlier when it is cutting it close. A wait beyond a period plus the lead (a stall, a
+ * slow present) says nothing about the phase and moves nothing.
+ */
+static inline int32_t
+sfs_latch_lead(uint32_t wait_us, uint32_t lead_us, uint32_t period_us, uint32_t step_us)
+{
+	if (wait_us > period_us + lead_us) {
+		return 0;
+	}
+	int32_t err = (int32_t)wait_us - (int32_t)lead_us;
+	if (err > -250 && err < 250) {
+		return 0;
+	}
+	return err > (int32_t)step_us ? (int32_t)step_us : (err < -(int32_t)step_us ? -(int32_t)step_us : err);
 }
 
