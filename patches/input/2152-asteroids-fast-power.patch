+/*
+ * Drains the queued events in order and applies sfs_fast_drain's decision. A dark step keeps the shown buffer (fFastKept)
+ * and flips another one to black. From then until the kept image is back on the screen, or iOS has turned the display off,
+ * fFastKept stays set and fastRestore runs on every call: at the window's end, on input, on every tick and on a 50 ms retry
+ * call. While dark, frames go on being taken and copied into the kept buffer without a flip, so it holds the newest frame.
+ */
+void
+AppleCLCD::fastRun(const char *why)
+{
+	struct sfs_fast_ev evs[SWEET_FB_FAST_RING];
+	unsigned n = 0;
+	IOSimpleLockLock(sweet_fb_fast_lock);
+	while (sweet_fb_fast_tail != sweet_fb_fast_head && n < SWEET_FB_FAST_RING) {
+		evs[n++] = sweet_fb_fast_ring[sweet_fb_fast_tail++ % SWEET_FB_FAST_RING];
+	}
+	bool lost = sweet_fb_fast_lost;
+	sweet_fb_fast_lost = false;
+	IOSimpleLockUnlock(sweet_fb_fast_lock);
+
+	uint64_t now = mach_absolute_time();
+	uint32_t owed0 = fFastKept;
+	IOLockLock(fLock);
+	bool off = fPowerOff;
+	bool canBlank = fFastKept == 0 && ast.enabled && !ast.stopped && ast.front != 0;
+	uint32_t ops = sfs_fast_drain(&fFast, fFastMode, evs, n, lost, off, fPowerGen, canBlank, now, fFastWindow);
+	IOLockUnlock(fLock);
+
+	bool blankFailed = false;
+	if (fFast.dark && ast.stopped) {
+		fFast.dark = false;     /* the flip path stopped under a dark step (nothing here flips then, but be sure): pay now */
+	}
+	if (ops & SFS_OP_BLANK) {
+		fFastKept = ast.front;
+		fFastBoot = false;
+		blackout();
+		if (ast.stopped) {
+			fFast.dark = false;     /* the black flip did not latch: the fallback scans the boot buffer; the image goes back now */
+			blankFailed = true;
+		}
+	}
+	bool paid = fFastKept != 0 && !fFast.dark && fastRestore();
+	if (fFast.dark && (ops & SFS_OP_BLANK)) {
+		(void)thread_call_enter_delayed(fFastTimeout, fFast.until + 1);
+	} else if (fFastKept != 0 && !fFast.dark && !thread_call_isactive(fFastTimeout)) {
+		uint64_t retry;         /* a retry the vsync tick does not push back: armed only when none is pending */
+		nanoseconds_to_absolutetime((ast.frozen ? 1000 : 50) * NSEC_PER_MSEC, &retry);
+		(void)thread_call_enter_delayed(fFastTimeout, mach_absolute_time() + retry);
+	} else if (owed0 != 0 && fFastKept == 0) {
+		(void)thread_call_cancel(fFastTimeout);
+	}
+	if (ops != 0 || paid || blankFailed) {
+		IOLog("SWEET FB: fast power (%s):%s%s%s%s, %u events%s, display %s, power key down %lld ms ago\n", why,
+		    (ops & SFS_OP_BLANK) ? " black (shown buffer kept)" : "", blankFailed ? ", the black flip failed" : "",
+		    (ops & SFS_OP_RESTORE) ? (now >= fFast.until ? " back: iOS did not confirm in time" : " back: input") : "",
+		    paid ? " (kept image shown again)" : (owed0 != 0 && fFastKept == 0 ? " (iOS turned the display off)" : ""), n,
+		    lost ? " (some lost)" : "", off ? "off" : "on", sweet_power_key_ms(0, mach_absolute_time()));
+	}
+}
