+
+IOReturn
+AppleCLCD::fastAction(OSObject *owner, void *a0 __unused, void *a1 __unused, void *a2 __unused, void *a3 __unused)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	uint32_t ev = __atomic_exchange_n(&sweet_fb_fast_ev, 0, __ATOMIC_ACQ_REL);
+	IOLockLock(fb->fLock);
+	uint32_t act = sfs_fast_step(&fb->fFast, fb->fFastMode, ev, fb->fPowerOff, fb->fPanel, fb->fPanelOff, mach_absolute_time(),
+	    fb->fFastWindow);
+	if (act & SFS_DO_SHOW) {
+		fb->fDirty = true;      /* the latest frame again on the next tick */
+	}
+	IOLockUnlock(fb->fLock);
+	fb->fastApply(act, ev & SFS_FAST_OTHER ? "input" : "power key");
+	return kIOReturnSuccess;
+}
+
 void
+AppleCLCD::fastApply(uint32_t act, const char *why)
+{
+	if (act & SFS_DO_DARK) {
+		blackout();
+		if (fPanel && !fPanelOff) {
+			fPanelOff = true;
+			sweet_panel_post_power(false);
+		}
+	}
+	if (act & SFS_DO_WAKE) {
+		fPanelOff = false;      /* sleep out and display on, showing the black frame the off left */
+		sweet_panel_post_power(true);
+	}
+	if (act != 0) {
+		IOLog("SWEET FB: fast power (%s):%s%s%s%s, power key down %lld ms ago\n", why, (act & SFS_DO_DARK) ? " dark" : "",
+		    (act & SFS_DO_WAKE) ? " panel woken" : "", (act & SFS_DO_SHOW) ? " shown again, iOS kept the display on" : "",
+		    (act & SFS_DO_SLEEP) ? " panel back to sleep, iOS kept the display off" : "", sweet_power_key_ms(0, mach_absolute_time()));
+	}
+}
