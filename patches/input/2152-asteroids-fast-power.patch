+sweet_fb_input_event(uint32_t kind)
+{
+	AppleCLCD *fb = __atomic_load_n(&sweet_fb_fast_fb, __ATOMIC_ACQUIRE);
+	if (fb == NULL || kind == 0) {
+		return;
+	}
+	/*
+	 * RequestPowerChange stores the state, then the generation. A read that catches it between the two pairs the new state
+	 * with the old generation; the generation then never matches again, so that event can neither darken nor wake early.
+	 */
+	struct sfs_fast_ev e;
+	e.kind = kind;
+	e.gen = __atomic_load_n(&fb->fPowerGen, __ATOMIC_ACQUIRE);
+	e.ios_off = __atomic_load_n(&fb->fPowerOff, __ATOMIC_ACQUIRE);
