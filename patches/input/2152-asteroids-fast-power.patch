 /*
+ * 2152: the power key's fast path. dark: the kernel blacked the screen out ahead of iOS's display off; awake: it woke the
+ * panel ahead of iOS's display on (showing black). iOS's state (ios_off, from RequestPowerChange) always wins: its request
+ * ends either step, and a step iOS has not confirmed within the window is undone. Mode bit 1 allows dark, bit 2 awake.
+ * Returns what the caller does now. Events come in batches; a press in the same batch as a short release cancels it. Only
+ * the release of a press that began with the display on darkens it, so the release of a wake press never does.
+ */
+#define SFS_FAST_SHORT  1u      /* the power key came up after a short press with no other key during it */
+#define SFS_FAST_PRESS  2u      /* the power key went down */
+#define SFS_FAST_OTHER  4u      /* another key or a touch went down */
+#define SFS_DO_DARK     1u      /* black out now, and the panel off if the panel driver runs */
+#define SFS_DO_WAKE     2u      /* the panel on now; it shows the black frame left by the off */
+#define SFS_DO_SHOW     4u      /* undone while iOS has the display on: present the latest frame again */
+#define SFS_DO_SLEEP    8u      /* undone while iOS has it off: the normal off path puts the panel back to sleep */
+struct sfs_fast {
+	bool dark, awake;
+	bool press_on;          /* the last power press came while iOS had the display on: only its release may darken */
+	uint64_t until;
+};
+
+static inline uint32_t
+sfs_fast_step(struct sfs_fast *f, uint32_t mode, uint32_t ev, bool ios_off, bool panel_cmds, bool panel_off, uint64_t now,
+    uint64_t window)
+{
+	uint32_t act = 0;
+	bool input = (ev & (SFS_FAST_PRESS | SFS_FAST_OTHER)) != 0;
+	if (f->dark && (ios_off || now >= f->until || input)) {
+		f->dark = false;
+		act |= ios_off ? 0u : SFS_DO_SHOW;
+	}
+	if (f->awake && (!ios_off || now >= f->until)) {
+		f->awake = false;
+		act |= ios_off ? SFS_DO_SLEEP : 0u;
+	}
+	if (ev & SFS_FAST_PRESS) {
+		f->press_on = !ios_off;
+	}
+	if ((ev & SFS_FAST_PRESS) && ios_off && (mode & 2u) && panel_cmds && panel_off && !f->awake) {
+		f->awake = true;
+		f->until = now + window;
+		act |= SFS_DO_WAKE;
+	}
+	if ((ev & SFS_FAST_SHORT) && f->press_on && !input && !ios_off && (mode & 1u) && !f->dark && !(act & SFS_DO_SHOW)) {
+		f->press_on = false;
+		f->dark = true;
+		f->until = now + window;
+		act |= SFS_DO_DARK;
+	}
+	return act;
+}
