+/* 2152: from the keys thread (power key, other keys) and the touch thread (a finger down); nothing unless sweetpwrfast is set */
+extern "C" void sweet_fb_input_event(uint32_t ev);
+void
+sweet_fb_input_event(uint32_t ev)
+{
+	AppleCLCD *fb = __atomic_load_n(&sweet_fb_fast_fb, __ATOMIC_ACQUIRE);
+	if (fb != NULL && ev != 0) {
+		__atomic_fetch_or(&sweet_fb_fast_ev, ev, __ATOMIC_ACQ_REL);
+		(void)thread_call_enter(fb->fFastCall);
+	}
+}
