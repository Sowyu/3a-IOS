+/*
+ * 2152: pays the debt as sfs_fast_keep_next directs. True once the kept image is on the screen again. False with the debt
+ * still owed (frozen scanout) or paid by iOS turning the display off. Bound when flips fail: the flip back waits at most 25 ms
+ * for its latch, astFallback at most 25 ms more to scan the boot buffer, then one copy or scale of the image into it.
+ */
+bool
+AppleCLCD::fastRestore(void)
+{
+	uint32_t kept = fFastKept;
+	for (int i = 0; i < 3; i++) {
+		bool off = __atomic_load_n(&fPowerOff, __ATOMIC_ACQUIRE);
+		int step = sfs_fast_keep_next(off, ast.stopped, ast.frozen, ast.front == kept, fFastBoot);
+		if (step == SFS_KEEP_DONE) {
+			fFastKept = 0;
+			fFastBoot = false;
+			return !off;
+		}
+		if (step == SFS_KEEP_WAIT) {
+			return false;
+		}
+		if (step == SFS_KEEP_FLIP) {
+			astFlip(kept);          /* a flip that does not latch ends in astFallback: ast.stopped, next step KEEP_BOOT */
+		} else {
+			fastShowInBoot(kept);
+			fFastBoot = true;
+			IOLog("SWEET FB: fast power: a flip did not latch; kept image written to the boot buffer (scanout %s)\n",
+			    ast.frozen ? "unknown" : "restored");
+		}
+	}
+	return false;
+}
