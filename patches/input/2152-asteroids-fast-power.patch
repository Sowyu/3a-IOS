+/*
+ * 2152: the kept image is owed back to the screen from the moment the black flip is tried until it is shown again or iOS
+ * turns the display off. The kernel asks this for the next step, does it, and asks again (at most three steps per call):
+ *   KEEP_FLIP  flip back to the kept buffer (normal path).
+ *   KEEP_BOOT  the flip path has stopped (a flip did not latch and astFallback took over): it scans the boot buffer, which
+ *              astFallback seeded from the black front, or with hardware scale with plain black. Put the kept image there.
+ *   KEEP_DONE  the debt is paid: the flip back latched, the boot buffer holds the image and is scanned, or iOS is off.
+ *   KEEP_WAIT  the boot buffer holds the image but the fallback could not restore scanout to it (frozen): no display path is
+ *              left for any frame, so the debt stays and is asked about again later, until iOS turns the display off.
+ * No step clears the debt on a failure: a flip that does not latch leads to KEEP_BOOT, never to KEEP_DONE.
+ */
+#define SFS_KEEP_DONE   0
+#define SFS_KEEP_FLIP   1
+#define SFS_KEEP_BOOT   2
+#define SFS_KEEP_WAIT   3
+static inline int
+sfs_fast_keep_next(bool ios_off, bool stopped, bool frozen, bool kept_on_screen, bool boot_written)
+{
+	if (ios_off) {
+		return SFS_KEEP_DONE;
+	}
+	if (!stopped) {
+		return kept_on_screen ? SFS_KEEP_DONE : SFS_KEEP_FLIP;
+	}
+	if (!boot_written) {
+		return SFS_KEEP_BOOT;
+	}
+	return frozen ? SFS_KEEP_WAIT : SFS_KEEP_DONE;
+}
