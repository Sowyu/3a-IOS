+/*
+ * 2152: the power key's fast path. dark: the screen went dark ahead of iOS's display off. awake: the panel left sleep ahead of
+ * iOS's display on, with its display still off, so nothing shows. iOS's state always wins: its own change ends either step,
+ * and a step iOS has not confirmed within the window is undone.
+ *
+ * Events are queued in order. Each carries iOS's display state and its generation (bumped on every RequestPowerChange that
+ * changes it) read before the key or touch went to iOS, so a press is classified by the state it began in, never by what iOS
+ * did with it since. A release darkens only if its press began with the display on and iOS has not changed it since. A wake
+ * press is only woken early if iOS is still off in the generation the press saw. A press, another key or a touch cancels a
+ * dark step; another key or a touch cancels an early wake. A dropped event (full queue) cancels both.
+ *
+ * sfs_fast_drain returns the physical work from the state before and after the whole batch, so a step undone within one batch
+ * costs nothing, and a step undone in this batch is not started again in it (each window has one start).
+ */
+#define SFS_FAST_SHORT  1u      /* the power key came up after a short press with no other key during it */
+#define SFS_FAST_PRESS  2u      /* the power key went down */
+#define SFS_FAST_OTHER  4u      /* another key or a touch went down */
+#define SFS_OP_BLANK    1u      /* dark now: panel display off (DCS 28), or with no panel commands a flip to black keeping the shown buffer */
+#define SFS_OP_RESTORE  2u      /* undo it: panel display on (DCS 29), or a flip back to the kept buffer. Never waits for the GPU */
+#define SFS_OP_WAKE     4u      /* the panel out of sleep with its display still off (DCS 11) */
+#define SFS_OP_SLEEP    8u      /* undo it: the panel back to sleep (DCS 10) */
+struct sfs_fast_ev {
+	uint32_t kind;
+	bool ios_off;           /* iOS's display state when the event was taken, before iOS saw it */
+	uint32_t gen;           /* and its generation */
+};
+struct sfs_fast {
+	bool dark, awake;
+	bool press_on;          /* the current press began with the display on */
+	uint32_t press_gen;     /* in this generation */
+	uint64_t until;
+};
+
+static inline void
+sfs_fast_one(struct sfs_fast *f, uint32_t mode, const struct sfs_fast_ev *e, bool ios_off, uint32_t gen, bool can_wake,
+    bool can_blank, bool may_dark, bool may_wake, uint64_t now, uint64_t window)
+{
+	if (e->kind & (SFS_FAST_PRESS | SFS_FAST_OTHER)) {
+		f->dark = false;
+	}
+	if (e->kind & SFS_FAST_OTHER) {
+		f->awake = false;
+		f->press_on = false;
+	}
+	if (e->kind & SFS_FAST_PRESS) {
+		f->press_on = !e->ios_off;
+		f->press_gen = e->gen;
+		if (e->ios_off && ios_off && gen == e->gen && (mode & 2u) && can_wake && may_wake && !f->awake) {
+			f->awake = true;
+			f->until = now + window;
+		}
+	}
+	if (e->kind & SFS_FAST_SHORT) {
+		if (f->press_on && f->press_gen == gen && !ios_off && (mode & 1u) && can_blank && may_dark && !f->dark) {
+			f->dark = true;
+			f->until = now + window;
+		}
+		f->press_on = false;
+	}
+}
+
+static inline uint32_t
+sfs_fast_drain(struct sfs_fast *f, uint32_t mode, const struct sfs_fast_ev *evs, unsigned n, bool lost, bool ios_off,
+    uint32_t gen, bool can_wake, bool can_blank, uint64_t now, uint64_t window)
+{
+	bool dark0 = f->dark, awake0 = f->awake;
+	if (f->dark && (ios_off || now >= f->until)) {
+		f->dark = false;
+	}
+	if (f->awake && (!ios_off || now >= f->until)) {
+		f->awake = false;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		sfs_fast_one(f, mode, &evs[i], ios_off, gen, can_wake, can_blank, !dark0, !awake0, now, window);
+	}
+	if (lost) {
+		f->dark = f->awake = f->press_on = false;
+	}
+	uint32_t ops = 0;
+	ops |= !dark0 && f->dark ? SFS_OP_BLANK : 0u;
+	ops |= dark0 && !f->dark && !ios_off ? SFS_OP_RESTORE : 0u;
+	ops |= !awake0 && f->awake ? SFS_OP_WAKE : 0u;
+	ops |= awake0 && !f->awake && ios_off ? SFS_OP_SLEEP : 0u;
+	return ops;
 }
 
