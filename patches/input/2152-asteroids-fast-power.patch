+/* 2152: the power key fast path, run on the work loop (serialised with the vsync tick and present) */
+void
+AppleCLCD::fastCall(thread_call_param_t p0, thread_call_param_t p1 __unused)
+{
+	AppleCLCD *fb = (AppleCLCD *)p0;
+	fb->fWorkLoop->runAction(&AppleCLCD::fastAction, fb);
