 /*
+ * 2152: the power key's fast path, pixels only (sweetpanel=0 with the asteroids flip; panel modes 1 and 2 never use it).
+ * dark: the screen was flipped to black ahead of iOS's display off, keeping the buffer that was shown. iOS's state always
+ * wins: its display off ends the step, and a step iOS has not confirmed within the window is undone.
+ *
+ * Events are queued in order. Each carries iOS's display state and its generation (bumped on every RequestPowerChange that
+ * changes it), read before the key or touch went to iOS, so a press is classified by the state it began in, never by what iOS
+ * did with it since. A release darkens only if its press began with the display on and iOS has not changed it since. A press,
+ * another key or a touch ends a dark step. A dropped event (full queue) ends it too.
+ *
+ * sfs_fast_drain returns BLANK when a dark step starts and RESTORE when one ends with iOS's display still on, from the state
+ * before and after the whole batch, so a step undone within one batch costs nothing and is not started again in it.
+ */
+#define SFS_FAST_SHORT  1u      /* the power key came up after a short press with no other key during it */
+#define SFS_FAST_PRESS  2u      /* the power key went down */
+#define SFS_FAST_OTHER  4u      /* another key or a touch went down */
+#define SFS_OP_BLANK    1u      /* black now: flip to a black buffer, keeping the shown one */
+#define SFS_OP_RESTORE  2u      /* the step ended with iOS's display on: show the kept image again (sfs_fast_keep_next) */
+struct sfs_fast_ev {
+	uint32_t kind;
+	bool ios_off;           /* iOS's display state when the event was taken, before iOS saw it */
+	uint32_t gen;           /* and its generation */
+};
+struct sfs_fast {
+	bool dark;
+	bool press_on;          /* the current press began with the display on */
+	uint32_t press_gen;     /* in this generation */
+	uint64_t until;
+};
+
+static inline void
+sfs_fast_one(struct sfs_fast *f, uint32_t mode, const struct sfs_fast_ev *e, bool ios_off, uint32_t gen, bool can_blank,
+    bool may_dark, uint64_t now, uint64_t window)
+{
+	if (e->kind & (SFS_FAST_PRESS | SFS_FAST_OTHER)) {
+		f->dark = false;
+	}
+	if (e->kind & SFS_FAST_OTHER) {
+		f->press_on = false;
+	}
+	if (e->kind & SFS_FAST_PRESS) {
+		f->press_on = !e->ios_off;
+		f->press_gen = e->gen;
+	}
+	if (e->kind & SFS_FAST_SHORT) {
+		if (f->press_on && f->press_gen == gen && !ios_off && (mode & 1u) && can_blank && may_dark && !f->dark) {
+			f->dark = true;
+			f->until = now + window;
+		}
+		f->press_on = false;
+	}
+}
+
+static inline uint32_t
+sfs_fast_drain(struct sfs_fast *f, uint32_t mode, const struct sfs_fast_ev *evs, unsigned n, bool lost, bool ios_off,
+    uint32_t gen, bool can_blank, uint64_t now, uint64_t window)
+{
+	bool dark0 = f->dark;
+	if (f->dark && (ios_off || now >= f->until)) {
+		f->dark = false;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		sfs_fast_one(f, mode, &evs[i], ios_off, gen, can_blank, !dark0, now, window);
+	}
+	if (lost) {
+		f->dark = f->press_on = false;
+	}
+	uint32_t ops = 0;
+	ops |= !dark0 && f->dark ? SFS_OP_BLANK : 0u;
+	ops |= dark0 && !f->dark && !ios_off ? SFS_OP_RESTORE : 0u;
+	return ops;
+}
