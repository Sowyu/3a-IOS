+/*
+ * 2152: from the keys thread (power key, other keys) and the touch thread (a finger down), always before the event goes to
+ * iOS, so it records iOS's display state as the press found it. Nothing unless sweetpwrfast is set.
  */
+extern "C" void sweet_fb_input_event(uint32_t kind);
