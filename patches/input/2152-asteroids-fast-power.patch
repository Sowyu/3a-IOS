+	if (sweet_fb_fast_head - sweet_fb_fast_tail < SWEET_FB_FAST_RING) {
+		sweet_fb_fast_ring[sweet_fb_fast_head++ % SWEET_FB_FAST_RING] = e;
+	} else {
+		sweet_fb_fast_lost = true;
+	}
+	IOSimpleLockUnlock(sweet_fb_fast_lock);
+	(void)thread_call_enter(fb->fFastCall);
+}
