+/* 2150: the power key's last press [0] and release [1] (bsd/dev/sweet_keys.c), as milliseconds before now; -1 if none in 10 s */
+extern "C" uint64_t sweet_keys_power_abs[2];
+static long long
+sweet_power_key_ms(int which, uint64_t now)
+{
+	uint64_t t = __atomic_load_n(&sweet_keys_power_abs[which], __ATOMIC_ACQUIRE);
+	if (t == 0 || t > now) {
+		return -1;
+	}
+	uint64_t us = sweet_abs_us(now - t);
+	return us > 10000000 ? -1 : (long long)(us / 1000);
+}
