asteroids A810: dump the first four hangs of a boot, with the submissions before them

UNTESTED on the phone, syntax-checked only. dumpHang ran once a boot, so ast24's RECOVERY 2 and 3 left no IB. It now runs for four, and every hang prints the last 8 submissions: fence, pid, time, IB, BO count, whether the ring had drained, whether the client changed. A line every 1024 submissions gives the BO list size, so a flat list is visible. Diagnostics only, no change to what reaches the GPU. Pairs with chlorophyll-prologue-free.patch, whose "render pipeline" lines use the same clock.

Apply: git apply in the kernel tree (-p1), after 2059.

--- a/iokit/Kernel/arm/SweetAdreno.cpp
+++ b/iokit/Kernel/arm/SweetAdreno.cpp
@@ -501,11 +501,45 @@ wcReassert(struct sweet_gem *g)
 	return fixed;
 }
 
+/*
+ * 2063: the submissions before a hang, printed with it. The first-IB2 hangs are suspected of following a drained ring or a client
+ * change; only a log with both can say. Under the GPU lock. Same clock as the client's CLOCK_UPTIME_RAW.
+ */
+#define SUBMIT_HIST             8
+static struct {
+	uint64_t ib, t;
+	uint32_t fence, dwords, cmds, bos;
+	int32_t  pid;
+	bool     drained, switched;
+} gHist[SUBMIT_HIST];
+static uint32_t gHistNext;
+
+static void
+histPrint(void)
+{
+	uint64_t now = mach_absolute_time(), nowns = 0;
+	absolutetime_to_nanoseconds(now, &nowns);
+	IOLog("SWEET HANG hist: now %llu ms\n", nowns / NSEC_PER_MSEC);
+	for (uint32_t n = 0; n < SUBMIT_HIST; n++) {
+		const uint32_t i = (gHistNext + n) % SUBMIT_HIST;
+		uint64_t ns = 0;
+		if (gHist[i].fence == 0) {
+			continue;
+		}
+		absolutetime_to_nanoseconds(gHist[i].t, &ns);
+		IOLog("SWEET HANG hist: fence %u pid %d at %llu ms, IB %#llx %u dwords, %u cmds, %u BOs, ring drained %d, client changed %d\n",
+		    gHist[i].fence, gHist[i].pid, ns / NSEC_PER_MSEC, gHist[i].ib, gHist[i].dwords, gHist[i].cmds, gHist[i].bos,
+		    gHist[i].drained, gHist[i].switched);
+	}
+}
