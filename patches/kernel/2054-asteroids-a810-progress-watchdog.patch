+++ b/iokit/Kernel/arm/SweetAdrenoWatch.h
@@ -0,0 +1,86 @@
+/*
+ * 2052: is the A810 still working on a fence that has not come back? Plain C, no kernel headers, so
+ * plans/stability/2052-progress-watchdog/watch_check.py replays the logged sessions through it on a Mac.
+ *
+ * A sample is every register the kernel already reads while a fence is out: a hung CP freezes all of them (ast16: rptr 0x282
+ * and RBBM 0xec0405 in 177 of 177 kicks over 311 s), a long job moves the IB pointers or flickers the busy bits. WPTR is left out
+ * on purpose: new submissions behind a hung CP must not look like progress.
+ *
+ * ponytail: frozen pointers plus static busy bits for WATCH cap is taken as a hang; a real job that holds every bit still for
+ * that long is reset as the base kernel already did. Add a RBBM_PERFCTR_GPU_BUSY read if a log ever shows such a job.
+ */
+#ifndef SWEET_ADRENO_WATCH_H
+#define SWEET_ADRENO_WATCH_H
+
+#define SWEET_WATCH_WORDS       12      /* rptr, rbbm, fence word, BV rptr shadow, then base/rem of IB1 and IB2 for BR and BV */
+#define SWEET_WATCH_HANG_DETECT (1u << 23)      /* RBBM_INT_0 RBBM_HANG_DETECT: a8xx_gpu.c recovers on this interrupt */
+
+enum sweet_watch_verdict {
+	SWEET_WATCH_WAIT = 0,   /* keep waiting */
+	SWEET_WATCH_FAST,       /* frozen for `fast` with the hardware's own hang bit up */
+	SWEET_WATCH_HUNG,       /* frozen for `cap` */
+	SWEET_WATCH_MAX,        /* moving, but no fence for `max` */
+};
+
+struct sweet_watch {
+	uint32_t last[SWEET_WATCH_WORDS];
+	uint64_t sampled, frozen_since, fence_since;
+	uint32_t same;
+	int      valid, would_fast;
+};
+
+struct sweet_watch_limits {
+	uint64_t gap;           /* samples further apart than this: what happened between them is unknown, start over */
+	uint64_t fast;          /* 0: the fast verdict is only noted in would_fast (boot-arg sweetgpufast) */
+	uint64_t cap, max;
+};
+
+static inline void
+sweet_watch_reset(struct sweet_watch *w)
+{
+	w->valid = 0;
+	w->same = 0;
+	w->would_fast = 0;
+}
+
+static inline enum sweet_watch_verdict
+sweet_watch_feed(struct sweet_watch *w, const struct sweet_watch_limits *l, uint64_t now, const uint32_t s[SWEET_WATCH_WORDS],
+    uint32_t int0)
+{
+	int moved = !w->valid, fence_moved = !w->valid || w->last[2] != s[2];
+
+	if (w->valid && now - w->sampled > l->gap) {
+		moved = fence_moved = 1;
+	}
+	for (unsigned i = 0; !moved && i < SWEET_WATCH_WORDS; i++) {
+		moved = w->last[i] != s[i];
+	}
+	for (unsigned i = 0; i < SWEET_WATCH_WORDS; i++) {
+		w->last[i] = s[i];
+	}
+	w->sampled = now;
+	w->valid = 1;
+	if (fence_moved) {
+		w->fence_since = now;
+	}
+	if (moved) {
+		w->frozen_since = now;
+		w->same = 0;
+		w->would_fast = 0;
+		return now - w->fence_since >= l->max ? SWEET_WATCH_MAX : SWEET_WATCH_WAIT;
+	}
+	w->same++;
+	if (now - w->frozen_since >= l->cap) {
+		return SWEET_WATCH_HUNG;
+	}
+	if ((int0 & SWEET_WATCH_HANG_DETECT) && w->same >= 2) {
+		if (l->fast != 0 && now - w->frozen_since >= l->fast) {
+			return SWEET_WATCH_FAST;
+		}
+		if (l->fast == 0) {
+			w->would_fast = 1;
+		}
+	}
+	return now - w->fence_since >= l->max ? SWEET_WATCH_MAX : SWEET_WATCH_WAIT;
+}
+#endif /* SWEET_ADRENO_WATCH_H */
