+
+/* 2044: display-only survey. Reserved RAM is not proof of a display IOVA mapping.
+ * Do not arm a flip until the bootloader's complete fetch mapping is established.
+ * Even read-only MMIO can abort under Gunyah: persist each block boundary first. */
+extern "C" void sweet_log_sync(void);
+static void
+sweet_ast_display_probe(void)
+{
+	int level = 0;
+	PE_parse_boot_argn("sweetfb_flip_ast", &level, sizeof(level));
+	if (level == 0) {
+		return;
+	}
+	if (level != 1 && level != 2) {
+		IOLog("SWEET FB AST: invalid probe level; copy unchanged\n");
+		return;
+	}
+	const uint32_t blocks[] = { 0x0ae16000, 0x0ae05000, 0x0ae36000 };
+	const char *names[] = { "CTL0", "SSPP0", "INTF1" };
+	/* DT offsets are relative to MDSS 0xae00000, not MDP 0xae01000. */
+	const uint32_t regs[3][8] = {
+		{ 0x00, 0x14, 0x18, 0x40, 0xe8, 0xf4, 0xfc, 0x110 },
+		{ 0x00, 0x08, 0x0c, 0x10, 0x14, 0x24, 0x30, 0x38 },
+		{ 0x00, 0x04, 0x08, 0x0c, 0x1c, 0x24, 0xa8, 0xb0 },
+	};
+	for (unsigned b = 0; b < 3; b++) {
+		IOLog("SWEET FB AST: before %s first access pa=0x%x (read only)\n", names[b], blocks[b]);
+		sweet_log_sync();
+		volatile const uint32_t *r = (volatile const uint32_t *)ml_io_map(blocks[b], 0x1000);
+		if (r == NULL) {
+			IOLog("SWEET FB AST: map failed; copy unchanged\n");
+			sweet_log_sync();
+			return;
+		}
+		for (unsigned i = 0; i < 8; i++) {
+			uint32_t value = r[regs[b][i] / 4];
+			IOLog("SWEET FB AST: %s +0x%x = 0x%x\n", names[b], regs[b][i], value);
+		}
+		if (b == 2) {
+			/* Counters must already be enabled by firmware. Never enable them here. */
+			uint32_t enabled = r[0xa8 / 4];
+			uint32_t frames = r[0xac / 4], line = r[0xb0 / 4];
+			uint64_t start = mach_absolute_time(), ns;
+			IOSleep(100);
+			uint32_t endFrames = r[0xac / 4], endLine = r[0xb0 / 4];
+			absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+			IOLog("SWEET FB AST: timing count_en=0x%x frames=%u->%u line=%u->%u elapsed_us=%llu\n",
+			    enabled, frames, endFrames, line, endLine, ns / 1000);
+		}
+		sweet_log_sync();
+	}
+	IOLog("SWEET FB AST: %s; copy unchanged (splash SMMU coverage unverified)\n",
+	    level == 2 ? "flip refused" : "probe complete");
+	sweet_log_sync();
+}
 
