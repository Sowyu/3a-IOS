+/*
+ * Keep falling edges of the IRQ pin in the TLMM status bit, not routed to the GIC (as beryllium, 0101). We only sample the
+ * pin level every at_idle_ms, so a low pulse between two samples was seen only by the 100 ms periodic read: a flick's first
+ * sample then came near its end, and a down + small move + up is a tap.
+ */
+static void
+at_irq_latch(void)
+{
+	uint32_t cfg = (at_rd(at.tlmm, (int32_t)GPIO_INTR_CFG(PIN_IRQ)) & ~INTR_CFG_MASK) | INTR_CFG_FALLING;
+	at_wr(at.tlmm, (int32_t)GPIO_INTR_CFG(PIN_IRQ), cfg);
+	at_wr(at.tlmm, (int32_t)GPIO_INTR_STATUS(PIN_IRQ), 0);
+	at.latch = (at_rd(at.tlmm, (int32_t)GPIO_INTR_CFG(PIN_IRQ)) & INTR_CFG_MASK) == INTR_CFG_FALLING;
+	printf("SWEET TOUCH: IRQ edge latch %s, cfg=%#x, idle %u ms, active %u us, hold %u ms\n", at.latch ? "on" : "off", cfg,
+	    at_idle_ms, at_active_us, at_hold_ms);
+}
