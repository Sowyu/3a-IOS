+/*
+ * A false release mid-swipe ends the pan and the next down + real lift is a short new touch: iOS takes it as a tap on
+ * whatever is under the finger (the owner's "I swipe and it opens an app"). Same failure as beryllium's 0113, which this
+ * driver never got. We read while touched without waiting for the IRQ (Linux reads only on it), so a read can land on a
+ * buffer being rewritten: all FF, or a valid frame that omits a contact. Release at once only on an UP record; a contact
+ * that merely vanished is kept for at_hold_ms, which covers two report frames at 120 Hz and costs an unannounced real
+ * lift that much latency.
+ */
+static uint32_t
+fts_hold_vanished(uint32_t mask, uint32_t released, int *x, int *y)
+{
+	uint32_t gone = at.active & ~mask & ~released;
+	if (!gone) {
+		if (at.vanish_at && (at.active & mask)) {
+			if (at.resumed++ < 50u) {
+				uint64_t ns;
+				absolutetime_to_nanoseconds(mach_absolute_time() - at.vanish_at, &ns);
+				printf("SWEET TOUCH: contact back after %llu ms with no UP record, kept (%u torn so far)\n",
+				    ns / NSEC_PER_MSEC, at.torn);
+			}
+		}
+		at.vanish_at = 0;
+		return mask;
+	}
+	uint64_t now = mach_absolute_time();
+	if (!at.vanish_at) {
+		at.vanish_at = now;
+	}
+	if (now - at.vanish_at >= at.hold_abs) {
+		at.vanish_at = 0;
+		return mask;
+	}
+	++at.held;
+	for (unsigned id = 0; id < FTS_MAX; ++id) {
+		if (gone & (1u << id)) {
+			x[id] = at.x[id];
+			y[id] = at.y[id];
+		}
+	}
+	return mask | gone;
 }
 
