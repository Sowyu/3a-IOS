+int
+sweet_a810_thermal_level(unsigned drop)
+{
+	unsigned base = 6, bw = 0;
+	uint32_t error = 0;
+	int st;
+
+	PE_parse_boot_argn("sweeta810level", &base, sizeof(base));
+	/* Try-lock: recovery holds this lock for a long time, and the thermal guard must keep polling meanwhile. */
+	if (!lck_mtx_try_lock(&a810_lck)) {
+		return EBUSY;
+	}
+	if (!sweet_a810_ready()) {
+		lck_mtx_unlock(&a810_lck);
+		return ENXIO;
+	}
+	const unsigned perf = ShengGmuPerfVote(drop >= base ? 1 : base - drop, &bw);
+	st = a810_gx_vote(NULL, perf, bw, &error);      /* blocking HFI, at most about 100 ms */
+	lck_mtx_unlock(&a810_lck);
+	A810_LOG("SWEET A810: thermal vote perf %u bw %u (%llu MHz) rc %d fw %u\n", perf, bw,
+	    sweet_a810_gpu_level_hz(perf) / 1000000, st, error);
+	return st || error ? EIO : 0;
+}
