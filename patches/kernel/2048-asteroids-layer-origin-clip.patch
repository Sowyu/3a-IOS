+/*
+ * Clip a layer's negative origins, each axis on its own, keeping source and destination pixels paired. w and h are the rectangle
+ * size; false when nothing is left. Sizes that do not fit int32 after the move come out empty.
+ */
+static inline bool
+sfs_clip_axis(int32_t *src, int32_t *dst, int32_t *size)
+{
+	int64_t s = *src, d = *dst, n = *size;
+	if (d < 0) {
+		s -= d;
+		n += d;
+		d = 0;
+	}
+	if (s < 0) {
+		d -= s;
+		n += s;
+		s = 0;
+	}
+	if (n <= 0 || s > INT32_MAX || d > INT32_MAX) {
+		return false;
+	}
+	*src = (int32_t)s;
+	*dst = (int32_t)d;
+	*size = (int32_t)n;
+	return true;
+}
+
+static inline bool
+sfs_clip_origin(int32_t *sx, int32_t *sy, int32_t *dx, int32_t *dy, int32_t *w, int32_t *h)
+{
+	return sfs_clip_axis(sx, dx, w) && sfs_clip_axis(sy, dy, h);
+}
