-  if (!astCovered(rec, mask)) memcpy((void *)fDraw, (const void *)ast.va[ast.front], astBytes);
+  if (!astCovered(rec, mask)) {
+   ast.preserves++;
+   memcpy((void *)fDraw, (const void *)ast.va[ast.front], astBytes);
+  }
   // The legacy first-use bar clear erases the entire image, including preserved damage.
   if (fScale && (fPadX > 0 || fPadY > 0)) {
    uint32_t right = fPadX + (uint64_t)fLogicalW * fScaleXNum / fScaleXDen;
@@ -4008,6 +4032,15 @@ AppleCLCD::present(const uint8_t *rec, uint32_t copyEpoch)
         else ast.epochDrops++;
     }
     uint64_t astLatchAbs = mach_absolute_time() - astLatchStart;
+    if (struct sweet_fb_trace_rec *tr = ast.enabled ? sweet_fb_trace_of(fCurSwapID) : NULL) {
+        uint64_t end = astLatchStart + astLatchAbs, ns;
+        tr->scan = tcp0;
+        tr->latch = tr->done = end;
+        absolutetime_to_nanoseconds(end - tr->swap, &ns);
+        ast.swapFlipNS += ns;
