+/*
+ * Bilinear canvas -> panel scaler for the CPU copy path (patch 2047). Host-testable: no kernel headers.
+ * Works both ways: 1242x2751 down to 1080x2392 and 828x1834 up. Each source row is filtered horizontally once into a
+ * per-thread line buffer and panel rows blend two such lines, so every source row is read once per band.
+ * Weights are 8-bit and blending is in gamma space. ponytail: 2 taps, add a third if thin lines visibly shimmer at 0.87x.
+ */
+#ifndef SWEET_FB_SCALE_H
+#define SWEET_FB_SCALE_H
+#include <stdint.h>
+#if defined(__arm64__) || defined(__aarch64__)
+#include <arm_neon.h>
+#define SFS_NEON 1
+#endif
+
+struct sfs_job {
+	const uint8_t *base;    /* surface row 0 */
+	uint8_t *draw;          /* panel row 0 */
+	const uint32_t *xi;     /* per output column: left source column; xi+1 is always readable */
+	const uint8_t *xf;      /* per output column: weight of xi+1 in 1/256 */
+	uint32_t bpr, rowBytes;
+	int32_t px0, n;         /* output columns */
+	int32_t padY;
+	uint32_t yNum, yDen;    /* panel = pad + logical * num / den */
+	int32_t yOff;           /* surface row = logical row + yOff */
+	int32_t rowMin, rowMax; /* readable surface rows, rowMax > rowMin */
+};
+
+/* Source position of a panel pixel centre, Q16, before clamping. */
+static inline int64_t
+sfs_pos(int32_t p, int32_t pad, uint32_t num, uint32_t den, int32_t off)
+{
+	return (int64_t)(2 * (p - pad) + 1) * den * 65536 / (2 * (int64_t)num) - 32768 + ((int64_t)off << 16);
+}
+
+/* Clamp to min..max; past max use the last pair with the largest weight, so index+1 stays readable. */
+static inline void
+sfs_split(int64_t q, int32_t min, int32_t max, int32_t *index, uint32_t *weight)
+{
+	if (q < (int64_t)min << 16) {
+		q = (int64_t)min << 16;
+	}
+	if (q >= (int64_t)max << 16) {
+		*index = max - 1;
+		*weight = 255;
+	} else {
+		*index = (int32_t)(q >> 16);
+		*weight = (uint32_t)(q >> 8) & 0xff;
+	}
+}
+
+static inline void
+sfs_build_x(uint32_t *xi, uint8_t *xf, int32_t px0, int32_t n, int32_t pad, uint32_t num, uint32_t den, int32_t off,
+    int32_t min, int32_t max)
+{
+	for (int32_t i = 0; i < n; i++) {
+		int32_t index;
+		uint32_t weight;
+		sfs_split(sfs_pos(px0 + i, pad, num, den, off), min, max, &index, &weight);
+		xi[i] = (uint32_t)index;
+		xf[i] = (uint8_t)weight;
+	}
+}
+
+static inline uint32_t
+sfs_lerp(uint32_t a, uint32_t b, uint32_t f)
+{
+	uint32_t out = 0;
+	for (int shift = 0; shift < 32; shift += 8) {
+		uint32_t x = (a >> shift) & 0xff, y = (b >> shift) & 0xff;
+		out |= ((x * (256 - f) + y * f + 128) >> 8) << shift;
+	}
+	return out;
+}
+
+static inline void
+sfs_hline_c(uint32_t *out, const uint32_t *src, const uint32_t *xi, const uint8_t *xf, int32_t n)
+{
+	for (int32_t i = 0; i < n; i++) {
+		out[i] = sfs_lerp(src[xi[i]], src[xi[i] + 1], xf[i]);
+	}
+}
+
+static inline void
+sfs_vline_c(uint32_t *out, const uint32_t *a, const uint32_t *b, uint32_t f, int32_t n)
+{
+	for (int32_t i = 0; i < n; i++) {
+		__builtin_memcpy(&out[i], (const uint32_t[1]){ sfs_lerp(a[i], b[i], f) }, 4);
+	}
+}
+
+#if SFS_NEON
+/* a*(256-w) = a*(255-w) + a, so the weight fits 8 bits. Rounded like sfs_lerp. */
+static inline uint8x16_t
+sfs_blend(uint8x16_t a, uint8x16_t b, uint8x8_t wl, uint8x8_t wh)
+{
+	uint16x8_t lo = vaddw_u8(vmlal_u8(vmull_u8(vget_low_u8(a), vmvn_u8(wl)), vget_low_u8(b), wl), vget_low_u8(a));
+	uint16x8_t hi = vaddw_u8(vmlal_u8(vmull_u8(vget_high_u8(a), vmvn_u8(wh)), vget_high_u8(b), wh), vget_high_u8(a));
+	return vcombine_u8(vrshrn_n_u16(lo, 8), vrshrn_n_u16(hi, 8));
+}
+
+static inline void
+sfs_hline(uint32_t *out, const uint32_t *src, const uint32_t *xi, const uint8_t *xf, int32_t n)
+{
+	int32_t i = 0;
+	for (; i + 4 <= n; i += 4) {
+		uint64_t p0, p1, p2, p3;
+		__builtin_memcpy(&p0, src + xi[i], 8);
+		__builtin_memcpy(&p1, src + xi[i + 1], 8);
+		__builtin_memcpy(&p2, src + xi[i + 2], 8);
+		__builtin_memcpy(&p3, src + xi[i + 3], 8);
+		uint32x4x2_t pair = vuzpq_u32(vcombine_u32(vcreate_u32(p0), vcreate_u32(p1)),
+		    vcombine_u32(vcreate_u32(p2), vcreate_u32(p3)));
+		uint8x8_t wl = vcreate_u8((xf[i] | (uint64_t)xf[i + 1] << 32) * 0x01010101u);
+		uint8x8_t wh = vcreate_u8((xf[i + 2] | (uint64_t)xf[i + 3] << 32) * 0x01010101u);
+		vst1q_u8((uint8_t *)(out + i), sfs_blend(vreinterpretq_u8_u32(pair.val[0]), vreinterpretq_u8_u32(pair.val[1]), wl, wh));
+	}
+	sfs_hline_c(out + i, src, xi + i, xf + i, n - i);
+}
+
+/* out may be the panel: st1 .4s needs only 4-byte alignment on any memory type, unlike the str q a plain store may become. */
+static inline void
+sfs_vline(uint32_t *out, const uint32_t *a, const uint32_t *b, uint32_t f, int32_t n)
+{
+	uint8x8_t w = vdup_n_u8((uint8_t)f);
+	int32_t i = 0;
+	for (; i + 4 <= n; i += 4) {
+		uint8x16_t v = sfs_blend(vld1q_u8((const uint8_t *)(a + i)), vld1q_u8((const uint8_t *)(b + i)), w, w);
+		__asm__ volatile("st1 {%1.4s}, [%0]" : : "r"(out + i), "w"(v) : "memory");
+	}
+	sfs_vline_c(out + i, a + i, b + i, f, n - i);
+}
+#else
+#define sfs_hline sfs_hline_c
+#define sfs_vline sfs_vline_c
+#endif
+
+/* One band of panel rows. line: two rows of n uint32_t owned by this thread. */
+static inline void
+sfs_draw(const struct sfs_job *j, int32_t from, int32_t to, uint32_t *line)
+{
+	uint32_t *lo = line, *hi = line + j->n;
+	int32_t loRow = -1, hiRow = -1;
+	for (int32_t py = from; py < to; py++) {
+		int32_t row;
+		uint32_t f;
+		sfs_split(sfs_pos(py, j->padY, j->yNum, j->yDen, j->yOff), j->rowMin, j->rowMax, &row, &f);
+		if (hiRow == row) {     /* moving down one row: the old lower line is the new upper one */
+			uint32_t *t = lo;
+			lo = hi;
+			hi = t;
+			loRow = row;
+			hiRow = -1;
+		}
+		if (loRow != row) {
+			sfs_hline(lo, (const uint32_t *)(j->base + (uint64_t)row * j->bpr), j->xi, j->xf, j->n);
+			loRow = row;
+		}
+		if (hiRow != row + 1) {
+			sfs_hline(hi, (const uint32_t *)(j->base + (uint64_t)(row + 1) * j->bpr), j->xi, j->xf, j->n);
+			hiRow = row + 1;
+		}
+		sfs_vline((uint32_t *)(j->draw + (uint64_t)py * j->rowBytes) + j->px0, lo, hi, f, j->n);
+	}
+}
+#endif
