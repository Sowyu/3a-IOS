+/*
+ * 2090 sweetfb_barcheck: sample a frame for dark bars before it is shown. Every 16th panel row, 8 columns; a row is dark when 3
+ * adjacent samples are black or flat grey up to 64 (the glass band is 60,60,60). A run of 3 or more dark rows is a bar. An icon
+ * spans at most 2 columns. ponytail: a bar under 48 rows or under 3 columns is missed, narrow the steps if one is seen anyway.
+ */
+#define SFS_BAR_STEP 16
+#define SFS_BAR_COLS 8
+#define SFS_BAR_MIN_ROWS 3
+#define SFS_BAR_RUNS 3
+
+struct sfs_bar {
+	int32_t from[SFS_BAR_RUNS], to[SFS_BAR_RUNS];   /* panel rows, to is exclusive */
+	uint32_t px[SFS_BAR_RUNS];                      /* the first dark sample of the run */
+	uint32_t runs, sig;                             /* sig: runs found, to log each change once */
+};
+
+static inline bool
+sfs_bar_dark(uint32_t px)
+{
+	uint32_t b = px & 0xff, g = (px >> 8) & 0xff, r = (px >> 16) & 0xff;
+	uint32_t hi = r > g ? r : g, lo = r < g ? r : g;
+	hi = b > hi ? b : hi;
+	lo = b < lo ? b : lo;
+	return hi <= 64 && hi - lo <= 2;
+}
+
+/* One row of a mapped image; the pixel is read once, the mapping may be device-like. True with *first set when the row is dark. */
+static inline bool
+sfs_bar_row(const uint8_t *row, uint32_t width, uint32_t *first)
+{
+	uint32_t adjacent = 0;
+	for (uint32_t i = 0; i < SFS_BAR_COLS; i++) {
+		uint32_t px = *(const volatile uint32_t *)(row + (uint64_t)(width * (2 * i + 1) / (2 * SFS_BAR_COLS)) * 4);
+		adjacent = sfs_bar_dark(px) ? adjacent + 1 : 0;
+		if (adjacent == 1) {
+			*first = px;
+		}
+		if (adjacent == 3) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static inline void
+sfs_bar_scan(const uint8_t *image, uint32_t rowBytes, uint32_t width, uint32_t height, struct sfs_bar *bar)
+{
+	int32_t start = -1;
+	uint32_t px = 0, startPx = 0;
+	bar->runs = 0;
+	bar->sig = 0;
+	for (uint32_t y = 0;; y = y + SFS_BAR_STEP < height ? y + SFS_BAR_STEP : height) {
+		bool dark = y < height && sfs_bar_row(image + (uint64_t)y * rowBytes, width, &px);
+		if (dark && start < 0) {
+			start = (int32_t)y;
+			startPx = px;
+		} else if (!dark && start >= 0) {
+			if ((y - (uint32_t)start + SFS_BAR_STEP - 1) / SFS_BAR_STEP >= SFS_BAR_MIN_ROWS && bar->runs < SFS_BAR_RUNS) {
+				bar->from[bar->runs] = start;
+				bar->to[bar->runs] = (int32_t)y;
+				bar->px[bar->runs] = startPx;
+				bar->sig = (bar->sig ^ (uint32_t)start ^ ((uint32_t)y << 12)) * 16777619u;
+				bar->runs++;
+			}
+			start = -1;
+		}
+		if (y == height) {
+			break;
+		}
+	}
+}
+
+/* Samples of a surface, to see whether it changes during its own copy. */
+static inline uint32_t
+sfs_bar_hash(const uint8_t *image, uint32_t rowBytes, uint32_t width, uint32_t height)
+{
+	uint32_t h = 2166136261u;
+	for (uint32_t y = 0; y < 16; y++) {
+		const uint8_t *row = image + (uint64_t)(height * (2 * y + 1) / 32) * rowBytes;
+		for (uint32_t i = 0; i < SFS_BAR_COLS; i++) {
+			h = (h ^ *(const volatile uint32_t *)(row + (uint64_t)(width * (2 * i + 1) / (2 * SFS_BAR_COLS)) * 4)) * 16777619u;
+		}
+	}
+	return h;
+}
