+/*
+ * 2090: runs right before the flip, while the swap still holds the source. src is the surface's first pixel, 0 when no canvas-sized
+ * surface was copied. One line per bar each time the set of bars changes, 256 lines a boot; the 10 s counters keep counting.
+ */
+static void
+astBarCheck(unsigned back, const uint8_t *src, uint32_t bpr, uint32_t srcW, uint32_t srcH, uint32_t swapID, uint64_t copyNS)
+{
+	struct sfs_bar bar;
+	uint64_t start = mach_absolute_time(), ns;
+	sfs_bar_scan((const uint8_t *)ast.va[back], 4320, 1080, 2392, &bar);
+	ast.barChecks++;
+	bool changed = bar.sig != ast.barSig;
+	ast.barSig = bar.sig;
+	for (uint32_t i = 0; i < bar.runs; i++) {
+		uint32_t first = 0;
+		bool dark = false;
+		if (src != NULL) {
+			uint32_t row = (uint32_t)(((uint64_t)bar.from[i] + bar.to[i]) / 2 * srcH / 2392);
+			dark = sfs_bar_row(src + (uint64_t)row * bpr, srcW, &first);
+		}
+		ast.barHits++;
+		if (dark) ast.barSrcDark++;
+		else if (src != NULL) ast.barSlotOnly++;
+		if (changed && ast.barLines < 256) {
+			ast.barLines++;
+			IOLog("SWEET FB BAR: swap=%u slot=%u rows=%d-%d px=%08x src=%s band_edges=%d,%d copy_us=%llu\n", swapID, back, bar.from[i], bar.to[i],
+			    bar.px[i], src == NULL ? "none" : (dark ? "dark" : "not-dark"), sweet_rows.band[1], sweet_rows.band[2], copyNS / 1000);
+		}
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+	if (ns > ast.barMaxNS) ast.barMaxNS = ns;
+}
