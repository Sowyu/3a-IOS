+/*
+ * 2111 sweetfb_hwtest: an opaque chart in canvas coordinates. Each edge has 4 stripes of 4 px, the outermost on the edge pixel, with
+ * black between them: left red, right green, top blue, bottom yellow. White ticks every 100 canvas px count from column and row 0,
+ * longer every 500. White centre lines, a magenta square 600x600 for aspect, and a cyan bar where the battery fill ended in ast43.
+ */
+static inline uint32_t
+sfs_pattern_px(uint32_t x, uint32_t y, uint32_t w, uint32_t h)
+{
+	if (w == 840 && x >= 814 && x < 816 && y >= 37 && y < 62) {
+		return 0xff00ffffu;
+	}
+	uint32_t l = x, r = w - 1 - x, t = y, b = h - 1 - y;
+	uint32_t dx = l < r ? l : r, dy = t < b ? t : b, d = dx < dy ? dx : dy;
+	if (d < 32) {
+		if ((d / 4) & 1) {
+			return 0xff000000u;
+		}
+		return d == l ? 0xffff0000u : d == r ? 0xff00ff00u : d == t ? 0xff0000ffu : 0xffffff00u;
+	}
+	uint32_t cx = w / 2, cy = h / 2;
+	if ((x == cx || x == cx - 1) || (y == cy || y == cy - 1)) {
+		return 0xffffffffu;
+	}
+	if (x >= cx - 300 && x < cx + 300 && y >= cy - 300 && y < cy + 300 &&
+	    (x < cx - 297 || x >= cx + 297 || y < cy - 297 || y >= cy + 297)) {
+		return 0xffff00ffu;
+	}
+	if ((dx < (y % 500 < 2 ? 80u : 56u) && y % 100 < 2) || (dy < (x % 500 < 2 ? 80u : 56u) && x % 100 < 2)) {
+		return 0xffffffffu;
+	}
+	return 0xff404040u;
 }
 
+/* dw x dh is what the scan-out buffer holds: the canvas under sweetfb_ast_hw, the panel with the CPU scaler (nearest, for comparison). */
+static inline void
+sfs_pattern_fill(uint8_t *draw, uint32_t rowBytes, uint32_t dw, uint32_t dh, uint32_t cw, uint32_t ch)
+{
+	for (uint32_t py = 0; py < dh; py++) {
+		volatile uint32_t *row = (volatile uint32_t *)(draw + (uint64_t)py * rowBytes);
+		uint32_t cy = (uint32_t)((uint64_t)py * ch / dh);
+		for (uint32_t px = 0; px < dw; px++) {
+			row[px] = sfs_pattern_px((uint32_t)((uint64_t)px * cw / dw), cy, cw, ch);
+		}
+	}
+}
