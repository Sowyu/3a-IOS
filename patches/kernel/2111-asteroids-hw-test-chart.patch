+/* 2111: replaces this frame with the chart until the time is up, counted from the first frame. Off without the boot-arg. */
+static void astTestFrame(uintptr_t draw, uint32_t rowBytes, uint32_t w, uint32_t h, uint32_t cw, uint32_t ch)
+{
+ uint64_t now = mach_absolute_time();
+ if (ast.testEnd == 0) {
+  nanoseconds_to_absolutetime((uint64_t)ast.testSecs * NSEC_PER_SEC, &ast.testEnd);
+  ast.testEnd += now;
+  IOLog("SWEET FB HWTEST: chart on for %u s, canvas %ux%u in a buffer of %ux%u\n", ast.testSecs, cw, ch, w, h);
+  sweet_log_sync();
+ }
+ if (now >= ast.testEnd) {
+  ast.testSecs = 0;
+  IOLog("SWEET FB HWTEST: chart off\n");
+  sweet_log_sync();
+  return;
+ }
+ if (!ast.testRegs && ast.front != 0) {
+  ast.testRegs = true;
+  astTestLog();
  }
+ sfs_pattern_fill((uint8_t *)draw, rowBytes, w, h, cw, ch);
+ __asm__ volatile("dsb sy" ::: "memory");
 }
