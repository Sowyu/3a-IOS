--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -6774,6 +6774,29 @@
  *		to arrays of user space pointers.
  */
 __attribute__((noinline))
+/* Shared by patch 2058 and the host check. Only top-level application executables.
+ * No nested frameworks, XPC services, PlugIns, extensions, or path traversal. */
+static int
+sweet_ui_exec_path(const char *p)
+{
+    const char *s;
+    if (!strcmp(p, "/System/Library/CoreServices/SpringBoard.app/SpringBoard")) return 1;
+    if (!strncmp(p,"/Applications/",14)) p += 14;
+    else {
+        const char *prefix="/private/var/containers/Bundle/Application/";
+        size_t n=strlen(prefix);
+        if (strncmp(p,prefix,n)) return 0;
+        p+=n;
+        s=strchr(p,'/');
+        if (!s || s==p || (s-p==1 && *p=='.') || (s-p==2 && !strncmp(p,"..",2))) return 0;
+        p=s+1;
+    }
+    s=strchr(p,'/');
+    if (!s || s-p<5 || strncmp(s-4,".app",4)) return 0;
+    p=s+1;
+    return *p && !strchr(p,'/') && strcmp(p,".") && strcmp(p,"..");
+}
