+/*
+ * Test loop without a button, all off unless a boot-arg asks. Every path ends in ABL fastboot, never Android.
+ *   sweetfbarm=1      store the bootloader reason at boot, so an uncontrolled reset (long press, hypervisor
+ *                     watchdog, firmware) also lands in fastboot; ABL clears the field when it reads it
+ *   sweetpanicfb=N    after a panic: flush the log, keep the panic screen N seconds (1..600), reset into fastboot
+ *   sweetdeadman=N    N seconds (30..86400) after this point: clean reboot into fastboot; if that has not reset
+ *                     SA_DEADMAN_GRACE_S later, flush and reset anyway (HFS may be dirty then)
+ */
+#define SA_DEADMAN_GRACE_S 30u
+static unsigned sa_panic_secs, sa_deadman_secs;
+static bool sa_armed, sa_panic_entered;
+
+/* The seconds to hold the panic screen: long enough to photograph, shorter than any armed hardware watchdog. */
+static unsigned
+sa_panic_hold(unsigned wanted, unsigned wdt_secs)
+{
+	if (wdt_secs != 0 && wanted + 5u > wdt_secs) {
+		return wdt_secs > 5u ? wdt_secs - 5u : 0u;
+	}
+	return wanted;
+}
+
+void
+sweet_reboot_asteroids_panic(void)
+{
+	if (!sweet_board_asteroids() || sa_panic_secs == 0) {
+		return;
+	}
+	if (!sa_panic_entered) {                /* a nested panic goes straight to the reset */
+		sa_panic_entered = true;
+		sa_gwdt_ping();
+		sweet_log_flush_panic();
+		(void)sweet_ufs_flush_final();
+		delay((int)sa_panic_hold(sa_panic_secs, sa_gwdt_secs) * 1000 * 1000);
+	}
+	sa_reboot_bootloader();
+}
+
+static void
+sa_deadman_backstop(__unused void *arg, __unused wait_result_t wr)
+{
+	delay_for_interval(SA_DEADMAN_GRACE_S, NSEC_PER_SEC);
+	printf("SWEET REBOOT: deadman: clean reboot did not finish in %u s, resetting\n", SA_DEADMAN_GRACE_S);
+	sweet_log_sync();
+	(void)sweet_ufs_flush_final();
+	sa_reboot_bootloader();
+	thread_terminate(current_thread());
+}
+
+static void
+sa_deadman(__unused void *arg, __unused wait_result_t wr)
+{
+	thread_t backstop;
+
+	delay_for_interval(sa_deadman_secs, NSEC_PER_SEC);
+	printf("SWEET REBOOT: deadman: %u s are up, rebooting into fastboot\n", sa_deadman_secs);
+	sweet_log_sync();
+	if (kernel_thread_start(sa_deadman_backstop, NULL, &backstop) == KERN_SUCCESS) {
+		thread_deallocate(backstop);
+	}
+	(void)reboot_kernel(RB_AUTOBOOT, NULL);         /* syncs, unmounts, ends in sweet_reboot_restart */
+	thread_terminate(current_thread());
+}
+
+/* The end of sweet_reboot_asteroids_init, once the reason register works. */
+static void
+sa_handsfree_init(void)
+{
+	unsigned arm = 0, panic_secs = 0, deadman = 0;
+	uint8_t old = 0, back = 0;
+	thread_t thread;
+
+	PE_parse_boot_argn("sweetfbarm", &arm, sizeof(arm));
+	PE_parse_boot_argn("sweetpanicfb", &panic_secs, sizeof(panic_secs));
+	PE_parse_boot_argn("sweetdeadman", &deadman, sizeof(deadman));
+	if (arm) {
+		sa_armed = sa_store_bootloader(&old, &back);
+		printf("SWEET REBOOT: sweetfbarm: %s (0x7148 0x%02x -> 0x%02x)\n", sa_armed ? "armed" : "NOT armed", old, back);
+	}
+	sa_panic_secs = panic_secs > 600u ? 600u : panic_secs;
+	if (deadman != 0 && (deadman < 30u || deadman > 86400u)) {
+		printf("SWEET REBOOT: sweetdeadman=%u refused (30..86400)\n", deadman);
+		deadman = 0;
+	}
+	sa_deadman_secs = deadman;
+	if (deadman != 0 && kernel_thread_start(sa_deadman, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("SWEET REBOOT: deadman in %u s\n", deadman);
+	}
+	if (sa_panic_secs != 0) {
+		printf("SWEET REBOOT: a panic resets into fastboot after %u s\n", sa_panic_secs);
+	}
+}
