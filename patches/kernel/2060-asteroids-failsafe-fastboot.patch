+/*
+ * The panic text before a reset (sweet_reboot_asteroids_panic): the log thread cannot run in a panic, so this CPU
+ * writes the ring itself. UFS commands poll with interrupts off. A panic inside a UFS command owns the mutex; then
+ * the flush is skipped, as in sweet_ufs_flush_final, and only the screen has the panic.
+ */
+void sweet_log_flush_panic(void);
+
+void
+sweet_log_flush_panic(void)
+{
+	if (!os_atomic_load(&sweet_log_running, acquire) || !su.ready || !su.writable) {
+		return;
+	}
+	if (!lck_mtx_try_lock(&sweet_ufs_lock)) {
+		return;
+	}
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	uint64_t pos = os_atomic_load(&sweet_log_flushed, acquire);
+	if (total - pos >= SWEET_LOG_SIZE) {
+		pos = total - SWEET_LOG_SIZE;
+	}
+	(void)sweet_log_write_locked(su.first_block + su.nblocks - SWEET_LOG_BLOCKS, pos, total, UINT64_MAX);
+	lck_mtx_unlock(&sweet_ufs_lock);
+}
