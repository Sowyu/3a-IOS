+/*
+ * TX progress (audit 4 finding 2). A TX the controller has held for UA_TX_STALL_MS is settled with output admission
+ * closed, so nothing is copied into UD_TX meanwhile. If its TRB is back from the controller (HWO clear), the transfer
+ * finished and only its event was lost: it is finished here, by the same test a completion passes. If the controller
+ * still owns it (the host stopped reading), ENDTRANSFER ends it, verified through GUCTL2's polling mode, and its frame
+ * is dropped. Only then is the slot used again. A failed end leaves the slot reserved and the gate stops the gadget,
+ * like every other failed end. Event thread only, so no teardown or completion runs at the same time.
+ */
 static void
+ua_tx_check(void)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_TX);
+	uint32_t ctl, size, txq;
+	uint64_t ms = 0;
+	bool back;
+
+	lck_mtx_lock(ud.lock);
+	if (!ud.tx_busy || !ud.xfer_active[EP_TX] || ud.tx_closed || ud.gate != NULL || ud.stopped ||
+	    (ms = ua_ms_since(ud.tx_t)) < UA_TX_STALL_MS) {
+		lck_mtx_unlock(ud.lock);
+		return;
+	}
+	ud.tx_closed = true;
+	ud_sync(UD_TRB_TX, 16);
+	ctl = t[3];
+	size = t[2];
+	txq = ud.txq_count;
+	back = !(ctl & TRB_HWO);
+	if (back) {
+		ud.xfer_active[EP_TX] = false;
+	}
+	lck_mtx_unlock(ud.lock);
+	if (back) {
+		ua.tx_lost++;
+	} else {
+		ua.tx_ended++;
+	}
+	if (ua.tx_lost + ua.tx_ended <= 20 || (ua.tx_lost + ua.tx_ended) % 100 == 0) {
+		printf("ASTEROIDS USB TX: no completion in %llu ms: TRB ctl 0x%08x size 0x%08x, resource %u, DEPCMD 0x%08x, "
+		    "txq %u, stale %u; %s (lost %u, ended %u)\n", ms, ctl, size, ud.xfer_res[EP_TX], dwc_rd(DEPCMD(EP_TX)), txq,
+		    ua.stale, back ? "the TRB is back from the controller: finished" : "the controller still owns it: ending it",
+		    ua.tx_lost, ua.tx_ended);
+	}
+	if (!back && ua_end_transfer(EP_TX) != 0) {
+		return;                 /* the gate stops the gadget; the slot stays reserved */
+	}
+	lck_mtx_lock(ud.lock);
+	ud.tx_busy = false;
+	if (ud.gate == NULL && ud.configured && ud.data_alt == 1) {
+		ud.tx_closed = false;
+		ud_tx_kick_locked();
+	}
+	lck_mtx_unlock(ud.lock);
+}
