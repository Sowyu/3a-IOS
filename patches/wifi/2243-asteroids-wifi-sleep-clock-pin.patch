@@ -22,6 +22,8 @@ static void wpss_worker(void *arg,wait_result_t wait){
   /* Last, so an SPMI surprise cannot hide the SMEM and firmware lines. */
   wpss_gpio5_survey();
   printf("SWEET WIFI: W1 survey complete; PAS6 untouched; no writes but the SPMI observer read command word\n");
