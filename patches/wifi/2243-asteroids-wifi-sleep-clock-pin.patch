- if(gate==WpssRefused){printf("SWEET WIFI: refused: sweetwprobe=1 with no modem or battery gate, or sweetwpss=1 with sweetfbarm=1 sweetselftest=1 sweetdeadman=600 and no modem or battery gate\n");return;}
+ if(gate==WpssRefused){printf("SWEET WIFI: refused: sweetwprobe=1 with no modem or battery gate, or sweetwpin=1 or sweetwpss=1 with sweetfbarm=1 sweetselftest=1 sweetdeadman=600 and no modem or battery gate\n");return;}
  thread_t thread=THREAD_NULL;kern_return_t rc=kernel_thread_start(wpss_worker,(void *)(uintptr_t)gate,&thread);
  if(rc==KERN_SUCCESS)thread_deallocate(thread);else printf("SWEET WIFI: thread failure %d\n",rc);
 }
diff --git a/bsd/dev/wifi/WpssGate.h b/bsd/dev/wifi/WpssGate.h
index 5dc4f7a2f..a2bec9b21 100644
--- a/bsd/dev/wifi/WpssGate.h
+++ b/bsd/dev/wifi/WpssGate.h
@@ -4,7 +4,8 @@
 #ifndef WPSS_GATE_H
 #define WPSS_GATE_H
 #include "../modem/ModemGate.h"
-enum {WpssOff=0,WpssSurvey=1,WpssStart=2,WpssRefused=-1};
+/* 2243: sweetwpin=1 (W1c) sets the sleep-clock pin and verifies it, with no WPSS start; same safeguards as sweetwpss. */
+enum {WpssOff=0,WpssSurvey=1,WpssStart=2,WpssPin=3,WpssRefused=-1};
 /* Refused in any form: the presets, the battery's own gates, and every modem, IPA and battery-test gate ModemGate.h lists
  * (modem_cell_gates, modem_cell_refused, modem_daily_refused), so the list cannot fall behind it. */
 static const char *const wpss_refused[5]={"sweetdaily","sweetcell","sweetbatt","sweetbmeter","sweetbprobe"};
@@ -16,13 +17,13 @@ static inline int wpss_conflict(const char *args){
     return 0;
 }
 static inline int wpss_gate(const char *args,int deadman){
-    unsigned probe=modem_arg_count(args,"sweetwprobe"),start=modem_arg_count(args,"sweetwpss");
-    if(!probe && !start)return WpssOff;
-    if(probe && start)return WpssRefused;
+    unsigned probe=modem_arg_count(args,"sweetwprobe"),start=modem_arg_count(args,"sweetwpss"),pin=modem_arg_count(args,"sweetwpin");
+    if(!probe && !start && !pin)return WpssOff;
+    if((probe!=0)+(start!=0)+(pin!=0)>1)return WpssRefused;
     if(wpss_conflict(args))return WpssRefused;
     if(probe)return modem_arg_is(args,"sweetwprobe","1")?WpssSurvey:WpssRefused;
-    if(!modem_arg_is(args,"sweetwpss","1") || !modem_gate(args,"sweetfbarm") || !modem_gate(args,"sweetselftest") || deadman!=600)
+    if(!modem_arg_is(args,pin?"sweetwpin":"sweetwpss","1") || !modem_gate(args,"sweetfbarm") || !modem_gate(args,"sweetselftest") || deadman!=600)
         return WpssRefused;
-    return WpssStart;
