diff --git a/bsd/dev/wifi/WlfwQmi.h b/bsd/dev/wifi/WlfwQmi.h
new file mode 100644
index 000000000..2288b1732
--- /dev/null
+++ b/bsd/dev/wifi/WlfwQmi.h
@@ -0,0 +1,282 @@
+/* 2248 (W4): the WLFW QMI messages, encoded and decoded here from scratch.
+ *
+ * WLFW is the Wi-Fi firmware's own QMI service, the one it announces on the WPSS's QRTR. This file holds the three
+ * requests stage 2 sends first (IND_REGISTER, HOST_CAP, and the two empty ones, CAP and DEVICE_INFO) and the replies'
+ * decoders. Nothing else: the board data download is the boot after this one.
+ *
+ * Where every number comes from. Message ids, TLV numbers and field layouts are from ath11k (the Linux driver for this
+ * chip family, BSD-3-Clause-Clear), read as declarations only:
+ *   drivers/net/wireless/ath/ath11k/qmi.h   the QMI_WLANFW_*_REQ_V01 / QMI_WLFW_*_IND_V01 ids, the service id, version
+ *                                          and instance, QMI_WLANFW_CLIENT_ID, and the message structures
+ *   drivers/net/wireless/ath/ath11k/qmi.c   the qmi_elem_info tables, which say which TLV number each field rides in,
+ *                                          and ath11k_qmi_fw_ind_register_send() / ath11k_qmi_host_cap_send() for which
+ *                                          fields are filled for a chip with fixed firmware memory
+ *   drivers/net/wireless/ath/ath11k/core.c  the "wcn6750 hw1.0" entry: fixed_fw_mem = true, internal_sleep_clock = false,
+ *                                          fw_mem_mode = 0, qmi_service_ins_id = 0x03
+ * No code, table or comment text is copied from ath11k or from any GPL file (Linux's qmi_encdec.c, qmi_interface.c or
+ * the reference port's drivers). Each function below is written against those declarations, and the bytes it produces
+ * are pinned by hand in 3a-IOS/tools/wifi/tests/wlfw.c.
+ *
+ * The framing is QMI version 1: a 7-byte header of type (1), transaction (2, little-endian), message id (2, LE) and
+ * payload length (2, LE), then type-length-value triples of type (1), length (2, LE) and value. The same framing this
+ * tree already speaks in qcom_servloc_answer() (modem/QcomQrtr.c), so it is not new protocol code.
+ *
+ * Every function is bounded by the caller's capacity and returns 0 rather than a partial message.
+ */
+#ifndef WLFW_QMI_H
+#define WLFW_QMI_H
+#include <stdint.h>
+#include <stddef.h>
+
+/* ---- the service, as the phone announces it --------------------------------------------------------------- */
+/* ath11k qmi.h: ATH11K_QMI_WLFW_SERVICE_ID_V01 0x45, ATH11K_QMI_WLFW_SERVICE_VERS_V01 0x01,
+ * ATH11K_QMI_WLFW_SERVICE_INS_ID_V01_WCN6750 0x03. Linux's QMI announces and looks up
+ * `version | instance << 8` (qmi_interface.c qmi_send_new_lookup), so the announced instance is 0x301. The ast222 W3
+ * boot printed exactly that: `W3 qrtr NEW_SERVER service=0x45 instance=0x301`. The plan's table said instance 1,
+ * which is QCA6390's value; the phone settles it. */
+#define WLFW_SERVICE 0x45u
+#define WLFW_VERSION 0x01u
+#define WLFW_INSTANCE 0x03u
+#define WLFW_ANNOUNCED (WLFW_VERSION | (WLFW_INSTANCE << 8))   /* 0x301 */
+
+/* ath11k qmi.h QMI_WLANFW_CLIENT_ID: the four bytes "LENK" little-endian, the host's own tag. */
+#define WLFW_CLIENT_ID 0x4b4e454cu
+
+/* ---- message ids (ath11k qmi.h) --------------------------------------------------------------------------- */
+#define WLFW_IND_REGISTER_REQ 0x0020u
+#define WLFW_HOST_CAP_REQ 0x0034u
+#define WLFW_CAP_REQ 0x0024u
+#define WLFW_DEVICE_INFO_REQ 0x004Cu
+#define WLFW_FW_READY_IND 0x0021u          /* QMI_WLFW_FW_READY_IND_V01 */
+#define WLFW_REQUEST_MEM_IND 0x0035u       /* QMI_WLFW_REQUEST_MEM_IND_V01 */
+#define WLFW_FW_MEM_READY_IND 0x0037u      /* QMI_WLFW_FW_MEM_READY_IND_V01 */
+#define WLFW_FW_INIT_DONE_IND 0x0038u      /* QMI_WLFW_FW_INIT_DONE_IND_V01 */
+#define WLFW_COLD_BOOT_CAL_DONE_IND 0x003Eu /* QMI_WLFW_COLD_BOOT_CAL_DONE_IND_V01 */
+
+/* ---- TLV numbers, from the qmi_elem_info tables in ath11k qmi.c ------------------------------------------- */
+#define WLFW_TLV_RESULT 0x02u          /* qmi_response_type_v01: u16 result, u16 error, in every response */
+#define WLFW_TLV_FW_READY 0x10u        /* ind_register: u8 fw_ready_enable */
+#define WLFW_TLV_CLIENT_ID 0x15u       /* ind_register: u32 client_id */
+#define WLFW_TLV_FW_INIT_DONE 0x18u    /* ind_register: u8 fw_init_done_enable */
+#define WLFW_TLV_CAL_DONE_ENABLE 0x1Bu /* ind_register: u8 cal_done_enable */
+#define WLFW_TLV_NUM_CLIENTS 0x10u     /* host_cap: u32 num_clients */
+#define WLFW_TLV_BDF_SUPPORT 0x14u     /* host_cap: u8 bdf_support */
+#define WLFW_TLV_HOST_CAL_DONE 0x1Au   /* host_cap: u8 cal_done, NOT 0x1B: in host_cap 0x1B is mem_bucket */
+#define WLFW_TLV_MEM_CFG_MODE 0x1Cu    /* host_cap: u8 mem_cfg_mode */
+#define WLFW_TLV_CHIP_INFO 0x10u       /* cap response: u32 chip_id, u32 chip_family */
+#define WLFW_TLV_BOARD_INFO 0x11u      /* cap response: u32 board_id */
+#define WLFW_TLV_SOC_INFO 0x12u        /* cap response: u32 soc_id */
+#define WLFW_TLV_BAR_ADDR 0x10u        /* device_info response: u64 bar_addr */
+#define WLFW_TLV_BAR_SIZE 0x11u        /* device_info response: u32 bar_size */
+/* The same TLV number means a different field in a different message: that is QMI, and it is why each name above says
+ * which message it belongs to. */
+
+#define WLFW_HEADER 7u
+enum {WLFW_REQUEST = 0, WLFW_RESPONSE = 2, WLFW_INDICATION = 4};
+
+/* ---- little-endian helpers -------------------------------------------------------------------------------- */
+static inline void wlfw_put16(uint8_t *p, uint32_t v) {p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8);}
+static inline void wlfw_put32(uint8_t *p, uint32_t v) {wlfw_put16(p, v); wlfw_put16(p + 2, v >> 16);}
+static inline void wlfw_put64(uint8_t *p, uint64_t v) {wlfw_put32(p, (uint32_t)v); wlfw_put32(p + 4, (uint32_t)(v >> 32));}
+static inline uint32_t wlfw_get16(const uint8_t *p) {return (uint32_t)p[0] | (uint32_t)p[1] << 8;}
+static inline uint32_t wlfw_get32(const uint8_t *p) {return wlfw_get16(p) | wlfw_get16(p + 2) << 16;}
+static inline uint64_t wlfw_get64(const uint8_t *p) {return (uint64_t)wlfw_get32(p) | (uint64_t)wlfw_get32(p + 4) << 32;}
+
+/* ---- encoding --------------------------------------------------------------------------------------------- */
+/* Opens a message: header with a zero length, filled in by wlfw_end. Returns the offset for the first TLV, or 0. */
+static inline uint32_t wlfw_begin(uint8_t *out, uint32_t capacity, uint8_t type, uint16_t transaction, uint16_t message)
+{
+    if (!out || capacity < WLFW_HEADER) return 0;
+    out[0] = type;
+    wlfw_put16(out + 1, transaction);
+    wlfw_put16(out + 3, message);
+    wlfw_put16(out + 5, 0);
+    return WLFW_HEADER;
+}
+/* Closes it: the payload length is everything after the header. 0 when it cannot be a message. */
+static inline uint32_t wlfw_end(uint8_t *out, uint32_t at)
+{
+    if (!out || at < WLFW_HEADER || at - WLFW_HEADER > 0xffffu) return 0;
+    wlfw_put16(out + 5, at - WLFW_HEADER);
+    return at;
+}
+/* One TLV. value may be null for a run of zeros. Returns the next offset, or 0 when it does not fit. */
+static inline uint32_t wlfw_tlv(uint8_t *out, uint32_t capacity, uint32_t at, uint8_t type, const uint8_t *value,
+                                uint32_t bytes)
+{
+    if (!out || at < WLFW_HEADER || bytes > 0xffffu || at + 3 + bytes > capacity) return 0;
+    out[at] = type;
+    wlfw_put16(out + at + 1, bytes);
+    for (uint32_t i = 0; i < bytes; ++i) out[at + 3 + i] = value ? value[i] : 0;
+    return at + 3 + bytes;
+}
+
+/* IND_REGISTER (0x0020): the indications the host wants. ath11k_qmi_fw_ind_register_send fills exactly these four for a
+ * chip with fixed firmware memory: fw_ready_enable, client_id, fw_init_done_enable and cal_done_enable. It leaves
+ * request_mem_enable and fw_mem_ready_enable unset because WCN6750 has fixed firmware memory (core.c fixed_fw_mem =
+ * true), and pin_connect_result_enable unset. 26 bytes: 7 header, then 4, 7, 4 and 4. */
+static inline uint32_t wlfw_ind_register(uint8_t *out, uint32_t capacity, uint16_t transaction)
+{
+    uint32_t at = wlfw_begin(out, capacity, WLFW_REQUEST, transaction, WLFW_IND_REGISTER_REQ);
+    if (!at) return 0;
+    const uint8_t on = 1, zero[4] = {0};
+    uint8_t client[4];
+    wlfw_put32(client, WLFW_CLIENT_ID);
+    if (!(at = wlfw_tlv(out, capacity, at, WLFW_TLV_FW_READY, &on, 1))) return 0;
+    if (!(at = wlfw_tlv(out, capacity, at, WLFW_TLV_CLIENT_ID, client, 4))) return 0;
+    if (!(at = wlfw_tlv(out, capacity, at, WLFW_TLV_FW_INIT_DONE, &on, 1))) return 0;
+    if (!(at = wlfw_tlv(out, capacity, at, WLFW_TLV_CAL_DONE_ENABLE, &on, 1))) return 0;
+    (void)zero;
+    return wlfw_end(out, at);
+}
+
+/* HOST_CAP (0x0034): what the host can do. From ath11k_qmi_host_cap_send with this chip's parameters: num_clients 1,
+ * bdf_support 1, cal_done 0 (cold boot calibration has not run yet), mem_cfg_mode = target_mem_mode = fw_mem_mode = 0.
+ * m3_support is not set (m3_fw_support false) and nm_modem is not set (internal_sleep_clock false), so neither rides
+ * on this wire. 26 bytes: 7 header, then 7, 4, 4 and 4.
+ *
+ * cal_done rides TLV 0x1A here, not 0x1B: in host_cap 0x1B is mem_bucket (a u32) and 0x1C is mem_cfg_mode. Getting
+ * that one number wrong would put a byte where the firmware reads a four-byte bucket, so it has its own name above. */
+static inline uint32_t wlfw_host_cap(uint8_t *out, uint32_t capacity, uint16_t transaction)
+{
+    uint32_t at = wlfw_begin(out, capacity, WLFW_REQUEST, transaction, WLFW_HOST_CAP_REQ);
+    if (!at) return 0;
+    const uint8_t on = 1, off = 0;
+    uint8_t clients[4];
+    wlfw_put32(clients, 1);
+    if (!(at = wlfw_tlv(out, capacity, at, WLFW_TLV_NUM_CLIENTS, clients, 4))) return 0;
+    if (!(at = wlfw_tlv(out, capacity, at, WLFW_TLV_BDF_SUPPORT, &on, 1))) return 0;
+    if (!(at = wlfw_tlv(out, capacity, at, WLFW_TLV_HOST_CAL_DONE, &off, 1))) return 0;
+    if (!(at = wlfw_tlv(out, capacity, at, WLFW_TLV_MEM_CFG_MODE, &off, 1))) return 0;
+    return wlfw_end(out, at);
+}
+
+/* CAP (0x0024) and DEVICE_INFO (0x004C): both requests are empty (their qmi_elem_info tables hold only the end
+ * marker), so 7 bytes and no TLV at all. */
+static inline uint32_t wlfw_empty_request(uint8_t *out, uint32_t capacity, uint16_t transaction, uint16_t message)
+{
+    const uint32_t at = wlfw_begin(out, capacity, WLFW_REQUEST, transaction, message);
+    return at ? wlfw_end(out, at) : 0;
+}
+
+/* ---- decoding --------------------------------------------------------------------------------------------- */
+typedef struct {
+    uint8_t type;
+    uint16_t transaction, message;
+    uint32_t length;          /* the header's payload length */
+    int result_valid;
+    uint16_t result, error;   /* TLV 0x02: 0 success, 0 no error */
+} WlfwMessage;
+
+/* Parses the header and validates the TLV chain, and lifts the result out. Returns 0, or -1 when the message is not a
+ * well-formed QMI message of exactly bytes length (a short one, a length that disagrees, a TLV that overruns). */
+static inline int wlfw_parse(const uint8_t *data, uint32_t bytes, WlfwMessage *m)
+{
+    if (!data || !m || bytes < WLFW_HEADER) return -1;
+    m->type = data[0];
+    m->transaction = (uint16_t)wlfw_get16(data + 1);
+    m->message = (uint16_t)wlfw_get16(data + 3);
+    m->length = wlfw_get16(data + 5);
+    m->result_valid = 0;
+    m->result = m->error = 0;
+    if (m->length != bytes - WLFW_HEADER) return -1;
+    for (uint32_t at = WLFW_HEADER; at < bytes;) {
+        if (bytes - at < 3) return -1;
+        const uint32_t n = wlfw_get16(data + at + 1);
+        if (n > bytes - at - 3) return -1;
+        if (data[at] == WLFW_TLV_RESULT) {
+            if (n != 4) return -1;
+            m->result_valid = 1;
+            m->result = (uint16_t)wlfw_get16(data + at + 3);
+            m->error = (uint16_t)wlfw_get16(data + at + 5);
+        }
+        at += 3 + n;
+    }
+    return 0;
+}
+
+/* The value of TLV type: 0 and its size in *size, 1 when there is no such TLV, -1 when the chain is malformed. */
+static inline int wlfw_tlv_find(const uint8_t *data, uint32_t bytes, uint8_t type, const uint8_t **value, uint32_t *size)
+{
+    if (!data || bytes < WLFW_HEADER) return -1;
+    if (wlfw_get16(data + 5) != bytes - WLFW_HEADER) return -1;
+    for (uint32_t at = WLFW_HEADER; at < bytes;) {
+        if (bytes - at < 3) return -1;
+        const uint32_t n = wlfw_get16(data + at + 1);
+        if (n > bytes - at - 3) return -1;
+        if (data[at] == type) {*value = data + at + 3; *size = n; return 0;}
+        at += 3 + n;
+    }
+    return 1;
+}
+
+/* The CAP response's board id (TLV 0x11, u32). 0 and the id in *board, 1 when the firmware sent none (the reference
+ * port's firmware sends none and ath11k then takes 0xff), -1 when the TLV is there but not four bytes. */
+static inline int wlfw_board_id(const uint8_t *data, uint32_t bytes, uint32_t *board)
+{
+    const uint8_t *v = 0;
+    uint32_t n = 0;
+    const int rc = wlfw_tlv_find(data, bytes, WLFW_TLV_BOARD_INFO, &v, &n);
+    if (rc) return rc;
+    if (n != 4) return -1;
+    *board = wlfw_get32(v);
+    return 0;
+}
+
+/* The CAP response's chip identity (TLV 0x10, two u32s: chip_id then chip_family). 0, 1 when absent, -1 when short. */
+static inline int wlfw_chip_info(const uint8_t *data, uint32_t bytes, uint32_t *chip, uint32_t *family)
+{
+    const uint8_t *v = 0;
+    uint32_t n = 0;
+    const int rc = wlfw_tlv_find(data, bytes, WLFW_TLV_CHIP_INFO, &v, &n);
+    if (rc) return rc;
+    if (n != 8) return -1;
+    *chip = wlfw_get32(v);
+    *family = wlfw_get32(v + 4);
+    return 0;
+}
+
+/* The DEVICE_INFO response's register window (TLV 0x10 u64 bar_addr, TLV 0x11 u32 bar_size). Recorded, never mapped:
+ * reading that window before mission mode ended the reference port's kernel (hakios.wifi.c:55-58). 0, or 1 when either
+ * is absent (both are optional), -1 when one is the wrong size. */
+static inline int wlfw_device_info(const uint8_t *data, uint32_t bytes, uint64_t *addr, uint32_t *size)
+{
+    const uint8_t *v = 0;
+    uint32_t n = 0;
+    int rc = wlfw_tlv_find(data, bytes, WLFW_TLV_BAR_ADDR, &v, &n);
+    if (rc) return rc;
+    if (n != 8) return -1;
+    *addr = wlfw_get64(v);
+    rc = wlfw_tlv_find(data, bytes, WLFW_TLV_BAR_SIZE, &v, &n);
+    if (rc) return rc;
+    if (n != 4) return -1;
+    *size = wlfw_get32(v);
+    return 0;
+}
+
+/* A request's name for the log, or "unknown". Ids only: nothing here is a name, an address or a byte of firmware. */
+static inline const char *wlfw_name(uint16_t message)
+{
+    switch (message) {
+    case WLFW_IND_REGISTER_REQ: return "ind_register";
+    case WLFW_HOST_CAP_REQ: return "host_cap";
+    case WLFW_CAP_REQ: return "cap";
+    case WLFW_DEVICE_INFO_REQ: return "device_info";
+    default: return "unknown";
+    }
+}
+
+/* An indication's name, for the same reason: so a firmware that volunteers one is not a number in the log. */
+static inline const char *wlfw_indication_name(uint16_t message)
+{
+    switch (message) {
+    case WLFW_FW_READY_IND: return "fw_ready";
+    case WLFW_REQUEST_MEM_IND: return "request_mem";
+    case WLFW_FW_MEM_READY_IND: return "fw_mem_ready";
