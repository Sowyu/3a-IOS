+  case W4Cap: bytes=wlfw_empty_request(w.wlfw_buf,sizeof(w.wlfw_buf),w.wlfw_transaction=3,WLFW_CAP_REQ);break;
+  case W4DeviceInfo: bytes=wlfw_empty_request(w.wlfw_buf,sizeof(w.wlfw_buf),w.wlfw_transaction=4,WLFW_DEVICE_INFO_REQ);break;
