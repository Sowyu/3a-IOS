diff --git a/bsd/dev/modem/QcomQrtr.c b/bsd/dev/modem/QcomQrtr.c
index b876b5d08..b92467949 100644
--- a/bsd/dev/modem/QcomQrtr.c
+++ b/bsd/dev/modem/QcomQrtr.c
@@ -98,6 +98,46 @@ int qcom_qrtr_find_remote(const QcomQrtr *q, uint32_t service)
     return -1;
 }
 
+/* 2248 (L1): the name service, asked from the client side.
+ * Linux's qmi_add_lookup() builds a control packet of {cmd = NEW_LOOKUP, server.service, server.instance} and sends it to
+ * node 0, port QRTR_PORT_CTRL, from a socket on our own node and port (qmi_interface.c qmi_send_new_lookup).
+ * `server.node` and `server.port` are zero: we are asking, not announcing. That is the whole layout: cmd, service,
+ * instance, and two zero words. The payload is 20 bytes because every QRTR control packet here is the command and four
+ * words (CTRL_BYTES), which is what control() sends; the two zero words are the same padding an announcement has.
+ * (2248b: this comment said 12 bytes, which was Linux's three-word payload, not the 20 this code sends — W4 audit note 9.)
+ * The answer arrives as an ordinary NEW_SERVER from the remote's own name service, which remote_server() already
+ * records, so there is no second table here to keep in step. */
+int qcom_qrtr_lookup(QcomQrtr *q, uint32_t service, uint32_t instance)
+{
+    /* No hello from the remote yet means no node to address: a packet sent to the broadcast node would go nowhere and
+     * count as a refusal. Say so by refusing here, so the caller retries when the remote speaks. */
+    if (q->remote_node == QCOM_QRTR_NODE_BROADCAST) return -1;
+    const uint32_t words[4] = {service, instance, 0, 0};  /* the last two: node and port, zero when asking */
+    return control(q, QCOM_QRTR_NEW_LOOKUP, words);
+}
+int qcom_qrtr_lookup_found(const QcomQrtr *q, uint32_t service, uint32_t instance, uint32_t *node, uint32_t *port)
+{
+    for (uint32_t i = 0; i < q->remote_count; ++i) {
+        if (q->remote[i].service != service) continue;
+        if (instance && q->remote[i].instance != instance) continue;
+        if (node) *node = q->remote[i].node;
+        if (port) *port = q->remote[i].port;
+        return 1;
+    }
+    return 0;
+}
+int qcom_qrtr_remove_service(QcomQrtr *q, uint32_t port)
+{
+    for (uint32_t i = 0; i < q->local_count; ++i) {
+        if (q->local[i].port != port) continue;
+        /* Keep the list dense: the last entry takes this slot, exactly as remote_server() drops one. */
+        q->local[i] = q->local[--q->local_count];
+        q->local[q->local_count] = (typeof(q->local[0])){0};
+        return 0;
+    }
+    return -1;
+}
+
 static void remote_server(QcomQrtr *q, const uint8_t *w, int add)
 {
     const uint32_t service = le32(w), instance = le32(w + 4), node = le32(w + 8), port = le32(w + 12);
diff --git a/bsd/dev/modem/QcomQrtr.h b/bsd/dev/modem/QcomQrtr.h
index 60664c7de..9e37f8bdb 100644
--- a/bsd/dev/modem/QcomQrtr.h
+++ b/bsd/dev/modem/QcomQrtr.h
@@ -62,6 +62,21 @@ int qcom_qrtr_send_data(QcomQrtr *q, uint32_t from_port, uint32_t node, uint32_t
 /* Index of a remote service in the list, -1 when not announced. */
 int qcom_qrtr_find_remote(const QcomQrtr *q, uint32_t service);
 
+/* ---- the name service, for when we are the client (2248, L1) ------------------------------------------------ */
+/* Asks the remote's name service which node and port carry a service, by sending NEW_LOOKUP to the control port. The
+ * answer is not a reply: it is the ordinary NEW_SERVER the service announces, which remote_server() already records, so
+ * the owner looks for the result with qcom_qrtr_lookup_found(). instance is the ANNOUNCED form (version | instance << 8),
+ * which is what Linux's qmi_interface.c sends and what our NEW_SERVER lines print.
+ * Returns 0 when the request was queued, -1 when it could not be (no hello yet from the remote, so no node to ask).
+ * Waiting, and saying so when nothing comes back, is the owner's: this never blocks. */
+int qcom_qrtr_lookup(QcomQrtr *q, uint32_t service, uint32_t instance);
+/* 1 and the node and port when the asked-for service is in the remote list, 0 when it is not. instance as announced;
+ * pass 0 to accept any. */
+int qcom_qrtr_lookup_found(const QcomQrtr *q, uint32_t service, uint32_t instance, uint32_t *node, uint32_t *port);
+/* Drops one of our services from the list, so its port stops being polled. 0, or -1 when it was not there. Nothing is
+ * announced or sent: a client port (service 0) was never announced to the remote, so there is nothing to withdraw. */
+int qcom_qrtr_remove_service(QcomQrtr *q, uint32_t port);
+
 /* ---- QMI messages carried in data packets: a 7-byte header (type, transaction, message id, length) and TLVs ---- */
 #define QCOM_QMI_HEADER 7u
 enum {QCOM_QMI_REQUEST = 0, QCOM_QMI_RESPONSE = 2, QCOM_QMI_INDICATION = 4};
