+  * cleared on every accepted reply and which is false again by the time this runs. It printed 0 on every healthy run. */
+ printf("SWEET WIFI: W4 wlfw close: step=%s tx=%u indications=%u answered=%u dropped=%u+%u\n",w4_step_str(w.wlfw_step),
+  w.wlfw_tx,w.wlfw_indications,w.wlfw_replies,w.wlfw_unexpected,w.wlfw_mismatched);
