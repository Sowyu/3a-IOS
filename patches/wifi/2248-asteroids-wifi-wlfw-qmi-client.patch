+ printf("SWEET WIFI: W4 exchange bounded to end %u ms after handover, %u ms before the stop\n",
+  W_DWELL_MS-W_W4_STOP_RESERVE_MS,W_W4_STOP_RESERVE_MS);
+ sweet_log_sync();
+}
