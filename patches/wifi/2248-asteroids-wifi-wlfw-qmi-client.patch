+ w.wlfw_opened=true;
+ printf("SWEET WIFI: W4 wlfw client port=%#x open; looking for service=%#x instance=%#x\n",W_WLFW_PORT,WLFW_SERVICE,WLFW_ANNOUNCED);
+ sweet_log_sync();
+ return 0;
+}
+static void w_wlfw_close(void){
