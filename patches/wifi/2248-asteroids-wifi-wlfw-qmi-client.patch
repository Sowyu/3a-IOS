+/* 2248b (W4 audit defect 3): the exchange must fit inside the dwell. The worst case was lookup 3 s + four replies at
+ * 5 s + three 50 ms gaps = about 23 s against W_DWELL_MS's 20 s from handover, so on a firmware that answers slowly the
+ * stop cut the exchange short. That was safe — the stop runs identically and the run grades as a request without a
+ * reply — but the brief claimed it fitted and it did not. Each bound is now clamped to a point just inside the dwell, so
+ * every request's timeout line is printed before the stop instead of being raced by the loop's break, and a request with
+ * no room left is not sent at all rather than going out with no time to be answered. The deadman is untouched and still
+ * covers anything this clamp cannot: 600 s against a 240 s body. */
+#define W_W4_STOP_RESERVE_MS 250u   /* the whole exchange ends at least this far before the stop */
+#define W_W4_MIN_BOUND_MS 1000u     /* a request is not sent unless the dwell still has this much left for it */
+static uint64_t w_w4_bound(uint64_t now,uint64_t ms){
+ const uint64_t want=now+ms;
+ if(!w.wlfw_dwell_end)return want;          /* handover not seen yet: the plain bound */
+ return want<w.wlfw_dwell_end?want:w.wlfw_dwell_end;   /* never later than the dwell allows */
+}
+/* Records where the exchange must end, from the handover that starts the dwell. Called once, at handover. */
+static void w_w4_note_dwell(uint64_t handover){
