+/* ---- 2251 (W7): WLAN_INI and WLAN_CFG, the two messages ath11k_qmi_firmware_start sends before mission mode -------
+ *
+ * THE ORDER, and where each message comes from. `ath11k_qmi_firmware_start(ab, mode)` is called from
+ * `ath11k_core_qmi_firmware_ready`, which is what the FW_READY event handler runs: the phone's W6 boot reached exactly
+ * that point. It sends, in this order:
+ *
+ *   1. WLAN_INI  (0x002F) enablefwlog = 1, when hw_params.fw_wmi_diag_event is true. core.c's "wcn6750 hw1.0" entry
+ *                sets fw_wmi_diag_event = true, so on this chip it is sent.
+ *   2. WLAN_CFG  (0x0023) host_version, tgt_cfg, svc_cfg and the shadow-register list.
+ *   3. WLAN_MODE (0x0022) mode 0 = ATH11K_FIRMWARE_MODE_NORMAL, which is mission mode.
+ *
+ * and only then does the driver touch the radio: `ath11k_core_qmi_firmware_ready` calls `ath11k_ce_init_pipes` after
+ * `ath11k_core_start_firmware` returns, and the register window is read from then on. So mission mode is the last thing
+ * that happens before the copy engines, which is exactly where W7 stops.
+ *
+ * WHAT THE FIRMWARE DOES WITH MISSION MODE AND NO HOST COPY ENGINES. It configures the pipes the host just described and
+ * starts waiting for the host to bring up the rings those pipes point at. Nothing arrives, so nothing is processed; the
+ * firmware does not fault on that. The reference port saw it from the other side: with the mode taken and the handle
+ * left open, the radio's registers answered (step 16) and the mode "off" was then taken; there was no crash and no
+ * timeout between the two. ath11k itself does not treat an idle post-mode firmware as an error either: its next step is
+ * to build the rings, and the firmware simply waits. What W7 must therefore prove is not "the firmware did something"
+ * but "the mode was taken, the firmware is in mission mode, and it came back out through a verified stop".
+ *
+ * THE MODE-OFF QUESTION, answered here because it decides the stop. `ath11k_qmi_firmware_stop` sends WLAN_MODE mode 4
+ * (ATH11K_FIRMWARE_MODE_OFF) before the rest of teardown, and the mode-off path in `ath11k_qmi_wlanfw_mode_send` treats
+ * a disconnected WLFW service (-ENETRESET) as success rather than an error. The reference port sent it after the
+ * cold-boot calibration, before any mission mode, and the firmware refused it with error 48; after mission mode it was
+ * taken. So W7 sends mode 4 only when mission mode was actually taken, and treats a refusal there as a finding rather
+ * than a blocker: the SMP2P stop and the PAS6 shutdown that follow are what actually stop this DSP, and they are proven
+ * since W2b. A boot where mission mode was never entered sends no OFF at all, so the stage cannot repeat the reference
+ * port's error 48 and cannot be misread as a clean mode-off that never happened.
+ */
+#define WLFW_HOST_VERSION "WIN"   /* ath11k qmi.h ATH11K_HOST_VERSION_STRING, three characters plus NUL */
+
+/* The copy-engine pipes, from ath11k_target_ce_config_wlan_qca6390 (hw.c), which core.c's "wcn6750 hw1.0" entry names
+ * as its target_ce_config with target_ce_count = 9. Each entry is {pipe_num, pipe_dir, nentries, nbytes_max, flags}.
+ * pipe_dir is the pipedir enum from ce.h, relative to the host: 1 = IN (target to host), 2 = OUT (host to target),
+ * 3 = INOUT (bidirectional), 4 = INOUT_H2H (bidirectional, host to host). flags is CE_ATTR_FLAGS | CE_ATTR_DIS_INTR
+ * where ath11k says so: CE_ATTR_FLAGS is 0 on a little-endian host and CE_ATTR_DIS_INTR is 8, and CE4, CE7 carry it.
+ * Entries 9 to 11 are the firmware's own description's tail ("used by MHI driver"), which ath11k never sends because
+ * target_ce_count is 9. */
+typedef struct {uint32_t pipe_num, pipe_dir, nentries, nbytes_max, flags;} WlfwCePipe;
+#define WLFW_CE_COUNT 9u
+static const WlfwCePipe wlfw_ce_pipes[WLFW_CE_COUNT] = {
+    {0, 2, 32, 2048, 0},    /* CE0 host->target HTC control and raw streams */
+    {1, 1, 32, 2048, 0},    /* CE1 target->host HTT + HTC control */
+    {2, 1, 32, 2048, 0},    /* CE2 target->host WMI */
+    {3, 2, 32, 2048, 0},    /* CE3 host->target WMI */
+    {4, 2, 256, 256, 8},    /* CE4 host->target HTT, no completion interrupt */
+    {5, 1, 32, 2048, 0},    /* CE5 target->host packet log */
+    {6, 3, 32, 16384, 0},   /* CE6 reserved for the target's autonomous hif_memcpy */
+    {7, 4, 0, 0, 8},        /* CE7 used only by the host, no ring and no interrupt */
+    {8, 3, 32, 16384, 0},   /* CE8 target->host, used only by IPA */
+};
+
+/* The service-to-pipe map, from ath11k_target_service_to_ce_map_wlan_qca6390 (hw.c), 14 entries per core.c's
+ * svc_to_ce_map_len: seven services, each with an OUT and an IN direction. The service ids are from htc.h's
+ * ATH11K_HTC_SVC_ID_* enum, which is SVC(group, idx) = (group << 8) | idx:
+ *   RSVD_CTRL        group 0, idx 1  = 0x0001
+ *   WMI_CONTROL      group 1, idx 0  = 0x0100
+ *   WMI_DATA_BE      group 1, idx 1  = 0x0101
+ *   WMI_DATA_BK      group 1, idx 2  = 0x0102
+ *   WMI_DATA_VI      group 1, idx 3  = 0x0103
+ *   WMI_DATA_VO      group 1, idx 4  = 0x0104
+ *   HTT_DATA_MSG     group 3, idx 0  = 0x0300
+ * ath11k's table is ordered DATA_VO, DATA_BK, DATA_BE, DATA_VI, WMI_CONTROL, RSVD_CTRL, HTT_DATA_MSG, and that order is
+ * kept here because it is what the table says, not because the firmware should care. */
+typedef struct {uint32_t service_id, pipe_dir, pipe_num;} WlfwCeService;
+#define WLFW_SVC_COUNT 14u
+static const WlfwCeService wlfw_ce_services[WLFW_SVC_COUNT] = {
+    {0x0104, 2, 3}, {0x0104, 1, 2},   /* WMI_DATA_VO */
+    {0x0102, 2, 3}, {0x0102, 1, 2},   /* WMI_DATA_BK */
+    {0x0101, 2, 3}, {0x0101, 1, 2},   /* WMI_DATA_BE */
+    {0x0103, 2, 3}, {0x0103, 1, 2},   /* WMI_DATA_VI */
+    {0x0100, 2, 3}, {0x0100, 1, 2},   /* WMI_CONTROL */
+    {0x0001, 2, 0}, {0x0001, 1, 2},   /* RSVD_CTRL: out on CE0, in on CE2 */
+    {0x0300, 2, 4}, {0x0300, 1, 1},   /* HTT_DATA_MSG: out on CE4, in on CE1 */
+};
+
+/* THE SHADOW REGISTER LIST. ath11k builds it at run time, not from a table: `ath11k_ce_get_shadow_config` calls
+ * `ath11k_hal_srng_shadow_config` and then `ath11k_ce_shadow_config`, and each `ath11k_hal_srng_update_shadow_config`
+ * appends one absolute register address to `hal->shadow_reg_addr[]`. The address is
+ *
+ *   srng_config->reg_start[HAL_HP_OFFSET_IN_REG_START] + reg_size[HAL_HP_OFFSET_IN_REG_START] * ring_num
+ *                                                        + (destination ring ? HAL_OFFSET_FROM_HP_TO_TP : 0)
+ *
+ * where HAL_HP_OFFSET_IN_REG_START is 1 (the ring's HP word), HAL_OFFSET_FROM_HP_TO_TP is 4, and reg_size is the
+ * distance between one CE's block and the next, 0x2000. `ath11k_hal_srng_create_config` sets the CE entries as:
+ *
+ *   HAL_CE_SRC         reg_start[1] = CE0_SRC_REG + HAL_CE_DST_RING_HP (0x400),  ring_dir = SRC  -> no +4
+ *   HAL_CE_DST         reg_start[1] = CE0_DST_REG + HAL_CE_DST_RING_HP (0x400),  ring_dir = SRC  -> no +4
+ *   HAL_CE_DST_STATUS  reg_start[1] = CE0_DST_REG + HAL_CE_DST_STATUS_RING_HP (0x408), ring_dir = DST -> +4
+ *
+ * Note the middle line: the CE_DST template entry is a SRC-direction ring, so its HP word is used as-is. Only the
+ * status ring, which really is a destination ring, takes the +4. Getting that backwards would send the firmware a word
+ * four bytes away from the one it has to shadow, which is the kind of mistake that looks like a firmware fault.
+ *
+ * The chip's bases are `wcn6750_regs` (hw.c): CE0_SRC at 0x01b80000, CE0_DST at 0x01b81000, each CE 0x2000 further.
+ * Both are WCSS-relative, which is what the firmware expects: the window's absolute base comes from the same DEVICE_INFO
+ * reply the host recorded in W4 (0x61e00000 in ast234), so a relative address is the only portable thing to send.
+ *
+ * THE LIST IS THE CE PART ONLY, and that is the whole of what this stage can honestly send. ath11k's list also holds
+ * every non-CE ring (REO, TCL, WBM, RXDMA), whose addresses are inside the radio's register window at 0x00a00000 and
+ * beyond. This kernel has not mapped that window, so it cannot compute them and must not pretend to; the CE entries are
+ * computable because they come from ath11k's per-chip register table, not from anything read out of the radio.
+ *
+ * WHICH PIPES: ath11k_ce_shadow_config asks `host_ce_config[i]`, the rings the HOST will build
+ * (`ath11k_host_ce_config_qca6390`, ce.c): CE0 16 src, CE1 512 dst, CE2 512 dst, CE3 32 src, CE4 2048 src with no
+ * interrupt, CE5 512 dst, CE6 and CE8 none, CE7 32 src. A pipe with a source ring contributes one word; a pipe with a
+ * destination ring contributes two, its TP and its status ring's TP. That is four source pipes (CE0, CE3, CE4, CE7) and
+ * three destination pipes (CE1, CE2, CE5), so 4 + 3 * 2 = 10 words, in pipe order. The count is derived by the function
+ * below and asserted in the host tests, not written down twice. */
+#define WLFW_CE_SRC_BASE 0x01b80000u   /* wcn6750_regs.hal_seq_wcss_umac_ce0_src_reg */
+#define WLFW_CE_DST_BASE 0x01b81000u   /* wcn6750_regs.hal_seq_wcss_umac_ce0_dst_reg */
+#define WLFW_CE_STRIDE 0x2000u         /* ce1_src - ce0_src, and ce1_dst - ce0_dst */
+#define WLFW_CE_HP 0x400u              /* HAL_CE_DST_RING_HP */
+#define WLFW_CE_DST_STATUS_HP 0x408u   /* HAL_CE_DST_STATUS_RING_HP */
+#define WLFW_HP_TO_TP 4u               /* HAL_OFFSET_FROM_HP_TO_TP */
+#define WLFW_SHADOW_MAX 36u            /* QMI_WLANFW_MAX_NUM_SHADOW_REG_V2_V01 */
+#define WLFW_SHADOW_COUNT 10u          /* what the derivation below produces; asserted, not assumed */
+
+/* Which of the host's pipes have a source ring and which a destination ring, from
+ * ath11k_host_ce_config_qca6390's src_nentries and dest_nentries. */
+static const uint8_t wlfw_ce_has_src[WLFW_CE_COUNT] = {1, 0, 0, 1, 1, 0, 0, 1, 0};
+static const uint8_t wlfw_ce_has_dst[WLFW_CE_COUNT] = {0, 1, 1, 0, 0, 1, 0, 0, 0};
+
+/* Builds the list exactly as ath11k_ce_shadow_config does: for each pipe in order, its source ring's HP when it has one,
+ * then its destination ring's TP and its status ring's TP when it has those. Returns how many words were written, or 0
+ * when capacity cannot hold the whole list (nothing partial: a truncated list is a different list to the firmware). */
+static inline uint32_t wlfw_shadow_config(uint32_t *out, uint32_t capacity)
+{
+    uint32_t n = 0;
+    if (!out) return 0;
+    for (uint32_t i = 0; i < WLFW_CE_COUNT; ++i) {
+        if (wlfw_ce_has_src[i]) {
+            if (n >= capacity || n >= WLFW_SHADOW_MAX) return 0;
+            out[n++] = WLFW_CE_SRC_BASE + WLFW_CE_STRIDE * i + WLFW_CE_HP;
+        }
+        if (wlfw_ce_has_dst[i]) {
+            if (n + 2 > capacity || n + 2 > WLFW_SHADOW_MAX) return 0;
+            out[n++] = WLFW_CE_DST_BASE + WLFW_CE_STRIDE * i + WLFW_CE_HP;
+            /* The status ring is a destination ring in ath11k's config table, so its TP address is HP + 4. */
+            out[n++] = WLFW_CE_DST_BASE + WLFW_CE_STRIDE * i + WLFW_CE_DST_STATUS_HP + WLFW_HP_TO_TP;
+        }
+    }
+    return n;
+}
+
+/* WLAN_INI (0x002F), 2251 (W7): the firmware's own logging. ath11k_qmi_wlanfw_wlan_ini_send fills exactly one field,
+ * `enablefwlog_valid = true` and `enablefwlog = 1`, and that is an OPT_FLAG plus a u8, so on the wire it is one TLV:
+ * type 0x10, length 1, value 1. Payload 4 bytes, which is ath11k's QMI_WLANFW_WLAN_INI_REQ_MSG_V01_MAX_LEN; the whole
+ * message is 7 + 4 = 11. */
+static inline uint32_t wlfw_wlan_ini(uint8_t *out, uint32_t capacity, uint16_t transaction, uint8_t enable)
+{
+    if (!out) return 0;
+    uint32_t at = wlfw_begin(out, capacity, WLFW_REQUEST, transaction, WLFW_WLAN_INI_REQ);
+    if (!at) return 0;
+    if (!(at = wlfw_tlv(out, capacity, at, WLFW_TLV_FWLOG, &enable, 1))) return 0;
+    return wlfw_end(out, at);
+}
+
+/* WLAN_CFG (0x0023), 2251 (W7): the copy engines and the shadow registers. ath11k_qmi_wlanfw_wlan_cfg_send fills four
+ * fields, and each is one TLV whose payload is a length byte followed by fixed-size records, because every array in that
+ * message is a VAR_LEN_ARRAY under a QMI_DATA_LEN whose elem_size is sizeof(u8):
+ *
+ *   0x10 host_version   a QMI_STRING at the top level, so NO length byte: the TLV's own length is strlen. "WIN" = 3.
+ *   0x11 tgt_cfg        u8 count, then count * qmi_wlanfw_ce_tgt_pipe_cfg_s_v01, 5 le32 = 20 bytes each.
+ *   0x12 svc_cfg        u8 count, then count * qmi_wlanfw_ce_svc_pipe_cfg_s_v01, 3 le32 = 12 bytes each.
+ *   0x14 shadow_reg_v2  u8 count, then count * qmi_wlanfw_shadow_reg_v2_cfg_s_v01, 1 le32 = 4 bytes each.
+ *
+ * TLV 0x13 (the older shadow_reg with u16 id and u16 offset) is NOT sent: ath11k sets `shadow_reg_valid = 0`
+ * unconditionally and uses only v2. The order below is the order of the elem_info table, and a firmware that reads by
+ * TLV number would not care, but a firmware that reads positionally would, so it is kept.
+ *
+ * Sizes with this chip's tables: 3 + 3 for host_version, 3 + 181 for 9 pipes, 3 + 169 for 14 services, 3 + 41 for 10
+ * shadow words = 406 of payload and 413 with the header, against ath11k's QMI_WLANFW_WLAN_CFG_REQ_MSG_V01_MAX_LEN of
+ * 803 (which holds the 12- and 24- and 36-entry maxima plus the older 0x13 TLV this chip does not use).
+ * Returns 0 rather than a partial message when anything does not fit. */
+static inline uint32_t wlfw_wlan_cfg(uint8_t *out, uint32_t capacity, uint16_t transaction)
+{
+    if (!out) return 0;
+    uint32_t at = wlfw_begin(out, capacity, WLFW_REQUEST, transaction, WLFW_WLAN_CFG_REQ);
+    if (!at) return 0;
+    const uint8_t version[] = WLFW_HOST_VERSION;
+
+    if (!(at = wlfw_tlv(out, capacity, at, WLFW_TLV_HOST_VERSION, version, sizeof(version) - 1))) return 0;
+
+    /* tgt_cfg: type, length, the u8 count, then the pipes. */
+    const uint32_t tgt_bytes = 1u + 20u * WLFW_CE_COUNT;
+    if (tgt_bytes > 0xffffu || at + 3u + tgt_bytes > capacity) return 0;
+    out[at] = WLFW_TLV_TGT_CFG;
+    wlfw_put16(out + at + 1, tgt_bytes);
+    out[at + 3] = (uint8_t)WLFW_CE_COUNT;
+    uint32_t p = at + 4;
+    for (uint32_t i = 0; i < WLFW_CE_COUNT; ++i, p += 20u) {
+        wlfw_put32(out + p + 0, wlfw_ce_pipes[i].pipe_num);
+        wlfw_put32(out + p + 4, wlfw_ce_pipes[i].pipe_dir);
+        wlfw_put32(out + p + 8, wlfw_ce_pipes[i].nentries);
+        wlfw_put32(out + p + 12, wlfw_ce_pipes[i].nbytes_max);
+        wlfw_put32(out + p + 16, wlfw_ce_pipes[i].flags);
+    }
+    at = p;
+
+    /* svc_cfg: type, length, the u8 count, then the services. */
+    const uint32_t svc_bytes = 1u + 12u * WLFW_SVC_COUNT;
+    if (svc_bytes > 0xffffu || at + 3u + svc_bytes > capacity) return 0;
+    out[at] = WLFW_TLV_SVC_CFG;
+    wlfw_put16(out + at + 1, svc_bytes);
+    out[at + 3] = (uint8_t)WLFW_SVC_COUNT;
+    p = at + 4;
+    for (uint32_t i = 0; i < WLFW_SVC_COUNT; ++i, p += 12u) {
+        wlfw_put32(out + p + 0, wlfw_ce_services[i].service_id);
+        wlfw_put32(out + p + 4, wlfw_ce_services[i].pipe_dir);
+        wlfw_put32(out + p + 8, wlfw_ce_services[i].pipe_num);
+    }
+    at = p;
+
+    /* shadow_reg_v2: type, length, the u8 count, then one le32 address each. A count of 0 is legal and is what a host
+     * with no shadow registers sends; the caller decides, and this writes whatever the builder above produced. */
+    uint32_t shadow[WLFW_SHADOW_MAX];
+    const uint32_t shadow_count = wlfw_shadow_config(shadow, WLFW_SHADOW_MAX);
+    if (!shadow_count) return 0;
+    const uint32_t shadow_bytes = 1u + 4u * shadow_count;
+    if (shadow_bytes > 0xffffu || at + 3u + shadow_bytes > capacity) return 0;
+    out[at] = WLFW_TLV_SHADOW_V2;
+    wlfw_put16(out + at + 1, shadow_bytes);
+    out[at + 3] = (uint8_t)shadow_count;
+    p = at + 4;
+    for (uint32_t i = 0; i < shadow_count; ++i, p += 4u) wlfw_put32(out + p, shadow[i]);
+    return wlfw_end(out, p);
+}
+
 /* The pieces a file of bytes takes at a piece size of piece: one per piece bytes, and never zero, so a zero-length file
  * still sends one piece with end=1 (which the firmware then refuses, as it should: no board file is empty). The piece
  * size is the link's, decided at run time, so a caller passes the one it is using; WLFW_MAX_DATA is only the ceiling. */
@@ -432,6 +676,8 @@ static inline const char *wlfw_name(uint16_t message)
