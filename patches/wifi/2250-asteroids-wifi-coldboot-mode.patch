+    switch (type) {
+    case WLFW_MEM_MSA: return "msa";
+    case WLFW_MEM_DDR: return "ddr";
+    case WLFW_MEM_BDF: return "bdf";
+    case WLFW_MEM_M3: return "m3";
+    case WLFW_MEM_CAL: return "cal";
+    case WLFW_MEM_DPD: return "dpd";
