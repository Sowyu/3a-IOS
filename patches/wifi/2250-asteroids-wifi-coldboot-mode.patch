@@ -349,6 +431,22 @@ static inline const char *wlfw_name(uint16_t message)
     case WLFW_CAP_REQ: return "cap";
     case WLFW_DEVICE_INFO_REQ: return "device_info";
     case WLFW_BDF_DOWNLOAD_REQ: return "bdf_download";
+    case WLFW_WLAN_MODE_REQ: return "wlan_mode";       /* 2250 (W6) */
+    default: return "unknown";
+    }
+}
+
+/* What a memory segment's type is, for the log: the enum's own names, so a request_mem line says M3 or MSA or DDR rather
+ * than a bare number. 2250 (W6). */
+static inline const char *wlfw_mem_type_name(uint32_t type)
