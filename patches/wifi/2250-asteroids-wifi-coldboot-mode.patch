+ * two this stage touches are named: 7 to ask for cold-boot calibration, which is the mode ath11k sends after fw_init_done
+ * and before it configures anything, and 0 for the reference of what comes after (L3's next boot). OFF is named too
+ * because this stage deliberately does not send it: see the W6 comment in WpssRuntime.inc. */
+#define WLFW_MODE_NORMAL 0u       /* ATH11K_FIRMWARE_MODE_NORMAL */
+#define WLFW_MODE_OFF 4u          /* ATH11K_FIRMWARE_MODE_OFF */
+#define WLFW_MODE_COLD_BOOT 7u    /* ATH11K_FIRMWARE_MODE_COLD_BOOT */
