+ * says which kind was asked for and not only a number. */
+#define WLFW_MEM_MSA 0u
+#define WLFW_MEM_DDR 1u
+#define WLFW_MEM_BDF 2u
+#define WLFW_MEM_M3 3u
+#define WLFW_MEM_CAL 4u
+#define WLFW_MEM_DPD 5u
