+
+/* Decodes the first mem_seg of a QMI_WLFW_REQUEST_MEM_IND_V01 (0x0035) indication, 2250 (W6).
+ *
+ * Why this exists at all, on a chip whose firmware memory is fixed. ath11k's WCN6750 entry sets fixed_fw_mem = true, and
+ * for that reason it never asks for DDR (`if (!ab->hw_params.fixed_fw_mem) req->request_mem_enable = 1`, qmi.c) and never
+ * enables the fw_mem_ready indication. So this firmware should not send 0x0035 at all. But it is the one indication that
+ * would change what the host must allocate, it is cheap to read, and a firmware that sends it to a host that has not
+ * registered for it is exactly the kind of surprise a stage should log rather than ignore. The values are ath11k's:
+ * TLV 0x01 is a u8 count then that many segments of {u32 size, u32 type, u8 mem_cfg_len, mem_cfg_len x mem_cfg}. This
+ * reads the count and the first segment, which is enough to say what was asked for, and never allocates anything.
+ *
+ * Returns 0 when a segment was decoded, 1 when the TLV is absent or holds no segment, -1 when it is malformed. */
+static inline int wlfw_request_mem(const uint8_t *data, uint32_t bytes, uint32_t *count, WlfwMemSegment *first)
+{
+    const uint8_t *v = 0;
+    uint32_t n = 0;
+    if (wlfw_tlv_find(data, bytes, WLFW_TLV_MEM_SEG, &v, &n)) return 1;
+    /* count, then at least one segment's fixed part: 1 + 4 + 4 + 1 = 10 bytes. */
+    if (n < 1u) return -1;
+    *count = v[0];
+    if (v[0] == 0) return 1;
+    if (n < 10u) return -1;
+    first->size = wlfw_get32(v + 1);
+    first->type = wlfw_get32(v + 5);
+    first->configs = v[9];
+    /* Every config is 13 bytes; the count must not claim more than the TLV holds. */
+    if (first->configs && 1u + 9u + 13u * first->configs > n) return -1;
+    return 0;
+}
