+/* QMI_WLANFW_MAX_DATA_SIZE_V01 6144: the most bytes one BDF_DOWNLOAD request carries. Each request repeats the file id,
+ * the bytes left (total_size), a segment number from 0 and the file's type, and sets end=1 only on the last piece. */
+#define WLFW_MAX_DATA 6144u
+/* enum ath11k_qmi_bdf_type: what the file is, as the firmware is told. A .bin board file is 0, an ELF one is 1 (the
+ * phone's bdwlan.eNN variants are ELF; bdwlan.bin is not), and the regulatory database is 4. */
+#define WLFW_BDF_TYPE_BIN 0u
+#define WLFW_BDF_TYPE_ELF 1u
+#define WLFW_BDF_TYPE_REGDB 4u
+
 /* ---- TLV numbers, from the qmi_elem_info tables in ath11k qmi.c ------------------------------------------- */
 #define WLFW_TLV_RESULT 0x02u          /* qmi_response_type_v01: u16 result, u16 error, in every response */
 #define WLFW_TLV_FW_READY 0x10u        /* ind_register: u8 fw_ready_enable */
@@ -68,6 +79,18 @@
 #define WLFW_TLV_SOC_INFO 0x12u        /* cap response: u32 soc_id */
 #define WLFW_TLV_BAR_ADDR 0x10u        /* device_info response: u64 bar_addr */
 #define WLFW_TLV_BAR_SIZE 0x11u        /* device_info response: u32 bar_size */
+/* The board data download (ath11k qmi.c, qmi_wlanfw_bdf_download_req_msg_v01_ei). Every field is optional and every one
+ * is sent: 0x01 u8 valid=1, 0x10 u32 file_id (the CAP reply's board id), 0x11 u32 total_size (bytes still to come),
+ * 0x12 u32 seg_id from 0, 0x13 u16 length then that many bytes of data, 0x14 u8 end (1 on the last piece only),
+ * 0x15 u8 bdf_type. 0x13's value is a length-prefixed array, not a plain scalar: the two-byte count comes first, then
+ * the bytes. */
+#define WLFW_TLV_BDF_VALID 0x01u       /* bdf_download: u8 valid */
+#define WLFW_TLV_BDF_FILE_ID 0x10u     /* bdf_download: u32 file_id */
+#define WLFW_TLV_BDF_TOTAL 0x11u       /* bdf_download: u32 total_size */
+#define WLFW_TLV_BDF_SEG 0x12u         /* bdf_download: u32 seg_id */
+#define WLFW_TLV_BDF_DATA 0x13u        /* bdf_download: u16 length, then the bytes */
+#define WLFW_TLV_BDF_END 0x14u         /* bdf_download: u8 end */
+#define WLFW_TLV_BDF_TYPE 0x15u        /* bdf_download: u8 bdf_type */
 /* The same TLV number means a different field in a different message: that is QMI, and it is why each name above says
  * which message it belongs to. */
 
@@ -159,6 +182,69 @@ static inline uint32_t wlfw_empty_request(uint8_t *out, uint32_t capacity, uint1
     return at ? wlfw_end(out, at) : 0;
 }
 
+/* BDF_DOWNLOAD (0x0025): one piece of a board data file. ath11k_qmi_load_file_target_mem builds it field by field from
+ * the file, so the values here are its own: file_id is the board id CAP reported (0xff when the firmware sent none, which
+ * is ath11k's fallback), total_size is what is LEFT of the file including this piece, seg_id counts from 0, end is 1 only
+ * on the last piece, and bdf_type says what the file is. The data TLV is length-prefixed (u16 count, then the bytes), so
+ * it is built here rather than through wlfw_tlv.
+ *
+ * Length: 4 (valid) + 7 (file_id) + 7 (total) + 7 (seg) + 3 + 2 + bytes (data) + 4 (end) + 4 (type). At the maximum
+ * 6144 bytes of data that is 7 + 33 + 3 + 2 + 6144 = 6189 bytes with the header, which is ath11k's own
+ * QMI_WLANFW_BDF_DOWNLOAD_REQ_MSG_V01_MAX_LEN 6182 plus the 7-byte header. Returns 0 when it does not fit, never a
+ * partial message. */
+static inline uint32_t wlfw_bdf_download(uint8_t *out, uint32_t capacity, uint16_t transaction, uint32_t file_id,
+                                         uint32_t total_size, uint32_t seg_id, const uint8_t *data, uint32_t bytes,
+                                         uint8_t end, uint8_t bdf_type)
+{
+    if (!out || bytes > WLFW_MAX_DATA || (bytes && !data)) return 0;
+    uint32_t at = wlfw_begin(out, capacity, WLFW_REQUEST, transaction, WLFW_BDF_DOWNLOAD_REQ);
+    if (!at) return 0;
+    uint8_t v[4];
+    const uint8_t one = 1;
+    if (!(at = wlfw_tlv(out, capacity, at, WLFW_TLV_BDF_VALID, &one, 1))) return 0;
+    wlfw_put32(v, file_id);
+    if (!(at = wlfw_tlv(out, capacity, at, WLFW_TLV_BDF_FILE_ID, v, 4))) return 0;
+    wlfw_put32(v, total_size);
+    if (!(at = wlfw_tlv(out, capacity, at, WLFW_TLV_BDF_TOTAL, v, 4))) return 0;
+    wlfw_put32(v, seg_id);
+    if (!(at = wlfw_tlv(out, capacity, at, WLFW_TLV_BDF_SEG, v, 4))) return 0;
+    /* The data TLV: type, the TLV length (2 for the count plus the bytes), the u16 count, then the bytes. A piece of zero
+     * bytes is still a TLV with a zero count, which is what a zero-length file would send. */
+    if (2u + bytes > 0xffffu || at + 3u + 2u + bytes > capacity) return 0;
+    out[at] = WLFW_TLV_BDF_DATA;
+    wlfw_put16(out + at + 1, 2u + bytes);
+    wlfw_put16(out + at + 3, bytes);
+    for (uint32_t i = 0; i < bytes; ++i) out[at + 5 + i] = data[i];
+    at += 3u + 2u + bytes;
+    if (!(at = wlfw_tlv(out, capacity, at, WLFW_TLV_BDF_END, &end, 1))) return 0;
+    if (!(at = wlfw_tlv(out, capacity, at, WLFW_TLV_BDF_TYPE, &bdf_type, 1))) return 0;
+    return wlfw_end(out, at);
+}
+
+/* The pieces a file of bytes takes at a piece size of piece: one per piece bytes, and never zero, so a zero-length file
+ * still sends one piece with end=1 (which the firmware then refuses, as it should: no board file is empty). The piece
+ * size is the link's, decided at run time, so a caller passes the one it is using; WLFW_MAX_DATA is only the ceiling. */
+static inline uint32_t wlfw_bdf_pieces(uint32_t bytes, uint32_t piece)
+{
+    if (!piece) return 1u;
+    return bytes ? (bytes + piece - 1u) / piece : 1u;
+}
+/* What the `bytes_left` of the piece at index of a file of size bytes is: the file's remaining bytes including this
+ * piece. ath11k sets total_size to `remaining` before subtracting, so the first piece carries the whole file. */
+static inline uint32_t wlfw_bdf_total(uint32_t bytes, uint32_t index)
+{
+    const uint32_t at = index * WLFW_MAX_DATA;
+    return at >= bytes ? 0u : bytes - at;
+}
+/* What this file is, by its first bytes: ELF when it starts with \177ELF, otherwise BIN. ath11k tests exactly this
+ * (qmi.c ath11k_qmi_load_bdf_qmi: memcmp(bd.data, ELFMAG, SELFMAG)), and the type decides whether the firmware treats
+ * the file as a flat board blob. The phone's bdwlan.eNN variants are ELF and bdwlan.bin is not. */
+static inline uint8_t wlfw_bdf_type(const uint8_t *data, uint32_t bytes)
+{
+    if (data && bytes >= 4 && data[0] == 0x7f && data[1] == 'E' && data[2] == 'L' && data[3] == 'F') return WLFW_BDF_TYPE_ELF;
+    return WLFW_BDF_TYPE_BIN;
+}
+
