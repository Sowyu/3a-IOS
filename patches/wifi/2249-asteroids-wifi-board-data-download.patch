  * WLFW is the Wi-Fi firmware's own QMI service, the one it announces on the WPSS's QRTR. This file holds the three
  * requests stage 2 sends first (IND_REGISTER, HOST_CAP, and the two empty ones, CAP and DEVICE_INFO) and the replies'
- * decoders. Nothing else: the board data download is the boot after this one.
+ * decoders. 2249 (W5) adds the board data download, BDF_DOWNLOAD, which carries a file from modem_a in pieces.
  *
  * Where every number comes from. Message ids, TLV numbers and field layouts are from ath11k (the Linux driver for this
  * chip family, BSD-3-Clause-Clear), read as declarations only:
@@ -47,12 +47,23 @@
 #define WLFW_HOST_CAP_REQ 0x0034u
 #define WLFW_CAP_REQ 0x0024u
 #define WLFW_DEVICE_INFO_REQ 0x004Cu
+#define WLFW_BDF_DOWNLOAD_REQ 0x0025u      /* QMI_WLANFW_BDF_DOWNLOAD_REQ_V01 */
 #define WLFW_FW_READY_IND 0x0021u          /* QMI_WLFW_FW_READY_IND_V01 */
 #define WLFW_REQUEST_MEM_IND 0x0035u       /* QMI_WLFW_REQUEST_MEM_IND_V01 */
 #define WLFW_FW_MEM_READY_IND 0x0037u      /* QMI_WLFW_FW_MEM_READY_IND_V01 */
 #define WLFW_FW_INIT_DONE_IND 0x0038u      /* QMI_WLFW_FW_INIT_DONE_IND_V01 */
 #define WLFW_COLD_BOOT_CAL_DONE_IND 0x003Eu /* QMI_WLFW_COLD_BOOT_CAL_DONE_IND_V01 */
 
