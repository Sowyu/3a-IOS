+++ b/bsd/dev/modem/QcomQrtr.c
@@ -39,6 +39,30 @@ static int emit(QcomQrtr *q, uint32_t type, uint32_t from_port, uint32_t node, u
     return 0;
 }
 
+/* 2249 (W5): a data packet whose payload is already laid out behind its own 32-byte header in the caller's buffer, so a
+ * board data piece is not limited by MAX_PACKET. payload_length is the message's true length; the packet is padded to
+ * four bytes, as QRTR requires, so the caller's buffer must hold QCOM_QRTR_HEADER + align4(payload_length). The size in
+ * the header is payload_length, never the padded length: a reader that trusts it must see the message, not its padding.
+ * Returns 0 when queued. */
+int qcom_qrtr_send_data_prefixed(QcomQrtr *q, uint32_t from_port, uint32_t node, uint32_t port, uint8_t *packet,
+                                 uint32_t payload_length)
+{
+    if (!q || !packet || !payload_length) return -1;
+    const uint32_t padded = (payload_length + 3) & ~3u;
+    for (uint32_t i = payload_length; i < padded; ++i) packet[QCOM_QRTR_HEADER + i] = 0;
+    put32(packet, 1);
+    put32(packet + 4, QCOM_QRTR_DATA);
+    put32(packet + 8, q->local_node);
+    put32(packet + 12, from_port);
+    put32(packet + 16, 0);  /* confirm_rx: unchanged from emit */
+    put32(packet + 20, payload_length);
+    put32(packet + 24, node);
+    put32(packet + 28, port);
+    if (q->send(q->send_context, packet, QCOM_QRTR_HEADER + padded)) {q->tx_refused++; return -1;}
+    q->tx_packets++;
+    return 0;
+}
