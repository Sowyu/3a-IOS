+}
+/* The read-only check that the lease is still exactly what was installed, taken while the firmware is in mission mode: the
+ * bank's own FSR, the global status, and the five words w9_is_ours reads. It writes no SMMU register, and it takes the same
+ * claim every other SMMU user takes, so it cannot read a table while IPA or touch is changing one. A claim that cannot be
+ * taken inside the bound is reported and the check is skipped; it is evidence, not a gate. */
+static void w9_check(void){
+ if(!w.dma_asked || !w.dma_installed)return;
+ if(!w9_claim()){printf("SWEET WIFI: W9 dma mission: busy, another SMMU user held the claim for %u ms; not checked\n",W_SMMU_CLAIM_MS);sweet_log_sync();return;}
+ w.dma_fsr=w_smmu_rd(w.dma_smmu,ipa_cb(w.dma_bank)+0x58);
+ w.dma_gfsr_mission=w_smmu_rd(w.dma_smmu,0x48);w.dma_checked=true;
+ bool ours=w9_is_ours();
+ if(!ours)w.dma_verify_fail++;
+ printf("SWEET WIFI: W9 dma mission: smr=%u bank=%u ours=%u sctlr=%#x cbar=%#x cba2r=%#x ttbr0=%#x:%#x fsr=%#x sGFSR=%#x\n",
+  w.dma_smr,w.dma_bank,(unsigned)ours,(unsigned)w_smmu_rd(w.dma_smmu,ipa_cb(w.dma_bank)),
+  (unsigned)w_smmu_rd(w.dma_smmu,0x1000+4*w.dma_bank),(unsigned)w_smmu_rd(w.dma_smmu,0x1800+4*w.dma_bank),
+  (unsigned)w_smmu_rd(w.dma_smmu,ipa_cb(w.dma_bank)+0x24),(unsigned)w_smmu_rd(w.dma_smmu,ipa_cb(w.dma_bank)+0x20),
+  w.dma_fsr,w.dma_gfsr_mission);
+ sweet_apps_smmu_release();
+ sweet_log_sync();
+}
+/* 2253 (W9) teardown: IPA's order, IPA's reasons (ipa_mmu_release). Route the owned stream to a fault first, so no request
+ * can reach a table that is about to go; disable the bank; invalidate the VMID and zero the TTBRs; unhook the SMR and only
+ * then restore its dormant route; give CBAR and CBA2R back to the free values, which is what hands the bank to IPA's next
+ * choice; and require the bank to pass the same free predicate the install used. Only then is anything freed. */
+static bool w9_release(bool stopped){
+ if(!w.dma_asked || w.dma_bank==W9_NONE)return true;
+ if(!stopped){printf("SWEET WIFI: W9 dma: the DSP stop is not verified; the lease, the tables and the ring page are retained until reset\n");sweet_log_sync();return false;}
+ if(!w.dma_installed){printf("SWEET WIFI: W9 dma: teardown refused, the install never completed; retained until reset\n");sweet_log_sync();return false;}
+ if(!w9_claim()){printf("SWEET WIFI: W9 dma: busy at teardown, the claim was not taken; retained until reset\n");sweet_log_sync();return false;}
