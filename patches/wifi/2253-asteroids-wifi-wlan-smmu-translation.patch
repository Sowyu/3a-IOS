+ *pa=ptoa_64(pmap_find_phys(kernel_pmap,(addr64_t)*va));
+ if(!*pa || *pa>=(1ull<<36) || size>(1ull<<36)-*pa)return EINVAL;
+ for(vm_size_t off=0;off<size;off+=PAGE_SIZE)if(ptoa_64(pmap_find_phys(kernel_pmap,(addr64_t)(*va+off)))!=*pa+off)return EINVAL;
+ return 0;
+}
+/* Resolves one IOVA through our own entries, the way the SMMU's walker would, so the table can be checked on the CPU before
+ * anything points at it. 0 when the leaf is missing, or when an entry points outside the table this stage owns. */
+static uint64_t w9_walk(uint64_t iova,unsigned *attr){
+ uint64_t *t=(uint64_t *)w.dma_pt_v,e=t[(iova>>30)&511u];
+ if((e&3)!=3)return 0;
+ uint64_t l2;
+ {uint64_t pa=e&0x0000fffffffff000ull;if(pa<w.dma_pt_pa || pa>=w.dma_pt_pa+IPA_PT_BYTES)return 0;l2=(pa-w.dma_pt_pa)/4096u;}
+ e=t[l2*512u+((iova>>21)&511u)];if((e&3)!=3)return 0;
+ uint64_t l3;
+ {uint64_t pa=e&0x0000fffffffff000ull;if(pa<w.dma_pt_pa || pa>=w.dma_pt_pa+IPA_PT_BYTES)return 0;l3=(pa-w.dma_pt_pa)/4096u;}
+ e=t[l3*512u+((iova>>12)&511u)];if(!(e&1))return 0;
+ if(attr)*attr=(unsigned)((e>>2)&7u);
+ return (e&0x0000fffffffff000ull)|(iova&4095u);
+}
+/* The claim, with the survey's own patience: a holder is writing, so wait a little and then say so instead of reading or
+ * writing a table half way through its update. Each install and each teardown takes it once and gives it back once. */
+static bool w9_claim(void){
+ unsigned waited=0;
+ while(!sweet_apps_smmu_claim()){
+  if(waited>=W_SMMU_CLAIM_MS)return false;
+  w_sleep(10);waited+=10;
+ }
+ return true;
+}
+/* IPA's own used-bank map, computed for its own reason: a bank a translating SMR reaches is owned, and so is a bank one of
+ * those chains to as a stage-2 context. Here it is what the free predicate is allowed to look at. */
+static void w9_used(bool *used){
+ memset(used,0,W_SMMU_NCB*sizeof(bool));
+ for(unsigned i=0;i<W_SMMU_NSMR;i++){
+  if(!(w_smmu_rd(w.dma_smmu,0x800+4*i)>>31))continue;
+  uint32_t s2=w_smmu_rd(w.dma_smmu,0xc00+4*i);
+  if(((s2>>16)&3)==0 && (s2&255u)<W_SMMU_NCB)used[s2&255u]=true;
+ }
+ for(unsigned i=0;i<W_SMMU_NCB;i++)if(used[i] && ((w_smmu_rd(w.dma_smmu,0x1000+4*i)>>16)&3)==3){
+  unsigned second=(w_smmu_rd(w.dma_smmu,0x1000+4*i)>>8)&255u;
+  if(second<W_SMMU_NCB)used[second]=true;
+ }
+}
+/* Is this bank free by the predicate ipa_mmu_choose uses? One place, called by the install before it writes and by the
+ * teardown after it has finished, so "free" cannot mean two things. */
+static bool w9_bank_free(unsigned c,const bool *used){
+ unsigned b=ipa_cb(c);
+ return !used[c] && !(w_smmu_rd(w.dma_smmu,b)&0xe1u) && !w_smmu_rd(w.dma_smmu,b+0x58) &&
+   !w_smmu_rd(w.dma_smmu,0x1000+4*c) && !w_smmu_rd(w.dma_smmu,0x1800+4*c);
+}
+/* The five words that identify the lease, in one place, so the install, the mission check and the teardown cannot disagree
+ * about what "ours" means. */
+static bool w9_is_ours(void){
+ unsigned b=ipa_cb(w.dma_bank),s=w.dma_smr;
+ return w_smmu_rd(w.dma_smmu,0x800+4*s)==w.dma_smr_raw &&
+   w_smmu_rd(w.dma_smmu,0xc00+4*s)==(w.dma_bank|(3u<<8)) &&
+   w_smmu_rd(w.dma_smmu,0x1000+4*w.dma_bank)==(W9_CBAR|w.dma_vmid) &&
+   w_smmu_rd(w.dma_smmu,0x1800+4*w.dma_bank)==1 && w_smmu_rd(w.dma_smmu,b)==w.dma_sctl;
+}
+/* 2253 (W9) install. One SMR, one bank, one stage-1 table, two mappings, all below 4 GiB.
+ *
+ * The choice is the IPA driver's, not a second copy of its rules: an IpaMmu pointed at this window runs ipa_mmu_choose for
+ * SID 0x1400, whose scan of all 114 SMRs finds no match for 0x1400 or 0x1401 (or refuses, exactly as it would for IPA) and
+ * whose free-bank scan is IPA's predicate. The table is written and synced before anything points at it, the bank is
+ * enabled while nothing routes to it, then the S2CR, then the SMR, which is ipa_mmu_install's order. */
+static int w9_install(void){
+ if(!w.dma_asked || w.dma_bank!=W9_NONE || w.dma_installed)return EBUSY;
+ int rc=EIO;
+ if(!w9_claim()){printf("SWEET WIFI: W9 dma: busy, another SMMU user held the claim for %u ms; not installed\n",W_SMMU_CLAIM_MS);sweet_log_sync();return EBUSY;}
+ vm_offset_t s=ml_io_map_unmappable(W_SMMU_PA,W_SMMU_BYTES,VM_WIMG_IO);
+ if(!s){printf("SWEET WIFI: W9 dma: mapping failed; not installed\n");sweet_log_sync();goto out_release;}
+ w.dma_smmu=s;
+ uint32_t id0=w_smmu_rd(s,0x20),id1=w_smmu_rd(s,0x24),id2=w_smmu_rd(s,0x28);
+ /* The geometry gate W8 measured: a different ID set is a different hypervisor build, and nothing here is proven there. */
+ if(id0!=W_SMMU_ID0 || id1!=W_SMMU_ID1 || id2!=W_SMMU_ID2){
+  printf("SWEET WIFI: W9 dma: geometry differs from the measured ID0=%#x ID1=%#x ID2=%#x; not installed\n",W_SMMU_ID0,W_SMMU_ID1,W_SMMU_ID2);
+  sweet_log_sync();goto out_unmap;
+ }
+ /* W8's own finding, enforced before anything is allocated: if a stream this stage would claim is already matched, a second
+  * SMR would be a match conflict on the device's first DMA. ipa_mmu_choose refuses this case for IPA's own SIDs; the
+  * device's two are checked here, with the SMR mask honoured. */
+ {bool taken[W_WLAN_SIDS]={false};
+  for(unsigned i=0;i<W_SMMU_NSMR;i++){
+   uint32_t smr=w_smmu_rd(s,0x800+4*i);if(!(smr>>31))continue;
+   for(unsigned k=0;k<W_WLAN_SIDS;k++)if(!taken[k] && w_smr_hits(smr,W_WLAN_SID+k)){
+    taken[k]=true;printf("SWEET WIFI: W9 dma: sid %#x is already matched by SMR %u raw=%#x; not installed\n",W_WLAN_SID+k,i,smr);
+    sweet_log_sync();goto out_unmap;
+   }
+  }}
+ /* The ring page and the table, each contiguous, zeroed and below 2^36 (w9_alloc is ipa_alloc's own check). The ring page
+  * stands in for W10's rings: this stage proves the translation, not the rings. */
+ if((rc=w9_alloc(&w.dma_ring,&w.dma_ring_pa,W9_RING_BYTES))){printf("SWEET WIFI: W9 dma: ring page allocation failed error=%d\n",rc);sweet_log_sync();goto out_unmap;}
+ if((rc=w9_alloc(&w.dma_pt_v,&w.dma_pt_pa,IPA_PT_BYTES))){printf("SWEET WIFI: W9 dma: page table allocation failed error=%d\n",rc);sweet_log_sync();goto out_free;}
+ memset((void *)w.dma_ring,0,W9_RING_BYTES);sweet_dma_sync_va((void *)w.dma_ring,W9_RING_BYTES);
+ IpaPageTable pt;
+ if(ipa_pt_init(&pt,(uint64_t *)w.dma_pt_v,w.dma_pt_pa) ||
+    ipa_pt_map(&pt,W9_RING_IOVA,w.dma_ring_pa,W9_RING_BYTES) ||
+    ipa_pt_map_attr(&pt,W9_DOORBELL_IOVA,W9_DOORBELL_PA,W9_DOORBELL_BYTES,1)){
+  printf("SWEET WIFI: W9 dma: the page table builder refused; not installed\n");sweet_log_sync();rc=EINVAL;goto out_free;
+ }
+ /* The walk the SMMU will make, made on the CPU first: both IOVAs must resolve to the pages this stage owns, with the ring
+  * Normal-NC and the doorbell Device. If they do not, nothing is published and the table is freed. */
+ unsigned attr_ring=0xffffffffu,attr_bell=0xffffffffu;
+ {uint64_t ring_hit=w9_walk(W9_RING_IOVA,&attr_ring),bell_hit=w9_walk(W9_DOORBELL_IOVA+W9_DOORBELL_OFF,&attr_bell);
+  printf("SWEET WIFI: W9 dma: table walk iova=%#x -> %#llx (want %#llx attr %u), iova=%#x -> %#llx (want %#llx attr %u)\n",
+   W9_RING_IOVA,(unsigned long long)ring_hit,(unsigned long long)w.dma_ring_pa,attr_ring,
+   (unsigned)(W9_DOORBELL_IOVA+W9_DOORBELL_OFF),(unsigned long long)bell_hit,(unsigned long long)(W9_DOORBELL_PA+W9_DOORBELL_OFF),attr_bell);
+  w.dma_table_ok=ring_hit==w.dma_ring_pa && attr_ring==0;
+  w.dma_doorbell=bell_hit==W9_DOORBELL_PA+W9_DOORBELL_OFF && attr_bell==1;
+  if(!w.dma_table_ok || !w.dma_doorbell){
+   printf("SWEET WIFI: W9 dma: the table does not resolve as asked (ring=%u doorbell=%u); not installed\n",
+    (unsigned)w.dma_table_ok,(unsigned)w.dma_doorbell);sweet_log_sync();rc=EIO;goto out_free;
+  }
+ }
+ sweet_dma_sync_va((void *)w.dma_pt_v,IPA_PT_BYTES);
+ /* The choice. IPA's own allocator, ipa_mmu_choose, cannot make it: it is written for IPA's two SIDs (0x4a0/0x4a2), it
+  * refuses a device whose streams it does not own, and it requires exactly two free SMRs. So the two predicates that ARE
+  * reusable are the ones reused, from IpaMmu.h itself: ipa_mmu_mode (translation on, 8-bit VMIDs, ordinary stream ids) and
+  * ipa_mmu_vmid_free (a VMID absent from every bank's CBAR, even a disabled bank). The bank predicate is ipa_mmu_choose's
+  * inner loop, written out once in w9_bank_free with its reasons, and the SMR is the lowest invalid slot, which is the same
+  * slot ipa_mmu_choose's scan would stop at. This is the rule that keeps the two apart: a bank this stage installs carries
+  * IPA's lease marker in CBAR, so ipa_mmu_choose's own predicate refuses it on its next run. */
+ IpaMmu mmu;
+ memset(&mmu,0,sizeof(mmu));
+ mmu.io=(IpaMmuIo){0,w9_read,w9_write,w9_write64,w9_delay};
+ if(!ipa_mmu_mode(&mmu)){printf("SWEET WIFI: W9 dma: sCR0 is not IPA's translation mode; not installed\n");sweet_log_sync();rc=EIO;goto out_free;}
+ {unsigned candidate=0;
+  for(unsigned v=1;v<256 && !candidate;v++)if(ipa_mmu_vmid_free(&mmu,v))candidate=v;
+  if(!candidate){printf("SWEET WIFI: W9 dma: no free nonzero VMID by IPA's rule; not installed\n");sweet_log_sync();rc=EIO;goto out_free;}
+  w.dma_vmid=candidate;
+ }
+ /* ath11k on this bus sets a 32-bit DMA mask, so every address the device is given must be below 4 GiB. The SMMU itself
+  * would accept up to 2^36 (ID2=0x5111), so this bound is the host's to keep; it is stated here, before anything is mapped
+  * or written, rather than inferred from the constants above. */
+ if((uint64_t)W9_RING_IOVA+W9_RING_BYTES>W9_LIMIT || (uint64_t)(W9_DOORBELL_IOVA+W9_DOORBELL_BYTES)>W9_LIMIT){
+  printf("SWEET WIFI: W9 dma: the IOVA window %#llx..%#llx is not below 4 GiB (ath11k's 32-bit host DMA mask); not installed\n",
+   (unsigned long long)W9_RING_IOVA,(unsigned long long)(W9_DOORBELL_IOVA+W9_DOORBELL_BYTES));
+  sweet_log_sync();rc=EINVAL;goto out_free;
+ }
+ w.dma_smr_raw=0x80000000u|(1u<<16)|W9_SID;
+ w.dma_sctl=1u|2u|4u|0x20u|(3u<<22);
+ /* The slot and the bank. The SMR is the lowest invalid one (ipa_mmu_choose's scan stops at the first, and W8 measured
+  * the first four free as 5 to 8). The bank is the lowest that passes ipa_mmu_choose's predicate against IPA's used[] map,
+  * which is why IPA's own two leases (banks 5 and 6 in ast174) and every bank another SMR reaches are skipped here. */
+ {bool used[W_SMMU_NCB];w9_used(used);
+  for(unsigned i=0;i<W_SMMU_NSMR && w.dma_smr==W9_NONE;i++)if(!(w_smmu_rd(s,0x800+4*i)>>31))w.dma_smr=i;
+  if(w.dma_smr==W9_NONE){printf("SWEET WIFI: W9 dma: no free SMR of %u; not installed\n",W_SMMU_NSMR);sweet_log_sync();rc=EIO;goto out_free;}
+  for(unsigned c=0;c<W_SMMU_NCB && w.dma_bank==W9_NONE;c++)if(w9_bank_free(c,used))w.dma_bank=c;
+  if(w.dma_bank==W9_NONE){printf("SWEET WIFI: W9 dma: no free context bank by IPA's rule; not installed\n");sweet_log_sync();rc=EIO;goto out_free;}
+ }
+ /* What the two slots hold before this stage takes them: the SMR must read invalid and the bank's three lease words must
+  * read free. Anything else is not a slot this stage may take, and the install stops here rather than adopt it. */
+ w.dma_smr_old=w_smmu_rd(s,0x800+4*w.dma_smr);
+ w.dma_s2cr_old=w_smmu_rd(s,0xc00+4*w.dma_smr);
+ w.dma_cbar_old=w_smmu_rd(s,0x1000+4*w.dma_bank);
+ w.dma_cba2r_old=w_smmu_rd(s,0x1800+4*w.dma_bank);
+ if(w.dma_smr_old || w.dma_cbar_old || w.dma_cba2r_old){
+  printf("SWEET WIFI: W9 dma: slot %u or bank %u changed after the choice (smr=%#x cbar=%#x cba2r=%#x); not installed\n",
+   w.dma_smr,w.dma_bank,w.dma_smr_old,w.dma_cbar_old,w.dma_cba2r_old);
+  sweet_log_sync();rc=EAGAIN;goto out_free;
+ }
+ const unsigned b=ipa_cb(w.dma_bank);
+ /* The table goes in while the bank is disabled, exactly as ipa_mmu_install does, so a half-written table is never
+  * reachable by any stream. CBAR carries the lease marker IPA's predicate refuses to reuse. */
+ w_smmu_wr(s,b,0);
+ if(w_smmu_rd(s,b)){printf("SWEET WIFI: W9 dma: SCTLR will not clear; not installed\n");sweet_log_sync();rc=EIO;goto retain;}
+ w_smmu_wr(s,0x1800+4*w.dma_bank,1);
+ if(w_smmu_rd(s,0x1800+4*w.dma_bank)!=1){printf("SWEET WIFI: W9 dma: CBA2R will not take the 64-bit form; not installed\n");sweet_log_sync();rc=EIO;goto retain;}
+ w_smmu_wr(s,0x1000+4*w.dma_bank,W9_CBAR|w.dma_vmid);
+ if(w_smmu_rd(s,0x1000+4*w.dma_bank)!=(W9_CBAR|w.dma_vmid)){printf("SWEET WIFI: W9 dma: CBAR will not take stage 1 with VMID %u; not installed\n",w.dma_vmid);sweet_log_sync();rc=EIO;goto retain;}
+ w_smmu_wr(s,b+0x10,IPA_MMU_TCR2);w_smmu_wr(s,b+0x30,IPA_MMU_TCR);
+ if(w_smmu_rd(s,b+0x10)!=IPA_MMU_TCR2 || w_smmu_rd(s,b+0x30)!=IPA_MMU_TCR){printf("SWEET WIFI: W9 dma: TCR will not take IPA's geometry; not installed\n");sweet_log_sync();rc=EIO;goto retain;}
+ w.dma_ttbr=w.dma_pt_pa|((uint64_t)(w.dma_bank+1)<<48);
+ w_smmu_wr64(s,b+0x20,w.dma_ttbr);w_smmu_wr64(s,b+0x28,0);
+ w_smmu_wr(s,b+0x38,0x0444);w_smmu_wr(s,b+0x3c,0);
+ /* Every word read back with the bank still disabled: a bank that will not hold its configuration is not enabled. */
+ if(w_smmu_rd(s,b) || w_smmu_rd64(s,b+0x20)!=w.dma_ttbr || w_smmu_rd(s,b+0x30)!=IPA_MMU_TCR ||
+    w_smmu_rd(s,b+0x10)!=IPA_MMU_TCR2 || w_smmu_rd(s,b+0x38)!=0x0444 || w_smmu_rd(s,b+0x3c) || w_smmu_rd64(s,b+0x28)){
+  printf("SWEET WIFI: W9 dma: the disabled bank did not hold its configuration; not installed\n");sweet_log_sync();w.dma_verify_fail++;rc=EIO;goto retain;
+ }
+ w_smmu_wr(s,b+0x618,0);       /* the invalidate word ipa_mmu_install writes for a leased VMID */
+ w_smmu_wr(s,b,w.dma_sctl);
+ if(w_smmu_rd(s,b)!=w.dma_sctl){printf("SWEET WIFI: W9 dma: the bank will not enable; not installed\n");sweet_log_sync();w.dma_verify_fail++;rc=EIO;goto retain;}
+ /* Publication, last and in IPA's order: the S2CR, then the SMR that makes the stream reach it. */
+ w_smmu_wr(s,0xc00+4*w.dma_smr,w.dma_bank|(3u<<8));
+ if(w_smmu_rd(s,0xc00+4*w.dma_smr)!=(w.dma_bank|(3u<<8))){printf("SWEET WIFI: W9 dma: S2CR will not route to bank %u; not installed\n",w.dma_bank);sweet_log_sync();w.dma_verify_fail++;rc=EIO;goto retain;}
+ w_smmu_wr(s,0x800+4*w.dma_smr,w.dma_smr_raw);
+ if(!w9_is_ours()){printf("SWEET WIFI: W9 dma: the published SMR and bank do not read back as installed\n");sweet_log_sync();w.dma_verify_fail++;rc=EIO;goto retain;}
+ w.dma_installed=true;w.dma_fsr=w_smmu_rd(s,b+0x58);
+ printf("SWEET WIFI: W9 dma: installed smr=%u raw=%#x s2cr=%#x bank=%u cbar=%#x cba2r=1 vmid=%u sctlr=%#x\n",
+  w.dma_smr,(unsigned)w.dma_smr_raw,(unsigned)(w.dma_bank|(3u<<8)),w.dma_bank,(unsigned)(W9_CBAR|w.dma_vmid),w.dma_vmid,(unsigned)w.dma_sctl);
+ printf("SWEET WIFI: W9 dma: ttbr0=%#llx tcr=%#x tcr2=%#x mair0=%#x mair1=%#x; iova %#x+%#x -> pa %#llx (Normal NC), doorbell iova %#x+%#x -> pa %#x (Device); fsr=%#x sGFSR=%#x\n",
+  (unsigned long long)w.dma_ttbr,(unsigned)IPA_MMU_TCR,(unsigned)IPA_MMU_TCR2,(unsigned)0x0444,0u,
+  W9_RING_IOVA,W9_RING_BYTES,(unsigned long long)w.dma_ring_pa,(unsigned)(W9_DOORBELL_IOVA+W9_DOORBELL_OFF),W9_DOORBELL_OFF,W9_DOORBELL_PA,w.dma_fsr,w.dma_gfsr_before);
+ printf("SWEET WIFI: W9 dma: no copy engine, no ring register, no radio register, no host address given to the firmware\n");
+ sweet_log_sync();rc=0;goto out_release;
+retain:
+ /* A partial lease is not a known format (ipa_mmu_release's rule): leave every word as it is and let the teardown refuse to
+  * guess. The SMR was published last, so a failure before it leaves the stream unrouted and the bank leased and idle. */
+ printf("SWEET WIFI: W9 dma: install stopped part way; the bank and the tables are retained until reset\n");sweet_log_sync();
+ rc=EIO;goto out_release;
+out_free:
+ if(w.dma_pt_v){kmem_free(kernel_map,w.dma_pt_v,IPA_PT_BYTES);w.dma_pt_v=0;}
+ if(w.dma_ring){kmem_free(kernel_map,w.dma_ring,W9_RING_BYTES);w.dma_ring=0;}
+ w.dma_bank=w.dma_smr=W9_NONE;
+out_unmap:
+ w_unmap(s,W_SMMU_BYTES);w.dma_smmu=0;
+out_release:
+ sweet_apps_smmu_release();
