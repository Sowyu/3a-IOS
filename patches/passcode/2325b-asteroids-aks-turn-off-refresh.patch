diff --git a/bsd/dev/SweetPasscode.h b/bsd/dev/SweetPasscode.h
--- a/bsd/dev/SweetPasscode.h
+++ b/bsd/dev/SweetPasscode.h
@@ -204,6 +204,10 @@
  * Set (new_len > 0) or clear (new_len == 0) the code. With a code already set, the old one has to verify unless
  * `force` is set, which the kernel passes only for uid 0. The new record is built in a local copy and swapped in only
  * after the write succeeds, so memory and disk cannot disagree.
+ *
+ * 2325b: a call that changes `have_code` in either direction raises SPC_EV_UNLOCKED, because that is the event whose
+ * handler re-reads the lock state, and SpringBoard's cached has-passcode byte is derived from it. A turn-off that
+ * only raised SPC_EV_PASSCODE_CHANGED left that byte at 1 and the lock screen kept asking for a code that was gone.
  */
 enum spc_try spc_lock_set(struct spc_lock *l, const uint8_t *old, size_t old_len,
     const uint8_t *new_code, size_t new_len, bool force, struct spc_events *ev);
