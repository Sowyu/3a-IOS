 {
 	(void)arg;
-	if (random_buf(buf, n) != 0) {
-		memset(buf, 0, n);      /* the store refuses an all-zero id, so a failed RNG makes no context */
-	}
+	read_random(buf, (unsigned int)n);
 }
 
