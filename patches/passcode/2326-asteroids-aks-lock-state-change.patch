diff --git a/bsd/dev/SweetPasscode.c b/bsd/dev/SweetPasscode.c
--- a/bsd/dev/SweetPasscode.c
+++ b/bsd/dev/SweetPasscode.c
@@ -902,6 +902,18 @@
 	if (l->unlocked) {
 		l->unlocked = false;
 		ev->on[SPC_EV_LOCKED] = true;
+		/*
+		 * 2326: and it must tell SpringBoard that the lock state moved, not just that a lock happened. A lock left
+		 * -[SBFUserAuthenticationController _authState] at Revoking (2), and in that state -isAuthenticated answers
+		 * from the grace-period assertion instead of the lock state, so the lock screen believed the session was
+		 * still open and presented no keypad (ast266). Only AKSEvent 1 runs -_queue_handleKeybagStatusChanged, and
+		 * only 0xd00d is that event, so the lock raises SPC_EV_UNLOCKED as well. It means "the lock state changed,
+		 * re-read it" here, not "a session is open"; every consumer re-reads the kernel's own answer.
+		 *
+		 * Only on a real transition: a second lock while already locked says nothing, or every selector 8/32/13
+		 * call would post a status change for a state that has not moved.
+		 */
+		ev->on[SPC_EV_UNLOCKED] = true;
 	}
 }
 
