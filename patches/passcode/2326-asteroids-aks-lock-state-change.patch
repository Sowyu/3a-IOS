     const uint8_t *new_code, size_t new_len, bool force, struct spc_events *ev);
 
-/* Lock the session. Does nothing when no code is set: there is nothing to unlock against. */
+/* Lock the session. Does nothing when no code is set: there is nothing to unlock against.
+ *
+ * 2326: a lock that actually happens also raises SPC_EV_UNLOCKED, the event whose handler re-reads the lock state
+ * (AKSEvent 1, which only 0xd00d produces). 2325's set and 2325b's turn-off had both learned that lesson; a lock had
+ * not, so SpringBoard stayed in its Revoking state and answered isAuthenticated from a grace-period assertion for the
+ * whole boot. The lock state itself was always right; only the announcement was missing.
+ */
 void spc_lock_now_locked(struct spc_lock *l, struct spc_events *ev);
 
 /* The DER device-state fields, filled from the lock. */
