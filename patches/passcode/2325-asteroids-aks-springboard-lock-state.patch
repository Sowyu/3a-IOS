diff --git a/bsd/dev/SweetPasscode.c b/bsd/dev/SweetPasscode.c
--- a/bsd/dev/SweetPasscode.c
+++ b/bsd/dev/SweetPasscode.c
@@ -866,9 +866,15 @@
 	/*
 	 * Whoever just set or changed the code is holding the phone and proved they may. Leaving the session locked
 	 * would make `sls` read 1 on a phone that is open in their hand, and the lock screen would appear from nowhere.
-	 */
-	if (l->have_code) {
+	 *
+	 * 2325: and it must tell SpringBoard so. A real keystore's lock state changes at this point, and every
+	 * SBFMobileKeyBag client (SpringBoard, Preferences, LocalAuthentication) refreshes its cached has-passcode byte
+	 * from a MobileKeyBag "unlocked" event, so the set reports unlocked as well as "passcode changed". Without the
+	 * unlocked half the byte stays 0 and the lock screen never asks for the code (ast253).
+	 */
+	if (l->have_code && !l->unlocked) {
 		l->unlocked = true;
+		ev->on[SPC_EV_UNLOCKED] = true;
 	}
 	ev->on[SPC_EV_PASSCODE_CHANGED] = true;
 	return SPC_TRY_OK;
