+static const char *
+pc_try_name(enum spc_try r)
+{
+	switch (r) {
+	case SPC_TRY_OK:           return "ok";
+	case SPC_TRY_WRONG:        return "wrong";
+	case SPC_TRY_BACKOFF:      return "backoff";
+	case SPC_TRY_NOTHING_SET:  return "nothing-set";
+	case SPC_TRY_NEED_OLD:     return "need-old";
+	case SPC_TRY_BAD_ARGUMENT: return "bad-arg";
+	case SPC_TRY_WRITE_FAILED: return "write-failed";
+	}
+	return "?";
+}
+
+/* Run one core operation under the mutex and send whatever it asked for, outside the mutex. */
+static enum spc_try
+pc_do(int op, const uint8_t *a, size_t alen, const uint8_t *b, size_t blen, bool force)
+{
+	struct spc_events ev;
+	enum spc_try r;
+
+	memset(&ev, 0, sizeof(ev));
+	lck_mtx_lock(&sweet_pc_mtx);
+	if (op == 1 && force) {
+		/*
+		 * A forced set is selector 5: "turn it on", which must not replace or clear a live code. Tested here, inside
+		 * the same lock as the write, so two privileged callers cannot both see "no code" and both write.
+		 */
+		(void)spc_lock_have_code(&sweet_pc);
+		if (!sweet_pc.loaded) {
+			lck_mtx_unlock(&sweet_pc_mtx);
+			return SPC_TRY_WRITE_FAILED;    /* state unknown: refuse rather than overwrite */
+		}
+		if (sweet_pc.have_code) {
+			lck_mtx_unlock(&sweet_pc_mtx);
+			return SPC_TRY_NEED_OLD;
+		}
+	}
+	switch (op) {
+	case 0:
+		r = spc_lock_verify(&sweet_pc, a, alen, &ev);
+		break;
+	case 1:
+		r = spc_lock_set(&sweet_pc, a, alen, b, blen, force, &ev);
+		break;
+	default:
+		spc_lock_now_locked(&sweet_pc, &ev);
+		r = SPC_TRY_OK;
+		break;
+	}
+	uint32_t sfa = spc_lock_failed(&sweet_pc);
+	uint32_t sb = spc_lock_wait(&sweet_pc);
+	lck_mtx_unlock(&sweet_pc_mtx);
+	pc_send_events(pc_events_to_bits(&ev));
+	/*
+	 * The test boot has to tell a wrong code from a refusal, and both map to kIOReturnNotPermitted. This line says
+	 * which, with the count and the wait, and never anything about the code itself.
+	 */
+	IOLog("SWEET AKS: %s -> %s, sfa %u, sb %u\n",
+	    op == 0 ? "verify" : op == 1 ? "set" : "lock", pc_try_name(r), sfa, sb);
+	return r;
+}
