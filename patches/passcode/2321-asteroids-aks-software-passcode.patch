+	 * "no passcode". Say plainly what happened, because a half-cleared file is exactly the state a recovery boot
+	 * must not leave behind. Never claim success that was not achieved.
+	 */
+	if (ok) {
+		printf("SWEET AKS: sweetpasscode=2 clear ok (r=%d), passcode %s\n", (int)r, had ? "gone" : "was already unset");
