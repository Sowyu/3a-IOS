+/* ---- the core's I/O, wired to the same vnode calls the SWEET RTC code uses ---- */
+
+static int
+pc_io_read(void *ctx, const char *path, void *buf, uint32_t len, uint32_t off)
+{
+	vfs_context_t vctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int resid = 0, err;
+
+	(void)ctx;
+	err = vnode_open(path, FREAD | O_NOFOLLOW, 0, VNODE_LOOKUP_NOFOLLOW, &vp, vctx);
+	if (err != 0) {
+		return err;
+	}
+	err = vn_rdwr(UIO_READ, vp, (caddr_t)buf, len, off, UIO_SYSSPACE, IO_NOAUTH,
+	    vfs_context_ucred(vctx), &resid, vfs_context_proc(vctx));
+	(void)vnode_close(vp, FREAD, vctx);
+	if (err == 0 && resid != 0) {
+		err = EIO;                      /* a short read is not a record; the core judges each slot on its own */
+	}
+	return err;
+}
+
+static int
+pc_io_write(void *ctx, const char *path, const void *buf, uint32_t len, uint32_t off)
+{
+	vfs_context_t vctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int resid = 0, err;
+
+	(void)ctx;
+	err = vnode_open(path, O_CREAT | FWRITE | O_NOFOLLOW, S_IRUSR | S_IWUSR, VNODE_LOOKUP_NOFOLLOW, &vp, vctx);
+	if (err != 0) {
+		return err;
+	}
+	err = vn_rdwr(UIO_WRITE, vp, (caddr_t)buf, len, off, UIO_SYSSPACE, IO_NOAUTH | IO_SYNC | IO_UNIT,
+	    vfs_context_ucred(vctx), &resid, vfs_context_proc(vctx));
+	if (err == 0 && resid != 0) {
+		err = EIO;
+	}
+	if (err == 0) {
+		err = VNOP_FSYNC(vp, MNT_WAIT, vctx);
+	}
+	int cerr = vnode_close(vp, FWRITE, vctx);
+	return err ? err : cerr;
+}
+
+static void
+pc_io_clock(void *ctx, uint64_t *wall_sec, uint64_t *mono_ms)
+{
+	clock_sec_t secs = 0;
+	clock_usec_t usec = 0;
+	uint64_t abs = 0, ns = 0;
+
+	(void)ctx;
+	clock_get_calendar_microtime(&secs, &usec);
+	clock_get_uptime(&abs);
+	absolutetime_to_nanoseconds(abs, &ns);
+	*wall_sec = (uint64_t)secs;
+	*mono_ms = ns / 1000000ull;
+}
