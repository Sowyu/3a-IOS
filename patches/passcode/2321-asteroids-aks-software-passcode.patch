+ */
+
+static void
+pc_clear_for_boot(void)
+{
+	struct spc_events ev;
+	uint8_t none = 0;
+
+	lck_mtx_lock(&sweet_pc_mtx);
+	if (sweet_pc_clear_done) {
+		lck_mtx_unlock(&sweet_pc_mtx);
+		return;
+	}
+	memset(&ev, 0, sizeof(ev));
+	enum spc_try r = SPC_TRY_OK;
+	/*
+	 * `spc_lock_have_code()` loads on demand and returns false for a read error that is not ENOENT or a short read,
+	 * so false does not mean "there is no code": it can mean "the volume is not ready yet". The first version
+	 * latched `done` on that and logged "passcode gone" for a phone that still had one (finding 1 of
+	 * audit-delta-report-2.md). Only latch once the load actually happened; otherwise leave it for the next
+	 * selector, which runs a moment later with the volume up.
+	 */
+	/* Load first: `loaded` says whether the disk answered, not whether a caller happened to have asked yet. */
+	(void)spc_lock_have_code(&sweet_pc);
+	if (!sweet_pc.loaded) {
+		lck_mtx_unlock(&sweet_pc_mtx);
+		printf("SWEET AKS: sweetpasscode=2 clear NOT DONE yet: the passcode files are not readable, retrying\n");
+		return;
+	}
+	bool had = spc_lock_have_code(&sweet_pc);
+	if (had) {
+		r = spc_lock_set(&sweet_pc, NULL, 0, &none, 0, true, &ev);
+	}
+	bool still = spc_lock_have_code(&sweet_pc);
+	/* The clear only counts as done when the code is really gone and the write said so. */
+	bool ok = !still && r == SPC_TRY_OK;
+	if (ok) {
