+/* ---- notifications ---- */
+
+static void
+pc_send_events(uint32_t bits)
+{
+	static const struct {
+		int      ev;
+		uint32_t msg;
+	} map[] = {
+		{ SPC_EV_LOCKED, SWEET_AKS_MSG_LOCKED },
+		{ SPC_EV_UNLOCKED, SWEET_AKS_MSG_UNLOCKED },
+		{ SPC_EV_FIRST_UNLOCK, SWEET_AKS_MSG_FIRST_UNLOCK },
+		{ SPC_EV_PASSCODE_CHANGED, SWEET_AKS_MSG_PASSCODE_CHANGED },
+		{ SPC_EV_ATTEMPTS_FAILED, SWEET_AKS_MSG_ATTEMPTS_FAILED },
+		{ SPC_EV_BACKOFF_STARTED, SWEET_AKS_MSG_BACKOFF_STARTED },
+	};
+
+	if (gSweetAKS == NULL) {
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(map) / sizeof(map[0]); i++) {
+		if (bits & (1u << map[i].ev)) {
+			gSweetAKS->sendLockMsg(map[i].msg);
+		}
+	}
+}
+
+static uint32_t
+pc_events_to_bits(const struct spc_events *ev)
+{
+	uint32_t bits = 0;
+	for (int i = 0; i < SPC_EV_COUNT; i++) {
+		if (ev->on[i]) {
+			bits |= (1u << i);
+		}
+	}
+	return bits;
+}
