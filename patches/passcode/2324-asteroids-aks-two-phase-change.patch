+/* True when `owner` staged a change whose temporary handle is `handle`. */
+static bool
+sweet_aks_stage_is(const void *owner, uint64_t handle)
+{
+	lck_mtx_lock(&sweet_pc_mtx);
+	bool yes = sweet_stage.owner != NULL && sweet_stage.owner == owner && sweet_stage.handle == handle;
+	lck_mtx_unlock(&sweet_pc_mtx);
+	return yes;
+}
+
+/* Wipe `owner`'s stage: the one for `handle`, or any when `any_handle`. Someone else's stage is left alone. */
+static void
+sweet_aks_stage_drop(const void *owner, bool any_handle, uint64_t handle)
+{
+	bool dropped = false;
+
+	lck_mtx_lock(&sweet_pc_mtx);
+	if (sweet_stage.owner != NULL && sweet_stage.owner == owner && (any_handle || sweet_stage.handle == handle)) {
+		spc_wipe(&sweet_stage, sizeof(sweet_stage));
+		dropped = true;
+	}
+	lck_mtx_unlock(&sweet_pc_mtx);
+	if (dropped) {
+		printf("SWEET AKS: staged change dropped, nothing was set\n");
+	}
+}
