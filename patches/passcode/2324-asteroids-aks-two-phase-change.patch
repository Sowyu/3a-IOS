+/*
+ * Selector 3, save_bag, for a staged temporary bag: { handle }, the blob in the output structure (libaks offers 0x8000,
+ * so it arrives as a descriptor). keybagd stores it as KeyBagKeys in /private/var/keybags/systembag.kb, which at boot is
+ * only opened for BackupKeyBagKeys because selector 14 answers with a handle. Any other handle is Unsupported, as
+ * before, so no other keybagd path starts writing that file.
+ */
+static IOReturn
+sweet_aks_save_bag(IOExternalMethodArguments *args, const void *owner)
+{
+	args->scalarOutputCount = 0;
+	if (args->scalarInputCount < 1 || !sweet_aks_stage_is(owner, args->scalarInput[0])) {
+		return kIOReturnUnsupported;
+	}
+	return sweet_aks_struct_out(args, SWEET_AKS_BAG_BLOB, (uint32_t)(sizeof(SWEET_AKS_BAG_BLOB) - 1));
+}
+
+/*
+ * Selector 5 for the staged temporary bag: { temp, device handle, new ptr, new len, acm }. The commit. Every 2321 rule
+ * applies as it did at selector 15: the entitlement, the state known, the old code proven by the core (counted before
+ * it is hashed) whenever one is live, never forced over a live code. On top, the code keybagd commits must be the one it
+ * staged. The stage is consumed whatever the outcome.
+ */
+static IOReturn
+sweet_aks_commit(IOExternalMethodArguments *args, const void *owner)
+{
+	struct sweet_aks_stage st;
+	uint8_t check[SPC_SECRET_MAX];
+	size_t check_len = 0;
+	enum spc_try r;
+	bool changed = false;
+	IOReturn ret = kIOReturnSuccess;
+
+	if (!sweet_aks_may_change()) {
+		printf("SWEET AKS: commit refused, no %s\n", SWEET_AKS_CHANGE_ENTITLEMENT);
+		return kIOReturnNotPermitted;
+	}
+	if (args->scalarInputCount < 5) {
+		return kIOReturnBadArgument;
+	}
+	lck_mtx_lock(&sweet_pc_mtx);
+	if (sweet_stage.owner == NULL || sweet_stage.owner != owner || sweet_stage.handle != args->scalarInput[0]) {
+		lck_mtx_unlock(&sweet_pc_mtx);
+		return kIOReturnNotFound;       /* staged elsewhere, dropped or replaced since the caller looked */
+	}
+	memcpy(&st, &sweet_stage, sizeof(st));
+	spc_wipe(&sweet_stage, sizeof(sweet_stage));
+	lck_mtx_unlock(&sweet_pc_mtx);
+
+	bool acm = (args->scalarInput[4] & SWEET_AKS_SET_ACM) != 0;
+	if (args->scalarInput[1] != SWEET_AKS_SYSTEM_HANDLE || acm != st.acm) {
+		printf("SWEET AKS: commit refused, not the device bag, or ids where codes were staged or the reverse\n");
+		ret = kIOReturnBadArgument;
+		goto out;
+	}
+	/* The new code again, read the way it was staged. An empty one is a removal and must have been staged as one. */
+	if (args->scalarInput[3] != 0 &&
+	    !sweet_aks_copy_secret(acm, args->scalarInput[2], args->scalarInput[3], check, sizeof(check), &check_len)) {
+		printf("SWEET AKS: commit refused, the new passcode did not resolve\n");
+		ret = kIOReturnBadArgument;
+		goto out;
+	}
+	if (check_len != st.new_len || (check_len != 0 && !spc_equal(check, st.new_code, check_len))) {
+		printf("SWEET AKS: commit refused, the new passcode is not the one staged\n");
+		ret = kIOReturnBadArgument;
+		goto out;
+	}
+	if (sweet_aks_state_unknown()) {
+		printf("SWEET AKS: commit refused, passcode state unknown\n");
+		ret = kIOReturnNotReady;
+		goto out;
+	}
+	{
+		/* Live is decided now, not at stage time: a code set in between must be proven like any other. */
+		bool live = !sweet_aks_no_code();
+		if (live && !st.had_old) {
+			printf("SWEET AKS: commit refused, a passcode is live and no old passcode was staged\n");
+			ret = kIOReturnNotPermitted;
+			goto out;
+		}
+		r = pc_do(1, live ? st.old_code : NULL, live ? st.old_len : 0, st.new_code, st.new_len, !live);
+		ret = sweet_aks_try_to_ret(r, &changed);
+		printf("SWEET AKS: commit %s\n", changed ? "done, the new passcode is live" : "refused by the lock");
+	}
+out:
+	spc_wipe(&st, sizeof(st));
+	spc_wipe(check, sizeof(check));
+	return ret;
 }
 
