+struct sweet_aks_stage {
+	const void *owner;                      /* the staging AppleKeyStoreUserClient; NULL: no stage */
+	uint64_t    handle;                     /* the temporary bag handle selector 15 returned */
+	bool        acm;                        /* the codes came from ACM ids */
+	bool        had_old;                    /* a code was live at stage time, so an old code was copied */
+	size_t      old_len, new_len;
+	uint8_t     old_code[SPC_SECRET_MAX], new_code[SPC_SECRET_MAX];
+};
+static struct sweet_aks_stage sweet_stage;
+static uint32_t sweet_stage_last;               /* the last temporary handle issued; never 0 (the device bag) or -1 */
+
