+
+/*
+ * 2142: copy mode (ast, not fEarly). Apple's display answers SwapWait(N) once swap N is on the glass and the surface of N-1
+ * has been handed back, and CoreAnimation renders the next frame into that surface as soon as it gets the answer. Here
+ * the panel scans the kernel's own slots, so a surface is handed back when its copy ends (2120), when a newer swap drops
+ * it, or (sweetfb_keep, 2082) when the frame kept for the next tick is shown or replaced. Answering at once while an older
+ * surface was still held let CoreAnimation draw into it, and the bgmtl hold-wait gave up after 50 ms into a black bar.
+ * Held and older than `id`: the kept frame (fPrev) or the one present() is copying.
+ */
+bool
+AppleCLCD::astOlderHeld(uint32_t id)
+{
+	bool held = false;
+	IOLockLock(fLock);
+	if (fPrevValid && (int32_t)(get32(fPrev, 0x50) - id) < 0) {
+		held = true;
+	}
+	IOLockUnlock(fLock);
+	SweetSurface **copying = __atomic_load_n(&fCopyHold, __ATOMIC_ACQUIRE);  /* its entries go NULL when the copy ends (2120), before the latch wait */
+	if (copying != NULL && (int32_t)(__atomic_load_n(&fCurSwapID, __ATOMIC_ACQUIRE) - id) < 0) {
+		for (uint32_t i = 0; i < 4; i++) {
+			if (__atomic_load_n(&copying[i], __ATOMIC_ACQUIRE) != NULL) {
+				held = true;
+			}
+		}
+	}
+	return held;
 }
 
 IOReturn
 AppleCLCD::swapWaitInner(uint32_t id)
 {
+	if (fAstWait && ast.enabled && !fPowerOff && id != 0) {
+		if ((int32_t)(id - __atomic_load_n(&fSwapNewest, __ATOMIC_ACQUIRE)) > 0 || !astOlderHeld(id)) {
+			return kIOReturnSuccess;
+		}
+		uint64_t t0 = mach_absolute_time(), limit, now;
+		nanoseconds_to_absolutetime((uint64_t)fVsyncUS * 1500, &limit);        /* 1.5 frames, then "pending": CoreAnimation asks again */
+		do {
+			delay_for_interval(250, NSEC_PER_USEC);
+			now = mach_absolute_time();
+		} while (astOlderHeld(id) && now - t0 <= limit);
+		ast.waitN++;
+		ast.waitAbs += now - t0;
+		if (now - t0 > ast.waitMaxAbs) {
+			ast.waitMaxAbs = now - t0;
+		}
+		if (now - t0 > limit) {
+			ast.waitBusy++;
+			return kIOReturnBusy;   /* 0221: kIOReturnBusy is "pending" to CoreAnimation's poll, anything else non-zero "complete" */
+		}
+		return kIOReturnSuccess;
+	}
 	if (!fSwapSync || !fEarly || fPowerOff || id == 0 || fSwapTimer == NULL) {
 		return kIOReturnSuccess;
 	}
