+/* 2141: who uses the GPU when. A ring of submissions (G: time, pid, fence, commands) and fence waits that returned (W: the time
+ * the wait began, the time it returned, pid, fence, result), printed after the display trace in kern.sweet_fb_trace in absolute
+ * microseconds. Relaxed stores, racy reads: a diagnostic. */
+#define SWEET_GPU_TRACE_N 512
+static struct { uint64_t t, t0; uint32_t pid, fence; uint8_t kind, arg; } gGpuTrace[SWEET_GPU_TRACE_N];
+static uint32_t gGpuTraceI;
+static void
+gpuTrace(uint8_t kind, uint64_t t0, uint32_t pid, uint32_t fence, uint8_t arg)
+{
+	uint32_t j = __atomic_fetch_add(&gGpuTraceI, 1, __ATOMIC_RELAXED) & (SWEET_GPU_TRACE_N - 1);
+	gGpuTrace[j].t = 0;
+	gGpuTrace[j].t0 = t0;
+	gGpuTrace[j].pid = pid;
+	gGpuTrace[j].fence = fence;
+	gGpuTrace[j].kind = kind;
+	gGpuTrace[j].arg = arg;
+	__atomic_store_n(&gGpuTrace[j].t, mach_absolute_time(), __ATOMIC_RELEASE);
+}
+extern "C" size_t sweet_gpu_trace_text(char *buf, size_t cap);
+size_t
+sweet_gpu_trace_text(char *buf, size_t cap)
+{
+	size_t n = 0;
+	uint32_t ti = __atomic_load_n(&gGpuTraceI, __ATOMIC_RELAXED);
+	for (uint32_t k = 0; k < SWEET_GPU_TRACE_N && n + 64 < cap; k++) {
+		uint32_t j = (ti + k) & (SWEET_GPU_TRACE_N - 1);
+		uint64_t t = __atomic_load_n(&gGpuTrace[j].t, __ATOMIC_ACQUIRE), a, b = 0;
+		if (t == 0) {
+			continue;
+		}
+		absolutetime_to_nanoseconds(t, &a);
+		if (gGpuTrace[j].t0) {
+			absolutetime_to_nanoseconds(gGpuTrace[j].t0, &b);
+		}
+		n += (size_t)snprintf(buf + n, cap - n, "%c %llu %llu %u %u %u\n", gGpuTrace[j].kind, a / 1000, b / 1000, gGpuTrace[j].pid,
+		    gGpuTrace[j].fence, gGpuTrace[j].arg);
+	}
+	return n;
+}
