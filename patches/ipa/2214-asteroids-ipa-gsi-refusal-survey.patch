     IpaGsiIo io={0,ipa_gread,ipa_gwrite,ipa_gsync,ipa_gwait};
-    if(!ipa_gsi_available(io))return EBUSY;
+    if(!ipa_gsi_available(io)){ipa_hardware_refusal();return EBUSY;}
     if(!ipa_hconfig(0xc00c,0,~0u) || !ipa_hconfig(0x2c,ipa_hr(0x2c)|(1u<<7)|(1u<<8),~0u) ||
