         }
         printf("SWEET IPA: SID=%#x matches=%u\n",sid,matches);
     }
+    bool used[256]={0};
+    for(unsigned i=0;i<count;i++){
+        uint32_t smr=m_rd(smmu,0x800+4*i),s2=m_rd(smmu,0xc00+4*i);
+        if((smr>>31) && ((s2>>16)&3)==0 && (s2&255)<banks)used[s2&255]=true;
+    }
+    for(unsigned i=0;i<banks;i++){
+        unsigned b=(unsigned)(cbbase+((uint64_t)i<<shift));
+        printf("SWEET IPA: CBsurvey bank=%u referenced=%u SCTLR=%#x TTBR0=%#x:%#x TTBR1=%#x:%#x FSR=%#x CBAR=%#x CBA2R=%#x read_only=1\n",
+            i,used[i],m_rd(smmu,b),m_rd(smmu,b+0x24),m_rd(smmu,b+0x20),m_rd(smmu,b+0x2c),m_rd(smmu,b+0x28),m_rd(smmu,b+0x58),m_rd(smmu,0x1000+4*i),m_rd(smmu,0x1800+4*i));
+    }
+    vm_offset_t smem=ml_io_map(M_SMEM,M_SM_SIZE);if(!smem)return ENOMEM;
+    QcomSmem shared={(volatile uint8_t *)smem,M_SM_SIZE};QcomSmemPartition part={0};
+    int part_rc=qcom_smem_partition(&shared,0,1,&part);uint32_t item=0,bytes=0;
+    int item_rc=part_rc?part_rc:qcom_smem_find(&shared,&part,497,&item,&bytes);
+    printf("SWEET IPA: SMEMsurvey partition_result=%d offset=%#x size=%#x uncached=%#x cached=%#x item497_result=%d offset=%#x bytes=%#x read_only=1\n",
+        part_rc,part.offset,part.size,part_rc?0:qcom_smem_read32(&shared,part.offset+12),part_rc?0:qcom_smem_read32(&shared,part.offset+16),item_rc,item,bytes);
     printf("SWEET IPA: preflight complete; no IPA/GSI register access or SMMU writes\n");sweet_log_sync();return 0;
 }
