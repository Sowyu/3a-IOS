@@ -98,6 +107,8 @@
         io->write64(c,b+0x28,(uint64_t)p->saved[7]|(uint64_t)p->saved[8]<<32);
         for(unsigned j=1;j<=6;j++)if(j!=2 && j!=3)io->write(c,b+ipa_mmu_regs[j],p->saved[j]);
         io->write(c,0x1800+4*p->bank,p->cba2r);io->write(c,0x1000+4*p->bank,p->cbar);
+        /* Restore the saved disabled control after tables and format. */
