diff --git a/bsd/dev/modem/IpaMmio.h b/bsd/dev/modem/IpaMmio.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/modem/IpaMmio.h
@@ -0,0 +1,26 @@
+#ifndef IPA_MMIO_H
+#define IPA_MMIO_H
+#include <stdint.h>
+/* Gunyah emulates APPS SMMU accesses. It rejects load/store writeback forms.
+ * Keep the access instruction explicit, as the measured touch driver does. */
+#ifdef IPA_HOST_TEST
+#define ipa_mmio_read32(base,off) m_rd((base),(off))
+#define ipa_mmio_write32(base,off,value) m_wr((base),(off),(value))
+#define ipa_mmio_write64(base,off,value) (*(volatile uint64_t *)((base)+(off))=(value))
+#else
+static inline uint32_t ipa_mmio_read32(uintptr_t base,unsigned off){
+    uint32_t value;__asm__ volatile("ldr %w0, [%1]":"=r"(value):"r"(base+off):"memory");
+    __asm__ volatile("dmb sy":::"memory");return value;
+}
+static inline void ipa_mmio_write32(uintptr_t base,unsigned off,uint32_t value){
+    __asm__ volatile("dmb sy":::"memory");
+    __asm__ volatile("str %w0, [%1]"::"r"(value),"r"(base+off):"memory");
+    __asm__ volatile("dsb sy":::"memory");
+}
+static inline void ipa_mmio_write64(uintptr_t base,unsigned off,uint64_t value){
+    __asm__ volatile("dmb sy":::"memory");
+    __asm__ volatile("str %0, [%1]"::"r"(value),"r"(base+off):"memory");
+    __asm__ volatile("dsb sy":::"memory");
+}
+#endif
+#endif
