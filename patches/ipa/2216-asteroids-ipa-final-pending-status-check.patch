      * Recheck the whole idle EE after masking output. Never clear pending
      * status or ERROR_LOG_CLR. No channel/event allocation has happened yet. */
     if(!ipa_gsi_available(io)){s->failed=true;return false;}
+    /* Context reads can span a newly latched fault. Sample pending status
