     if(io->read(c,0x20)!=0x4c017e72 || io->read(c,0x24)!=0x60000048 || io->read(c,0x28)!=0x5111)return false;
+    if(io->read(c,0)&(1u<<3))return false; /* Extended StreamIDs need a separate allocator. */
     bool used[72]={0};unsigned slots[2],ns=0;
