diff --git a/bsd/dev/modem/IpaMmu.h b/bsd/dev/modem/IpaMmu.h
--- a/bsd/dev/modem/IpaMmu.h
+++ b/bsd/dev/modem/IpaMmu.h
@@ -28,6 +28,7 @@
     IpaMmuIo *io=&s->io;void *c=io->ctx;
