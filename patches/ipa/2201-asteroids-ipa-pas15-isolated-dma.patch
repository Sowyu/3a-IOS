+}
+static int ipa_pas(unsigned cmd,uint32_t info,uint64_t a,uint64_t b){
+    uint64_t result=~0ull;int rc=m_scm(qcom_scm_fn(2,cmd),info,15,a,b,0,&result);
+    printf("SWEET IPA: PAS15 cmd=%u status=%d result=%lld\n",cmd,rc,(long long)result);sweet_log_sync();
+    return rc?rc:(int)result;
+}
+static int ipa_memory_prepare(void){
+    int rc=ipa_alloc(&ipa.dma,&ipa.dma_pa,IPA_DMA_BYTES+2*PAGE_SIZE);if(rc)return rc;
+    memset((void *)ipa.dma,0xa5,PAGE_SIZE);memset((void *)(ipa.dma+PAGE_SIZE+IPA_DMA_BYTES),0x5a,PAGE_SIZE);
+    for(unsigned i=0;i<2;i++){rc=ipa_alloc(&ipa.pt[i],&ipa.pt_pa[i],IPA_PT_BYTES);if(rc)return rc;}
+    if(m_alloc(497,0xb000,&ipa.smem_off))return EIO;
+    uint32_t actual=0;if(m_item(497,0xb000,&ipa.smem_off,&actual) || actual!=0xb000)return EINVAL;
+    ipa.smem_bytes=actual;
+    IpaPageTable pt[2];
+    for(unsigned i=0;i<2;i++)if(ipa_pt_init(&pt[i],(uint64_t *)ipa.pt[i],ipa.pt_pa[i]))return EINVAL;
+    if(ipa_pt_map(&pt[0],IPA_DMA_IOVA,ipa.dma_pa+PAGE_SIZE,IPA_DMA_BYTES))return EINVAL;
+    if(ipa_pt_map_attr(&pt[0],0x14683000,0x14683000,0x2000,1))return EINVAL;
+    uint64_t shared=M_SMEM+ipa.smem_off,low=shared&~4095ull,high=(shared+actual+4095)&~4095ull;
+    if(low<M_SMEM || high>M_SMEM+M_SM_SIZE || ipa_pt_map(&pt[0],low,low,(size_t)(high-low)))return EINVAL;
+    /* uC has its own empty domain. No optional WLAN/uC feature buffers exist. */
+    sweet_dma_sync_va((void *)ipa.dma,IPA_DMA_BYTES+2*PAGE_SIZE);
+    for(unsigned i=0;i<2;i++)sweet_dma_sync_va((void *)ipa.pt[i],IPA_PT_BYTES);
+    ipa.smmu=ml_io_map_unmappable(0x15000000,0x100000,VM_WIMG_IO);if(!ipa.smmu)return ENOMEM;
+    ipa.mmu.io=(IpaMmuIo){0,ipa_mread,ipa_mwrite,ipa_mwrite64,ipa_mdelay};
+    if(!sweet_apps_smmu_claim())return EBUSY;
+    ipa.mmu_attempted=true;bool ok=ipa_mmu_install(&ipa.mmu,ipa.pt_pa);sweet_apps_smmu_release();
+    if(!ok)return EIO;
+    printf("SWEET IPA: isolated SIDs AP=%#x CB=%u SMR=%u uC=%#x CB=%u SMR=%u DMA=%#llx SMEM=%#llx\n",0x4a0,ipa.mmu.context[0].bank,ipa.mmu.context[0].slot,0x4a2,ipa.mmu.context[1].bank,ipa.mmu.context[1].slot,(unsigned long long)ipa.dma_pa+PAGE_SIZE,(unsigned long long)shared);
+    sweet_log_sync();return 0;
+}
+static int ipa_load_firmware(const struct wl_fat *f){
+    uint32_t cl,size;int rc=fat_open(f,"image/ipa_fws.mdt",&cl,&size);if(rc)return rc;
+    if(size<52 || size>IPA_FW_METADATA_MAX)return EINVAL;
+    rc=ipa_alloc(&ipa.metadata,&ipa.metadata_pa,IPA_FW_METADATA_MAX);if(rc)return rc;
+    if((rc=fat_read_chain(f,cl,0,(void *)ipa.metadata,size)))return rc;
+    IpaFirmware fw;if(ipa_firmware_parse((void *)ipa.metadata,size,&fw))return EINVAL;
+    /* Validate every split before PAS init or writing the reservation. */
+    for(unsigned i=0;i<fw.count;i++){
+        IpaLoad *p=&fw.loads[i];if(!p->file_bytes)continue;char name[32];uint32_t actual;uint8_t last;
+        snprintf(name,sizeof(name),"image/ipa_fws.b%02u",p->index);
+        if(fat_open(f,name,&cl,&actual) || actual!=p->file_bytes || fat_read_chain(f,cl,actual-1,&last,1))return EIO;
+    }
+    uint64_t supported=0;rc=m_scm(qcom_scm_fn(2,7),1,15,0,0,0,&supported);if(rc || supported!=1)return ENOTSUP;
+    sweet_dma_sync_va((void *)ipa.metadata,IPA_FW_METADATA_MAX);
+    ipa.pas_owed=true;
+    if((rc=ipa_pas(1,qcom_scm_args(2,0,2,0),ipa.metadata_pa,0)))return rc;
+    if((rc=ipa_pas(2,qcom_scm_args(3,0,0,0),IPA_FW_BASE,fw.span)))return rc;
+    /* Map a full CPU page range but write only the DT's 0xa000 reservation. */
+    ipa.firmware=ml_io_map_unmappable(IPA_FW_BASE,IPA_FW_SIZE,VM_WIMG_WCOMB);if(!ipa.firmware)return ENOMEM;
+    for(unsigned i=0;i<fw.count;i++){
+        IpaLoad *p=&fw.loads[i];char name[32];uint32_t actual;
+        if(p->file_bytes){snprintf(name,sizeof(name),"image/ipa_fws.b%02u",p->index);
+            if(fat_open(f,name,&cl,&actual) || actual!=p->file_bytes)return EIO;
+            if((rc=fat_read_chain(f,cl,0,(void *)(ipa.firmware+p->offset),p->file_bytes)))return rc;}
+        if(p->memory_bytes>p->file_bytes)memset((void *)(ipa.firmware+p->offset+p->file_bytes),0,p->memory_bytes-p->file_bytes);
+    }
+    IPA_BARRIER();
+    if((rc=ipa_pas(5,1,0,0)))return rc;ipa.started=true;return 0;
+}
+static int ipa_prepare(const struct wl_fat *f){
+    int rc=ipa_vote_extra();if(rc)return rc;
+    if((rc=ipa_memory_prepare()))return rc;
+    if((rc=ipa_load_firmware(f)))return rc;
+    ipa.block=ml_io_map_unmappable(0x3e00000,0x200000,VM_WIMG_IO);if(!ipa.block)return ENOMEM;
+    printf("SWEET IPA: powered read-only flavor=%#x shared_mem=%#x GSI_status=%#x param2=%#x param4=%#x\n",
+        m_rd(ipa.block,0x140000),m_rd(ipa.block,0x140040),m_rd(ipa.block,0x4000+0x25000),m_rd(ipa.block,0x4000+0x25040),m_rd(ipa.block,0x4000+0x25050));
+    sweet_log_sync();return 0;
+}
+static bool ipa_cleanup(bool modem_stopped){
+    if(!ipa.enabled)return true;
+    if(!modem_stopped){ipa.retained=true;goto retain;}
+    if(ipa.pas_owed){
+        int rc=EIO;for(unsigned n=0;n<4;n++){rc=ipa_pas(6,1,0,0);if(!rc)break;m_sleep(100);}
+        if(rc){ipa.retained=true;goto retain;}ipa.pas_owed=false;ipa.started=false;
+    }
+    if(ipa.retained || ipa.mmu.retained)goto retain;
+    if(ipa.mmu_attempted){
+        if(!sweet_apps_smmu_claim()){ipa.retained=true;goto retain;}
+        bool ok=ipa_mmu_restore(&ipa.mmu,true);sweet_apps_smmu_release();if(!ok)goto retain;
+    }
+    if(ipa.dma){sweet_dma_sync_va((void *)ipa.dma,IPA_DMA_BYTES+2*PAGE_SIZE);
+        for(unsigned i=0;i<PAGE_SIZE;i++)if(*(uint8_t *)(ipa.dma+i)!=0xa5 || *(uint8_t *)(ipa.dma+PAGE_SIZE+IPA_DMA_BYTES+i)!=0x5a){ipa.retained=true;goto retain;}}
+    if(ipa.block)ml_io_unmap(ipa.block,0x200000);
+    if(ipa.firmware)ml_io_unmap(ipa.firmware,IPA_FW_SIZE);
+    if(ipa.smmu)ml_io_unmap(ipa.smmu,0x100000);
+    if(ipa.metadata)kmem_free(kernel_map,ipa.metadata,IPA_FW_METADATA_MAX);
+    if(ipa.dma)kmem_free(kernel_map,ipa.dma,IPA_DMA_BYTES+2*PAGE_SIZE);
+    for(unsigned i=0;i<2;i++)if(ipa.pt[i])kmem_free(kernel_map,ipa.pt[i],IPA_PT_BYTES);
+    printf("SWEET IPA: PAS15 stopped; DMA guards intact; SMMU restored; backing released; shared power floors pinned=%u\n",ipa.clock_pinned);sweet_log_sync();return true;
+retain:printf("SWEET IPA: cleanup UNVERIFIED; retain memory, mappings and power until reset\n");sweet_log_sync();return false;
+}
