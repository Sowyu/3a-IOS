diff --git a/bsd/dev/modem/IpaSmmu.h b/bsd/dev/modem/IpaSmmu.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/modem/IpaSmmu.h
@@ -0,0 +1,44 @@
+#ifndef IPA_SMMU_H
+#define IPA_SMMU_H
+#include <stdint.h>
+#include <stddef.h>
+#define IPA_PT_PAGE 4096u
+#define IPA_PT_PAGES 16u
+/* One L1, allocated L2/L3 pages. 4 KiB granule, 36-bit IOVA and PA, as measured ID2=0x5111 advertises.
+ * The caller supplies zeroed, physically contiguous tables and synchronizes them
+ * before installing TTBR0. No broad block mappings are emitted. */
+typedef struct {uint64_t *words,physical;unsigned used;} IpaPageTable;
+static inline int ipa_pt_init(IpaPageTable *t,uint64_t *words,uint64_t pa){
+    if(!words || ((uintptr_t)words&7) || (pa&4095) || pa>(1ull<<36)-IPA_PT_PAGES*IPA_PT_PAGE)return -1;
+    t->words=words;t->physical=pa;t->used=1;
+    for(unsigned i=0;i<IPA_PT_PAGES*512;i++)words[i]=0;
+    return 0;
+}
+static inline int ipa_pt_next(IpaPageTable *t,unsigned parent,unsigned index,unsigned *child){
+    uint64_t *e=&t->words[parent*512+index];
+    if(*e){
+        uint64_t pa=*e&0x0000fffffffff000ull;
+        if((*e&3)!=3 || pa<t->physical || pa>=t->physical+(uint64_t)t->used*4096)return -1;
+        *child=(unsigned)((pa-t->physical)/4096);return 0;
+    }
+    if(t->used==IPA_PT_PAGES)return -1;
+    *child=t->used++;*e=(t->physical+(uint64_t)*child*4096)|3;return 0;
+}
+static inline int ipa_pt_map_attr(IpaPageTable *t,uint64_t iova,uint64_t pa,size_t bytes,unsigned attr){
+    if(attr>1)return -1;
+    if(!bytes || ((iova|pa|bytes)&4095) || iova>=(1ull<<36) || bytes>(1ull<<36)-iova ||
+       pa>=(1ull<<36) || bytes>(1ull<<36)-pa)return -1;
+    for(size_t at=0;at<bytes;at+=4096){
+        uint64_t v=iova+at;unsigned l2,l3;
+        if(ipa_pt_next(t,0,(unsigned)(v>>30)&511,&l2) ||
+           ipa_pt_next(t,l2,(unsigned)(v>>21)&511,&l3))return -1;
+        uint64_t *e=&t->words[l3*512+((v>>12)&511)];
+        if(*e)return -1; /* Refuse duplicate/overlapping mappings, even identical. */
+        /* AF, inner-shareable, unprivileged RW, Normal NC attr0, UXN/PXN. */
+        *e=(pa+at)|3|((uint64_t)attr<<2)|(1ull<<10)|(3ull<<8)|(1ull<<6)|(3ull<<53);
+    }
+    return 0;
+}
+static inline int ipa_pt_map(IpaPageTable *t,uint64_t iova,uint64_t pa,size_t bytes){return ipa_pt_map_attr(t,iova,pa,bytes,0);}
+/* A partial mapping failure requires discarding the whole unpublished table. */
+#endif
diff --git a/bsd/dev/modem/IpaMmu.h b/bsd/dev/modem/IpaMmu.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/modem/IpaMmu.h
@@ -0,0 +1,108 @@
+#ifndef IPA_MMU_H
+#define IPA_MMU_H
+#include <stdint.h>
+#include <stdbool.h>
+/* One serialized caller owns APPS stream allocation. No global SMMU control,
+ * global invalidation or implementation-defined registers are written. */
+typedef struct {
+    void *ctx;
+    uint32_t (*read)(void *,unsigned);
+    void (*write)(void *,unsigned,uint32_t);
+    void (*write64)(void *,unsigned,uint64_t);
+    void (*delay)(void *);
+} IpaMmuIo;
+typedef struct {
+    unsigned slot,bank,sid;
+    uint32_t smr,s2cr,cbar,cba2r,saved[9];
+    bool touched,published;
+} IpaMmuContext;
+typedef struct {IpaMmuIo io;IpaMmuContext context[2];bool retained;} IpaMmu;
+static const unsigned ipa_mmu_regs[9]={0,0x10,0x20,0x24,0x30,0x38,0x3c,0x28,0x2c};
+static inline unsigned ipa_cb(unsigned n){return 0x80000+4096*n;}
+static inline bool ipa_mmu_sync(IpaMmu *s,unsigned base){
+    s->io.write(s->io.ctx,base+0x7f0,0);
+    for(unsigned n=0;n<100000;n++){if(!(s->io.read(s->io.ctx,base+0x7f4)&1))return true;s->io.delay(s->io.ctx);}
+    s->retained=true;return false;
+}
+static inline bool ipa_mmu_choose(IpaMmu *s){
+    IpaMmuIo *io=&s->io;void *c=io->ctx;
+    /* Geometry measured in ast159. A different boot firmware is a new probe. */
+    if(io->read(c,0x20)!=0x4c017e72 || io->read(c,0x24)!=0x60000048 || io->read(c,0x28)!=0x5111)return false;
+    bool used[72]={0};unsigned slots[2],ns=0;
+    for(unsigned i=0;i<114;i++){
+        uint32_t smr=io->read(c,0x800+4*i),s2=io->read(c,0xc00+4*i);
+        if(!(smr>>31)){if(ns<2)slots[ns++]=i;continue;}
+        uint32_t mask=(smr>>16)&0x7fff;
+        if(!((smr^0x4a0)&~mask&0x7fff) || !((smr^0x4a2)&~mask&0x7fff))return false;
+        if(((s2>>16)&3)==0){if((s2&255)>=72)return false;used[s2&255]=true;}
+    }
+    if(ns!=2)return false;
+    unsigned nb=0;
+    for(unsigned i=0;i<72 && nb<2;i++){
+        unsigned b=ipa_cb(i);
+        if(used[i] || io->read(c,b) || io->read(c,b+0x20) || io->read(c,b+0x24) || io->read(c,b+0x28) || io->read(c,b+0x2c) || io->read(c,b+0x58))continue;
+        IpaMmuContext *p=&s->context[nb];p->slot=slots[nb];p->bank=i;p->sid=nb?0x4a2:0x4a0;
+        p->smr=io->read(c,0x800+4*p->slot);p->s2cr=io->read(c,0xc00+4*p->slot);
+        p->cbar=io->read(c,0x1000+4*i);p->cba2r=io->read(c,0x1800+4*i);
+        for(unsigned j=0;j<9;j++)p->saved[j]=io->read(c,b+ipa_mmu_regs[j]);nb++;
+    }
+    return nb==2;
+}
+static inline bool ipa_mmu_install(IpaMmu *s,const uint64_t table[2]){
+    IpaMmuIo *io=&s->io;void *c=io->ctx;
+    if(!ipa_mmu_choose(s))return false;
+    for(unsigned n=0;n<2;n++)if((table[n]&4095) || table[n]>(1ull<<36)-0x10000)return false;
+    for(unsigned n=0;n<2;n++){
+        IpaMmuContext *p=&s->context[n];unsigned b=ipa_cb(p->bank);
+        /* Recheck ownership immediately before touching each reserved slot. */
+        if(io->read(c,0x800+4*p->slot)!=p->smr || io->read(c,0xc00+4*p->slot)!=p->s2cr || io->read(c,b)!=p->saved[0])return false;
+        p->touched=true;
+        io->write(c,0x1800+4*p->bank,1); /* 64-bit context */
+        io->write(c,0x1000+4*p->bank,0x1f300); /* stage 1, stage 2 bypass */
+        /* SEP=7, PASIZE=1 (36-bit), 36-bit IOVA, EPD1, noncached walks. */
+        io->write(c,b+0x10,(7u<<15)|1);io->write(c,b+0x30,(1u<<23)|(3u<<12)|28);
+        uint64_t ttbr=table[n]|((uint64_t)(p->bank+1)<<48);
+        io->write64(c,b+0x20,ttbr);io->write64(c,b+0x28,0);
+        io->write(c,b+0x38,0x0444);io->write(c,b+0x3c,0);
+        io->write(c,b+0x618,0);
+        if(!ipa_mmu_sync(s,b))return false;
+        /* Terminate faults, never stall. No IRQ without an installed handler. */
+        uint32_t ctl=1|2|4|0x20|0x1000|(3u<<22);
+        io->write(c,b,ctl);
+        if(io->read(c,b)!=ctl || io->read(c,b+0x20)!=(uint32_t)ttbr || io->read(c,b+0x24)!=(uint32_t)(ttbr>>32) || io->read(c,b+0x30)!=((1u<<23)|(3u<<12)|28) || io->read(c,b+0x10)!=((7u<<15)|1))return false;
+        if(io->read(c,0x1800+4*p->bank)!=1 || io->read(c,0x1000+4*p->bank)!=0x1f300 ||
+           io->read(c,b+0x38)!=0x0444 || io->read(c,b+0x3c) || io->read(c,b+0x28) || io->read(c,b+0x2c))return false;
+        io->write(c,0xc00+4*p->slot,p->bank|(3u<<8));
+        /* Publication last: only exact IPA SID can reach this table. */
+        p->published=true;io->write(c,0x800+4*p->slot,0x80000000u|p->sid);
+        if(io->read(c,0x800+4*p->slot)!=(0x80000000u|p->sid) || io->read(c,0xc00+4*p->slot)!=(p->bank|(3u<<8)))return false;
+    }
+    return true;
+}
+/* Caller must prove both PAS15 and every GSI DMA producer stopped first.
+ * Any failed sync/readback pins page tables and all DMA allocations to reset. */
+static inline bool ipa_mmu_restore(IpaMmu *s,bool stopped){
+    if(!stopped || s->retained){s->retained=true;return false;}
+    IpaMmuIo *io=&s->io;void *c=io->ctx;
+    for(unsigned n=0;n<2;n++){
+        IpaMmuContext *p=&s->context[n];if(!p->touched)continue;unsigned b=ipa_cb(p->bank);
+        if(p->published){
+            if(io->read(c,0x800+4*p->slot)!=(0x80000000u|p->sid)){s->retained=true;return false;}
+            io->write(c,0xc00+4*p->slot,2u<<16); /* route all owned requests to fault */
+            if(io->read(c,0xc00+4*p->slot)!=(2u<<16)){s->retained=true;return false;}
+        }
+        io->write(c,b,0);io->write(c,b+0x618,0);if(!ipa_mmu_sync(s,b))return false;
+        if(io->read(c,b)){s->retained=true;return false;}
+        io->write(c,0x800+4*p->slot,p->smr);io->write(c,0xc00+4*p->slot,p->s2cr);
+        io->write64(c,b+0x20,(uint64_t)p->saved[2]|(uint64_t)p->saved[3]<<32);
+        io->write64(c,b+0x28,(uint64_t)p->saved[7]|(uint64_t)p->saved[8]<<32);
+        for(unsigned j=1;j<=6;j++)if(j!=2 && j!=3)io->write(c,b+ipa_mmu_regs[j],p->saved[j]);
+        io->write(c,0x1800+4*p->bank,p->cba2r);io->write(c,0x1000+4*p->bank,p->cbar);
+        if(io->read(c,0x800+4*p->slot)!=p->smr || io->read(c,0xc00+4*p->slot)!=p->s2cr){s->retained=true;return false;}
+        for(unsigned j=0;j<9;j++)if(io->read(c,b+ipa_mmu_regs[j])!=p->saved[j]){s->retained=true;return false;}
+        if(io->read(c,0x1800+4*p->bank)!=p->cba2r || io->read(c,0x1000+4*p->bank)!=p->cbar){s->retained=true;return false;}
+        p->touched=false;p->published=false;
+    }
+    return true;
+}
+#endif
diff --git a/bsd/dev/modem/IpaPower.h b/bsd/dev/modem/IpaPower.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/modem/IpaPower.h
@@ -0,0 +1,25 @@
+#ifndef IPA_POWER_H
+#define IPA_POWER_H
+#include "QcomRpmh.h"
+/* The modem 2183 bandwidth floor covers SN3/SN0/SH1/SH0/MC0/ACV.
+ * Add IPA's configuration path and core clock, each as a separate VCD commit.
+ * Shared bandwidth floors and the owned 120 MHz clock request stay until reset. */
+static inline int ipa_power_command(const uint8_t *db,size_t bytes,unsigned resource,uint32_t *address,uint32_t *data){
+    if(resource>1)return -1;
+    QcomRpmhResource r={0};
+    if(qcom_cmd_db_find(db,bytes,resource?"IP0":"CN0",&r) || r.slave_id!=5 || (r.address>>16)!=5 ||
+       (r.address&3) || r.aux_version!=0x1000 || r.aux_bytes!=8 || r.aux_prefix[7])return -1;
+    uint32_t unit=(uint32_t)r.aux_prefix[0]|(uint32_t)r.aux_prefix[1]<<8|(uint32_t)r.aux_prefix[2]<<16|(uint32_t)r.aux_prefix[3]<<24;
+    if(!unit || r.aux_prefix[6]>15)return -1;
+    /* Nothing's ipa3_controller_static_bind selects the v5.0 clock table
+     * for v5.2. Its initial SVS2 rate is 120 MHz. The clock driver uses
+     * command-db unit in kHz, with X=0 and Y=ceil(rate/unit). */
+    uint32_t vote=1;
+    if(resource){
+        if(r.address!=0x50038 || unit!=40 || r.aux_prefix[4]!=8 || r.aux_prefix[5] || r.aux_prefix[6]!=7)return -1;
+        vote=(120000u+unit-1)/unit;
+        if(vote>0x3fff)return -1;
+    }
+    *address=r.address;*data=0x60000000u|vote;return 0;
+}
+#endif
diff --git a/bsd/dev/modem/IpaRuntime.inc b/bsd/dev/modem/IpaRuntime.inc
new file mode 100644
--- /dev/null
+++ b/bsd/dev/modem/IpaRuntime.inc
@@ -0,0 +1,162 @@
+/* 2201: guarded IPA5.2 PAS15 lifecycle. No packet endpoint is advertised yet. */
+#include "IpaSmmu.h"
+#include "IpaMmu.h"
+#include "IpaPower.h"
+#ifndef IPA_HOST_TEST
+#include "../sweet_board.h"
+#include <vm/vm_kern_xnu.h>
+#define IPA_BARRIER() __asm__ volatile("dsb sy":::"memory")
+#else
+#define IPA_BARRIER() ((void)0)
+#endif
+extern int sweet_apps_smmu_claim(void);
+extern void sweet_apps_smmu_release(void);
+extern ppnum_t pmap_find_phys(pmap_t,addr64_t);
+#define IPA_DMA_BYTES 0x100000u
+#define IPA_DMA_IOVA 0x20000000u
+#define IPA_PT_BYTES (IPA_PT_PAGES*IPA_PT_PAGE)
+static struct {
+    vm_offset_t smmu,block,firmware,dma,pt[2],metadata;
+    uint64_t dma_pa,pt_pa[2],metadata_pa;
+    IpaMmu mmu;
+    uint32_t smem_off,smem_bytes;
+    bool enabled,pas_owed,started,retained,clock_pinned,mmu_attempted;
+} ipa;
+static uint32_t ipa_mread(void *unused,unsigned off){(void)unused;return m_rd(ipa.smmu,off);}
+static void ipa_mwrite(void *unused,unsigned off,uint32_t v){(void)unused;m_wr(ipa.smmu,off,v);}
+static void ipa_mwrite64(void *unused,unsigned off,uint64_t v){(void)unused;IPA_BARRIER();*(volatile uint64_t *)(ipa.smmu+off)=v;IPA_BARRIER();}
+static void ipa_mdelay(void *unused){(void)unused;delay(1);}
+static int ipa_alloc(vm_offset_t *va,uint64_t *pa,vm_size_t size){
+    if(kmem_alloc_contig(kernel_map,va,size,PAGE_MASK,0,0,KMA_DATA|KMA_ZERO,VM_KERN_MEMORY_IOKIT)!=KERN_SUCCESS)return ENOMEM;
+    *pa=ptoa_64(pmap_find_phys(kernel_pmap,(addr64_t)*va));
+    if(!*pa || *pa>=(1ull<<36) || size>(1ull<<36)-*pa)return EINVAL;
+    for(vm_size_t off=0;off<size;off+=PAGE_SIZE)if(ptoa_64(pmap_find_phys(kernel_pmap,(addr64_t)(*va+off)))!=*pa+off)return EINVAL;
+    return 0;
+}
+static int ipa_vote_extra(void){
+    if(!m.bandwidth_pinned || !m.bandwidth_irq || !m.gic || m.vote_uncertain)return EINVAL;
+    static uint8_t dbcopy[0x20000];
+    for(unsigned i=0;i<sizeof(dbcopy);i+=4){uint32_t v=m_rd(m.db,i);memcpy(dbcopy+i,&v,4);}
+    uint32_t address[2],data[2];
+    for(unsigned i=0;i<2;i++)if(ipa_power_command(dbcopy,sizeof(dbcopy),i,&address[i],&data[i]))return EINVAL;
+    if(address[0]==address[1])return EINVAL;
+    for(unsigned i=0;i<2;i++){
+        sweet_apps_rsc_lock();int chosen=-1,rc=ETIMEDOUT;unsigned b=0;
+        /* The completion status is masked by RSC IRQ enable. Poll with the
+         * owned source unmasked only while GIC delivery remains disabled. */
+        uint32_t gbit=1u<<5,group=m_rd(m.gic,0x84),priority=(m_rd(m.gic,0x424)>>8)&255;
+        if((!(group&gbit) && !priority) || (m_rd(m.gic,0x104)&gbit) || (m_rd(m.gic,0x304)&gbit)){
+            sweet_apps_rsc_unlock();return EBUSY;
+        }
+        for(unsigned j=0;j<3;j++){
+            unsigned t=0xd00+j*0x2a0;
+            if(m_rd(m.rsc,t+0x28) && !m_rd(m.rsc,t+0x24) && !m_rd(m.rsc,t+0x2c) && !m_rd(m.rsc,t+0x20) && !(m_rd(m.rsc,0xd04)&(1u<<j))){chosen=j;b=t;break;}
+        }
+        if(chosen<0){sweet_apps_rsc_unlock();return EBUSY;}
+        uint32_t bit=1u<<chosen,irq=m_rd(m.rsc,0xd00);
+        m_wr(m.rsc,0xd08,bit);m_wr(m.rsc,0xd00,irq|bit);
+        if(!(m_rd(m.rsc,0xd00)&bit) || (m_rd(m.rsc,0xd04)&bit)){
+            m_wr(m.rsc,0xd00,(m_rd(m.rsc,0xd00)&~bit)|(irq&bit));sweet_apps_rsc_unlock();return EIO;
+        }
