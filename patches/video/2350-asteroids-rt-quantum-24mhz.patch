+/*
+ * Patch 2350: a kernel log line for each time constraint request this kernel refuses (the first 32 of a boot) and
+ * for each one only 2350's 24 MHz allowance admits (the first 8), so a run names the RT threads the 19.2 MHz
+ * timebase affects. thread_policy_set_checked is the stock thread_policy_set.
+ */
+kern_return_t
+thread_policy_set(
+	thread_t                                thread,
+	thread_policy_flavor_t  flavor,
+	thread_policy_t                 policy_info,
+	mach_msg_type_number_t  count)
+{
+	static uint32_t sweet_rt_refused, sweet_rt_widened;
+	thread_time_constraint_policy_data_t want = {};
+	bool rt = thread != THREAD_NULL && count >= THREAD_TIME_CONSTRAINT_POLICY_COUNT &&
+	    (flavor == THREAD_TIME_CONSTRAINT_POLICY || flavor == THREAD_TIME_CONSTRAINT_WITH_PRIORITY_POLICY);
+
+	if (rt) {
+		want = *(thread_time_constraint_policy_t)(void *)policy_info;
+	}
+	kern_return_t kr = thread_policy_set_checked(thread, flavor, policy_info, count);
+	if (rt && kr != KERN_SUCCESS && os_atomic_inc_orig(&sweet_rt_refused, relaxed) < 32) {
+		printf("SWEET RT: pid %d tid %llu time constraint refused, kr %d: period %u computation %u constraint %u, "
+		    "admits %u..%u (2350)\n", task_pid(get_threadtask(thread)), thread_tid(thread), kr, want.period,
+		    want.computation, want.constraint, min_rt_quantum, max_rt_quantum);
+	} else if (rt && kr == KERN_SUCCESS && want.computation > sweet_rt_stock_max_quantum &&
+	    os_atomic_inc_orig(&sweet_rt_widened, relaxed) < 8) {
+		printf("SWEET RT: pid %d tid %llu time constraint admitted by 2350: period %u computation %u constraint %u, "
+		    "stock limit %u\n", task_pid(get_threadtask(thread)), thread_tid(thread), want.period, want.computation,
+		    want.constraint, sweet_rt_stock_max_quantum);
+	}
+	return kr;
+}
+
 static_assert(offsetof(thread_time_constraint_with_priority_policy_data_t, period) == offsetof(thread_time_constraint_policy_data_t, period));
 static_assert(offsetof(thread_time_constraint_with_priority_policy_data_t, computation) == offsetof(thread_time_constraint_policy_data_t, computation));
 static_assert(offsetof(thread_time_constraint_with_priority_policy_data_t, constraint) == offsetof(thread_time_constraint_policy_data_t, constraint));
