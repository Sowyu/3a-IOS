+++ b/osfmk/kern/sched.h
@@ -349,6 +349,7 @@ extern uint32_t default_timeshare_computation;
 extern uint32_t default_timeshare_constraint;
 
 extern uint32_t max_rt_quantum, min_rt_quantum;
+extern uint32_t sweet_rt_stock_max_quantum;     /* patch 2350: max_rt_quantum before its 24 MHz allowance */
 
 extern int default_preemption_rate;
 
diff --git a/osfmk/kern/sched_rt.c b/osfmk/kern/sched_rt.c
index 531dbfe..aefcf21 100644
--- a/osfmk/kern/sched_rt.c
+++ b/osfmk/kern/sched_rt.c
@@ -37,6 +37,8 @@
 #include <kern/sched_rt.h>
 #include <kern/thread.h>
 #include <kern/queue.h>
+#include <kern/misc_protos.h>
+#include <kern/startup.h>
 
 #include <sys/kdebug_kernel.h>
 
@@ -54,6 +56,10 @@ uint32_t rt_constraint_threshold;
 int rt_deadline_epsilon_us = 100;
 uint32_t max_rt_quantum;
 uint32_t min_rt_quantum;
+/* Patch 2350: 50 ms of the 24 MHz clock iOS userspace assumes, and the limit before 2350 raised it */
+#define SWEET_RT_QUANTUM_24MHZ 1200000u
+static TUNABLE(uint32_t, sweet_rtq, "sweetrtq", 1);
+uint32_t sweet_rt_stock_max_quantum;
 int sched_allow_rt_smt = 1;
 int sched_rt_runq_strict_priority = false;
 
@@ -91,6 +97,20 @@ sched_realtime_timebase_init(void)
 		50, 1000 * NSEC_PER_USEC, &abstime);
 	assert((abstime >> 32) == 0 && (uint32_t)abstime != 0);
 	max_rt_quantum = (uint32_t)abstime;
+	/*
+	 * Patch 2350: iOS 26 userspace builds RT time constraints on a fixed 24 MHz clock. CoreAudio's
+	 * AMCP::Utility::configure_thread_for_realtime clamps the computation to 1200000 ticks, 50 ms at 24 MHz, but
+	 * this kernel's 19.2 MHz timebase makes the 50 ms limit 960000 ticks. Every HAL IO thread with a cycle of
+	 * 960000 ticks or more (4096 frames, the media playback buffer) was refused and its IO stopped after 0 frames,
+	 * so Safari's MSE timebase never started. Admit 50 ms of a 24 MHz clock as well, 62.5 ms here. No change on
+	 * 24 MHz hardware. sweetrtq=0 keeps the stock limit.
+	 */
+	sweet_rt_stock_max_quantum = max_rt_quantum;
+	if (sweet_rtq && max_rt_quantum < SWEET_RT_QUANTUM_24MHZ) {
+		max_rt_quantum = SWEET_RT_QUANTUM_24MHZ;
+	}
+	printf("SWEET RT: max rt computation %u ticks, stock %u (2350 sweetrtq=%u)\n", max_rt_quantum,
+	    sweet_rt_stock_max_quantum, sweet_rtq);
 
 	/* constraint threshold for sending backup IPIs (4 ms) */
 	clock_interval_to_absolutetime_interval(4, NSEC_PER_MSEC, &abstime);
