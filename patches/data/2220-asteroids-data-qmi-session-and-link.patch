+/*
+ * SWEET DATA: mobile data above the modem runtime (bsd/dev/modem) and the IPA.
+ *
+ * Three parts, all off unless their boot arg is the exact token NAME=1:
+ *   sweetdata=1        the QMI session (CellSession.c) on two QRTR client ports, and en2, an Ethernet ifnet that configd sets up by
+ *                      DHCP. Its frames are answered or turned into IP packets by CellLink.c; the packets go through QMAP (Qmap.c)
+ *                      to the IPA driver's transmit hook, and the IPA driver hands received buffers to sweet_data_ipa_rx().
+ *   sweetdataonline=1  lets the session put the modem online (DMS Set Operating Mode 0). Without it the session waits.
+ *   sweetqmiraw=1      sysctl kern.sweet_qmi for root: one call sends a QMI request through the allow list (QmiRaw.c) and returns
+ *                      the response; kern.sweet_qmi_ind returns the last kept indications.
+ * sweetapn=NAME gives the APN; without it Start Network uses the modem's default profile.
+ *
+ * Threads (sweet_data.h): the modem runtime's worker runs the session, every QRTR send and the QRTR receive callbacks. The stack's
+ * output, the IPA's receive and the sysctl callers meet it only under sd_lock: the CellLink state, the raw request slot and the
+ * indication ring. ifnet_input and the IPA transmit hook are always called without sd_lock. No packet byte is logged.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/sysctl.h>
+#include <sys/kauth.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/sockio.h>
+#include <sys/kern_event.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+#include <net/if.h>
+#include <net/if_media.h>
+#include <net/if_types.h>
+#include <net/if_ether.h>
+#include <net/ethernet.h>
+#include <net/ether_if_module.h>
+#include <net/kpi_interface.h>
+#include <net/bpf.h>
+#include <net/dlil.h>
+#include "../modem/QcomQrtr.h"
+#include "../modem/ModemGate.h"
+#include "QmiData.h"
+#include "Qmap.h"
+#include "CellLink.h"
+#include "CellSession.h"
+#include "QmiRaw.h"
+#include "DataServices.h"
+#include "sweet_data.h"
+
+#define PORT_CLIENT0 0x4010u
+#define PORT_CLIENT1 0x4011u
+#define IND_RING 8u
+#define IND_MAX 256u
+#define RA_REFRESH_MS 600000u
+#define SD_MUX 1u          /* the QMAP mux both calls are bound to */
+
+static LCK_GRP_DECLARE(sd_grp, "sweet_data");
+static LCK_MTX_DECLARE(sd_lock, &sd_grp);
+
+static const uint8_t sd_mac[6] = {0x02, 0x53, 0x57, 0x44, 0x41, 0x01};     /* locally administered "SWDA" 1 */
+static const uint8_t sd_router_mac[6] = {0x02, 0x53, 0x57, 0x44, 0x41, 0xfe};
+
+enum {RAW_FREE, RAW_COPYING, RAW_QUEUED, RAW_SENT, RAW_DONE};
+
+static struct {
+	int session_on, raw_on, attached, closed;
+	QcomQrtr *qr;                   /* worker thread only */
+	CellSession session;            /* worker thread only */
+	char apn[101];
+	DataServices services;          /* worker thread only */
+	int usim, ready_given;          /* worker thread only */
+	uint64_t next_ra;
+	/* the presentation, under sd_lock */
+	CellLink link;
+	ifnet_t ifp;
+	int link_up;                    /* atomic */
+	/* the IPA driver's side: written once by set_ipa before attach, read-only afterwards */
+	int (*ipa_tx)(void *, const uint8_t *, uint32_t);
+	void *ipa_ctx;
+	QmapVersion qmap;
+	uint32_t ipa_rx_bytes, ipa_datagrams;
+	int ipa_ready, tx_paused;       /* atomic */
+	QmapCounters qmap_count;        /* the IPA receive thread only */
+	/* one raw request at a time, under sd_lock */
+	struct {
+		int state, err;
+		uint8_t service, client;
+		uint16_t txn, next_txn, message;
+		uint8_t msg[QMI_RAW_MAX];
+		uint32_t len, reply_len;
+		uint8_t reply[QMI_RAW_MAX];
+	} raw;
+	struct {uint32_t seq, len; uint8_t service, client, data[IND_MAX];} ind[IND_RING];
+	uint32_t ind_seq;
+} sd;
+
+#define LOAD(x) __atomic_load_n(&(x), __ATOMIC_ACQUIRE)
+#define STORE(x, v) __atomic_store_n(&(x), (v), __ATOMIC_RELEASE)
+
+static int
+sd_gate(const char *name)
+{
+	return modem_gate(PE_boot_args(), name) != 0;
+}
+
+static uint64_t
+sd_now_ms(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+/* Worker thread. */
+static int
+sd_send(void *ctx, unsigned client, uint8_t service, const uint8_t *msg, uint32_t length)
+{
+	(void)ctx;
+	uint32_t node, port;
+	if (data_services_endpoint(&sd.services, service, &node, &port) || sd.qr == NULL || client > 1 || (client == 1 && !sd.session_on)) {
+		return -1;
+	}
+	return qcom_qrtr_send_data(sd.qr, client ? PORT_CLIENT1 : PORT_CLIENT0, node, port, msg, length);
+}
+
+/* ---- the ifnet ---- */
+/* Hands one frame to the stack. Never called with sd_lock held. */
+static void
+sd_input(const uint8_t *header, const uint8_t *packet, uint32_t length)
+{
+	mbuf_t m = NULL;
+
+	if (sd.ifp == NULL || length > MCLBYTES - CELL_ETHER) {
+		return;
+	}
+	const uint32_t frame_len = CELL_ETHER + length;
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 || mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 ||
+	    !(mbuf_flags(m) & MBUF_EXT) || mbuf_maxlen(m) < frame_len) {
+		if (m != NULL) {
+			mbuf_freem(m);
+		}
+		ifnet_stat_increment_in(sd.ifp, 0, 0, 1);
+		return;
+	}
+	uint8_t *d = mbuf_data(m);
+	memcpy(d, header, CELL_ETHER);
+	memcpy(d + CELL_ETHER, packet, length);
+	mbuf_setlen(m, frame_len);
+	mbuf_pkthdr_setlen(m, frame_len);
+	mbuf_pkthdr_setrcvif(m, sd.ifp);
+	mbuf_pkthdr_setheader(m, d);
+	mbuf_pkthdr_adjustlen(m, -(int)CELL_ETHER);
+	(void)mbuf_setdata(m, d + CELL_ETHER, length);
+	struct ifnet_stat_increment_param st = {};
+	st.packets_in = 1;
+	st.bytes_in = frame_len;
+	ifnet_input(sd.ifp, m, &st);
+}
+
+static errno_t
+sd_output(ifnet_t ifp, mbuf_t m)
+{
+	/* per call: the frame, with the Ethernet header's 14 bytes as room for the QMAP headers (4 or 8) */
+	uint8_t frame[CELL_FRAME_MAX], reply[CELL_REPLY_MAX];
+	uint32_t n = 0;
+	CellAction a = CELL_DROP;
+	const size_t len = mbuf_pkthdr_len(m);
+	int ok = 0;
+
+	if (len >= CELL_ETHER && len <= sizeof frame && mbuf_copydata(m, 0, len, frame) == 0) {
+		lck_mtx_lock(&sd_lock);
+		a = cell_link_output(&sd.link, frame, (uint32_t)len, reply, &n);
+		lck_mtx_unlock(&sd_lock);
+	}
+	mbuf_freem(m);
+	if (a == CELL_REPLY) {
+		sd_input(reply, reply + CELL_ETHER, n - CELL_ETHER);
+		ok = 1;
+	} else if (a == CELL_TO_MODEM && sd.ipa_tx != NULL && !LOAD(sd.tx_paused) && LOAD(sd.ipa_ready)) {
+		uint8_t *ip = frame + CELL_ETHER;
+		const uint32_t framed = qmap_frame(sd.qmap, SD_MUX, ip, n);
+		ok = framed && sd.ipa_tx(sd.ipa_ctx, ip - qmap_headroom(sd.qmap), framed) == 0;
+	}
+	ifnet_stat_increment_out(ifp, ok, ok ? (uint32_t)len : 0, !ok);
+	return 0;
+}
+
+static errno_t
+sd_ioctl(ifnet_t ifp, unsigned long cmd, void *data)
+{
+	switch (cmd) {
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64: {
+		struct ifmediareq *ifmr = (struct ifmediareq *)data;
+		user_addr_t list = (cmd == SIOCGIFMEDIA64) ? ((struct ifmediareq64 *)ifmr)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)ifmr)->ifmu_ulist);
+		const int asked = ifmr->ifm_count, up = LOAD(sd.link_up);
+		int word = IFM_ETHER | IFM_AUTO;
+		if (asked < 0) {
+			return EINVAL;
+		}
+		ifmr->ifm_current = word;
+		ifmr->ifm_active = up ? (IFM_ETHER | IFM_1000_T | IFM_FDX) : word;
+		ifmr->ifm_mask = 0;
+		ifmr->ifm_status = IFM_AVALID | (up ? IFM_ACTIVE : 0);
+		ifmr->ifm_count = 1;
+		return asked > 0 && list != USER_ADDR_NULL ? copyout(&word, list, sizeof(word)) : 0;
+	}
+	case SIOCSIFADDR:
+	case SIOCAIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		return 0;
+	case SIOCSIFFLAGS:
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		return 0;
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+static void
+sd_detach_ifnet(ifnet_t ifp __unused)
+{
+}
+
+static void
+sd_ifnet_create(void)
+{
+	struct ifnet_init_eparams init;
+
+	bzero(&init, sizeof(init));
+	init.ver = IFNET_INIT_CURRENT_VERSION;
+	init.len = sizeof(init);
+	init.flags = IFNET_INIT_LEGACY;
+	init.uniqueid = "sweet-cellular";
+	init.uniqueid_len = sizeof("sweet-cellular") - 1;
+	init.name = "en";
+	init.unit = 2;
+	init.family = IFNET_FAMILY_ETHERNET;
+	init.type = IFT_ETHER;
+	init.output = sd_output;
+	init.demux = ether_demux;
+	init.add_proto = ether_add_proto;
+	init.del_proto = ether_del_proto;
+	init.check_multi = ether_check_multi;
+	init.framer_extended = ether_frameout_extended;
+	init.ioctl = sd_ioctl;
+	init.detach = sd_detach_ifnet;
+	init.broadcast_addr = etherbroadcastaddr;
+	init.broadcast_len = ETHER_ADDR_LEN;
+	if (ifnet_allocate_extended(&init, &sd.ifp) != 0) {
+		printf("SWEET DATA: ifnet_allocate failed\n");
+		sd.ifp = NULL;
+		return;
+	}
+	ifnet_set_addrlen(sd.ifp, ETHER_ADDR_LEN);
+	ifnet_set_hdrlen(sd.ifp, sizeof(struct ether_header));
+	ifnet_set_mtu(sd.ifp, ETHERMTU);
+	ifnet_set_baudrate(sd.ifp, 100000000);
+	ifnet_set_flags(sd.ifp, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST, 0xffff);
+	if (ifnet_attach(sd.ifp, NULL) != 0) {
+		printf("SWEET DATA: ifnet_attach failed\n");
+		ifnet_release(sd.ifp);
+		sd.ifp = NULL;
+		return;
+	}
+	ifnet_set_lladdr(sd.ifp, sd_mac, ETHER_ADDR_LEN);
+	/* IPConfiguration probes and runs DHCP over BPF (see sweet_usb.c, 0158) */
+	(void)bpf_attach(sd.ifp, DLT_EN10MB, sizeof(struct ether_header), NULL, NULL);
+	ifnet_set_flags(sd.ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+	printf("SWEET DATA: en2 attached, link down until a call is up\n");
+}
+
+/* Link state for configd: KEV_DL_LINK_ON/OFF, read with SIOCGIFMEDIA. Worker thread, sd_lock not held. */
+static void
+sd_link(int up)
+{
+	if (sd.ifp == NULL || LOAD(sd.link_up) == up) {
+		return;
+	}
+	STORE(sd.link_up, up);
+	dlil_post_msg(sd.ifp, KEV_DL_SUBCLASS, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF, NULL, 0, FALSE);
+	printf("SWEET DATA: en2 link %s\n", up ? "up" : "down");
+}
+
+/* An unsolicited router advertisement when IPv6 comes up and every 10 minutes after. Worker thread. */
+static void
+sd_advertise(void)
+{
+	uint8_t ra[CELL_REPLY_MAX];
+	lck_mtx_lock(&sd_lock);
+	const uint32_t n = cell_link_router_advert(&sd.link, ra, sizeof ra);
+	lck_mtx_unlock(&sd_lock);
+	sd.next_ra = sd_now_ms() + RA_REFRESH_MS;  /* also with IPv6 down, so the poll does not retry each time */
+	if (n) {
+		sd_input(ra, ra + CELL_ETHER, n - CELL_ETHER);
+	}
+}
+
+/* ---- session events (worker thread) ---- */
+static void
+sd_event(void *ctx, CellEvent e, uint32_t arg, const void *data, const char *text)
+{
+	(void)ctx;
+	switch (e) {
+	case CE_STATE:
+		printf("SWEET DATA: state %s\n", text);
+		break;
+	case CE_INFO:
+		printf("SWEET DATA: %s\n", text);
+		break;
+	case CE_ERROR:
+		printf("SWEET DATA: error (message %#x): %s\n", arg, text);
+		break;
+	case CE_SERVING: {
+		const NasServing *s = data;
+		printf("SWEET DATA: NAS registration %u CS %u PS %u radio %u roaming %u PLMN %03u-%02u '%s'\n", s->reg_state,
+		    s->cs_attach, s->ps_attach, s->radio_count ? s->radio[0] : 0, s->roaming, s->mcc, s->mnc, s->description);
+		break;
+	}
+	case CE_SIGNAL: {
+		const NasSignal *s = data;
+		printf("SWEET DATA: signal bars %d LTE rsrp %d rsrq %d NR rsrp %d\n", (int)arg, s->lte_rsrp, s->lte_rsrq, s->nr_rsrp);
+		break;
+	}
+	case CE_OPERATOR: {
+		const NasOperator *o = data;
+		printf("SWEET DATA: operator '%s' '%s'\n", o->spn, o->name);
+		break;
+	}
+	case CE_UP: {
+		const WdsSettings *w = data;
+		int ok = 1;
+		lck_mtx_lock(&sd_lock);
+		if (arg == WDS_FAMILY_IPV4) {
+			cell_link_set_v4(&sd.link, w->v4_addr, w->v4_dns1, w->v4_dns2, w->mtu);
+		} else {
+			ok = cell_link_set_v6(&sd.link, w->v6_addr, w->v6_prefix, w->has_v6_dns1 ? w->v6_dns1 : NULL,
+			    w->has_v6_dns2 ? w->v6_dns2 : NULL, w->mtu) == 0;
+		}
+		const uint32_t mtu = sd.link.mtu;
+		lck_mtx_unlock(&sd_lock);
+		/* addresses are the user's, not identifiers, but only the family and MTU go to the log */
+		printf("SWEET DATA: IPv%u call up, MTU %u%s\n", arg, mtu, ok ? "" : ", but the prefix is not presentable");
+		if (!ok) {
+			break;
+		}
+		if (sd.ifp != NULL) {
+			ifnet_set_mtu(sd.ifp, mtu);
+		}
+		sd_link(1);
+		if (arg == WDS_FAMILY_IPV6) {
+			sd_advertise();
+		}
+		break;
+	}
+	case CE_DOWN: {
+		lck_mtx_lock(&sd_lock);
+		if (arg == WDS_FAMILY_IPV4) {
+			cell_link_set_v4(&sd.link, 0, 0, 0, 0);
+		} else {
+			cell_link_set_v6(&sd.link, NULL, 0, NULL, NULL, 0);
+		}
+		const int any = sd.link.v4_up || sd.link.v6_up;
+		lck_mtx_unlock(&sd_lock);
+		printf("SWEET DATA: IPv%u call down\n", arg);
+		if (!any) {
+			sd_link(0);
+		}
+		break;
+	}
+	}
+}
+
+static void sd_readiness(void);
+static void sd_sync_services(QcomQrtr *qr);
+
+/* ---- QRTR receive (worker thread) ---- */
+static void
+sd_raw_finish(int err)
+{
+	sd.raw.err = err;
+	sd.raw.state = RAW_DONE;
+	wakeup(&sd.raw);
+}
+
+static void
+sd_receive(void *ctx, QcomQrtr *q, uint32_t port, uint32_t node, uint32_t from_port, const uint8_t *data, uint32_t length)
+{
+	(void)ctx;
+	const unsigned client = port == PORT_CLIENT1;
+	if (!sd.attached || q != sd.qr) {
+		return;
+	}
+	/* the QRTR list is the truth: a DEL_SERVER earlier in this batch must count before this reply is routed */
+	sd_sync_services(q);
+	const int service = data_services_lookup(&sd.services, node, from_port);
+	if (service < 0 || length < QCOM_QMI_HEADER) {
+		return;
+	}
+	const uint16_t txn = (uint16_t)(data[1] | data[2] << 8), message = (uint16_t)(data[3] | data[4] << 8);
+	if (data[0] == QCOM_QMI_RESPONSE && txn >= CELL_TXN_RAW) {
+		/* only the request in flight is answered; replies to retired transactions are dropped */
+		lck_mtx_lock(&sd_lock);
+		if (sd.raw.state == RAW_SENT && sd.raw.txn == txn && sd.raw.service == service && sd.raw.client == client &&
+		    sd.raw.message == message) {
+			if (length > sizeof sd.raw.reply) {
+				sd_raw_finish(EMSGSIZE);
+			} else {
+				memcpy(sd.raw.reply, data, length);
+				sd.raw.reply_len = length;
+				sd_raw_finish(0);
+			}
+		}
+		lck_mtx_unlock(&sd_lock);
+		return;
+	}
+	if (data[0] == QCOM_QMI_INDICATION && sd.raw_on && qmi_raw_indication_kept((uint8_t)service, message)) {
+		lck_mtx_lock(&sd_lock);
+		const uint32_t slot = sd.ind_seq % IND_RING;
+		sd.ind[slot].seq = ++sd.ind_seq;
+		sd.ind[slot].service = (uint8_t)service;
+		sd.ind[slot].client = (uint8_t)client;
+		sd.ind[slot].len = length < IND_MAX ? length : IND_MAX;
+		memcpy(sd.ind[slot].data, data, sd.ind[slot].len);
+		lck_mtx_unlock(&sd_lock);
+	}
+	if (sd.session_on) {
+		sd_readiness();  /* a revocation counts before this message can advance anything */
+		cell_session_receive(&sd.session, client, (uint8_t)service, data, length);
+	}
+}
+
+/* ---- the modem runtime's hooks (worker thread) ---- */
+int
+sweet_data_attach(QcomQrtr *qr)
+{
+	static int once;
+	if (sd.attached || once) {
+		return EBUSY;  /* one attach per boot: a restart would need its own waiter, port and readiness reset (re-audit) */
+	}
+	sd.session_on = sd_gate("sweetdata");
+	sd.raw_on = sd_gate("sweetqmiraw");
+	if (!sd.session_on && !sd.raw_on) {
+		return 0;
+	}
+	/* service 0: QcomQrtr announces nothing for these client ports */
+	if (qcom_qrtr_add_service(qr, 0, 0, PORT_CLIENT0, sd_receive, NULL) ||
+	    (sd.session_on && qcom_qrtr_add_service(qr, 0, 0, PORT_CLIENT1, sd_receive, NULL))) {
+		printf("SWEET DATA: refused: no free QRTR port (QCOM_QRTR_MAX_LOCAL)\n");
+		sd.session_on = sd.raw_on = 0;
+		return EIO;
+	}
+	lck_mtx_lock(&sd_lock);
+	sd.qr = qr;
+	sd.closed = 0;
+	sd.raw.state = RAW_FREE;
+	sd.raw.next_txn = CELL_TXN_RAW;
+	cell_link_init(&sd.link, sd_mac, sd_router_mac);
+	lck_mtx_unlock(&sd_lock);
+	if (sd.session_on) {
+		if (!PE_parse_boot_arg_str("sweetapn", sd.apn, sizeof sd.apn)) {
+			sd.apn[0] = 0;
+		}
+		const CellConfig cfg = {
+			.allow_online = (uint8_t)sd_gate("sweetdataonline"), .want_v4 = 1, .want_v6 = 1, .apn = sd.apn[0] ? sd.apn : NULL,
+			.mux = SD_MUX, .ep_interface = 1, .ipa_rx = 2, .ipa_tx = 18,
+		};
+		const CellSessionOps ops = {sd_send, sd_event, NULL};
+		cell_session_init(&sd.session, &cfg, &ops, sd_now_ms());
+		if (!sd.ifp) {
+			sd_ifnet_create();
+		}
+	}
+	sd.attached = once = 1;
+	printf("SWEET DATA: attached (session %d, online allowed %d, raw %d, APN %s, IPA hook %s)\n", sd.session_on,
+	    sd.session_on && sd.session.cfg.allow_online, sd.raw_on, sd.apn[0] ? "given" : "default profile",
+	    sd.ipa_tx ? "set" : "absent");
+	return 0;
+}
+
+static void
+sd_service_lost(void *ctx, uint8_t service)
+{
+	(void)ctx;
+	lck_mtx_lock(&sd_lock);
+	if (sd.raw.state == RAW_SENT && sd.raw.service == service) {
+		sd_raw_finish(ENOENT);
+	}
+	lck_mtx_unlock(&sd_lock);
+}
+
+static void
+sd_sync_services(QcomQrtr *qr)
+{
+	data_services_sync(&sd.services, qr, sd.session_on ? &sd.session : NULL, sd_service_lost, NULL);
+}
+
+void
+sweet_data_discovery(QcomQrtr *qr)
+{
+	if (!sd.attached || qr != sd.qr) {
+		return;
+	}
+	sd_sync_services(qr);
+	if (sd.session_on) {
+		sd_readiness();
+	}
+}
+
+/* The readiness barrier: USIM ready (modem runtime), IPA handshake done and the transmit hook set (IPA driver). */
+static void
+sd_readiness(void)
+{
+	const int ready = sd.usim && LOAD(sd.ipa_ready) && sd.ipa_tx != NULL;
+	if (ready && !sd.ready_given) {
+		const CellReady r = {sd.qmap, sd.ipa_datagrams, sd.ipa_rx_bytes};
+		cell_session_ready(&sd.session, &r);
+		sd.ready_given = 1;
+	} else if (!ready && sd.ready_given) {
+		cell_session_ready(&sd.session, NULL);
+		sd.ready_given = 0;
+	}
+}
+
+static void
+sd_raw_poll(void)
+{
+	lck_mtx_lock(&sd_lock);
+	if (sd.raw.state != RAW_QUEUED) {
+		lck_mtx_unlock(&sd_lock);
+		return;
+	}
+	uint8_t msg[QMI_RAW_MAX];
+	const uint32_t len = sd.raw.len;
+	const uint8_t service = sd.raw.service, client = sd.raw.client;
+	const uint16_t txn = sd.raw.txn;
+	memcpy(msg, sd.raw.msg, len);
+	sd.raw.state = RAW_SENT;
+	lck_mtx_unlock(&sd_lock);
+	if (sd_send(NULL, client, service, msg, len)) {
+		lck_mtx_lock(&sd_lock);
+		if (sd.raw.state == RAW_SENT && sd.raw.txn == txn) {
+			sd_raw_finish(ENOENT);  /* not sent: the service is not there or the link refused */
+		}
+		lck_mtx_unlock(&sd_lock);
+	}
+}
+
+void
+sweet_data_poll(QcomQrtr *qr, uint64_t now_ms)
+{
+	if (!sd.attached || qr != sd.qr) {
+		return;
+	}
+	sd_sync_services(qr);  /* before readiness, so a readiness transition never sends through a stale endpoint */
+	if (sd.session_on) {
+		sd_readiness();
+	}
+	sd_raw_poll();
+	if (sd.session_on) {
+		cell_session_poll(&sd.session, now_ms);
+		if (LOAD(sd.link_up) && now_ms >= sd.next_ra) {
+			sd_advertise();
+		}
+	}
+}
+
+void
+sweet_data_usim(int ready)
+{
+	sd.usim = ready != 0;
+	if (sd.attached && sd.session_on) {
+		sd_readiness();  /* worker thread: a revocation takes effect before anything else runs */
+	}
+}
+
+static void
+sd_raw_close(void)
+{
+	lck_mtx_lock(&sd_lock);
+	sd.closed = 1;
+	if (sd.raw.state == RAW_QUEUED || sd.raw.state == RAW_SENT) {
+		sd_raw_finish(ESHUTDOWN);
+	}
+	lck_mtx_unlock(&sd_lock);
+}
+
+void
+sweet_data_stop(void)
+{
+	if (!sd.attached) {
+		return;
+	}
+	sd_raw_close();
+	if (sd.session_on) {
+		cell_session_stop(&sd.session);
+	}
+}
+
+int
+sweet_data_idle(void)
+{
+	return !sd.attached || !sd.session_on || cell_session_idle(&sd.session);
+}
+
+int
+sweet_data_cleanup(void)
+{
+	if (!sd.session_on) {
+		return 0;
+	}
+	switch (cell_session_cleanup(&sd.session)) {
+	case CELL_CLEANUP_CLEAN:
+		return 0;
+	case CELL_CLEANUP_PENDING:
+		return EINPROGRESS;
+	default:
+		return EIO;
+	}
+}
+
+void
+sweet_data_detach(void)
+{
+	if (!sd.attached) {
+		return;
+	}
+	sd_raw_close();
+	sd_link(0);
+	lck_mtx_lock(&sd_lock);
+	cell_link_set_v4(&sd.link, 0, 0, 0, 0);
+	cell_link_set_v6(&sd.link, NULL, 0, NULL, NULL, 0);
+	sd.attached = 0;
+	sd.qr = NULL;
+	lck_mtx_unlock(&sd_lock);
+	data_services_clear(&sd.services);
+	sd.ready_given = 0;
+	printf("SWEET DATA: detached\n");
+}
+
+/* ---- the IPA driver's hooks ---- */
+int
+sweet_data_set_ipa(int (*tx)(void *, const uint8_t *, uint32_t), void *ctx, int qmap_version, uint32_t rx_buffer_bytes,
+    uint32_t max_datagrams)
+{
+	if (!sd_gate("sweetdata") || sd.attached || sd.ipa_tx != NULL || tx == NULL || (qmap_version != 1 && qmap_version != 5) ||
+	    !rx_buffer_bytes || !max_datagrams) {
+		return -1;
+	}
+	sd.ipa_ctx = ctx;
+	sd.qmap = qmap_version == 5 ? QMAP_V5 : QMAP_V1;
+	sd.ipa_rx_bytes = rx_buffer_bytes;
+	sd.ipa_datagrams = max_datagrams;
+	__atomic_store_n(&sd.ipa_tx, tx, __ATOMIC_RELEASE);
+	return 0;
+}
+
+void
+sweet_data_ipa_ready(int ready)
+{
+	STORE(sd.ipa_ready, ready != 0);
+}
+
+/* The IPA receive thread: no sd_lock while packets go to the stack or replies to the IPA. */
+static void
+sd_deliver(void *ctx, uint8_t mux, int command, const uint8_t *data, uint32_t length)
+{
+	(void)ctx;
+	if (mux != SD_MUX) {
+		return;
+	}
+	if (command) {
+		uint8_t reply[64];
+		int flow;
+		const uint32_t n = qmap_command_reply(mux, data, length, reply, sizeof reply, &flow);
+		if (flow >= 0) {
+			STORE(sd.tx_paused, !flow);
+		}
+		if (n) {
+			(void)sd.ipa_tx(sd.ipa_ctx, reply, n);
+		}
+		return;
+	}
+	uint8_t header[CELL_ETHER];
+	lck_mtx_lock(&sd_lock);
+	const uint32_t made = cell_link_input_header(&sd.link, data, length, header);
+	lck_mtx_unlock(&sd_lock);
+	if (made) {
+		sd_input(header, data, length);
+	}
+}
+
+void
+sweet_data_ipa_rx(const uint8_t *buf, uint32_t length)
+{
+	if (!sd.session_on || sd.ipa_tx == NULL || !LOAD(sd.ipa_ready)) {
+		return;
+	}
+	(void)qmap_deaggregate(sd.qmap, buf, length, 1u << SD_MUX, sd_deliver, NULL, &sd.qmap_count);
+}
+
+/* ---- kern.sweet_qmi, root only ---- */
+static int
+sd_sysctl_qmi SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	static uint8_t in[QMI_RAW_REQUEST_HEADER + QMI_RAW_MAX];   /* used only by the caller that holds the slot (RAW_COPYING) */
+	uint8_t out[QMI_RAW_REPLY_HEADER + QMI_RAW_MAX];
+	QmiRawRequest r;
+	int status, error;
+
+	if (!sd.raw_on) {
+		return ENOENT;
+	}
+	if (!kauth_cred_issuser(kauth_cred_get())) {
+		return EPERM;
+	}
+	if (req->newptr == USER_ADDR_NULL || req->oldptr == USER_ADDR_NULL || req->newlen > sizeof in) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sd_lock);
+	if (!sd.attached || sd.closed) {
+		lck_mtx_unlock(&sd_lock);
+		return ENOENT;
+	}
+	if (sd.raw.state != RAW_FREE) {
+		lck_mtx_unlock(&sd_lock);
+		return EBUSY;
+	}
+	if (sd.raw.next_txn == 0xffff) {  /* each transaction is used once per attach: the range is spent */
+		lck_mtx_unlock(&sd_lock);
+		return ENOSPC;
+	}
+	sd.raw.state = RAW_COPYING;
+	lck_mtx_unlock(&sd_lock);
+	const uint32_t inlen = (uint32_t)req->newlen;
+	error = SYSCTL_IN(req, in, inlen);
+	if (!error) {
+		error = qmi_raw_parse(in, inlen, &r);
+	}
+	lck_mtx_lock(&sd_lock);
+	if (error || sd.closed) {
+		sd.raw.state = RAW_FREE;
+		lck_mtx_unlock(&sd_lock);
+		printf("SWEET DATA: raw request refused (%d)\n", error ? error : ESHUTDOWN);
+		return error ? error : ESHUTDOWN;
+	}
+	memcpy(sd.raw.msg, r.msg, r.length);
+	sd.raw.len = r.length;
+	sd.raw.service = r.service;
+	sd.raw.client = r.client;
+	/* a fresh transaction each time, so a reply to a retired one never matches */
+	sd.raw.txn = sd.raw.next_txn;
+	sd.raw.next_txn = (uint16_t)(sd.raw.next_txn + 1);
+	sd.raw.message = (uint16_t)(r.msg[3] | r.msg[4] << 8);
+	sd.raw.msg[0] = QCOM_QMI_REQUEST;
+	sd.raw.msg[1] = (uint8_t)sd.raw.txn;
+	sd.raw.msg[2] = (uint8_t)(sd.raw.txn >> 8);
+	sd.raw.err = 0;
+	sd.raw.reply_len = 0;
+	sd.raw.state = RAW_QUEUED;
+	printf("SWEET DATA: raw request service %#x message %#x\n", r.service, sd.raw.message);
+	const uint64_t deadline = sd_now_ms() + r.timeout_ms;
+	while (sd.raw.state == RAW_QUEUED || sd.raw.state == RAW_SENT) {
+		const uint64_t now = sd_now_ms();
+		if (now >= deadline) {
+			break;
+		}
+		const uint64_t left = deadline - now;
+		struct timespec ts = {.tv_sec = (long)(left / 1000), .tv_nsec = (long)(left % 1000) * NSEC_PER_MSEC};
+		(void)msleep(&sd.raw, &sd_lock, PZERO, "sweetqmi", &ts);
+	}
+	uint32_t n = 0;
+	if (sd.raw.state == RAW_DONE && !sd.raw.err) {
+		status = 0;
+		n = sd.raw.reply_len;
+		memcpy(out + QMI_RAW_REPLY_HEADER, sd.raw.reply, n);
+	} else {
+		status = sd.raw.state == RAW_DONE ? sd.raw.err : ETIMEDOUT;
+	}
+	sd.raw.state = RAW_FREE;    /* a timed-out transaction is retired: its late reply is dropped */
+	lck_mtx_unlock(&sd_lock);
+	for (unsigned i = 0; i < 4; ++i) {
+		out[i] = (uint8_t)((uint32_t)status >> 8 * i);
+		out[4 + i] = (uint8_t)(n >> 8 * i);
+	}
+	return SYSCTL_OUT(req, out, QMI_RAW_REPLY_HEADER + n);
+}
+
+/* The kept indications: for each, seq (u32), service, client, length (u16), then the message. Root only. */
+static int
+sd_sysctl_ind SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	const uint32_t size = IND_RING * (8 + IND_MAX);
+	uint32_t at = 0;
+
+	if (!sd.raw_on) {
+		return ENOENT;
+	}
+	if (!kauth_cred_issuser(kauth_cred_get())) {
+		return EPERM;
+	}
+	uint8_t *out = kalloc_data(size, Z_WAITOK | Z_ZERO);
+	if (out == NULL) {
+		return ENOMEM;
+	}
+	lck_mtx_lock(&sd_lock);
+	for (unsigned k = 0; k < IND_RING; ++k) {
+		const unsigned i = (sd.ind_seq + k) % IND_RING;
+		if (!sd.ind[i].seq) {
+			continue;
+		}
+		memcpy(out + at, &sd.ind[i].seq, 4);
+		out[at + 4] = sd.ind[i].service;
+		out[at + 5] = sd.ind[i].client;
+		out[at + 6] = (uint8_t)sd.ind[i].len;
+		out[at + 7] = (uint8_t)(sd.ind[i].len >> 8);
+		memcpy(out + at + 8, sd.ind[i].data, sd.ind[i].len);
+		at += 8 + sd.ind[i].len;
+	}
+	lck_mtx_unlock(&sd_lock);
+	const int error = SYSCTL_OUT(req, out, at);
+	kfree_data(out, size);
+	return error;
+}
+
+/* The names always exist; without sweetqmiraw=1 both answer ENOENT before touching any state. */
+SYSCTL_PROC(_kern, OID_AUTO, sweet_qmi, CTLTYPE_OPAQUE | CTLFLAG_RW | CTLFLAG_LOCKED | CTLFLAG_MASKED, 0, 0, sd_sysctl_qmi, "S", "");
+SYSCTL_PROC(_kern, OID_AUTO, sweet_qmi_ind, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED | CTLFLAG_MASKED, 0, 0, sd_sysctl_ind, "S",
+    "");
+#endif /* ARM64_BOARD_CONFIG_SWEET */
