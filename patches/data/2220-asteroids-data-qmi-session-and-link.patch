+#if defined(ARM64_BOARD_CONFIG_SWEET) || !defined(KERNEL)
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Order and retry behaviour follow ModemManager's QMI bearer for the "ipa" net driver and HakiOS hakios.mpss.c, which learned on
+ * hardware that without DPM Open Port the modem answers WDA, Bind Mux and Start Network with InvalidOperation. Fixes from
+ * docs/data-2220-audit.md: the readiness barrier, STOPPING as a terminal barrier, failures through cleanup, validated replies, and a
+ * charge for every attempted send. */
+#include "CellSession.h"
+#ifdef KERNEL
+#include <libkern/libkern.h>
+#else
+#include <stdio.h>
+#endif
+
+#define REPLY_MS 5000u
+#define POLL_MS 5000u
+#define START_RETRY_MS 6000u
+#define START_TRIES 20u
+#define STEP_TRIES 3u
+#define STEP_RETRY_MS 1000u
+#define STOP_MS 5000u
+#define SEND_BACKOFF_MS 1000u
+#define QMI_ERR_CALL_FAILED 0x0e
+#define START_UNKNOWN_MS 30000u  /* a start unanswered this long ends its call: its outcome can no longer be owned */
+
+enum {B_DMS = 1, B_NAS = 2, B_WDS = 4, B_WDA = 8, B_DPM = 16, B_ALL = 31};
+
+static uint8_t bit(uint8_t service)
+{
+    switch (service) {
+    case QMI_SVC_DMS: return B_DMS;
+    case QMI_SVC_NAS: return B_NAS;
+    case QMI_SVC_WDS: return B_WDS;
+    case QMI_SVC_WDA: return B_WDA;
+    case QMI_SVC_DPM: return B_DPM;
+    default: return 0;
+    }
+}
+
+const char *cell_state_name(CellState st)
+{
+    static const char *const names[] = {"wait-ready", "dpm", "wda", "wda-verify", "online", "wait-online-allowed", "register",
+                                        "calls", "stopping", "stopped", "failed"};
+    return (unsigned)st < sizeof names / sizeof names[0] ? names[st] : "?";
+}
+
+static int ending(const CellSession *s) {return s->state >= CS_STOPPING;}
+
+static void event(CellSession *s, CellEvent e, uint32_t arg, const void *data, const char *text)
+{
+    if (s->ops.event) s->ops.event(s->ops.context, e, arg, data, text);
+}
+
+static void set_state(CellSession *s, CellState st)
+{
+    if (s->state == st) return;
+    s->state = st;
+    s->state_since = s->now;
+    s->tries = 0;
+    event(s, CE_STATE, st, 0, cell_state_name(st));
+}
+
+static void advance(CellSession *s);
+
+static void begin_stop(CellSession *s)
+{
+    if (ending(s)) return;
+    set_state(s, CS_STOPPING);
+    advance(s);
+}
+
+/* Every failure ends through cleanup; the reason is kept apart from it. */
+static void fail(CellSession *s, uint16_t message, const char *why)
+{
+    event(s, CE_ERROR, message, 0, why);
+    if (s->state == CS_STOPPED || s->state == CS_FAILED) return;
+    s->failing = 1;
+    begin_stop(s);
+}
+
+/* ---- outstanding requests ---- */
+static CellPending *find(CellSession *s, unsigned client, uint8_t service, uint16_t message)
+{
+    for (unsigned i = 0; i < CELL_PENDING; ++i) {
+        CellPending *p = &s->pending[i];
+        if (p->busy && p->client == client && p->service == service && p->message == message) return p;
+    }
+    return 0;
+}
+
+/* Transactions are never reused in one session. The last CLEANUP_TXNS are kept for Stop Network: setup that reaches them ends the
+ * session through cleanup (after about 45 hours of polling). 0 means none is left and nothing may be sent. */
+#define CLEANUP_TXNS 64u
+static uint16_t take_txn(CellSession *s)
+{
+    const uint16_t t = s->next_txn;
+    if (t >= CELL_TXN_RAW) return 0;
+    if (t >= CELL_TXN_RAW - CLEANUP_TXNS && !ending(s)) {
+        s->failing = 1;
+        event(s, CE_ERROR, 0, 0, "transaction space used up");
+        set_state(s, CS_STOPPING);  /* the caller's setup request is not sent: its builder gets no transaction */
+        return 0;
+    }
+    s->next_txn = (uint16_t)(t + 1);
+    return t;
+}
+
+/* Sends a built message (its transaction already inside) unless the same message is outstanding or its service is gone. Returns 1
+ * when sent. A transport refusal backs every step off for a second, so nothing is resent on each poll. */
+static int issue(CellSession *s, unsigned client, uint8_t service, const uint8_t *msg, uint32_t length)
+{
+    if (!length) return 0;
+    const uint16_t message = (uint16_t)(msg[3] | msg[4] << 8), txn = (uint16_t)(msg[1] | msg[2] << 8);
+    if (find(s, client, service, message) || !(s->services & bit(service))) return 0;
+    if (ending(s) && !(service == QMI_SVC_WDS && message == WDS_STOP_NETWORK)) return 0;  /* teardown sends only Stop Network */
+    for (unsigned i = 0; i < CELL_PENDING; ++i) {
+        CellPending *p = &s->pending[i];
+        if (p->busy) continue;
+        if (s->ops.send(s->ops.context, client, service, msg, length)) {
+            s->backoff_until = s->now + SEND_BACKOFF_MS;
+            return 0;
+        }
+        *p = (CellPending){1, (uint8_t)client, service, txn, message, s->now};
+        return 1;
+    }
+    return 0;
+}
+
+/* Builds with a fresh transaction and sends. */
+#define SEND(s, client, service, builder, ...) do { \
+        uint8_t b_[256]; const uint16_t t_ = take_txn(s); \
+        if (t_) (void)issue((s), (client), (service), b_, builder(b_, sizeof b_, t_, ##__VA_ARGS__)); \
+    } while (0)
+
+/* The outstanding request this response answers, freed; null when it answers nothing of ours. */
+static CellPending *answered(CellSession *s, unsigned client, uint8_t service, const uint8_t *msg, uint32_t length)
+{
+    if (length < QCOM_QMI_HEADER || msg[0] != QCOM_QMI_RESPONSE) return 0;
+    const uint16_t txn = (uint16_t)(msg[1] | msg[2] << 8), message = (uint16_t)(msg[3] | msg[4] << 8);
+    for (unsigned i = 0; i < CELL_PENDING; ++i) {
+        CellPending *p = &s->pending[i];
+        if (p->busy && p->client == client && p->service == service && p->txn == txn && p->message == message) {
+            p->busy = 0;
+            return p;
+        }
+    }
+    return 0;
+}
+
+/* ---- the steps ---- */
+/* Read-only queries for the log; allowed before the readiness barrier. */
+static void info(CellSession *s)
+{
+    if (s->info_sent) return;
+    s->info_sent = 1;
+    SEND(s, 0, QMI_SVC_DMS, dms_get_revision);
+    SEND(s, 0, QMI_SVC_DMS, dms_get_ids);
+    SEND(s, 0, QMI_SVC_NAS, nas_get_operator_name);
+    SEND(s, 0, QMI_SVC_NAS, nas_get_signal_info);
+    SEND(s, 0, QMI_SVC_WDS, wds_get_profile_list);
+}
+
+/* A session step's next attempt: 1 when it should send now (the attempt is charged), 0 when it waits or has failed. */
+static int step_once(CellSession *s, unsigned client, uint8_t service, uint16_t message)
+{
+    if (find(s, client, service, message)) return 0;
+    if (s->tries++ >= STEP_TRIES) {fail(s, message, "no usable answer"); return 0;}
+    return 1;
+}
+
+static void reread_mode(CellSession *s)
+{
+    if (s->now < s->next_poll) return;
+    s->next_poll = s->now + POLL_MS;
+    s->mode_known = 0;
+    s->tries = 0;
+}
+
+static void exhaust(CellSession *s, CellCall *c, const char *why)
+{
+    if (c->exhausted) return;
+    c->exhausted = 1;
+    event(s, CE_ERROR, c->family, 0, why);
+    const CellCall *other = c == &s->call[0] ? &s->call[1] : &s->call[0];
+    if (!other->family || other->exhausted) fail(s, 0, "no call can come up");
+}
+
+/* One charged attempt of a call's bind or family step. */
+static int call_try(CellSession *s, CellCall *c, uint16_t message)
+{
+    if (find(s, c->client, QMI_SVC_WDS, message) || s->now < c->next_try) return 0;
+    if (c->step_tries++ >= STEP_TRIES) {exhaust(s, c, "bind or family refused"); return 0;}
+    return 1;
+}
+
+static void call_step(CellSession *s, CellCall *c)
+{
+    const CellConfig *cfg = &s->cfg;
+    if (!c->family || c->exhausted) return;
+    if (c->drop) {  /* a handle whose settings never came: stop it, then start again */
+        if (s->now - c->drop_since >= STOP_MS) {exhaust(s, c, "an unusable call would not stop"); return;}
+        if (c->handle && !find(s, c->client, QMI_SVC_WDS, WDS_STOP_NETWORK) && s->now >= c->next_try) {
+            c->next_try = s->now + STEP_RETRY_MS;
+            SEND(s, c->client, QMI_SVC_WDS, wds_stop_network, c->handle);
+        }
+        return;
+    }
+    if (!c->bound) {
+        if (call_try(s, c, WDS_BIND_MUX_DATA_PORT))
+            SEND(s, c->client, QMI_SVC_WDS, wds_bind_mux, QMI_ENDPOINT_EMBEDDED, cfg->ep_interface, cfg->mux);
+        return;
+    }
+    if (!c->family_set) {
+        if (call_try(s, c, WDS_SET_IP_FAMILY)) SEND(s, c->client, QMI_SVC_WDS, wds_set_ip_family, c->family);
+        return;
+    }
+    if (c->handle) {
+        if (c->up || find(s, c->client, QMI_SVC_WDS, WDS_GET_CURRENT_SETTINGS) || s->now < c->next_try) return;
+        if (c->settings_tries >= STEP_TRIES) {
+            event(s, CE_ERROR, WDS_GET_CURRENT_SETTINGS, 0, "no usable settings: stopping the call");
+            c->drop = 1;
+            c->drop_since = s->now;
+            return;
+        }
+        c->settings_tries++;
+        SEND(s, c->client, QMI_SVC_WDS, wds_get_current_settings);
+        return;
+    }
+    if (c->start_unknown) {  /* no new start while an earlier one may still bring a handle */
+        if (s->now - c->start_sent >= START_UNKNOWN_MS) exhaust(s, c, "a start never answered");
+        return;
+    }
+    if (!s->registered || s->now < c->next_start) return;
+    /* the budget covers the whole cycle: it is reset only when a call comes up */
+    if (c->start_tries >= START_TRIES) {exhaust(s, c, "start network: tries used up"); return;}
+    c->start_tries++;
+    c->next_start = s->now + START_RETRY_MS;
+    const WdsCall call = {cfg->apn, 0, 0, 0, 0xff, cfg->profile, c->family};
+    uint8_t m[256];
+    const uint16_t txn = take_txn(s);
+    if (txn && issue(s, c->client, QMI_SVC_WDS, m, wds_start_network(m, sizeof m, txn, &call))) {
+        c->start_unknown = 1;
+        c->start_txn = txn;
+        c->start_sent = s->now;
+    }
+}
+
+static void call_down(CellSession *s, CellCall *c, const WdsPacketStatus *st)
+{
+    const int was_up = c->up;
+    c->handle = WDS_HANDLE_NONE;
+    c->up = c->drop = 0;
+    c->settings_tries = 0;
+    c->next_start = s->now + START_RETRY_MS;
+    if (was_up) event(s, CE_DOWN, c->family, st, "call ended");
+}
+
+static void finish(CellSession *s)
+{
+    for (unsigned i = 0; i < 2; ++i) if (s->call[i].up) {s->call[i].up = 0; event(s, CE_DOWN, s->call[i].family, 0, "session ended");}
+    set_state(s, s->failing ? CS_FAILED : CS_STOPPED);
+}
+
+static void stopping(CellSession *s)
+{
+    unsigned live = 0;
+    for (unsigned i = 0; i < 2; ++i) {
+        CellCall *c = &s->call[i];
+        if (c->start_unknown) live++;  /* its answer may still bring a handle, even past its reply deadline */
+        if (c->handle == WDS_HANDLE_NONE) continue;
+        live++;
+        if (!find(s, c->client, QMI_SVC_WDS, WDS_STOP_NETWORK) && s->now >= c->next_try) {
+            c->next_try = s->now + STEP_RETRY_MS;
+            SEND(s, c->client, QMI_SVC_WDS, wds_stop_network, c->handle);
+        }
+    }
+    if (live && s->now - s->state_since < STOP_MS) return;
+    if (live) {
+        s->unresolved = 1;
+        event(s, CE_ERROR, WDS_STOP_NETWORK, 0, "cleanup not confirmed within 5 s: a handle or a start is unresolved");
+    }
+    finish(s);
+}
+
+static void advance(CellSession *s)
+{
+    const CellConfig *cfg = &s->cfg;
+    if (s->state > CS_WAIT_READY && !ending(s) && !s->is_ready) {fail(s, 0, "readiness lost (USIM or IPA)"); return;}
+    if (s->now < s->backoff_until) return;
+    switch (s->state) {
+    case CS_WAIT_READY:
+        if ((s->services & B_ALL) != B_ALL) return;
+        info(s);
+        if (!s->is_ready) return;
+        set_state(s, CS_DPM);
+        if (!s->indications_sent) {  /* a subscription change, so only past the barrier */
+            s->indications_sent = 1;
+            SEND(s, 0, QMI_SVC_NAS, nas_register_indications);
+        }
+        advance(s);
+        return;
+    case CS_DPM:
+        if (step_once(s, 0, QMI_SVC_DPM, DPM_OPEN_PORT))
+            SEND(s, 0, QMI_SVC_DPM, dpm_open_port, QMI_ENDPOINT_EMBEDDED, cfg->ep_interface, cfg->ipa_rx, cfg->ipa_tx);
+        return;
+    case CS_WDA:
+        if (step_once(s, 0, QMI_SVC_WDA, WDA_SET_DATA_FORMAT)) {
+            const uint32_t agg = s->ready.qmap == QMAP_V5 ? WDA_AGG_QMAPV5 : WDA_AGG_QMAP;
+            const WdaFormat f = {WDA_LINK_RAW_IP, agg, agg, s->ready.dl_max_datagrams, s->ready.dl_max_size, 0, 0,
+                                 QMI_ENDPOINT_EMBEDDED, cfg->ep_interface, 0};
+            SEND(s, 0, QMI_SVC_WDA, wda_set_data_format, &f);
+        }
+        return;
+    case CS_WDA_VERIFY:
+        if (step_once(s, 0, QMI_SVC_WDA, WDA_GET_DATA_FORMAT))
+            SEND(s, 0, QMI_SVC_WDA, wda_get_data_format, QMI_ENDPOINT_EMBEDDED, cfg->ep_interface);
+        return;
+    case CS_ONLINE:
+        if (!s->mode_known) {
+            if (step_once(s, 0, QMI_SVC_DMS, DMS_GET_OPERATING_MODE)) SEND(s, 0, QMI_SVC_DMS, dms_get_operating_mode);
+            return;
+        }
+        if (s->mode == DMS_MODE_ONLINE) {set_state(s, CS_REGISTER); return;}
+        if (!cfg->allow_online) {set_state(s, CS_WAIT_ONLINE_ALLOWED); return;}
+        if (!s->online_sent) {
+            if (find(s, 0, QMI_SVC_DMS, DMS_SET_OPERATING_MODE)) return;
+            s->online_sent = 1;
+            SEND(s, 0, QMI_SVC_DMS, dms_set_operating_mode, DMS_MODE_ONLINE);
+        } else {
+            reread_mode(s);
+        }
+        return;
+    case CS_WAIT_ONLINE_ALLOWED:
+        /* the raw tool may put the modem online by hand; this only reads the mode */
+        if (s->mode_known && s->mode == DMS_MODE_ONLINE) {set_state(s, CS_REGISTER); return;}
+        if (!s->mode_known) {
+            if (!find(s, 0, QMI_SVC_DMS, DMS_GET_OPERATING_MODE)) SEND(s, 0, QMI_SVC_DMS, dms_get_operating_mode);
+            return;
+        }
+        reread_mode(s);
+        return;
+    case CS_REGISTER:
+    case CS_CALLS:
+        if (s->now >= s->next_poll && !find(s, 0, QMI_SVC_NAS, NAS_SERVING_SYSTEM)) {
+            s->next_poll = s->now + POLL_MS;
+            SEND(s, 0, QMI_SVC_NAS, nas_get_serving_system);
+            if (ending(s)) return;  /* that poll may have reached the cleanup reserve */
+        }
+        if (s->state == CS_REGISTER) {
+            if (!s->registered) return;
+            set_state(s, CS_CALLS);
+        }
+        call_step(s, &s->call[0]);
+        if (!ending(s)) call_step(s, &s->call[1]);
+        return;
+    case CS_STOPPING:
+        stopping(s);
+        return;
+    default:
+        return;
+    }
+}
+
+/* ---- replies ---- */
+/* 1: the modem uses exactly the asked format within the receive limits; 0: it echoed too little to tell; -1: something differs. */
+static int check_format(const CellSession *s, const WdaFormat *f)
+{
+    const uint32_t agg = s->ready.qmap == QMAP_V5 ? WDA_AGG_QMAPV5 : WDA_AGG_QMAP;
+    const uint32_t all = WDA_HAS_LINK | WDA_HAS_UL_AGG | WDA_HAS_DL_AGG | WDA_HAS_DL_DATAGRAMS | WDA_HAS_DL_SIZE;
+    if (((f->present & WDA_HAS_LINK) && f->link != WDA_LINK_RAW_IP) || ((f->present & WDA_HAS_UL_AGG) && f->ul_agg != agg) ||
+        ((f->present & WDA_HAS_DL_AGG) && f->dl_agg != agg)) return -1;
+    /* the downlink limits must be confirmed, positive and within one receive buffer */
+    if ((f->present & WDA_HAS_DL_DATAGRAMS) && (!f->dl_max_datagrams || f->dl_max_datagrams > s->ready.dl_max_datagrams)) return -1;
+    if ((f->present & WDA_HAS_DL_SIZE) && (!f->dl_max_size || f->dl_max_size > s->ready.dl_max_size)) return -1;
+    return (f->present & all) == all ? 1 : 0;
+}
+
+static int usable(const CellCall *c, const WdsSettings *w)
+{
+    if (w->has_family && w->family != c->family) return 0;  /* the modem says this is another family's call, or none */
+    if (c->family == WDS_FAMILY_IPV4) {
+        const uint32_t a = w->v4_addr, top = a >> 24;
+        return w->has_v4 && top != 0 && top != 127 && top < 224;  /* not this-network, loopback, multicast or broadcast */
+    }
+    unsigned prefix_bits = 0;
+    for (unsigned i = 0; i < 8; ++i) prefix_bits |= w->v6_addr[i];
+    /* the same rule CellLink applies: a global /64, never unspecified, link-local or multicast */
+    return w->has_v6 && w->v6_prefix == 64 && prefix_bits && w->v6_addr[0] != 0xff &&
+           !(w->v6_addr[0] == 0xfe && (w->v6_addr[1] & 0xc0) == 0x80);
+}
+
+static void wds_message(CellSession *s, unsigned client, const uint8_t *msg, uint32_t length, const CellPending *p)
+{
+    CellCall *c = client == 0 ? &s->call[0] : &s->call[1];
+    QcomQmiMessage m;
+    char line[96];
+    if (msg[0] == QCOM_QMI_INDICATION) {
+        WdsPacketStatus st;
+        if (wds_parse_packet_status(msg, length, &st) || !c->family || !c->handle) return;
+        if (st.status == WDS_STATUS_DISCONNECTED) call_down(s, c, &st);
+        else if (st.status == WDS_STATUS_CONNECTED && st.reconfigure && !ending(s)) {
+            if (c->up) event(s, CE_DOWN, c->family, &st, "reconfiguring");  /* withdrawn until the new settings are read */
+            c->up = 0;
+            c->settings_tries = 0;
+        }
+        advance(s);
+        return;
+    }
+    if (!p) return;
+    const int stop_phase = ending(s);
+    switch (p->message) {
+    case WDS_GET_PROFILE_LIST: {
+        WdsProfiles list;
+        if (stop_phase || wds_parse_profile_list(msg, length, p->txn, &list)) return;
+        for (unsigned i = 0; i < list.count && i < 4; ++i) SEND(s, 0, QMI_SVC_WDS, wds_get_profile_settings, list.p[i].index);
+        snprintf(line, sizeof line, "%u 3GPP profiles", list.total);
+        event(s, CE_INFO, 0, &list, line);
+        return;
+    }
+    case WDS_GET_PROFILE_SETTINGS: {
+        WdsProfile pr;
+        if (stop_phase || wds_parse_profile_settings(msg, length, p->txn, &pr)) return;
+        snprintf(line, sizeof line, "profile '%s' APN '%s' PDP %u", pr.name, pr.apn, pr.has_pdp ? pr.pdp_type : 0xffu);
+        event(s, CE_INFO, 0, 0, line);  /* the name and APN only: usernames and passwords are never decoded */
+        return;
+    }
+    case WDS_BIND_MUX_DATA_PORT:
+    case WDS_SET_IP_FAMILY:
+        if (stop_phase) return;
+        if (qmi_response(msg, length, p->txn, p->message, &m)) {
+            event(s, CE_ERROR, p->message, 0, p->message == WDS_SET_IP_FAMILY ? "set IP family refused" : "bind mux refused");
+            c->next_try = s->now + STEP_RETRY_MS;
+        } else if (p->message == WDS_SET_IP_FAMILY) {
+            c->family_set = 1;
+            c->step_tries = 0;
+        } else {
+            c->bound = 1;
+            c->step_tries = 0;
+        }
+        break;
+    case WDS_START_NETWORK: {
+        WdsStarted st;
+        const int rc = wds_parse_start(msg, length, p->txn, &st);
+        /* only a valid success with a handle, or a valid failure result, settles who owns the call; a malformed reply keeps the
+         * start unresolved (still blocking new starts and counted by cleanup) and a later valid answer is still adopted */
+        if (rc >= 0 && p->txn == c->start_txn) c->start_unknown = 0;
+        if (rc < 0) {
+            event(s, CE_ERROR, p->message, 0, "malformed start reply: outcome still unknown");
+            break;
+        }
+        if (rc == 0) {
+            c->handle = st.handle;  /* in the stop phase too, so STOPPING stops it */
+            c->settings_tries = 0;
+            break;
+        }
+        if (stop_phase) return;
+        snprintf(line, sizeof line, "start IPv%u refused: error %d, end reason %u, verbose %u/%d (try %u)", c->family, rc,
+                 st.end_reason, st.verbose_type, st.verbose_reason, c->start_tries);
+        event(s, CE_ERROR, p->message, &st, line);
+        /* the packet domain still attaching, or a call the network failed: retried after the backoff; anything else stops it */
+        if (rc > 0 && rc != QMI_ERR_INVALID_OPERATION && rc != QMI_ERR_CALL_FAILED) exhaust(s, c, "start network refused");
+        break;
+    }
+    case WDS_GET_CURRENT_SETTINGS: {
+        WdsSettings w;
+        if (stop_phase || !c->handle) return;
+        if (wds_parse_settings(msg, length, p->txn, &w) || !usable(c, &w)) {
+            event(s, CE_ERROR, p->message, 0, "settings without a usable address for this family");
+            c->next_try = s->now + STEP_RETRY_MS;
+            break;
+        }
+        c->settings = w;
+        c->up = 1;
+        c->start_tries = 0;
+        event(s, CE_UP, c->family, &c->settings, "call up");
+        return;
+    }
+    case WDS_STOP_NETWORK: {
+        const int rc = qmi_response(msg, length, p->txn, p->message, &m);
+        if (rc != 0 && rc != QMI_ERR_NO_EFFECT) {
+            event(s, CE_ERROR, p->message, 0, "stop network refused; retrying");  /* the handle stays until a stop succeeds */
+            break;
+        }
+        call_down(s, c, 0);
+        break;
+    }
+    default:
+        return;
+    }
+    advance(s);
+}
+
+static void dms_message(CellSession *s, const uint8_t *msg, uint32_t length, const CellPending *p)
+{
+    QcomQmiMessage m;
+    char line[96];
+    if (!p) return;
+    if (p->message == DMS_GET_REVISION) {
+        DmsRevision r;
+        if (!dms_parse_revision(msg, length, p->txn, &r)) {snprintf(line, sizeof line, "revision %s", r.text); event(s, CE_INFO, 0, 0, line);}
+    } else if (p->message == DMS_GET_IDS) {
+        DmsIds ids;
+        if (!dms_parse_ids(msg, length, p->txn, &ids) && ids.has_imei) {
+            snprintf(line, sizeof line, "IMEI ending %s", ids.imei_last4);
+            event(s, CE_INFO, 0, 0, line);
+        }
+    } else if (p->message == DMS_GET_OPERATING_MODE) {
+        DmsMode md;
+        if (dms_parse_operating_mode(msg, length, p->txn, &md)) return;
+        s->mode = md.mode;
+        s->mode_known = 1;
+        s->tries = 0;
+        snprintf(line, sizeof line, "operating mode %u, offline reason %#x", md.mode, md.offline_reason);
+        event(s, CE_INFO, md.mode, &md, line);
+    } else if (p->message == DMS_SET_OPERATING_MODE && s->state == CS_ONLINE) {
+        if (qmi_response(msg, length, p->txn, p->message, &m)) {fail(s, p->message, "online refused"); return;}
+        s->mode_known = 0;  /* read it back */
+        s->tries = 0;
+    }
+}
+
+static void nas_message(CellSession *s, const uint8_t *msg, uint32_t length, const CellPending *p)
+{
+    const uint16_t message = (uint16_t)(msg[3] | msg[4] << 8), txn = p ? p->txn : 0;
+    if (message == NAS_SERVING_SYSTEM) {
+        NasServing sv;
+        if (nas_parse_serving(msg, length, txn, &sv)) return;
+        s->serving = sv;
+        s->registered = (uint8_t)nas_registered_for_data(&sv);
+        event(s, CE_SERVING, s->registered, &sv, 0);
+    } else if (message == NAS_GET_SIGNAL_INFO || message == NAS_SIGNAL_INFO_IND) {
+        NasSignal sg;
+        if (!nas_parse_signal(msg, length, txn, &sg)) event(s, CE_SIGNAL, (uint32_t)nas_bars(&sg), &sg, 0);
+    } else if (message == NAS_GET_OPERATOR_NAME || message == NAS_OPERATOR_NAME_IND) {
+        NasOperator op;
+        if (!nas_parse_operator(msg, length, txn, &op)) event(s, CE_OPERATOR, 0, &op, 0);
+    }
+}
+
+void cell_session_receive(CellSession *s, unsigned client, uint8_t service, const uint8_t *msg, uint32_t length)
+{
+    QcomQmiMessage m;
+    if (client > 1 || length < QCOM_QMI_HEADER) return;
+    const CellPending *p = answered(s, client, service, msg, length);
+    CellPending late;
+    if (msg[0] == QCOM_QMI_RESPONSE && !p && service == QMI_SVC_WDS) {
+        /* a start answered after its reply deadline still owns whatever handle it brings */
+        const CellCall *c = client ? &s->call[1] : &s->call[0];
+        const uint16_t txn = (uint16_t)(msg[1] | msg[2] << 8), message = (uint16_t)(msg[3] | msg[4] << 8);
+        if (c->start_unknown && message == WDS_START_NETWORK && txn == c->start_txn) {
+            late = (CellPending){0, (uint8_t)client, service, txn, message, 0};
+            p = &late;
+        }
+    }
+    if (msg[0] == QCOM_QMI_RESPONSE && !p) return;  /* late, duplicate or the raw tool's */
+    if (service == QMI_SVC_WDS) {wds_message(s, client, msg, length, p); return;}
+    if (client != 0 || ending(s)) return;           /* in the stop phase only WDS cleanup matters */
+    if (service == QMI_SVC_NAS) nas_message(s, msg, length, p);
+    else if (service == QMI_SVC_DMS) dms_message(s, msg, length, p);
+    else if (service == QMI_SVC_DPM && p && p->message == DPM_OPEN_PORT && s->state == CS_DPM) {
+        const int rc = qmi_response(msg, length, p->txn, p->message, &m);
+        if (rc && rc != QMI_ERR_NO_EFFECT) {fail(s, p->message, "open port refused"); return;}
+        set_state(s, CS_WDA);
+    } else if (service == QMI_SVC_WDA && p && (p->message == WDA_SET_DATA_FORMAT || p->message == WDA_GET_DATA_FORMAT) &&
+               s->state == (p->message == WDA_SET_DATA_FORMAT ? CS_WDA : CS_WDA_VERIFY)) {
+        WdaFormat f;
+        if (wda_parse_data_format(msg, length, p->txn, p->message, &f)) {fail(s, p->message, "data format refused"); return;}
+        const int ok = check_format(s, &f);
+        if (ok < 0 || (ok == 0 && p->message == WDA_GET_DATA_FORMAT)) {fail(s, p->message, "data format differs"); return;}
+        set_state(s, ok ? CS_ONLINE : CS_WDA_VERIFY);
+    }
+    if (!ending(s)) advance(s);
+}
+
+/* ---- the owner's side ---- */
+void cell_session_init(CellSession *s, const CellConfig *cfg, const CellSessionOps *ops, uint64_t now_ms)
+{
+    *s = (CellSession){0};
+    s->ops = *ops;
+    s->cfg = *cfg;
+    s->now = s->state_since = now_ms;
+    s->next_txn = 1;
+    s->state = CS_WAIT_READY;
+    if (cfg->want_v4) s->call[0] = (CellCall){.family = WDS_FAMILY_IPV4, .client = 0};
+    if (cfg->want_v6) s->call[1] = (CellCall){.family = WDS_FAMILY_IPV6, .client = 1};
+}
+
+void cell_session_service(CellSession *s, uint8_t service, int present)
+{
+    const uint8_t b = bit(service);
+    if (!b) return;
+    if (present) s->services |= b;
+    else {
+        s->services &= (uint8_t)~b;
+        if (s->state != CS_WAIT_READY && !ending(s)) fail(s, 0, "a service went away");
+    }
+    advance(s);
+}
+
+void cell_session_ready(CellSession *s, const CellReady *r)
+{
+    if (!r) {
+        s->is_ready = 0;
+        if (s->state != CS_WAIT_READY && !ending(s)) fail(s, 0, "readiness lost (USIM or IPA)");
+        return;
+    }
+    if (s->state != CS_WAIT_READY || (r->qmap != QMAP_V1 && r->qmap != QMAP_V5) || !r->dl_max_datagrams || !r->dl_max_size) return;
+    s->ready = *r;
+    s->is_ready = 1;
+    advance(s);
+}
+
+void cell_session_poll(CellSession *s, uint64_t now_ms)
+{
+    s->now = now_ms;
+    for (unsigned i = 0; i < CELL_PENDING; ++i) {
+        CellPending *p = &s->pending[i];
+        if (p->busy && now_ms - p->sent >= REPLY_MS) {
+            p->busy = 0;
+            event(s, CE_ERROR, p->message, 0, "request timed out");
+        }
+    }
+    advance(s);
+}
+
+void cell_session_stop(CellSession *s)
+{
+    if (s->state == CS_WAIT_READY) {set_state(s, CS_STOPPED); return;}  /* nothing that changes modem state was sent */
+    begin_stop(s);
+}
+
+int cell_session_idle(const CellSession *s)
+{
+    return s->state == CS_STOPPED || s->state == CS_FAILED || s->state == CS_WAIT_READY;
+}
+
+CellCleanup cell_session_cleanup(const CellSession *s)
+{
+    if (!cell_session_idle(s)) return CELL_CLEANUP_PENDING;
+    if (s->unresolved) return CELL_CLEANUP_UNRESOLVED;
+    for (unsigned i = 0; i < 2; ++i)
+        if (s->call[i].handle != WDS_HANDLE_NONE || s->call[i].start_unknown) return CELL_CLEANUP_UNRESOLVED;
+    return CELL_CLEANUP_CLEAN;
+}
+#endif
