@@ -0,0 +1,106 @@
+#if defined(ARM64_BOARD_CONFIG_SWEET) || !defined(KERNEL)
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Message ids: libqmi data/qmi-service-*.json. */
+#include "QmiRaw.h"
+#include "QmiData.h"
+
+#ifndef EINVAL
+#define EINVAL 22
+#endif
+#ifndef EPERM
+#define EPERM 1
+#endif
+
+static int listed(uint16_t id, const uint16_t *ids, unsigned n)
+{
+    for (unsigned i = 0; i < n; ++i) if (ids[i] == id) return 1;
+    return 0;
+}
+
+/* Reads only. The DMS mode and NAS mode-preference checks below stay for a later readiness-gated path; neither id is listed now. Left out on purpose: every Reset (0x00), WDS profile
+ * create/modify/delete/settings (writes, or replies carrying credentials), Start/Stop Network (handles the kernel could not tear
+ * down), Bind, Set IP Family, event and indication registration, WDA Set Data Format and DPM (session state), NAS network scan and
+ * signal reporting setup, and DMS reads of identifiers (IDs, MSISDN, ICCID, IMSI). */
+static const uint16_t dms_ok[] = {0x1e, 0x20, 0x21, 0x22, 0x23, 0x26, 0x2b, 0x2c, 0x2d, 0x2f, 0x31, 0x44, 0x45, 0x51};
+static const uint16_t nas_ok[] = {0x1e, 0x20, 0x24, 0x25, 0x26, 0x2b, 0x31, 0x34, 0x39, 0x43, 0x44, 0x4d, 0x4f, 0x5a, 0x7d, 0x89,
+                                  0xac, 0xe8};
+static const uint16_t wds_ok[] = {0x1e, 0x22, 0x23, 0x24, 0x2a, 0x2d, 0x30, 0x34, 0x37, 0x44, 0x49, 0x6c, 0x85, 0x92, 0x94, 0xb0};
+static const uint16_t wda_ok[] = {0x1e, 0x21};
+static const uint16_t uim_ok[] = {0x2f};  /* card status; slot status carries the ICCID */
+
+/* Every TLV of m has a type in allowed (n of them) and appears once. */
+static int only(const QcomQmiMessage *m, const uint8_t *allowed, unsigned n)
+{
+    uint8_t seen[256] = {0};
+    for (uint32_t at = 0; at + 3 <= m->length;) {
+        const uint8_t type = m->tlvs[at];
+        const uint32_t size = (uint32_t)m->tlvs[at + 1] | (uint32_t)m->tlvs[at + 2] << 8;
+        int ok = !allowed;
+        for (unsigned i = 0; allowed && i < n; ++i) ok |= allowed[i] == type;
+        if (!ok || seen[type]++) return 0;
+        at += 3 + size;
+    }
+    return 1;
+}
+
+int qmi_raw_allowed(uint8_t service, const uint8_t *msg, uint32_t length)
+{
+    QcomQmiMessage m;
+    uint32_t n = 0;
+    if (length < QCOM_QMI_HEADER) return EPERM;
+    /* parse as the request it will become */
+    uint8_t copy[QMI_RAW_MAX];
+    if (length > sizeof copy) return EPERM;
+    for (uint32_t i = 0; i < length; ++i) copy[i] = msg[i];
+    copy[0] = QCOM_QMI_REQUEST;
+    if (qcom_qmi_parse(copy, length, &m) || !only(&m, 0, 0)) return EPERM;  /* no duplicate TLV anywhere */
+    const uint16_t id = m.message;
+#define IN(list) listed(id, list, sizeof list / sizeof list[0])
+    switch (service) {
+    case QMI_SVC_DMS:
+        if (!IN(dms_ok)) return EPERM;
+        if (id == DMS_SET_OPERATING_MODE) {
+            static const uint8_t t[] = {0x01};
+            const uint8_t *v = qcom_qmi_tlv(&m, 0x01, &n);
+            if (!only(&m, t, 1) || !v || n != 1 || (v[0] != DMS_MODE_ONLINE && v[0] != DMS_MODE_LOW_POWER)) return EPERM;
+        }
+        return 0;
+    case QMI_SVC_NAS:
+        if (!IN(nas_ok)) return EPERM;
+        if (id == NAS_SET_SYSTEM_SELECTION) {
+            static const uint8_t t[] = {0x11, 0x17};  /* mode preference and change duration only */
+            const uint8_t *d = qcom_qmi_tlv(&m, 0x17, &n);
+            if (!only(&m, t, 2) || !d || n != 1 || d[0] != 0) return EPERM;
+            const uint8_t *v = qcom_qmi_tlv(&m, 0x11, &n);
+            if (!v || n != 2 || !(v[0] | v[1]) || v[0] >> 7 || v[1]) return EPERM;
+        }
+        return 0;
+    case QMI_SVC_WDS: return IN(wds_ok) ? 0 : EPERM;
+    case QMI_SVC_WDA: return IN(wda_ok) ? 0 : EPERM;
+    case QMI_SVC_UIM: return IN(uim_ok) ? 0 : EPERM;
+    default: return EPERM;
+    }
+#undef IN
+}
+
+int qmi_raw_indication_kept(uint8_t service, uint16_t message)
+{
+    return (service == QMI_SVC_NAS && (message == NAS_SERVING_SYSTEM || message == NAS_SIGNAL_INFO_IND ||
+                                       message == NAS_OPERATOR_NAME_IND)) ||
+           (service == QMI_SVC_WDS && message == WDS_PACKET_SERVICE_STATUS);
+}
+
+int qmi_raw_parse(const uint8_t *buf, uint32_t length, QmiRawRequest *out)
+{
+    if (length < QMI_RAW_REQUEST_HEADER + QCOM_QMI_HEADER || length > QMI_RAW_REQUEST_HEADER + QMI_RAW_MAX) return EINVAL;
+    if (buf[0] != QMI_RAW_VERSION || buf[3]) return EINVAL;
+    out->service = buf[1];
+    out->client = buf[2];
+    out->timeout_ms = (uint32_t)buf[4] | (uint32_t)buf[5] << 8 | (uint32_t)buf[6] << 16 | (uint32_t)buf[7] << 24;
+    if (!out->timeout_ms || out->timeout_ms > QMI_RAW_TIMEOUT_MAX) return EINVAL;
+    out->msg = buf + QMI_RAW_REQUEST_HEADER;
+    out->length = length - QMI_RAW_REQUEST_HEADER;
+    if (out->client != 0) return EINVAL;  /* client 1 belongs to the session's IPv6 call */
+    return qmi_raw_allowed(out->service, out->msg, out->length);
+}
+#endif
