@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* QMAP (rmnet MAP) framing of the IPA's modem data endpoints. Each packet has a 4-byte header: flags (bit 7 command, bit 6 next header,
+ * bits 5..0 trailing pad length), mux id, and a big-endian length that counts the payload and its pad but not the headers. With
+ * QMAPv5 every data packet carries a 4-byte checksum header after it (type 2 in bits 7..1 of its first byte). Downlink aggregates are
+ * several such packets back to back. Layout as Linux include/linux/if_rmnet.h and rmnet_map_data.c. */
+#ifndef QMAP_H
+#define QMAP_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QMAP_HEADER 4u
+#define QMAP_CSUM_HEADER 4u
+#define QMAP_FLAG_COMMAND 0x80u
+#define QMAP_FLAG_NEXT 0x40u
+#define QMAP_PAD_MASK 0x3fu
+
+typedef enum {QMAP_V1 = 1, QMAP_V5 = 5} QmapVersion;
+
+typedef struct {
+    uint64_t packets, commands, bad, unknown_mux, empty;
+} QmapCounters;
+
+/* One data packet or command from an aggregate. data/length are the IP packet (pad removed) or the whole command payload. */
+typedef void (*QmapDeliver)(void *context, uint8_t mux, int command, const uint8_t *data, uint32_t length);
+
+/* Splits one received buffer. Packets whose mux is not in mux_mask (bit n = mux n, muxes 0..31) are counted and dropped; commands are
+ * delivered whatever their mux. Returns how many packets and commands were delivered; stops at the first malformed header and counts it
+ * in bad. */
+uint32_t qmap_deaggregate(QmapVersion version, const uint8_t *buf, uint32_t length, uint32_t mux_mask, QmapDeliver deliver,
+                          void *context, QmapCounters *counters);
+
+/* Bytes of headroom qmap_frame() needs in front of the packet. */
+uint32_t qmap_headroom(QmapVersion version);
+/* Writes the header(s) into the headroom just before packet (which must have qmap_headroom() bytes before it) for one uplink packet,
+ * with no pad and no checksum offload request. Returns the framed length, or 0 when the packet is empty or too long. */
+uint32_t qmap_frame(QmapVersion version, uint8_t mux, uint8_t *packet, uint32_t length);
+
+/* A received command that is a request becomes the acknowledgement to send back (the same bytes with the type set to ack, as Linux
+ * rmnet_map_send_ack does); out must hold QMAP_HEADER + length bytes. Returns the ack's length, or 0 when no ack is owed. */
+uint32_t qmap_command_ack(uint8_t mux, const uint8_t *command, uint32_t length, uint8_t *out, uint32_t capacity);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
--- /dev/null
+++ b/bsd/dev/data/QmiData.c
@@ -0,0 +1,565 @@
+#if defined(ARM64_BOARD_CONFIG_SWEET) || !defined(KERNEL)
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Layouts: libqmi data/qmi-service-{dms,nas,wds,wda,dpm}.json. Integers are little-endian, IPv6 words big-endian. A string that is a
+ * whole TLV has no length byte; a string inside a sequence or array element has a one-byte length before it. */
+#include "QmiData.h"
+
+static uint16_t le16(const uint8_t *p) {return (uint16_t)(p[0] | p[1] << 8);}
+static uint32_t le32(const uint8_t *p) {return (uint32_t)le16(p) | (uint32_t)le16(p + 2) << 16;}
+
+/* ---- building ---- */
+void qmi_begin(QmiOut *o, uint8_t *buf, uint32_t cap, uint16_t transaction, uint16_t message)
+{
+    o->buf = buf; o->cap = cap; o->len = QCOM_QMI_HEADER; o->bad = cap < QCOM_QMI_HEADER;
+    if (o->bad) return;
+    buf[0] = QCOM_QMI_REQUEST;
+    buf[1] = (uint8_t)transaction; buf[2] = (uint8_t)(transaction >> 8);
+    buf[3] = (uint8_t)message; buf[4] = (uint8_t)(message >> 8);
+}
+
+void qmi_put_bytes(QmiOut *o, uint8_t type, const void *v, uint32_t n)
+{
+    if (o->bad || n > 0xffff || o->cap - o->len < 3 || o->cap - o->len - 3 < n || (n && !v)) {o->bad = 1; return;}
+    uint8_t *p = o->buf + o->len;
+    p[0] = type; p[1] = (uint8_t)n; p[2] = (uint8_t)(n >> 8);
+    for (uint32_t i = 0; i < n; ++i) p[3 + i] = ((const uint8_t *)v)[i];
+    o->len += 3 + n;
+}
+
+void qmi_put_u8(QmiOut *o, uint8_t type, uint8_t v) {qmi_put_bytes(o, type, &v, 1);}
+void qmi_put_u16(QmiOut *o, uint8_t type, uint16_t v) {uint8_t b[2] = {(uint8_t)v, (uint8_t)(v >> 8)}; qmi_put_bytes(o, type, b, 2);}
+void qmi_put_u32(QmiOut *o, uint8_t type, uint32_t v)
+{
+    uint8_t b[4] = {(uint8_t)v, (uint8_t)(v >> 8), (uint8_t)(v >> 16), (uint8_t)(v >> 24)};
+    qmi_put_bytes(o, type, b, 4);
+}
+
+void qmi_put_string(QmiOut *o, uint8_t type, const char *s, uint32_t max)
+{
+    uint32_t n = 0;
+    while (s[n] && n <= max) ++n;
+    if (n > max) {o->bad = 1; return;}
+    qmi_put_bytes(o, type, s, n);
+}
+
+uint32_t qmi_end(QmiOut *o)
+{
+    if (o->bad) return 0;
+    const uint32_t body = o->len - QCOM_QMI_HEADER;
+    o->buf[5] = (uint8_t)body; o->buf[6] = (uint8_t)(body >> 8);
+    return o->len;
+}
+
+static uint32_t empty(uint8_t *buf, uint32_t cap, uint16_t txn, uint16_t message)
+{
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, message);
+    return qmi_end(&o);
+}
+
+/* ---- reading ---- */
+static int parse_any(const uint8_t *data, uint32_t length, uint8_t type, uint16_t transaction, uint16_t message, QcomQmiMessage *m)
+{
+    if (qcom_qmi_parse(data, length, m) || m->type != type || m->message != message) return -1;
+    if (type == QCOM_QMI_RESPONSE && m->transaction != transaction) return -1;
+    return 0;
+}
+
+int qmi_response(const uint8_t *data, uint32_t length, uint16_t transaction, uint16_t message, QcomQmiMessage *m)
+{
+    uint32_t n = 0;
+    if (parse_any(data, length, QCOM_QMI_RESPONSE, transaction, message, m)) return -1;
+    const uint8_t *r = qcom_qmi_tlv(m, 0x02, &n);
+    if (!r || n != 4) return -1;
+    const uint16_t result = le16(r), error = le16(r + 2);
+    if (result > 1 || (!result && error) || (result && !error)) return -1;
+    return error;
+}
+
+/* A response or, for messages that are also indications, the indication. */
+static int response_or_indication(const uint8_t *p, uint32_t n, uint16_t txn, uint16_t message, QcomQmiMessage *m)
+{
+    if (n >= 1 && p[0] == QCOM_QMI_INDICATION) return parse_any(p, n, QCOM_QMI_INDICATION, 0, message, m);
+    return qmi_response(p, n, txn, message, m);
+}
+
+/* Copies n bytes of text into out (size bytes with the terminator), replacing anything outside printable ASCII. */
+static void text(char *out, uint32_t size, const uint8_t *s, uint32_t n)
+{
+    uint32_t i = 0;
+    for (; i < n && i + 1 < size; ++i) out[i] = s[i] >= 0x20 && s[i] < 0x7f ? (char)s[i] : '?';
+    out[i] = 0;
+}
+
+static const uint8_t *tlv_at_least(const QcomQmiMessage *m, uint8_t type, uint32_t need, uint32_t *size)
+{
+    uint32_t n = 0;
+    const uint8_t *v = qcom_qmi_tlv(m, type, &n);
+    if (!v || n < need) return 0;
+    if (size) *size = n;
+    return v;
+}
+
+/* ---- DMS ---- */
+uint32_t dms_get_ids(uint8_t *buf, uint32_t cap, uint16_t txn) {return empty(buf, cap, txn, DMS_GET_IDS);}
+uint32_t dms_get_revision(uint8_t *buf, uint32_t cap, uint16_t txn) {return empty(buf, cap, txn, DMS_GET_REVISION);}
+uint32_t dms_get_operating_mode(uint8_t *buf, uint32_t cap, uint16_t txn) {return empty(buf, cap, txn, DMS_GET_OPERATING_MODE);}
+
+uint32_t dms_set_operating_mode(uint8_t *buf, uint32_t cap, uint16_t txn, uint8_t mode)
+{
+    if (mode != DMS_MODE_ONLINE && mode != DMS_MODE_LOW_POWER) return 0;
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, DMS_SET_OPERATING_MODE);
+    qmi_put_u8(&o, 0x01, mode);
+    return qmi_end(&o);
+}
+
+int dms_parse_ids(const uint8_t *p, uint32_t n, uint16_t txn, DmsIds *out)
+{
+    QcomQmiMessage m;
+    *out = (DmsIds){0};
+    int rc = qmi_response(p, n, txn, DMS_GET_IDS, &m);
+    if (rc) return rc;
+    uint32_t len = 0;
+    const uint8_t *imei = tlv_at_least(&m, 0x11, 4, &len);
+    if (imei) {
+        if (len > 17) return -1;
+        for (uint32_t i = 0; i < len; ++i) if (imei[i] < '0' || imei[i] > '9') return -1;
+        for (unsigned i = 0; i < 4; ++i) out->imei_last4[i] = (char)imei[len - 4 + i];
+        out->has_imei = 1;
+    }
+    return 0;
+}
+
+int dms_parse_revision(const uint8_t *p, uint32_t n, uint16_t txn, DmsRevision *out)
+{
+    QcomQmiMessage m;
+    *out = (DmsRevision){0};
+    int rc = qmi_response(p, n, txn, DMS_GET_REVISION, &m);
+    if (rc) return rc;
+    uint32_t len = 0;
+    const uint8_t *s = tlv_at_least(&m, 0x01, 1, &len);
+    if (!s) return -1;
+    text(out->text, sizeof out->text, s, len);
+    return 0;
+}
+
+int dms_parse_operating_mode(const uint8_t *p, uint32_t n, uint16_t txn, DmsMode *out)
+{
+    QcomQmiMessage m;
+    *out = (DmsMode){0};
+    int rc = qmi_response(p, n, txn, DMS_GET_OPERATING_MODE, &m);
+    if (rc) return rc;
+    const uint8_t *v = tlv_at_least(&m, 0x01, 1, 0);
+    if (!v) return -1;
+    out->mode = v[0];
+    if ((v = tlv_at_least(&m, 0x10, 2, 0))) {out->offline_reason = le16(v); out->has_offline_reason = 1;}
+    if ((v = tlv_at_least(&m, 0x11, 1, 0))) out->hw_restricted = v[0];
+    return 0;
+}
+
+/* ---- NAS ---- */
+uint32_t nas_register_indications(uint8_t *buf, uint32_t cap, uint16_t txn)
+{
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, NAS_REGISTER_INDICATIONS);
+    qmi_put_u8(&o, 0x13, 1);  /* serving system */
+    qmi_put_u8(&o, 0x19, 1);  /* signal info */
+    qmi_put_u8(&o, 0x1e, 1);  /* current PLMN name */
+    return qmi_end(&o);
+}
+
+uint32_t nas_get_serving_system(uint8_t *buf, uint32_t cap, uint16_t txn) {return empty(buf, cap, txn, NAS_SERVING_SYSTEM);}
+uint32_t nas_get_signal_info(uint8_t *buf, uint32_t cap, uint16_t txn) {return empty(buf, cap, txn, NAS_GET_SIGNAL_INFO);}
+uint32_t nas_get_signal_strength(uint8_t *buf, uint32_t cap, uint16_t txn) {return empty(buf, cap, txn, NAS_GET_SIGNAL_STRENGTH);}
+uint32_t nas_get_operator_name(uint8_t *buf, uint32_t cap, uint16_t txn) {return empty(buf, cap, txn, NAS_GET_OPERATOR_NAME);}
+uint32_t nas_get_system_selection(uint8_t *buf, uint32_t cap, uint16_t txn) {return empty(buf, cap, txn, NAS_GET_SYSTEM_SELECTION);}
+
+uint32_t nas_set_mode_preference(uint8_t *buf, uint32_t cap, uint16_t txn, uint16_t mode_mask)
+{
+    if (!mode_mask || mode_mask >> 7) return 0;
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, NAS_SET_SYSTEM_SELECTION);
+    qmi_put_u16(&o, 0x11, mode_mask);
+    qmi_put_u8(&o, 0x17, 0);  /* change duration: until power cycle */
+    return qmi_end(&o);
+}
+
+int nas_parse_serving(const uint8_t *p, uint32_t n, uint16_t txn, NasServing *out)
+{
+    QcomQmiMessage m;
+    *out = (NasServing){0};
+    int rc = response_or_indication(p, n, txn, NAS_SERVING_SYSTEM, &m);
+    if (rc) return rc;
+    uint32_t len = 0;
+    const uint8_t *v = tlv_at_least(&m, 0x01, 5, &len);
+    if (!v || len != 5u + v[4] || v[4] > NAS_MAX_RADIOS) return -1;
+    out->reg_state = v[0]; out->cs_attach = v[1]; out->ps_attach = v[2]; out->network = v[3]; out->radio_count = v[4];
+    for (unsigned i = 0; i < v[4]; ++i) out->radio[i] = v[5 + i];
+    if ((v = tlv_at_least(&m, 0x10, 1, 0))) {out->roaming = v[0]; out->has_roaming = 1;}
+    if ((v = tlv_at_least(&m, 0x12, 5, &len))) {
+        if (len != 5u + v[4]) return -1;
+        out->mcc = le16(v); out->mnc = le16(v + 2);
+        text(out->description, sizeof out->description, v + 5, v[4]);
+        out->has_plmn = 1;
+    }
+    return 0;
+}
+
+int nas_registered_for_data(const NasServing *s)
+{
+    return s->reg_state == NAS_REGISTERED && s->ps_attach == NAS_ATTACHED;
+}
+
+int nas_parse_signal(const uint8_t *p, uint32_t n, uint16_t txn, NasSignal *out)
+{
+    QcomQmiMessage m;
+    *out = (NasSignal){0};
+    int rc;
+    if (n >= 1 && p[0] == QCOM_QMI_INDICATION) rc = parse_any(p, n, QCOM_QMI_INDICATION, 0, NAS_SIGNAL_INFO_IND, &m);
+    else rc = qmi_response(p, n, txn, NAS_GET_SIGNAL_INFO, &m);
+    if (rc) return rc;
+    const uint8_t *v;
+    if ((v = tlv_at_least(&m, 0x12, 1, 0))) {out->gsm_rssi = (int8_t)v[0]; out->has_gsm = 1;}
+    if ((v = tlv_at_least(&m, 0x13, 3, 0))) {out->wcdma_rssi = (int8_t)v[0]; out->wcdma_ecio = (int16_t)le16(v + 1); out->has_wcdma = 1;}
+    if ((v = tlv_at_least(&m, 0x14, 6, 0))) {
+        out->lte_rssi = (int8_t)v[0]; out->lte_rsrq = (int8_t)v[1];
+        out->lte_rsrp = (int16_t)le16(v + 2); out->lte_snr = (int16_t)le16(v + 4);
+        out->has_lte = 1;
+    }
+    if ((v = tlv_at_least(&m, 0x17, 4, 0))) {out->nr_rsrp = (int16_t)le16(v); out->nr_snr = (int16_t)le16(v + 2); out->has_nr = 1;}
+    return 0;
+}
+
+int nas_parse_signal_strength(const uint8_t *p, uint32_t n, uint16_t txn, int8_t *dbm, int8_t *radio)
+{
+    QcomQmiMessage m;
+    int rc = qmi_response(p, n, txn, NAS_GET_SIGNAL_STRENGTH, &m);
+    if (rc) return rc;
+    const uint8_t *v = tlv_at_least(&m, 0x01, 2, 0);
+    if (!v) return -1;
+    *dbm = (int8_t)v[0]; *radio = (int8_t)v[1];
+    return 0;
+}
+
+/* RSRP thresholds as Android's default LTE table (-115, -105, -95, -85 dBm); RSSI for 2G/3G (-107, -97, -89, -77). */
+static int level(int value, int a, int b, int c, int d)
+{
+    return value >= d ? 4 : value >= c ? 3 : value >= b ? 2 : value >= a ? 1 : 0;
+}
+
+int nas_bars(const NasSignal *s)
+{
+    if (s->has_nr && s->nr_rsrp < 0) return level(s->nr_rsrp, -115, -105, -95, -85);
+    if (s->has_lte && s->lte_rsrp < 0) return level(s->lte_rsrp, -115, -105, -95, -85);
+    if (s->has_wcdma && s->wcdma_rssi < 0) return level(s->wcdma_rssi, -107, -97, -89, -77);
+    if (s->has_gsm && s->gsm_rssi < 0) return level(s->gsm_rssi, -107, -97, -89, -77);
+    return -1;
+}
+
+int nas_parse_operator(const uint8_t *p, uint32_t n, uint16_t txn, NasOperator *out)
+{
+    QcomQmiMessage m;
+    *out = (NasOperator){0};
+    int rc;
+    if (n >= 1 && p[0] == QCOM_QMI_INDICATION) rc = parse_any(p, n, QCOM_QMI_INDICATION, 0, NAS_OPERATOR_NAME_IND, &m);
+    else rc = qmi_response(p, n, txn, NAS_GET_OPERATOR_NAME, &m);
+    if (rc) return rc;
+    uint32_t len = 0;
+    const uint8_t *v;
+    if ((v = tlv_at_least(&m, 0x10, 2, &len))) {  /* display condition, then a prefixed name */
+        if (len != 2u + v[1]) return -1;
+        text(out->spn, sizeof out->spn, v + 2, v[1]);
+        out->has_spn = 1;
+    }
+    if ((v = tlv_at_least(&m, 0x13, 1, &len))) {
+        while (len && !v[len - 1]) --len;
+        text(out->name, sizeof out->name, v, len);
+        out->has_name = 1;
+    }
+    return 0;
+}
+
+int nas_parse_system_selection(const uint8_t *p, uint32_t n, uint16_t txn, NasSelection *out)
+{
+    QcomQmiMessage m;
+    *out = (NasSelection){0};
+    int rc = qmi_response(p, n, txn, NAS_GET_SYSTEM_SELECTION, &m);
+    if (rc) return rc;
+    const uint8_t *v;
+    if ((v = tlv_at_least(&m, 0x11, 2, 0))) {out->mode_pref = le16(v); out->has_mode_pref = 1;}
+    if ((v = tlv_at_least(&m, 0x16, 1, 0))) {out->net_sel_pref = v[0]; out->has_net_sel = 1;}
+    return 0;
+}
+
+/* ---- WDS ---- */
+uint32_t wds_get_profile_list(uint8_t *buf, uint32_t cap, uint16_t txn)
+{
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDS_GET_PROFILE_LIST);
+    qmi_put_u8(&o, 0x10, 0);  /* 3GPP */
+    return qmi_end(&o);
+}
+
+uint32_t wds_get_profile_settings(uint8_t *buf, uint32_t cap, uint16_t txn, uint8_t index)
+{
+    const uint8_t id[2] = {0, index};
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDS_GET_PROFILE_SETTINGS);
+    qmi_put_bytes(&o, 0x01, id, 2);
+    return qmi_end(&o);
+}
+
+static int filled(const char *s) {return s && s[0];}
+
+static void profile_fields(QmiOut *o, const WdsCall *c)
+{
+    qmi_put_u8(o, 0x11, c->pdp_type);
+    if (filled(c->apn)) qmi_put_string(o, 0x14, c->apn, 100);
+    if (filled(c->username)) qmi_put_string(o, 0x1b, c->username, 127);
+    if (filled(c->password)) qmi_put_string(o, 0x1c, c->password, 127);
+    if (c->auth != 0xff) qmi_put_u8(o, 0x1d, c->auth);
+}
+
+uint32_t wds_create_profile(uint8_t *buf, uint32_t cap, uint16_t txn, const WdsCall *call)
+{
+    if (call->pdp_type > WDS_PDP_IPV4V6 || (call->auth != 0xff && call->auth > 3)) return 0;
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDS_CREATE_PROFILE);
+    qmi_put_u8(&o, 0x01, 0);  /* 3GPP */
+    profile_fields(&o, call);
+    return qmi_end(&o);
+}
+
+uint32_t wds_modify_profile(uint8_t *buf, uint32_t cap, uint16_t txn, const WdsCall *call)
+{
+    if (!call->profile || call->pdp_type > WDS_PDP_IPV4V6 || (call->auth != 0xff && call->auth > 3)) return 0;
+    const uint8_t id[2] = {0, call->profile};
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDS_MODIFY_PROFILE);
+    qmi_put_bytes(&o, 0x01, id, 2);
+    profile_fields(&o, call);
+    return qmi_end(&o);
+}
+
+uint32_t wds_bind_mux(uint8_t *buf, uint32_t cap, uint16_t txn, uint32_t endpoint_type, uint32_t interface, uint8_t mux)
+{
+    uint8_t ep[8];
+    for (unsigned i = 0; i < 4; ++i) {ep[i] = (uint8_t)(endpoint_type >> 8 * i); ep[4 + i] = (uint8_t)(interface >> 8 * i);}
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDS_BIND_MUX_DATA_PORT);
+    qmi_put_bytes(&o, 0x10, ep, 8);
+    qmi_put_u8(&o, 0x11, mux);
+    return qmi_end(&o);
+}
+
+uint32_t wds_set_ip_family(uint8_t *buf, uint32_t cap, uint16_t txn, uint8_t family)
+{
+    if (family != WDS_FAMILY_IPV4 && family != WDS_FAMILY_IPV6) return 0;
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDS_SET_IP_FAMILY);
+    qmi_put_u8(&o, 0x01, family);
+    return qmi_end(&o);
+}
+
+uint32_t wds_start_network(uint8_t *buf, uint32_t cap, uint16_t txn, const WdsCall *c)
+{
+    if (c->family && c->family != WDS_FAMILY_IPV4 && c->family != WDS_FAMILY_IPV6) return 0;
+    if (c->auth != 0xff && c->auth > 3) return 0;
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDS_START_NETWORK);
+    if (filled(c->apn)) qmi_put_string(&o, 0x14, c->apn, 100);
+    if (c->auth != 0xff) qmi_put_u8(&o, 0x16, c->auth);
+    if (filled(c->username)) qmi_put_string(&o, 0x17, c->username, 127);
+    if (filled(c->password)) qmi_put_string(&o, 0x18, c->password, 127);
+    if (c->family) qmi_put_u8(&o, 0x19, c->family);
+    if (c->profile) qmi_put_u8(&o, 0x31, c->profile);
+    return qmi_end(&o);
+}
+
+uint32_t wds_stop_network(uint8_t *buf, uint32_t cap, uint16_t txn, uint32_t handle)
+{
+    if (handle == WDS_HANDLE_NONE) return 0;
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDS_STOP_NETWORK);
+    qmi_put_u32(&o, 0x01, handle);
+    return qmi_end(&o);
+}
+
+#define WDS_WANT_SETTINGS (1u << 0 | 1u << 4 | 1u << 8 | 1u << 9 | 1u << 13 | 1u << 15)
+
+uint32_t wds_get_current_settings(uint8_t *buf, uint32_t cap, uint16_t txn)
+{
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDS_GET_CURRENT_SETTINGS);
+    qmi_put_u32(&o, 0x10, WDS_WANT_SETTINGS);
+    return qmi_end(&o);
+}
+
+int wds_parse_profile_list(const uint8_t *p, uint32_t n, uint16_t txn, WdsProfiles *out)
+{
+    QcomQmiMessage m;
+    *out = (WdsProfiles){0};
+    int rc = qmi_response(p, n, txn, WDS_GET_PROFILE_LIST, &m);
+    if (rc) return rc;
+    uint32_t len = 0;
+    const uint8_t *v = tlv_at_least(&m, 0x01, 1, &len);
+    if (!v) return -1;
+    uint32_t at = 1;
+    out->total = v[0];
+    for (unsigned i = 0; i < v[0]; ++i) {
+        if (len - at < 3 || len - at - 3 < v[at + 2]) return -1;
+        if (out->count < WDS_MAX_PROFILES) {
+            out->p[out->count].type = v[at];
+            out->p[out->count].index = v[at + 1];
+            text(out->p[out->count].name, sizeof out->p[0].name, v + at + 3, v[at + 2]);
+            out->count++;
+        }
+        at += 3u + v[at + 2];
+    }
+    return at == len ? 0 : -1;
+}
+
+int wds_parse_profile_settings(const uint8_t *p, uint32_t n, uint16_t txn, WdsProfile *out)
+{
+    QcomQmiMessage m;
+    *out = (WdsProfile){0};
+    int rc = qmi_response(p, n, txn, WDS_GET_PROFILE_SETTINGS, &m);
+    if (rc) return rc;
+    uint32_t len = 0;
+    const uint8_t *v;
+    if ((v = tlv_at_least(&m, 0x10, 0, &len))) text(out->name, sizeof out->name, v, len);
+    if ((v = tlv_at_least(&m, 0x14, 0, &len))) text(out->apn, sizeof out->apn, v, len);
+    if ((v = tlv_at_least(&m, 0x11, 1, 0))) {out->pdp_type = v[0]; out->has_pdp = 1;}
+    if ((v = tlv_at_least(&m, 0x1d, 1, 0))) {out->auth = v[0]; out->has_auth = 1;}
+    return 0;
+}
+
+int wds_parse_profile_created(const uint8_t *p, uint32_t n, uint16_t txn, uint8_t *index)
+{
+    QcomQmiMessage m;
+    int rc = qmi_response(p, n, txn, WDS_CREATE_PROFILE, &m);
+    if (rc) return rc;
+    const uint8_t *v = tlv_at_least(&m, 0x01, 2, 0);
+    if (!v) return -1;
+    *index = v[1];
+    return 0;
+}
+
+int wds_parse_start(const uint8_t *p, uint32_t n, uint16_t txn, WdsStarted *out)
+{
+    QcomQmiMessage m;
+    *out = (WdsStarted){0};
+    int rc = qmi_response(p, n, txn, WDS_START_NETWORK, &m);
+    if (rc < 0) return rc;
+    const uint8_t *v;
+    if ((v = tlv_at_least(&m, 0x10, 2, 0))) {out->end_reason = le16(v); out->has_end = 1;}
+    if ((v = tlv_at_least(&m, 0x11, 4, 0))) {out->verbose_type = le16(v); out->verbose_reason = (int16_t)le16(v + 2); out->has_verbose = 1;}
+    if (rc) return rc;
+    if (!(v = tlv_at_least(&m, 0x01, 4, 0)) || le32(v) == WDS_HANDLE_NONE) return -1;
+    out->handle = le32(v);
+    return 0;
+}
+
+static void copy16(uint8_t *to, const uint8_t *from) {for (unsigned i = 0; i < 16; ++i) to[i] = from[i];}
+
+int wds_parse_settings(const uint8_t *p, uint32_t n, uint16_t txn, WdsSettings *out)
+{
+    QcomQmiMessage m;
+    *out = (WdsSettings){0};
+    int rc = qmi_response(p, n, txn, WDS_GET_CURRENT_SETTINGS, &m);
+    if (rc) return rc;
+    const uint8_t *v;
+    if ((v = tlv_at_least(&m, 0x1e, 4, 0))) {out->v4_addr = le32(v); out->has_v4 = out->v4_addr != 0;}
+    if ((v = tlv_at_least(&m, 0x20, 4, 0))) out->v4_gateway = le32(v);
+    if ((v = tlv_at_least(&m, 0x21, 4, 0))) out->v4_mask = le32(v);
+    if ((v = tlv_at_least(&m, 0x15, 4, 0))) out->v4_dns1 = le32(v);
+    if ((v = tlv_at_least(&m, 0x16, 4, 0))) out->v4_dns2 = le32(v);
+    if ((v = tlv_at_least(&m, 0x25, 17, 0))) {copy16(out->v6_addr, v); out->v6_prefix = v[16]; out->has_v6 = 1;}
+    if ((v = tlv_at_least(&m, 0x26, 17, 0))) {copy16(out->v6_gateway, v); out->v6_gateway_prefix = v[16];}
+    if ((v = tlv_at_least(&m, 0x27, 16, 0))) {copy16(out->v6_dns1, v); out->has_v6_dns1 = 1;}
+    if ((v = tlv_at_least(&m, 0x28, 16, 0))) {copy16(out->v6_dns2, v); out->has_v6_dns2 = 1;}
+    if ((v = tlv_at_least(&m, 0x29, 4, 0))) out->mtu = le32(v);
+    if ((v = tlv_at_least(&m, 0x2b, 1, 0))) out->family = v[0];
+    if (out->has_v6 && out->v6_prefix > 128) return -1;
+    return out->has_v4 || out->has_v6 ? 0 : -1;
+}
+
+int wds_parse_packet_status(const uint8_t *p, uint32_t n, WdsPacketStatus *out)
+{
+    QcomQmiMessage m;
+    *out = (WdsPacketStatus){0};
+    if (parse_any(p, n, QCOM_QMI_INDICATION, 0, WDS_PACKET_SERVICE_STATUS, &m)) return -1;
+    const uint8_t *v = tlv_at_least(&m, 0x01, 2, 0);
+    if (!v) return -1;
+    out->status = v[0]; out->reconfigure = v[1];
+    if ((v = tlv_at_least(&m, 0x10, 2, 0))) {out->end_reason = le16(v); out->has_end = 1;}
+    if ((v = tlv_at_least(&m, 0x12, 1, 0))) {out->family = v[0]; out->has_family = 1;}
+    return 0;
+}
+
+/* ---- WDA ---- */
+static void endpoint(QmiOut *o, uint8_t type, uint32_t endpoint_type, uint32_t interface)
+{
+    uint8_t ep[8];
+    for (unsigned i = 0; i < 4; ++i) {ep[i] = (uint8_t)(endpoint_type >> 8 * i); ep[4 + i] = (uint8_t)(interface >> 8 * i);}
+    qmi_put_bytes(o, type, ep, 8);
+}
+
+uint32_t wda_set_data_format(uint8_t *buf, uint32_t cap, uint16_t txn, const WdaFormat *f)
+{
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDA_SET_DATA_FORMAT);
+    qmi_put_u32(&o, 0x11, f->link);
+    qmi_put_u32(&o, 0x12, f->ul_agg);
+    qmi_put_u32(&o, 0x13, f->dl_agg);
+    if (f->dl_max_datagrams) qmi_put_u32(&o, 0x15, f->dl_max_datagrams);
+    if (f->dl_max_size) qmi_put_u32(&o, 0x16, f->dl_max_size);
+    endpoint(&o, 0x17, f->endpoint_type, f->interface);
+    if (f->ul_max_datagrams) qmi_put_u32(&o, 0x1b, f->ul_max_datagrams);
+    if (f->ul_max_size) qmi_put_u32(&o, 0x1c, f->ul_max_size);
+    return qmi_end(&o);
+}
+
+uint32_t wda_get_data_format(uint8_t *buf, uint32_t cap, uint16_t txn, uint32_t endpoint_type, uint32_t interface)
+{
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDA_GET_DATA_FORMAT);
+    endpoint(&o, 0x10, endpoint_type, interface);
+    return qmi_end(&o);
+}
+
+int wda_parse_data_format(const uint8_t *p, uint32_t n, uint16_t txn, uint16_t message, WdaFormat *out)
+{
+    QcomQmiMessage m;
+    *out = (WdaFormat){0};
+    if (message != WDA_SET_DATA_FORMAT && message != WDA_GET_DATA_FORMAT) return -1;
+    int rc = qmi_response(p, n, txn, message, &m);
+    if (rc) return rc;
+    const uint8_t *v;
+    if ((v = tlv_at_least(&m, 0x11, 4, 0))) out->link = le32(v);
+    if ((v = tlv_at_least(&m, 0x12, 4, 0))) out->ul_agg = le32(v);
+    if ((v = tlv_at_least(&m, 0x13, 4, 0))) out->dl_agg = le32(v);
+    if ((v = tlv_at_least(&m, 0x15, 4, 0))) out->dl_max_datagrams = le32(v);
+    if ((v = tlv_at_least(&m, 0x16, 4, 0))) out->dl_max_size = le32(v);
+    if ((v = tlv_at_least(&m, 0x17, 4, 0))) out->ul_max_datagrams = le32(v);
+    if ((v = tlv_at_least(&m, 0x18, 4, 0))) out->ul_max_size = le32(v);
+    return 0;
+}
+
+/* ---- DPM ---- */
+uint32_t dpm_open_port(uint8_t *buf, uint32_t cap, uint16_t txn, uint32_t endpoint_type, uint32_t interface, uint32_t rx_endpoint,
+                       uint32_t tx_endpoint)
+{
+    const uint32_t words[4] = {endpoint_type, interface, rx_endpoint, tx_endpoint};
+    uint8_t port[17];
+    port[0] = 1;  /* one hardware data port */
+    for (unsigned w = 0; w < 4; ++w) for (unsigned i = 0; i < 4; ++i) port[1 + 4 * w + i] = (uint8_t)(words[w] >> 8 * i);
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, DPM_OPEN_PORT);
+    qmi_put_bytes(&o, 0x11, port, sizeof port);
+    return qmi_end(&o);
+}
+
+uint32_t dpm_close_port(uint8_t *buf, uint32_t cap, uint16_t txn) {return empty(buf, cap, txn, DPM_CLOSE_PORT);}
+#endif
