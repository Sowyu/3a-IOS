+/* ---- WDS ---- */
+uint32_t wds_get_profile_list(uint8_t *buf, uint32_t cap, uint16_t txn)
+{
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDS_GET_PROFILE_LIST);
+    qmi_put_u8(&o, 0x10, 0);  /* 3GPP */
+    return qmi_end(&o);
+}
+
+uint32_t wds_get_profile_settings(uint8_t *buf, uint32_t cap, uint16_t txn, uint8_t index)
+{
+    const uint8_t id[2] = {0, index};
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDS_GET_PROFILE_SETTINGS);
+    qmi_put_bytes(&o, 0x01, id, 2);
+    return qmi_end(&o);
+}
+
+static int filled(const char *s) {return s && s[0];}
+
+static void profile_fields(QmiOut *o, const WdsCall *c)
+{
+    qmi_put_u8(o, 0x11, c->pdp_type);
+    if (filled(c->apn)) qmi_put_string(o, 0x14, c->apn, 100);
+    if (filled(c->username)) qmi_put_string(o, 0x1b, c->username, 127);
+    if (filled(c->password)) qmi_put_string(o, 0x1c, c->password, 127);
+    if (c->auth != 0xff) qmi_put_u8(o, 0x1d, c->auth);
+}
+
+uint32_t wds_create_profile(uint8_t *buf, uint32_t cap, uint16_t txn, const WdsCall *call)
+{
+    if (call->pdp_type > WDS_PDP_IPV4V6 || (call->auth != 0xff && call->auth > 3)) return 0;
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDS_CREATE_PROFILE);
+    qmi_put_u8(&o, 0x01, 0);  /* 3GPP */
+    profile_fields(&o, call);
+    return qmi_end(&o);
+}
+
+uint32_t wds_modify_profile(uint8_t *buf, uint32_t cap, uint16_t txn, const WdsCall *call)
+{
+    if (!call->profile || call->pdp_type > WDS_PDP_IPV4V6 || (call->auth != 0xff && call->auth > 3)) return 0;
+    const uint8_t id[2] = {0, call->profile};
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDS_MODIFY_PROFILE);
+    qmi_put_bytes(&o, 0x01, id, 2);
+    profile_fields(&o, call);
+    return qmi_end(&o);
+}
+
+uint32_t wds_bind_mux(uint8_t *buf, uint32_t cap, uint16_t txn, uint32_t endpoint_type, uint32_t interface, uint8_t mux)
+{
+    uint8_t ep[8];
+    for (unsigned i = 0; i < 4; ++i) {ep[i] = (uint8_t)(endpoint_type >> 8 * i); ep[4 + i] = (uint8_t)(interface >> 8 * i);}
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDS_BIND_MUX_DATA_PORT);
+    qmi_put_bytes(&o, 0x10, ep, 8);
+    qmi_put_u8(&o, 0x11, mux);
+    return qmi_end(&o);
+}
+
+uint32_t wds_set_ip_family(uint8_t *buf, uint32_t cap, uint16_t txn, uint8_t family)
+{
+    if (family != WDS_FAMILY_IPV4 && family != WDS_FAMILY_IPV6) return 0;
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDS_SET_IP_FAMILY);
+    qmi_put_u8(&o, 0x01, family);
+    return qmi_end(&o);
+}
+
+uint32_t wds_start_network(uint8_t *buf, uint32_t cap, uint16_t txn, const WdsCall *c)
+{
+    if (c->family && c->family != WDS_FAMILY_IPV4 && c->family != WDS_FAMILY_IPV6) return 0;
+    if (c->auth != 0xff && c->auth > 3) return 0;
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDS_START_NETWORK);
+    if (filled(c->apn)) qmi_put_string(&o, 0x14, c->apn, 100);
+    if (c->auth != 0xff) qmi_put_u8(&o, 0x16, c->auth);
+    if (filled(c->username)) qmi_put_string(&o, 0x17, c->username, 127);
+    if (filled(c->password)) qmi_put_string(&o, 0x18, c->password, 127);
+    if (c->family) qmi_put_u8(&o, 0x19, c->family);
+    if (c->profile) qmi_put_u8(&o, 0x31, c->profile);
+    return qmi_end(&o);
+}
+
+uint32_t wds_stop_network(uint8_t *buf, uint32_t cap, uint16_t txn, uint32_t handle)
+{
+    if (handle == WDS_HANDLE_NONE) return 0;
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDS_STOP_NETWORK);
+    qmi_put_u32(&o, 0x01, handle);
+    return qmi_end(&o);
+}
+
+#define WDS_WANT_SETTINGS (1u << 0 | 1u << 4 | 1u << 8 | 1u << 9 | 1u << 13 | 1u << 15)
+
+uint32_t wds_get_current_settings(uint8_t *buf, uint32_t cap, uint16_t txn)
+{
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDS_GET_CURRENT_SETTINGS);
+    qmi_put_u32(&o, 0x10, WDS_WANT_SETTINGS);
+    return qmi_end(&o);
+}
+
+int wds_parse_profile_list(const uint8_t *p, uint32_t n, uint16_t txn, WdsProfiles *out)
+{
+    QcomQmiMessage m;
+    *out = (WdsProfiles){0};
+    int rc = qmi_response(p, n, txn, WDS_GET_PROFILE_LIST, &m);
+    if (rc) return rc;
+    uint32_t len = 0;
+    const uint8_t *v = tlv_at_least(&m, 0x01, 1, &len);
+    if (!v) return -1;
+    uint32_t at = 1;
+    out->total = v[0];
+    for (unsigned i = 0; i < v[0]; ++i) {
+        if (len - at < 3 || len - at - 3 < v[at + 2]) return -1;
+        if (out->count < WDS_MAX_PROFILES) {
+            out->p[out->count].type = v[at];
+            out->p[out->count].index = v[at + 1];
+            text(out->p[out->count].name, sizeof out->p[0].name, v + at + 3, v[at + 2]);
+            out->count++;
+        }
+        at += 3u + v[at + 2];
+    }
+    return at == len ? 0 : -1;
+}
+
+int wds_parse_profile_settings(const uint8_t *p, uint32_t n, uint16_t txn, WdsProfile *out)
+{
+    QcomQmiMessage m;
+    *out = (WdsProfile){0};
+    int rc = qmi_response(p, n, txn, WDS_GET_PROFILE_SETTINGS, &m);
+    if (rc) return rc;
+    uint32_t len = 0;
+    const uint8_t *v;
+    if ((v = tlv_at_least(&m, 0x10, 0, &len))) text(out->name, sizeof out->name, v, len);
+    if ((v = tlv_at_least(&m, 0x14, 0, &len))) text(out->apn, sizeof out->apn, v, len);
+    if ((v = tlv_at_least(&m, 0x11, 1, 0))) {out->pdp_type = v[0]; out->has_pdp = 1;}
+    if ((v = tlv_at_least(&m, 0x1d, 1, 0))) {out->auth = v[0]; out->has_auth = 1;}
+    return 0;
+}
+
+int wds_parse_profile_created(const uint8_t *p, uint32_t n, uint16_t txn, uint8_t *index)
+{
+    QcomQmiMessage m;
+    int rc = qmi_response(p, n, txn, WDS_CREATE_PROFILE, &m);
+    if (rc) return rc;
+    const uint8_t *v = tlv_at_least(&m, 0x01, 2, 0);
+    if (!v) return -1;
+    *index = v[1];
+    return 0;
+}
+
+int wds_parse_start(const uint8_t *p, uint32_t n, uint16_t txn, WdsStarted *out)
+{
+    QcomQmiMessage m;
+    *out = (WdsStarted){0};
+    int rc = qmi_response(p, n, txn, WDS_START_NETWORK, &m);
+    if (rc < 0) return rc;
+    /* ownership of a call hangs on this reply: one result and at most one handle, each of its exact size, or it proves nothing */
+    int ok;
+    if (tlv_count(&m, 0x02, 4, &ok) != 1 || !ok || tlv_count(&m, 0x01, 4, &ok) > 1 || !ok) return -1;
+    const uint8_t *v;
+    if ((v = tlv_at_least(&m, 0x10, 2, 0))) {out->end_reason = le16(v); out->has_end = 1;}
+    if ((v = tlv_at_least(&m, 0x11, 4, 0))) {out->verbose_type = le16(v); out->verbose_reason = (int16_t)le16(v + 2); out->has_verbose = 1;}
+    if (rc) return rc;
+    if (!(v = tlv_at_least(&m, 0x01, 4, 0)) || le32(v) == WDS_HANDLE_NONE) return -1;
+    out->handle = le32(v);
+    return 0;
+}
+
+static void copy16(uint8_t *to, const uint8_t *from) {for (unsigned i = 0; i < 16; ++i) to[i] = from[i];}
+
+int wds_parse_settings(const uint8_t *p, uint32_t n, uint16_t txn, WdsSettings *out)
+{
+    QcomQmiMessage m;
+    *out = (WdsSettings){0};
+    int rc = qmi_response(p, n, txn, WDS_GET_CURRENT_SETTINGS, &m);
+    if (rc) return rc;
+    const uint8_t *v;
+    if ((v = tlv_at_least(&m, 0x1e, 4, 0))) {out->v4_addr = le32(v); out->has_v4 = out->v4_addr != 0;}
+    if ((v = tlv_at_least(&m, 0x20, 4, 0))) out->v4_gateway = le32(v);
+    if ((v = tlv_at_least(&m, 0x21, 4, 0))) out->v4_mask = le32(v);
+    if ((v = tlv_at_least(&m, 0x15, 4, 0))) out->v4_dns1 = le32(v);
+    if ((v = tlv_at_least(&m, 0x16, 4, 0))) out->v4_dns2 = le32(v);
+    if ((v = tlv_at_least(&m, 0x25, 17, 0))) {copy16(out->v6_addr, v); out->v6_prefix = v[16]; out->has_v6 = 1;}
+    if ((v = tlv_at_least(&m, 0x26, 17, 0))) {copy16(out->v6_gateway, v); out->v6_gateway_prefix = v[16];}
+    if ((v = tlv_at_least(&m, 0x27, 16, 0))) {copy16(out->v6_dns1, v); out->has_v6_dns1 = 1;}
+    if ((v = tlv_at_least(&m, 0x28, 16, 0))) {copy16(out->v6_dns2, v); out->has_v6_dns2 = 1;}
+    if ((v = tlv_at_least(&m, 0x29, 4, 0))) out->mtu = le32(v);
+    int ok;
+    if (tlv_count(&m, 0x1e, 4, &ok) > 1 || tlv_count(&m, 0x25, 17, &ok) > 1) return -1;
+    const unsigned families = tlv_count(&m, 0x2b, 1, &ok);
+    if (families > 1 || !ok) return -1;
+    if ((v = tlv_at_least(&m, 0x2b, 1, 0))) {out->family = v[0]; out->has_family = 1;}
+    if (out->has_v6 && out->v6_prefix > 128) return -1;
+    return out->has_v4 || out->has_v6 ? 0 : -1;
+}
+
+int wds_parse_packet_status(const uint8_t *p, uint32_t n, WdsPacketStatus *out)
+{
+    QcomQmiMessage m;
+    *out = (WdsPacketStatus){0};
+    if (parse_any(p, n, QCOM_QMI_INDICATION, 0, WDS_PACKET_SERVICE_STATUS, &m)) return -1;
+    const uint8_t *v = tlv_at_least(&m, 0x01, 2, 0);
+    if (!v) return -1;
+    out->status = v[0]; out->reconfigure = v[1];
+    if ((v = tlv_at_least(&m, 0x10, 2, 0))) {out->end_reason = le16(v); out->has_end = 1;}
+    if ((v = tlv_at_least(&m, 0x12, 1, 0))) {out->family = v[0]; out->has_family = 1;}
+    return 0;
+}
+
+/* ---- WDA ---- */
+static void endpoint(QmiOut *o, uint8_t type, uint32_t endpoint_type, uint32_t interface)
+{
+    uint8_t ep[8];
+    for (unsigned i = 0; i < 4; ++i) {ep[i] = (uint8_t)(endpoint_type >> 8 * i); ep[4 + i] = (uint8_t)(interface >> 8 * i);}
+    qmi_put_bytes(o, type, ep, 8);
+}
+
+uint32_t wda_set_data_format(uint8_t *buf, uint32_t cap, uint16_t txn, const WdaFormat *f)
+{
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDA_SET_DATA_FORMAT);
+    qmi_put_u32(&o, 0x11, f->link);
+    qmi_put_u32(&o, 0x12, f->ul_agg);
+    qmi_put_u32(&o, 0x13, f->dl_agg);
+    if (f->dl_max_datagrams) qmi_put_u32(&o, 0x15, f->dl_max_datagrams);
+    if (f->dl_max_size) qmi_put_u32(&o, 0x16, f->dl_max_size);
+    endpoint(&o, 0x17, f->endpoint_type, f->interface);
+    if (f->ul_max_datagrams) qmi_put_u32(&o, 0x1b, f->ul_max_datagrams);
+    if (f->ul_max_size) qmi_put_u32(&o, 0x1c, f->ul_max_size);
+    return qmi_end(&o);
+}
+
+uint32_t wda_get_data_format(uint8_t *buf, uint32_t cap, uint16_t txn, uint32_t endpoint_type, uint32_t interface)
+{
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, WDA_GET_DATA_FORMAT);
+    endpoint(&o, 0x10, endpoint_type, interface);
+    return qmi_end(&o);
+}
+
+int wda_parse_data_format(const uint8_t *p, uint32_t n, uint16_t txn, uint16_t message, WdaFormat *out)
+{
+    QcomQmiMessage m;
+    *out = (WdaFormat){0};
+    if (message != WDA_SET_DATA_FORMAT && message != WDA_GET_DATA_FORMAT) return -1;
+    int rc = qmi_response(p, n, txn, message, &m);
+    if (rc) return rc;
+    static const struct {uint8_t type; uint32_t bit;} fields[] = {
+        {0x11, WDA_HAS_LINK}, {0x12, WDA_HAS_UL_AGG}, {0x13, WDA_HAS_DL_AGG}, {0x15, WDA_HAS_DL_DATAGRAMS}, {0x16, WDA_HAS_DL_SIZE},
+        {0x17, 0}, {0x18, 0},
+    };
+    uint32_t *const to[] = {&out->link, &out->ul_agg, &out->dl_agg, &out->dl_max_datagrams, &out->dl_max_size,
+                            &out->ul_max_datagrams, &out->ul_max_size};
+    for (unsigned i = 0; i < sizeof fields / sizeof fields[0]; ++i) {
+        unsigned count = 0;
+        for (uint32_t at = 0; at + 3 <= m.length; at += 3u + le16(m.tlvs + at + 1)) {
+            if (m.tlvs[at] != fields[i].type) continue;
+            if (++count > 1 || le16(m.tlvs + at + 1) != 4) return -1;
+            *to[i] = le32(m.tlvs + at + 3);
+            out->present |= fields[i].bit;
+        }
+    }
+    return 0;
+}
+
+/* ---- DPM ---- */
+uint32_t dpm_open_port(uint8_t *buf, uint32_t cap, uint16_t txn, uint32_t endpoint_type, uint32_t interface, uint32_t rx_endpoint,
+                       uint32_t tx_endpoint)
+{
+    const uint32_t words[4] = {endpoint_type, interface, rx_endpoint, tx_endpoint};
+    uint8_t port[17];
+    port[0] = 1;  /* one hardware data port */
+    for (unsigned w = 0; w < 4; ++w) for (unsigned i = 0; i < 4; ++i) port[1 + 4 * w + i] = (uint8_t)(words[w] >> 8 * i);
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, DPM_OPEN_PORT);
+    qmi_put_bytes(&o, 0x11, port, sizeof port);
+    return qmi_end(&o);
+}
+
+uint32_t dpm_close_port(uint8_t *buf, uint32_t cap, uint16_t txn) {return empty(buf, cap, txn, DPM_CLOSE_PORT);}
+#endif
