@@ -0,0 +1,75 @@
+#if defined(ARM64_BOARD_CONFIG_SWEET) || !defined(KERNEL)
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "Qmap.h"
+
+#define CSUM_TYPE 2u
+#define MAX_PACKET 0xffffu
+
+uint32_t qmap_deaggregate(QmapVersion version, const uint8_t *buf, uint32_t length, uint32_t mux_mask, QmapDeliver deliver,
+                          void *context, QmapCounters *c)
+{
+    uint32_t at = 0, delivered = 0;
+    while (length - at >= QMAP_HEADER) {
+        const uint8_t flags = buf[at], mux = buf[at + 1];
+        const uint32_t size = (uint32_t)buf[at + 2] << 8 | buf[at + 3];
+        const int command = (flags & QMAP_FLAG_COMMAND) != 0;
+        uint32_t header = QMAP_HEADER;
+        if (version == QMAP_V5 && !command) {
+            /* a v5 data packet without its checksum header is invalid (Linux drops it too) */
+            if (!(flags & QMAP_FLAG_NEXT)) {c->bad++; break;}
+            header += QMAP_CSUM_HEADER;
+        }
+        if (length - at < header || length - at - header < size) {c->bad++; break;}
+        if (version == QMAP_V5 && !command && (buf[at + QMAP_HEADER] >> 1) != CSUM_TYPE) {c->bad++; break;}
+        const uint8_t *payload = buf + at + header;
+        at += header + size;
+        if (!size) {c->empty++; continue;}  /* hardware may pad an aggregate with empty frames */
+        if (command) {
+            c->commands++;
+            deliver(context, mux, 1, payload, size);
+            delivered++;
+            continue;
+        }
+        const uint32_t pad = flags & QMAP_PAD_MASK;
+        if (pad >= size) {c->bad++; continue;}
+        if (mux > 31 || !(mux_mask >> mux & 1)) {c->unknown_mux++; continue;}
+        c->packets++;
+        deliver(context, mux, 0, payload, size - pad);
+        delivered++;
+    }
+    return delivered;
+}
+
+uint32_t qmap_headroom(QmapVersion version) {return version == QMAP_V5 ? QMAP_HEADER + QMAP_CSUM_HEADER : QMAP_HEADER;}
+
+uint32_t qmap_frame(QmapVersion version, uint8_t mux, uint8_t *packet, uint32_t length)
+{
+    if (!length || length > MAX_PACKET) return 0;
+    const uint32_t room = qmap_headroom(version);
+    uint8_t *h = packet - room;
+    h[0] = version == QMAP_V5 ? QMAP_FLAG_NEXT : 0;
+    h[1] = mux;
+    h[2] = (uint8_t)(length >> 8);
+    h[3] = (uint8_t)length;
+    if (version == QMAP_V5) {
+        h[4] = CSUM_TYPE << 1;  /* no further header */
+        h[5] = 0;               /* no checksum offload asked: iOS fills in its checksums */
+        h[6] = h[7] = 0;
+    }
+    return room + length;
+}
+
+/* struct rmnet_map_control_command: command name, then cmd_type in bits 1..0 (0 request, 1 ack). */
+uint32_t qmap_command_ack(uint8_t mux, const uint8_t *command, uint32_t length, uint8_t *out, uint32_t capacity)
+{
+    if (length < 2 || length > MAX_PACKET || capacity < QMAP_HEADER || capacity - QMAP_HEADER < length) return 0;
+    if ((command[1] & 3) != 0) return 0;
+    out[0] = QMAP_FLAG_COMMAND;
+    out[1] = mux;
+    out[2] = (uint8_t)(length >> 8);
+    out[3] = (uint8_t)length;
+    for (uint32_t i = 0; i < length; ++i) out[QMAP_HEADER + i] = command[i];
+    out[QMAP_HEADER + 1] = (uint8_t)((command[1] & ~3u) | 1u);
+    return QMAP_HEADER + length;
+}
+#endif
