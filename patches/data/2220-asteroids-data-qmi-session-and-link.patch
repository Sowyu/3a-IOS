+/* ---- NAS ---- */
+uint32_t nas_register_indications(uint8_t *buf, uint32_t cap, uint16_t txn)
+{
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, NAS_REGISTER_INDICATIONS);
+    qmi_put_u8(&o, 0x13, 1);  /* serving system */
+    qmi_put_u8(&o, 0x19, 1);  /* signal info */
+    qmi_put_u8(&o, 0x1e, 1);  /* current PLMN name */
+    return qmi_end(&o);
+}
+
+uint32_t nas_get_serving_system(uint8_t *buf, uint32_t cap, uint16_t txn) {return empty(buf, cap, txn, NAS_SERVING_SYSTEM);}
+uint32_t nas_get_signal_info(uint8_t *buf, uint32_t cap, uint16_t txn) {return empty(buf, cap, txn, NAS_GET_SIGNAL_INFO);}
+uint32_t nas_get_signal_strength(uint8_t *buf, uint32_t cap, uint16_t txn) {return empty(buf, cap, txn, NAS_GET_SIGNAL_STRENGTH);}
+uint32_t nas_get_operator_name(uint8_t *buf, uint32_t cap, uint16_t txn) {return empty(buf, cap, txn, NAS_GET_OPERATOR_NAME);}
+uint32_t nas_get_system_selection(uint8_t *buf, uint32_t cap, uint16_t txn) {return empty(buf, cap, txn, NAS_GET_SYSTEM_SELECTION);}
+
+uint32_t nas_set_mode_preference(uint8_t *buf, uint32_t cap, uint16_t txn, uint16_t mode_mask)
+{
+    if (!mode_mask || mode_mask >> 7) return 0;
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, NAS_SET_SYSTEM_SELECTION);
+    qmi_put_u16(&o, 0x11, mode_mask);
+    qmi_put_u8(&o, 0x17, 0);  /* change duration: until power cycle */
+    return qmi_end(&o);
+}
+
+int nas_parse_serving(const uint8_t *p, uint32_t n, uint16_t txn, NasServing *out)
+{
+    QcomQmiMessage m;
+    *out = (NasServing){0};
+    int rc = response_or_indication(p, n, txn, NAS_SERVING_SYSTEM, &m);
+    if (rc) return rc;
+    uint32_t len = 0;
+    const uint8_t *v = tlv_at_least(&m, 0x01, 5, &len);
+    if (!v || len != 5u + v[4] || v[4] > NAS_MAX_RADIOS) return -1;
+    out->reg_state = v[0]; out->cs_attach = v[1]; out->ps_attach = v[2]; out->network = v[3]; out->radio_count = v[4];
+    for (unsigned i = 0; i < v[4]; ++i) out->radio[i] = v[5 + i];
+    if ((v = tlv_at_least(&m, 0x10, 1, 0))) {out->roaming = v[0]; out->has_roaming = 1;}
+    if ((v = tlv_at_least(&m, 0x12, 5, &len))) {
+        if (len != 5u + v[4]) return -1;
+        out->mcc = le16(v); out->mnc = le16(v + 2);
+        text(out->description, sizeof out->description, v + 5, v[4]);
+        out->has_plmn = 1;
+    }
+    return 0;
+}
+
+int nas_registered_for_data(const NasServing *s)
+{
+    return s->reg_state == NAS_REGISTERED && s->ps_attach == NAS_ATTACHED;
+}
+
+int nas_parse_signal(const uint8_t *p, uint32_t n, uint16_t txn, NasSignal *out)
+{
+    QcomQmiMessage m;
+    *out = (NasSignal){0};
+    int rc;
+    if (n >= 1 && p[0] == QCOM_QMI_INDICATION) rc = parse_any(p, n, QCOM_QMI_INDICATION, 0, NAS_SIGNAL_INFO_IND, &m);
+    else rc = qmi_response(p, n, txn, NAS_GET_SIGNAL_INFO, &m);
+    if (rc) return rc;
+    const uint8_t *v;
+    if ((v = tlv_at_least(&m, 0x12, 1, 0))) {out->gsm_rssi = (int8_t)v[0]; out->has_gsm = 1;}
+    if ((v = tlv_at_least(&m, 0x13, 3, 0))) {out->wcdma_rssi = (int8_t)v[0]; out->wcdma_ecio = (int16_t)le16(v + 1); out->has_wcdma = 1;}
+    if ((v = tlv_at_least(&m, 0x14, 6, 0))) {
+        out->lte_rssi = (int8_t)v[0]; out->lte_rsrq = (int8_t)v[1];
+        out->lte_rsrp = (int16_t)le16(v + 2); out->lte_snr = (int16_t)le16(v + 4);
+        out->has_lte = 1;
+    }
+    if ((v = tlv_at_least(&m, 0x17, 4, 0))) {out->nr_rsrp = (int16_t)le16(v); out->nr_snr = (int16_t)le16(v + 2); out->has_nr = 1;}
+    return 0;
+}
+
+int nas_parse_signal_strength(const uint8_t *p, uint32_t n, uint16_t txn, int8_t *dbm, int8_t *radio)
+{
+    QcomQmiMessage m;
+    int rc = qmi_response(p, n, txn, NAS_GET_SIGNAL_STRENGTH, &m);
+    if (rc) return rc;
+    const uint8_t *v = tlv_at_least(&m, 0x01, 2, 0);
+    if (!v) return -1;
+    *dbm = (int8_t)v[0]; *radio = (int8_t)v[1];
+    return 0;
+}
+
+/* RSRP thresholds as Android's default LTE table (-115, -105, -95, -85 dBm); RSSI for 2G/3G (-107, -97, -89, -77). */
+static int level(int value, int a, int b, int c, int d)
+{
+    return value >= d ? 4 : value >= c ? 3 : value >= b ? 2 : value >= a ? 1 : 0;
+}
+
+int nas_bars(const NasSignal *s)
+{
+    if (s->has_nr && s->nr_rsrp < 0) return level(s->nr_rsrp, -115, -105, -95, -85);
+    if (s->has_lte && s->lte_rsrp < 0) return level(s->lte_rsrp, -115, -105, -95, -85);
+    if (s->has_wcdma && s->wcdma_rssi < 0) return level(s->wcdma_rssi, -107, -97, -89, -77);
+    if (s->has_gsm && s->gsm_rssi < 0) return level(s->gsm_rssi, -107, -97, -89, -77);
+    return -1;
+}
+
+int nas_parse_operator(const uint8_t *p, uint32_t n, uint16_t txn, NasOperator *out)
+{
+    QcomQmiMessage m;
+    *out = (NasOperator){0};
+    int rc;
+    if (n >= 1 && p[0] == QCOM_QMI_INDICATION) rc = parse_any(p, n, QCOM_QMI_INDICATION, 0, NAS_OPERATOR_NAME_IND, &m);
+    else rc = qmi_response(p, n, txn, NAS_GET_OPERATOR_NAME, &m);
+    if (rc) return rc;
+    uint32_t len = 0;
+    const uint8_t *v;
+    if ((v = tlv_at_least(&m, 0x10, 2, &len))) {  /* display condition, then a prefixed name */
+        if (len != 2u + v[1]) return -1;
+        text(out->spn, sizeof out->spn, v + 2, v[1]);
+        out->has_spn = 1;
+    }
+    if ((v = tlv_at_least(&m, 0x13, 1, &len))) {
+        while (len && !v[len - 1]) --len;
+        text(out->name, sizeof out->name, v, len);
+        out->has_name = 1;
+    }
+    return 0;
+}
+
+int nas_parse_system_selection(const uint8_t *p, uint32_t n, uint16_t txn, NasSelection *out)
+{
+    QcomQmiMessage m;
+    *out = (NasSelection){0};
+    int rc = qmi_response(p, n, txn, NAS_GET_SYSTEM_SELECTION, &m);
+    if (rc) return rc;
+    const uint8_t *v;
+    if ((v = tlv_at_least(&m, 0x11, 2, 0))) {out->mode_pref = le16(v); out->has_mode_pref = 1;}
+    if ((v = tlv_at_least(&m, 0x16, 1, 0))) {out->net_sel_pref = v[0]; out->has_net_sel = 1;}
+    return 0;
+}
