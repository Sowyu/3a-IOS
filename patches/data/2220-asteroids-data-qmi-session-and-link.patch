+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* The Ethernet look of a cellular data session, for an ifnet configd treats like a USB Ethernet adapter. The modem carries bare IP
+ * packets; the stack sees frames between its own MAC and a made-up router MAC. This file answers, from the session's WDS settings,
+ * everything the stack asks of that router: ARP for any address, DHCP (the WDS address, a /24 around it with the router at .1 or .2,
+ * the WDS DNS servers and MTU), IPv6 neighbor solicitations for any target, and router solicitations with an advertisement of the
+ * WDS /64 prefix and DNS servers (SLAAC and RDNSS). Every other unicast IP frame to the router becomes a packet for the modem.
+ * Multicast and broadcast that is not DHCP is dropped. The mask and router are not the network's: a cellular bearer is point to
+ * point, and DHCP cannot express a gateway outside the subnet, so any router works as long as every packet reaches the modem.
+ * Pure frame logic: no mbufs, no locks, built in the kernel and on the host. Packet path and presentation stay separate, so a later
+ * pdp_ip0 (IFT_CELLULAR, no Ethernet) can feed the same IP packets without this file. */
+#ifndef CELL_LINK_H
+#define CELL_LINK_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define CELL_ETHER 14u
+#define CELL_FRAME_MAX 1536u
+#define CELL_REPLY_MAX 400u
+
+typedef struct {
+    uint8_t mac[6], router_mac[6];
+    /* IPv4, host order; what DHCP hands out */
+    uint8_t v4_up;
+    uint32_t v4_addr, v4_mask, v4_router, v4_dns1, v4_dns2, mtu, lease;
+    /* IPv6: the /64 the network gave the bearer */
+    uint8_t v6_up, v6_prefix[8], v6_dns1[16], v6_dns2[16], has_v6_dns1, has_v6_dns2;
+    struct {uint64_t arp, dhcp, dhcp_nak, ns, ra, to_modem, dropped_out, from_modem, dropped_in;} count;
+} CellLink;
+
+void cell_link_init(CellLink *l, const uint8_t mac[6], const uint8_t router_mac[6]);
+/* A new or changed IPv4 session (addr 0: down). The presented mask is /24 and the router .1 of it, or .2 when the address is .1. */
+void cell_link_set_v4(CellLink *l, uint32_t addr, uint32_t dns1, uint32_t dns2, uint32_t mtu);
+/* A new or changed IPv6 session: the first 8 bytes of the WDS address are the prefix (prefix length must be 64). null: down. */
+int cell_link_set_v6(CellLink *l, const uint8_t addr[16], uint8_t prefix_len, const uint8_t *dns1, const uint8_t *dns2, uint32_t mtu);
+
+typedef enum {CELL_DROP = 0, CELL_REPLY = 1, CELL_TO_MODEM = 2} CellAction;
+/* One frame the stack sent. CELL_REPLY: reply holds *reply_len bytes, a frame to hand back to the stack as received. CELL_TO_MODEM:
+ * the IP datagram is frame + CELL_ETHER, *reply_len bytes (its own length, so Ethernet padding never reaches the modem). DHCP must be
+ * unfragmented with a consistent UDP length; solicitations need code 0 and a valid checksum. */
+CellAction cell_link_output(CellLink *l, const uint8_t *frame, uint32_t length, uint8_t *reply, uint32_t *reply_len);
+
+/* The Ethernet header (14 bytes) to put in front of an IP packet from the modem. Returns 0 and counts a drop when the packet is not
+ * IPv4 or IPv6 of a usable size, else CELL_ETHER. */
+uint32_t cell_link_input_header(CellLink *l, const uint8_t *packet, uint32_t length, uint8_t header[CELL_ETHER]);
+
+/* An unsolicited router advertisement (for a new prefix, or the link coming up). Returns its length in out, 0 when IPv6 is down. */
+uint32_t cell_link_router_advert(CellLink *l, uint8_t *out, uint32_t capacity);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
