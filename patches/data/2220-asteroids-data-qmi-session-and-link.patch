+#if defined(ARM64_BOARD_CONFIG_SWEET) || !defined(KERNEL)
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Moved out of sweet_data.c so the cache can be tested with the real QRTR and session code (modem 2189 audit, finding 1). */
+#include "DataServices.h"
+
+const uint8_t data_service_ids[DATA_SERVICE_COUNT] = {QMI_SVC_DMS, QMI_SVC_NAS, QMI_SVC_WDS, QMI_SVC_WDA, QMI_SVC_DPM, QMI_SVC_UIM};
+
+void data_services_sync(DataServices *d, const QcomQrtr *qr, CellSession *session, DataServiceLost lost, void *context)
+{
+    for (unsigned i = 0; i < DATA_SERVICE_COUNT; ++i) {
+        const int r = qcom_qrtr_find_remote(qr, data_service_ids[i]);
+        const int moved = r >= 0 && d->svc[i].present &&
+                          (d->svc[i].node != qr->remote[r].node || d->svc[i].port != qr->remote[r].port);
+        if (d->svc[i].present && (r < 0 || moved)) {
+            d->svc[i].present = 0;
+            if (lost) lost(context, data_service_ids[i]);
+            if (session) cell_session_service(session, data_service_ids[i], 0);
+        }
+        if (r >= 0 && !d->svc[i].present) {
+            d->svc[i].node = qr->remote[r].node;
+            d->svc[i].port = qr->remote[r].port;
+            d->svc[i].present = 1;
+            if (session) cell_session_service(session, data_service_ids[i], 1);
+        }
+    }
+}
+
+int data_services_lookup(const DataServices *d, uint32_t node, uint32_t port)
+{
+    for (unsigned i = 0; i < DATA_SERVICE_COUNT; ++i)
+        if (d->svc[i].present && d->svc[i].node == node && d->svc[i].port == port) return data_service_ids[i];
+    return -1;
+}
+
+int data_services_endpoint(const DataServices *d, uint8_t service, uint32_t *node, uint32_t *port)
+{
+    for (unsigned i = 0; i < DATA_SERVICE_COUNT; ++i) {
+        if (data_service_ids[i] != service || !d->svc[i].present) continue;
+        *node = d->svc[i].node;
+        *port = d->svc[i].port;
+        return 0;
+    }
+    return -1;
+}
+
+void data_services_clear(DataServices *d)
+{
+    for (unsigned i = 0; i < DATA_SERVICE_COUNT; ++i) d->svc[i].present = 0;
+}
+#endif
