+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Where each QMI service the data side uses lives, as the modem's QRTR name service last announced it, and the session's view of it.
+ * data_services_sync compares the cache with the QRTR remote list and tells the session about every service that went away or came
+ * back. The owner calls it after every QRTR control packet (so a DEL_SERVER is seen before the next data packet, and a DEL then NEW
+ * at the same endpoint is still seen as a loss) and again before readiness and session work. Pure, worker-thread only. */
+#ifndef DATA_SERVICES_H
+#define DATA_SERVICES_H
+#include <stdint.h>
+#include "CellSession.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define DATA_SERVICE_COUNT 6u
+extern const uint8_t data_service_ids[DATA_SERVICE_COUNT];  /* DMS, NAS, WDS, WDA, DPM, UIM */
+
+typedef struct {
+    struct {uint32_t node, port; int present;} svc[DATA_SERVICE_COUNT];
+} DataServices;
+
+/* Called for a service that went away (before the session hears of it), for example to fail a raw request waiting on it. */
+typedef void (*DataServiceLost)(void *context, uint8_t service);
+
+/* Brings the cache in line with qr's remote list. A service whose endpoint moved counts as lost, then found. session may be null. */
+void data_services_sync(DataServices *d, const QcomQrtr *qr, CellSession *session, DataServiceLost lost, void *context);
+/* The service at node:port in the cache, or -1. */
+int data_services_lookup(const DataServices *d, uint32_t node, uint32_t port);
+/* The cached endpoint of service: 0 and node/port set when present, -1 otherwise. */
+int data_services_endpoint(const DataServices *d, uint8_t service, uint32_t *node, uint32_t *port);
+void data_services_clear(DataServices *d);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
