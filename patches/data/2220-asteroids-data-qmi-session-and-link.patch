+typedef struct {uint8_t status, reconfigure, family, has_family; uint16_t end_reason; uint8_t has_end;} WdsPacketStatus;
+/* The 0x22 indication only. */
+int wds_parse_packet_status(const uint8_t *p, uint32_t n, WdsPacketStatus *out);
+
+/* ---- WDA and DPM ---- */
+typedef struct {
+    uint32_t link, ul_agg, dl_agg, dl_max_datagrams, dl_max_size, ul_max_datagrams, ul_max_size;
+    uint32_t endpoint_type, interface;
+} WdaFormat;
+uint32_t wda_set_data_format(uint8_t *buf, uint32_t cap, uint16_t txn, const WdaFormat *f);
+uint32_t wda_get_data_format(uint8_t *buf, uint32_t cap, uint16_t txn, uint32_t endpoint_type, uint32_t interface);
+/* What the modem agreed to: TLVs it left out stay 0. */
+int wda_parse_data_format(const uint8_t *p, uint32_t n, uint16_t txn, uint16_t message, WdaFormat *out);
+
+/* One embedded hardware data port: rx_endpoint is the IPA endpoint the modem receives on (our transmit), tx_endpoint the one it sends
