+#if defined(ARM64_BOARD_CONFIG_SWEET) || !defined(KERNEL)
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Layouts: libqmi data/qmi-service-{dms,nas,wds,wda,dpm}.json. Integers are little-endian, IPv6 words big-endian. A string that is a
+ * whole TLV has no length byte; a string inside a sequence or array element has a one-byte length before it. */
+#include "QmiData.h"
+
+static uint16_t le16(const uint8_t *p) {return (uint16_t)(p[0] | p[1] << 8);}
+static uint32_t le32(const uint8_t *p) {return (uint32_t)le16(p) | (uint32_t)le16(p + 2) << 16;}
+
+/* ---- building ---- */
+void qmi_begin(QmiOut *o, uint8_t *buf, uint32_t cap, uint16_t transaction, uint16_t message)
+{
+    o->buf = buf; o->cap = cap; o->len = QCOM_QMI_HEADER; o->bad = cap < QCOM_QMI_HEADER;
+    if (o->bad) return;
+    buf[0] = QCOM_QMI_REQUEST;
+    buf[1] = (uint8_t)transaction; buf[2] = (uint8_t)(transaction >> 8);
+    buf[3] = (uint8_t)message; buf[4] = (uint8_t)(message >> 8);
+}
+
+void qmi_put_bytes(QmiOut *o, uint8_t type, const void *v, uint32_t n)
+{
+    if (o->bad || n > 0xffff || o->cap - o->len < 3 || o->cap - o->len - 3 < n || (n && !v)) {o->bad = 1; return;}
+    uint8_t *p = o->buf + o->len;
+    p[0] = type; p[1] = (uint8_t)n; p[2] = (uint8_t)(n >> 8);
+    for (uint32_t i = 0; i < n; ++i) p[3 + i] = ((const uint8_t *)v)[i];
+    o->len += 3 + n;
+}
+
+void qmi_put_u8(QmiOut *o, uint8_t type, uint8_t v) {qmi_put_bytes(o, type, &v, 1);}
+void qmi_put_u16(QmiOut *o, uint8_t type, uint16_t v) {uint8_t b[2] = {(uint8_t)v, (uint8_t)(v >> 8)}; qmi_put_bytes(o, type, b, 2);}
+void qmi_put_u32(QmiOut *o, uint8_t type, uint32_t v)
+{
+    uint8_t b[4] = {(uint8_t)v, (uint8_t)(v >> 8), (uint8_t)(v >> 16), (uint8_t)(v >> 24)};
+    qmi_put_bytes(o, type, b, 4);
+}
+
+void qmi_put_string(QmiOut *o, uint8_t type, const char *s, uint32_t max)
+{
+    uint32_t n = 0;
+    while (n <= max && s[n]) ++n;  /* reads at most max + 1 bytes of s */
+    if (n > max) {o->bad = 1; return;}
+    qmi_put_bytes(o, type, s, n);
+}
+
+uint32_t qmi_end(QmiOut *o)
+{
+    if (o->bad || o->len - QCOM_QMI_HEADER > 0xffff) return 0;
+    const uint32_t body = o->len - QCOM_QMI_HEADER;
+    o->buf[5] = (uint8_t)body; o->buf[6] = (uint8_t)(body >> 8);
+    return o->len;
+}
+
+static uint32_t empty(uint8_t *buf, uint32_t cap, uint16_t txn, uint16_t message)
+{
+    QmiOut o;
+    qmi_begin(&o, buf, cap, txn, message);
+    return qmi_end(&o);
+}
+
+/* ---- reading ---- */
+static int parse_any(const uint8_t *data, uint32_t length, uint8_t type, uint16_t transaction, uint16_t message, QcomQmiMessage *m)
+{
+    if (qcom_qmi_parse(data, length, m) || m->type != type || m->message != message) return -1;
+    if (type == QCOM_QMI_RESPONSE && m->transaction != transaction) return -1;
+    return 0;
+}
+
+int qmi_response(const uint8_t *data, uint32_t length, uint16_t transaction, uint16_t message, QcomQmiMessage *m)
+{
+    uint32_t n = 0;
+    if (parse_any(data, length, QCOM_QMI_RESPONSE, transaction, message, m)) return -1;
+    const uint8_t *r = qcom_qmi_tlv(m, 0x02, &n);
+    if (!r || n != 4) return -1;
+    unsigned results = 0;  /* exactly one result TLV: a second could say something else */
+    for (uint32_t at = 0; at + 3 <= m->length; at += 3u + le16(m->tlvs + at + 1)) results += m->tlvs[at] == 0x02;
+    if (results != 1) return -1;
+    const uint16_t result = le16(r), error = le16(r + 2);
+    if (result > 1 || (!result && error) || (result && !error)) return -1;
+    return error;
+}
+
+/* A response or, for messages that are also indications, the indication. */
+static int response_or_indication(const uint8_t *p, uint32_t n, uint16_t txn, uint16_t message, QcomQmiMessage *m)
+{
+    if (n >= 1 && p[0] == QCOM_QMI_INDICATION) return parse_any(p, n, QCOM_QMI_INDICATION, 0, message, m);
+    return qmi_response(p, n, txn, message, m);
+}
+
+/* Copies n bytes of text into out (size bytes with the terminator), replacing anything outside printable ASCII. */
+static void text(char *out, uint32_t size, const uint8_t *s, uint32_t n)
+{
+    uint32_t i = 0;
+    for (; i < n && i + 1 < size; ++i) out[i] = s[i] >= 0x20 && s[i] < 0x7f ? (char)s[i] : '?';
+    out[i] = 0;
+}
+
+static const uint8_t *tlv_at_least(const QcomQmiMessage *m, uint8_t type, uint32_t need, uint32_t *size)
+{
+    uint32_t n = 0;
+    const uint8_t *v = qcom_qmi_tlv(m, type, &n);
+    if (!v || n < need) return 0;
+    if (size) *size = n;
+    return v;
+}
+
+/* How many TLVs of type m carries, and whether every one is exactly size bytes. */
+static unsigned tlv_count(const QcomQmiMessage *m, uint8_t type, uint32_t size, int *sizes_ok)
+{
+    unsigned n = 0;
+    *sizes_ok = 1;
+    for (uint32_t at = 0; at + 3 <= m->length; at += 3u + le16(m->tlvs + at + 1)) {
+        if (m->tlvs[at] != type) continue;
+        n++;
+        if (le16(m->tlvs + at + 1) != size) *sizes_ok = 0;
+    }
+    return n;
+}
