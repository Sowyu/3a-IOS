+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* QMI messages for mobile data: DMS, NAS, WDS, WDA and DPM requests built into a caller's buffer, and their responses and indications
+ * decoded into plain structs. Wire layouts follow libqmi's data/qmi-service-*.json. Parsing reuses the modem runtime's qcom_qmi_parse()
+ * and qcom_qmi_tlv() (bsd/dev/modem/QcomQrtr.h). No allocation, no locking, no logging: the same file builds into the kernel and into
+ * the host tests. Decoders never keep a full IMEI, ICCID, IMSI or phone number; the IMEI comes out as its last four digits only. */
+#ifndef QMI_DATA_H
+#define QMI_DATA_H
+#include <stdint.h>
+#ifdef KERNEL
+#include "../modem/QcomQrtr.h"
+#else
+#include "QcomQrtr.h"  /* host tests */
+#endif
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* services, as announced over QRTR */
+enum {QMI_SVC_WDS = 0x01, QMI_SVC_DMS = 0x02, QMI_SVC_NAS = 0x03, QMI_SVC_UIM = 0x0b, QMI_SVC_WDA = 0x1a, QMI_SVC_DPM = 0x2f};
+
+/* message ids */
+enum {
+    DMS_GET_REVISION = 0x23, DMS_GET_IDS = 0x25, DMS_GET_OPERATING_MODE = 0x2d, DMS_SET_OPERATING_MODE = 0x2e,
+    NAS_REGISTER_INDICATIONS = 0x03, NAS_GET_SIGNAL_STRENGTH = 0x20, NAS_SERVING_SYSTEM = 0x24, NAS_SET_SYSTEM_SELECTION = 0x33,
+    NAS_GET_SYSTEM_SELECTION = 0x34, NAS_GET_OPERATOR_NAME = 0x39, NAS_OPERATOR_NAME_IND = 0x3a, NAS_GET_SIGNAL_INFO = 0x4f,
+    NAS_SIGNAL_INFO_IND = 0x51,
+    WDS_START_NETWORK = 0x20, WDS_STOP_NETWORK = 0x21, WDS_PACKET_SERVICE_STATUS = 0x22, WDS_CREATE_PROFILE = 0x27,
+    WDS_MODIFY_PROFILE = 0x28, WDS_GET_PROFILE_LIST = 0x2a, WDS_GET_PROFILE_SETTINGS = 0x2b, WDS_GET_CURRENT_SETTINGS = 0x2d,
+    WDS_SET_IP_FAMILY = 0x4d, WDS_BIND_MUX_DATA_PORT = 0xa2,
+    WDA_SET_DATA_FORMAT = 0x20, WDA_GET_DATA_FORMAT = 0x21,
+    DPM_OPEN_PORT = 0x20, DPM_CLOSE_PORT = 0x21,
+};
+
+enum {DMS_MODE_ONLINE = 0, DMS_MODE_LOW_POWER = 1};
+enum {WDS_FAMILY_IPV4 = 4, WDS_FAMILY_IPV6 = 6};
+enum {WDS_PDP_IPV4 = 0, WDS_PDP_IPV6 = 2, WDS_PDP_IPV4V6 = 3};
+enum {WDS_STATUS_DISCONNECTED = 1, WDS_STATUS_CONNECTED = 2, WDS_STATUS_SUSPENDED = 3, WDS_STATUS_AUTHENTICATING = 4};
+enum {NAS_REGISTERED = 1, NAS_ATTACHED = 1};
+enum {QMI_ERR_NO_EFFECT = 0x1a, QMI_ERR_INVALID_OPERATION = 0x46};
+enum {WDA_LINK_RAW_IP = 2, WDA_AGG_QMAP = 5, WDA_AGG_QMAPV5 = 9};
+enum {QMI_ENDPOINT_EMBEDDED = 4};
+#define WDS_HANDLE_NONE 0u
+
+/* ---- building a request ---- */
+typedef struct {uint8_t *buf; uint32_t cap, len; int bad;} QmiOut;
+void qmi_begin(QmiOut *o, uint8_t *buf, uint32_t cap, uint16_t transaction, uint16_t message);
+void qmi_put_u8(QmiOut *o, uint8_t type, uint8_t v);
+void qmi_put_u16(QmiOut *o, uint8_t type, uint16_t v);
+void qmi_put_u32(QmiOut *o, uint8_t type, uint32_t v);
+void qmi_put_bytes(QmiOut *o, uint8_t type, const void *v, uint32_t n);
+/* A TLV of a NUL-terminated string without its terminator; refused (o->bad) above max bytes. */
+void qmi_put_string(QmiOut *o, uint8_t type, const char *s, uint32_t max);
+/* Finishes the header. Returns the message length, or 0 when anything did not fit or was refused. */
+uint32_t qmi_end(QmiOut *o);
+
+/* The standard result TLV 0x02 of a response: 0 success, the QMI error code (>0), or -1 when the message is not the matching response
+ * (wrong type, message id or transaction, or no well-formed result). */
+int qmi_response(const uint8_t *data, uint32_t length, uint16_t transaction, uint16_t message, QcomQmiMessage *m);
+
+/* ---- DMS ---- */
+uint32_t dms_get_ids(uint8_t *buf, uint32_t cap, uint16_t txn);
+uint32_t dms_get_revision(uint8_t *buf, uint32_t cap, uint16_t txn);
+uint32_t dms_get_operating_mode(uint8_t *buf, uint32_t cap, uint16_t txn);
+/* Only ONLINE and LOW_POWER are built: persistent low power, factory test, offline and reset return 0. */
+uint32_t dms_set_operating_mode(uint8_t *buf, uint32_t cap, uint16_t txn, uint8_t mode);
+
+typedef struct {char imei_last4[5]; uint8_t has_imei;} DmsIds;
+typedef struct {char text[64];} DmsRevision;
+typedef struct {uint8_t mode, has_offline_reason, hw_restricted; uint16_t offline_reason;} DmsMode;
+int dms_parse_ids(const uint8_t *p, uint32_t n, uint16_t txn, DmsIds *out);
+int dms_parse_revision(const uint8_t *p, uint32_t n, uint16_t txn, DmsRevision *out);
+int dms_parse_operating_mode(const uint8_t *p, uint32_t n, uint16_t txn, DmsMode *out);
+
+/* ---- NAS ---- */
+/* Serving system, signal info and current PLMN name indications on; everything else left at the modem's default. */
+uint32_t nas_register_indications(uint8_t *buf, uint32_t cap, uint16_t txn);
+uint32_t nas_get_serving_system(uint8_t *buf, uint32_t cap, uint16_t txn);
+uint32_t nas_get_signal_info(uint8_t *buf, uint32_t cap, uint16_t txn);
+uint32_t nas_get_signal_strength(uint8_t *buf, uint32_t cap, uint16_t txn);
+uint32_t nas_get_operator_name(uint8_t *buf, uint32_t cap, uint16_t txn);
+uint32_t nas_get_system_selection(uint8_t *buf, uint32_t cap, uint16_t txn);
+/* Mode preference bits (libqmi QmiNasRatModePreference: 1<<4 LTE, 1<<3 UMTS, 1<<2 GSM, 1<<6 5GNR...), always with change duration
+ * "until power cycle", so nothing persists across a modem restart. */
+uint32_t nas_set_mode_preference(uint8_t *buf, uint32_t cap, uint16_t txn, uint16_t mode_mask);
+
+#define NAS_MAX_RADIOS 8u
+typedef struct {
+    uint8_t reg_state, cs_attach, ps_attach, network, radio_count;
+    uint8_t radio[NAS_MAX_RADIOS];
+    uint8_t has_plmn, has_roaming, roaming;
+    uint16_t mcc, mnc;
+    char description[32];
+} NasServing;
+/* Works for the 0x24 response (txn checked) and the 0x24 indication (txn ignored). */
+int nas_parse_serving(const uint8_t *p, uint32_t n, uint16_t txn, NasServing *out);
+int nas_registered_for_data(const NasServing *s);
+
+typedef struct {
+    uint8_t has_lte, has_nr, has_wcdma, has_gsm;
+    int8_t lte_rssi, lte_rsrq, gsm_rssi, wcdma_rssi;
+    int16_t lte_rsrp, lte_snr, nr_rsrp, nr_snr, wcdma_ecio;
+} NasSignal;
+/* Get Signal Info 0x4f response (txn checked) or the 0x51 indication. */
+int nas_parse_signal(const uint8_t *p, uint32_t n, uint16_t txn, NasSignal *out);
+/* Get Signal Strength 0x20: the primary strength (dBm) and radio. */
+int nas_parse_signal_strength(const uint8_t *p, uint32_t n, uint16_t txn, int8_t *dbm, int8_t *radio);
+/* 0..4 bars from a signal report, for a later status bar; -1 when nothing usable. */
+int nas_bars(const NasSignal *s);
+
+typedef struct {char spn[32], name[32]; uint8_t has_spn, has_name;} NasOperator;
+int nas_parse_operator(const uint8_t *p, uint32_t n, uint16_t txn, NasOperator *out);
+
+typedef struct {uint16_t mode_pref; uint8_t has_mode_pref, net_sel_pref, has_net_sel;} NasSelection;
+int nas_parse_system_selection(const uint8_t *p, uint32_t n, uint16_t txn, NasSelection *out);
+
+/* ---- WDS ---- */
+uint32_t wds_get_profile_list(uint8_t *buf, uint32_t cap, uint16_t txn);
+uint32_t wds_get_profile_settings(uint8_t *buf, uint32_t cap, uint16_t txn, uint8_t index);
+
+typedef struct {
+    const char *apn, *username, *password;  /* null or "" leaves the TLV out */
+    uint8_t pdp_type;                       /* WDS_PDP_* */
+    uint8_t auth;                           /* 0 none, 1 PAP, 2 CHAP, 3 both; 0xff leaves it out */
+    uint8_t profile;                        /* 3GPP profile index, 0 for none (start network) or a new one (create) */
+    uint8_t family;                         /* start network only: WDS_FAMILY_*, 0 leaves it out */
+} WdsCall;
+/* Create writes a new 3GPP profile, Modify rewrites profile call->profile. Both write the modem's EFS, which the modem runtime keeps in
+ * RAM only. The session never sends them; they exist for the raw tool and for a later persistent setup. */
+uint32_t wds_create_profile(uint8_t *buf, uint32_t cap, uint16_t txn, const WdsCall *call);
+uint32_t wds_modify_profile(uint8_t *buf, uint32_t cap, uint16_t txn, const WdsCall *call);
+uint32_t wds_bind_mux(uint8_t *buf, uint32_t cap, uint16_t txn, uint32_t endpoint_type, uint32_t interface, uint8_t mux);
+uint32_t wds_set_ip_family(uint8_t *buf, uint32_t cap, uint16_t txn, uint8_t family);
+uint32_t wds_start_network(uint8_t *buf, uint32_t cap, uint16_t txn, const WdsCall *call);
+uint32_t wds_stop_network(uint8_t *buf, uint32_t cap, uint16_t txn, uint32_t handle);
+/* Asks for DNS, IP address, gateway, MTU, IP family and profile id. */
+uint32_t wds_get_current_settings(uint8_t *buf, uint32_t cap, uint16_t txn);
+
+#define WDS_MAX_PROFILES 8u
+typedef struct {uint8_t count, total; struct {uint8_t type, index; char name[32];} p[WDS_MAX_PROFILES];} WdsProfiles;
+int wds_parse_profile_list(const uint8_t *p, uint32_t n, uint16_t txn, WdsProfiles *out);
+typedef struct {char name[32], apn[64]; uint8_t has_pdp, pdp_type, has_auth, auth;} WdsProfile;
+int wds_parse_profile_settings(const uint8_t *p, uint32_t n, uint16_t txn, WdsProfile *out);
+int wds_parse_profile_created(const uint8_t *p, uint32_t n, uint16_t txn, uint8_t *index);
