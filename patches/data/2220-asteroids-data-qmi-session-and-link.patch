+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* The root-only raw QMI path (sysctl kern.sweet_qmi, boot arg sweetqmiraw=1): the wire format between the userland tool and the
+ * kernel, and the allow list every request passes before it reaches the modem. The list admits reads only: no request changes modem
+ * state, so none can get around the session's readiness barrier (docs/data-2220-reaudit.md B1). Duplicate request TLVs are refused. It refuses anything that returns a full identifier (IMEI, MSISDN, ICCID, IMSI) or profile credentials,
+ * touches PINs or SIM files, resets a service, starts or stops a call, or persists past a modem restart. Every service not listed is
+ * refused. Requests use client 0 only. */
+#ifndef QMI_RAW_H
+#define QMI_RAW_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QMI_RAW_VERSION 1u
+#define QMI_RAW_REQUEST_HEADER 8u   /* version, service, client (0), 0, timeout_ms (u32 LE), then a whole QMI message */
+#define QMI_RAW_REPLY_HEADER 8u     /* status (i32 LE: 0, or an errno), length (u32 LE), then the response */
+#define QMI_RAW_MAX 480u            /* QRTR carries at most 480 data bytes (plans/modem/README.md) */
+#define QMI_RAW_TIMEOUT_MAX 10000u
+
+typedef struct {
+    uint8_t service, client;
+    uint32_t timeout_ms;
+    const uint8_t *msg;             /* QMI header and TLVs; the kernel sets type and transaction */
+    uint32_t length;
+} QmiRawRequest;
+
+/* 0 or an errno (EINVAL malformed, EPERM refused by the allow list). */
+int qmi_raw_parse(const uint8_t *buf, uint32_t length, QmiRawRequest *out);
+/* 0 when the message may go to the modem, else EPERM. */
+int qmi_raw_allowed(uint8_t service, const uint8_t *msg, uint32_t length);
+/* Whether an indication may be kept for kern.sweet_qmi_ind: serving system, signal, operator name, packet service status. */
+int qmi_raw_indication_kept(uint8_t service, uint16_t message);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
