+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* The root-only raw QMI path (sysctl kern.sweet_qmi, boot arg sweetqmiraw=1): the wire format between the userland tool and the
+ * kernel, and the allow list every request passes before it reaches the modem. The list admits reads, the session's own requests
+ * and transient settings. It refuses anything that returns a full identifier (IMEI, MSISDN, ICCID, IMSI), touches PINs or SIM files,
+ * resets or reflashes the modem, or persists beyond a modem restart outside the RAM-only EFS (NAS preferences without "until power
+ * cycle", autoconnect, firmware and lock settings). Every service not listed is refused. */
+#ifndef QMI_RAW_H
+#define QMI_RAW_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QMI_RAW_VERSION 1u
+#define QMI_RAW_REQUEST_HEADER 8u   /* version, service, client, 0, timeout_ms (u32 LE), then a whole QMI message */
+#define QMI_RAW_REPLY_HEADER 8u     /* status (i32 LE: 0, or an errno), length (u32 LE), then the response */
+#define QMI_RAW_MAX 1024u
+#define QMI_RAW_TIMEOUT_MAX 10000u
+
+typedef struct {
+    uint8_t service, client;
+    uint32_t timeout_ms;
+    const uint8_t *msg;             /* QMI header and TLVs; the kernel sets type and transaction */
+    uint32_t length;
+} QmiRawRequest;
+
+/* 0 or an errno (EINVAL malformed, EPERM refused by the allow list). */
+int qmi_raw_parse(const uint8_t *buf, uint32_t length, QmiRawRequest *out);
+/* 0 when the message may go to the modem, else EPERM. */
+int qmi_raw_allowed(uint8_t service, const uint8_t *msg, uint32_t length);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
