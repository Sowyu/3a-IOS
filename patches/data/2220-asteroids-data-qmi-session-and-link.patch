+/*
+ * SWEET DATA: mobile data above the modem runtime (bsd/dev/modem) and the IPA.
+ *
+ * Three parts, all off unless their boot arg is the exact token NAME=1:
+ *   sweetdata=1     the QMI session (CellSession.c) on two QRTR client ports, and en2, an Ethernet ifnet that configd sets up by
+ *                   DHCP. Its frames are answered or turned into IP packets by CellLink.c; the packets go through QMAP (Qmap.c)
+ *                   to the IPA agent's transmit hook, and the IPA agent hands received buffers to sweet_data_ipa_rx().
+ *   sweetdataonline=1  lets the session put the modem online (DMS Set Operating Mode 0). Without it the session waits.
+ *   sweetqmiraw=1   sysctl kern.sweet_qmi for root: one call sends a QMI request through the allow list (QmiRaw.c) and returns
+ *                   the response; kern.sweet_qmi_ind returns the last indications.
+ * sweetapn=NAME gives the APN; without it Start Network uses the modem's default profile.
+ *
+ * Threads: the modem runtime's worker calls sweet_data_attach(), sweet_data_poll() and the QRTR receive callbacks, so the session and
+ * every QRTR send run on that one thread. The stack's output, the IPA's receive and the sysctl caller meet the worker only under
+ * sd.lock: the CellLink state, the raw request slot and the indication ring. No packet byte is logged.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/sysctl.h>
+#include <sys/kauth.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/sockio.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+#include <net/if.h>
+#include <net/if_media.h>
+#include <net/if_types.h>
+#include <net/if_ether.h>
+#include <net/ethernet.h>
+#include <net/ether_if_module.h>
+#include <net/kpi_interface.h>
+#include <sys/kern_event.h>
+#include <net/bpf.h>
+#include <net/dlil.h>
+#include "../modem/QcomQrtr.h"
+#include "../modem/ModemGate.h"
+#include "QmiData.h"
+#include "Qmap.h"
+#include "CellLink.h"
+#include "CellSession.h"
+#include "QmiRaw.h"
+#include "sweet_data.h"
+
+#define PORT_CLIENT0 0x4010u
+#define PORT_CLIENT1 0x4011u
+#define RAW_BUF (QMI_RAW_REPLY_HEADER + QMI_RAW_MAX)
+#define IND_RING 8u
+#define IND_MAX 256u
+
+static const uint8_t sd_mac[6] = {0x02, 0x53, 0x57, 0x44, 0x41, 0x01};     /* locally administered "SWDA" 1 */
+static const uint8_t sd_router_mac[6] = {0x02, 0x53, 0x57, 0x44, 0x41, 0xfe};
+static const uint8_t sd_services[] = {QMI_SVC_DMS, QMI_SVC_NAS, QMI_SVC_WDS, QMI_SVC_WDA, QMI_SVC_DPM, QMI_SVC_UIM};
+
+static struct {
+	int session_on, raw_on, attached;
+	lck_grp_t *grp;
+	lck_mtx_t *lock;
+	QcomQrtr *qr;
+	CellSession session;
+	char apn[101];
+	/* where each service is, as the remote announced it */
+	struct {uint32_t node, port; int present;} svc[sizeof sd_services];
+	/* the presentation */
+	CellLink link;
+	ifnet_t ifp;
+	int link_up;
+	/* the IPA agent's side */
+	int (*ipa_tx)(void *, const uint8_t *, uint32_t);
+	void *ipa_ctx;
+	QmapVersion qmap;
+	QmapCounters qmap_count;
+	/* one raw request at a time */
+	struct {
+		int state;              /* 0 free, 1 queued, 2 sent, 3 answered, 4 abandoned */
+		uint8_t service, client;
+		uint16_t txn, next_txn, message;
+		uint8_t msg[QMI_RAW_MAX];
+		uint32_t len, reply_len;
+		uint8_t reply[QMI_RAW_MAX];
+	} raw;
+	struct {uint32_t seq, len; uint8_t service, client, data[IND_MAX];} ind[IND_RING];
+	uint32_t ind_seq;
+} sd;
+
+static void
+sd_lock_init(void)
+{
+	/* ponytail: unsynchronised first call; attach and set_ipa both run during single-threaded bring-up */
+	if (sd.lock == NULL) {
+		sd.grp = lck_grp_alloc_init("sweet_data", LCK_GRP_ATTR_NULL);
+		sd.lock = lck_mtx_alloc_init(sd.grp, LCK_ATTR_NULL);
+	}
+}
+
+static int
+sd_gate(const char *name)
+{
+	return modem_gate(PE_boot_args(), name) != 0;
+}
+
+static int
+sd_index(uint8_t service)
+{
+	for (unsigned i = 0; i < sizeof sd_services; ++i) {
+		if (sd_services[i] == service) {
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+static int
+sd_send(void *ctx, unsigned client, uint8_t service, const uint8_t *msg, uint32_t length)
+{
+	(void)ctx;
+	const int i = sd_index(service);
+	if (i < 0 || !sd.svc[i].present || sd.qr == NULL || client > 1) {
+		return -1;
+	}
+	return qcom_qrtr_send_data(sd.qr, client ? PORT_CLIENT1 : PORT_CLIENT0, sd.svc[i].node, sd.svc[i].port, msg, length);
+}
+
+/* ---- the ifnet ---- */
+static void
+sd_input(const uint8_t *header, const uint8_t *packet, uint32_t length)
+{
+	mbuf_t m = NULL;
+	const uint32_t total = CELL_ETHER + length;
+
+	if (sd.ifp == NULL || total > MCLBYTES) {
+		return;
+	}
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 || mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 ||
+	    !(mbuf_flags(m) & MBUF_EXT) || mbuf_maxlen(m) < total) {
+		if (m != NULL) {
+			mbuf_freem(m);
+		}
+		ifnet_stat_increment_in(sd.ifp, 0, 0, 1);
+		return;
+	}
+	uint8_t *d = mbuf_data(m);
+	memcpy(d, header, CELL_ETHER);
+	memcpy(d + CELL_ETHER, packet, length);
+	mbuf_setlen(m, total);
+	mbuf_pkthdr_setlen(m, total);
+	mbuf_pkthdr_setrcvif(m, sd.ifp);
+	mbuf_pkthdr_setheader(m, d);
+	mbuf_pkthdr_adjustlen(m, -(int)CELL_ETHER);
+	(void)mbuf_setdata(m, d + CELL_ETHER, length);
+	struct ifnet_stat_increment_param st = {};
+	st.packets_in = 1;
+	st.bytes_in = total;
+	ifnet_input(sd.ifp, m, &st);
+}
+
+static errno_t
+sd_output(ifnet_t ifp, mbuf_t m)
+{
+	/* room for the QMAP headers in front of the IP packet: the frame's Ethernet header is 14 bytes, QMAPv5 needs 8 */
+	static uint8_t frame[CELL_FRAME_MAX];
+	uint8_t reply[CELL_REPLY_MAX];
+	uint32_t reply_len = 0;
+	const size_t len = mbuf_pkthdr_len(m);
+	int ok = 0, answer = 0;
+
+	lck_mtx_lock(sd.lock);
+	if (len >= CELL_ETHER && len <= sizeof frame && mbuf_copydata(m, 0, len, frame) == 0) {
+		const CellAction a = cell_link_output(&sd.link, frame, (uint32_t)len, reply, &reply_len);
+		if (a == CELL_REPLY) {
+			answer = ok = 1;
+		} else if (a == CELL_TO_MODEM && sd.ipa_tx != NULL) {
+			uint8_t *ip = frame + CELL_ETHER;
+			const uint32_t n = qmap_frame(sd.qmap, sd.session.cfg.mux, ip, (uint32_t)len - CELL_ETHER);
+			ok = n && sd.ipa_tx(sd.ipa_ctx, ip - qmap_headroom(sd.qmap), n) == 0;
+		}
+	}
+	lck_mtx_unlock(sd.lock);
+	if (answer) {
+		sd_input(reply, reply + CELL_ETHER, reply_len - CELL_ETHER);  /* outside the lock: input may come back to output */
+	}
+	ifnet_stat_increment_out(ifp, ok, ok ? (uint32_t)len : 0, !ok);
+	mbuf_freem(m);
+	return 0;
+}
+
+static errno_t
+sd_ioctl(ifnet_t ifp, unsigned long cmd, void *data)
+{
+	switch (cmd) {
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64: {
+		struct ifmediareq *ifmr = (struct ifmediareq *)data;
+		user_addr_t list = (cmd == SIOCGIFMEDIA64) ? ((struct ifmediareq64 *)ifmr)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)ifmr)->ifmu_ulist);
+		int word = IFM_ETHER | IFM_AUTO;
+		ifmr->ifm_current = word;
+		ifmr->ifm_active = sd.link_up ? (IFM_ETHER | IFM_1000_T | IFM_FDX) : word;
+		ifmr->ifm_mask = 0;
+		ifmr->ifm_status = IFM_AVALID | (sd.link_up ? IFM_ACTIVE : 0);
+		ifmr->ifm_count = 1;
+		return list != USER_ADDR_NULL ? copyout(&word, list, sizeof(word)) : 0;
+	}
+	case SIOCSIFADDR:
+	case SIOCAIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		return 0;
+	case SIOCSIFFLAGS:
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		return 0;
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+static void
+sd_detach(ifnet_t ifp __unused)
+{
+}
+
+static void
+sd_ifnet_create(void)
+{
+	struct ifnet_init_eparams init;
+
+	bzero(&init, sizeof(init));
+	init.ver = IFNET_INIT_CURRENT_VERSION;
+	init.len = sizeof(init);
+	init.flags = IFNET_INIT_LEGACY;
+	init.uniqueid = "sweet-cellular";
+	init.uniqueid_len = sizeof("sweet-cellular") - 1;
+	init.name = "en";
+	init.unit = 2;
+	init.family = IFNET_FAMILY_ETHERNET;
+	init.type = IFT_ETHER;
+	init.output = sd_output;
+	init.demux = ether_demux;
+	init.add_proto = ether_add_proto;
+	init.del_proto = ether_del_proto;
+	init.check_multi = ether_check_multi;
+	init.framer_extended = ether_frameout_extended;
+	init.ioctl = sd_ioctl;
+	init.detach = sd_detach;
+	init.broadcast_addr = etherbroadcastaddr;
+	init.broadcast_len = ETHER_ADDR_LEN;
+	if (ifnet_allocate_extended(&init, &sd.ifp) != 0) {
+		printf("SWEET DATA: ifnet_allocate failed\n");
+		sd.ifp = NULL;
+		return;
+	}
+	ifnet_set_addrlen(sd.ifp, ETHER_ADDR_LEN);
+	ifnet_set_hdrlen(sd.ifp, sizeof(struct ether_header));
+	ifnet_set_mtu(sd.ifp, ETHERMTU);
+	ifnet_set_baudrate(sd.ifp, 100000000);
+	ifnet_set_flags(sd.ifp, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST, 0xffff);
+	if (ifnet_attach(sd.ifp, NULL) != 0) {
+		printf("SWEET DATA: ifnet_attach failed\n");
+		ifnet_release(sd.ifp);
+		sd.ifp = NULL;
+		return;
+	}
+	ifnet_set_lladdr(sd.ifp, sd_mac, ETHER_ADDR_LEN);
+	/* IPConfiguration probes and runs DHCP over BPF (see sweet_usb.c, 0158) */
+	(void)bpf_attach(sd.ifp, DLT_EN10MB, sizeof(struct ether_header), NULL, NULL);
+	ifnet_set_flags(sd.ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+	printf("SWEET DATA: en2 attached, link down until a call is up\n");
+}
+
+/* Link state for configd: KEV_DL_LINK_ON/OFF, read with SIOCGIFMEDIA. Worker thread, sd.lock not held. */
+static void
+sd_link(int up)
+{
+	if (sd.ifp == NULL || sd.link_up == up) {
+		return;
+	}
+	sd.link_up = up;
+	ifnet_set_mtu(sd.ifp, sd.link.mtu ? sd.link.mtu : ETHERMTU);
+	dlil_post_msg(sd.ifp, KEV_DL_SUBCLASS, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF, NULL, 0, FALSE);
+	printf("SWEET DATA: en2 link %s\n", up ? "up" : "down");
+}
+
+/* ---- session events ---- */
+static void
+sd_event(void *ctx, CellEvent e, uint32_t arg, const void *data, const char *text)
+{
+	(void)ctx;
+	switch (e) {
+	case CE_STATE:
+	case CE_INFO:
+	case CE_ERROR:
+		printf("SWEET DATA: %s%s%s\n", e == CE_ERROR ? "error: " : e == CE_STATE ? "state " : "", text ? text : "",
+		    e == CE_ERROR ? "" : "");
+		break;
+	case CE_SERVING: {
+		const NasServing *s = data;
+		printf("SWEET DATA: NAS registration %u CS %u PS %u radio %u roaming %u PLMN %03u-%02u '%s'\n", s->reg_state,
+		    s->cs_attach, s->ps_attach, s->radio_count ? s->radio[0] : 0, s->roaming, s->mcc, s->mnc, s->description);
+		break;
+	}
+	case CE_SIGNAL: {
+		const NasSignal *s = data;
+		printf("SWEET DATA: signal bars %d LTE rsrp %d rsrq %d NR rsrp %d\n", (int)arg, s->lte_rsrp, s->lte_rsrq, s->nr_rsrp);
+		break;
+	}
+	case CE_OPERATOR: {
+		const NasOperator *o = data;
+		printf("SWEET DATA: operator '%s' '%s'\n", o->spn, o->name);
+		break;
+	}
+	case CE_UP: {
+		const WdsSettings *w = data;
+		lck_mtx_lock(sd.lock);
+		if (arg == WDS_FAMILY_IPV4) {
+			cell_link_set_v4(&sd.link, w->v4_addr, w->v4_dns1, w->v4_dns2, w->mtu);
+		} else {
+			cell_link_set_v6(&sd.link, w->v6_addr, w->v6_prefix, w->has_v6_dns1 ? w->v6_dns1 : NULL,
+			    w->has_v6_dns2 ? w->v6_dns2 : NULL, w->mtu);
+		}
+		lck_mtx_unlock(sd.lock);
+		/* addresses are the user's, not identifiers, but only the family and MTU go to the log */
+		printf("SWEET DATA: IPv%u call up, MTU %u%s\n", arg, w->mtu, sd.ipa_tx ? "" : " (no IPA transmit hook yet)");
+		sd_link(1);
+		break;
+	}
+	case CE_DOWN:
+		lck_mtx_lock(sd.lock);
+		if (arg == WDS_FAMILY_IPV4) {
+			cell_link_set_v4(&sd.link, 0, 0, 0, 0);
+		} else {
+			cell_link_set_v6(&sd.link, NULL, 0, NULL, NULL, 0);
+		}
+		const int any = sd.link.v4_up || sd.link.v6_up;
+		lck_mtx_unlock(sd.lock);
+		printf("SWEET DATA: IPv%u call down\n", arg);
+		if (!any) {
+			sd_link(0);
+		}
+		break;
+	}
+}
+
+/* ---- QRTR receive (worker thread) ---- */
+static void
+sd_keep_indication(unsigned client, uint8_t service, const uint8_t *data, uint32_t length)
+{
+	lck_mtx_lock(sd.lock);
+	const uint32_t slot = sd.ind_seq % IND_RING;
+	sd.ind[slot].seq = ++sd.ind_seq;
+	sd.ind[slot].service = service;
+	sd.ind[slot].client = (uint8_t)client;
+	sd.ind[slot].len = length < IND_MAX ? length : IND_MAX;
+	memcpy(sd.ind[slot].data, data, sd.ind[slot].len);
+	lck_mtx_unlock(sd.lock);
+}
+
+static void
+sd_receive(void *ctx, QcomQrtr *q, uint32_t port, uint32_t node, uint32_t from_port, const uint8_t *data, uint32_t length)
+{
+	(void)ctx; (void)q;
+	const unsigned client = port == PORT_CLIENT1;
+	int service = -1;
+	for (unsigned i = 0; i < sizeof sd_services; ++i) {
+		if (sd.svc[i].present && sd.svc[i].node == node && sd.svc[i].port == from_port) {
+			service = sd_services[i];
+		}
+	}
+	if (service < 0 || length < QCOM_QMI_HEADER) {
+		return;
+	}
+	const uint16_t txn = (uint16_t)(data[1] | data[2] << 8);
+	if (data[0] == QCOM_QMI_RESPONSE && txn >= CELL_TXN_RAW) {
+		lck_mtx_lock(sd.lock);
+		if (sd.raw.state == 2 && sd.raw.txn == txn && sd.raw.service == service && sd.raw.client == client &&
+		    (uint16_t)(data[3] | data[4] << 8) == sd.raw.message && length <= sizeof sd.raw.reply) {
+			memcpy(sd.raw.reply, data, length);
+			sd.raw.reply_len = length;
+			sd.raw.state = 3;
+			wakeup(&sd.raw);
+		} else if (sd.raw.state == 4 && sd.raw.txn == txn) {
+			sd.raw.state = 0;
+		}
+		lck_mtx_unlock(sd.lock);
+		return;
+	}
+	if (data[0] == QCOM_QMI_INDICATION && sd.raw_on) {
+		sd_keep_indication(client, (uint8_t)service, data, length);
+	}
+	if (sd.session_on) {
+		cell_session_receive(&sd.session, client, (uint8_t)service, data, length);
+	}
+}
+
+/* ---- the modem runtime's hooks ---- */
+int
+sweet_data_attach(QcomQrtr *qr)
+{
+	sd.session_on = sd_gate("sweetdata");
+	sd.raw_on = sd_gate("sweetqmiraw");
+	if (!sd.session_on && !sd.raw_on) {
+		return 0;
+	}
+	sd_lock_init();
+	sd.qr = qr;
+	/* ponytail: announced as service 0 like the UIM client, until QcomQrtr has a client port that is not announced */
+	if (qcom_qrtr_add_service(qr, 0, 0, PORT_CLIENT0, sd_receive, NULL) ||
+	    (sd.session_on && qcom_qrtr_add_service(qr, 0, 0, PORT_CLIENT1, sd_receive, NULL))) {
+		printf("SWEET DATA: refused: no free QRTR port (QCOM_QRTR_MAX_LOCAL)\n");
+		sd.session_on = sd.raw_on = 0;
+		return EIO;
+	}
+	sd.raw.next_txn = CELL_TXN_RAW;
+	cell_link_init(&sd.link, sd_mac, sd_router_mac);
+	if (sd.session_on) {
+		uint64_t ns;
+		absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+		if (!PE_parse_boot_arg_str("sweetapn", sd.apn, sizeof sd.apn)) {
+			sd.apn[0] = 0;
+		}
+		const CellConfig cfg = {
+			.allow_online = (uint8_t)sd_gate("sweetdataonline"), .want_v4 = 1, .want_v6 = 1, .apn = sd.apn[0] ? sd.apn : NULL,
+			.mux = 1, .ep_interface = 1, .ipa_rx = 2, .ipa_tx = 18, .qmap = sd.qmap ? sd.qmap : QMAP_V1,
+			.dl_max_datagrams = 32, .dl_max_size = 16384,
+		};
+		const CellSessionOps ops = {sd_send, sd_event, NULL};
+		cell_session_init(&sd.session, &cfg, &ops, ns / NSEC_PER_MSEC);
+		if (!sd.ifp) {
+			sd_ifnet_create();
+		}
+	}
+	sd.attached = 1;
+	printf("SWEET DATA: attached (session %d, online allowed %d, raw %d, APN %s)\n", sd.session_on,
+	    sd.session_on && sd.session.cfg.allow_online, sd.raw_on, sd.apn[0] ? "given" : "default profile");
+	return 0;
+}
+
+void
+sweet_data_poll(QcomQrtr *qr, uint64_t now_ms)
+{
+	if (!sd.attached || qr != sd.qr) {
+		return;
+	}
+	/* services appearing and going away */
+	for (unsigned i = 0; i < sizeof sd_services; ++i) {
+		const int r = qcom_qrtr_find_remote(qr, sd_services[i]);
+		const int present = r >= 0;
+		if (present && (!sd.svc[i].present || sd.svc[i].node != qr->remote[r].node || sd.svc[i].port != qr->remote[r].port)) {
+			sd.svc[i].node = qr->remote[r].node;
+			sd.svc[i].port = qr->remote[r].port;
+			sd.svc[i].present = 1;
+			if (sd.session_on) {
+				cell_session_service(&sd.session, sd_services[i], 1);
+			}
+		} else if (!present && sd.svc[i].present) {
+			sd.svc[i].present = 0;
+			if (sd.session_on) {
+				cell_session_service(&sd.session, sd_services[i], 0);
+			}
+		}
+	}
+	/* the queued raw request */
+	lck_mtx_lock(sd.lock);
+	if (sd.raw.state == 1) {
+		uint8_t msg[QMI_RAW_MAX];
+		const uint32_t len = sd.raw.len;
+		const uint8_t service = sd.raw.service, client = sd.raw.client;
+		memcpy(msg, sd.raw.msg, len);
+		sd.raw.state = 2;
+		lck_mtx_unlock(sd.lock);
+		if (sd_send(NULL, client, service, msg, len)) {
+			lck_mtx_lock(sd.lock);
+			if (sd.raw.state == 2) {
+				sd.raw.state = 3;
+				sd.raw.reply_len = 0;   /* not sent: the waiter reports ENOENT */
+				wakeup(&sd.raw);
+			}
+			lck_mtx_unlock(sd.lock);
+		}
+	} else {
+		lck_mtx_unlock(sd.lock);
+	}
+	if (sd.session_on) {
+		cell_session_poll(&sd.session, now_ms);
+	}
+}
+
+void
+sweet_data_stop(void)
+{
+	if (sd.session_on) {
+		cell_session_stop(&sd.session);
+	}
+}
+
+int
+sweet_data_idle(void)
+{
+	return !sd.session_on || cell_session_stopped(&sd.session) || sd.session.state == CS_FAILED;
+}
+
+/* ---- the IPA agent's hooks ---- */
+void
+sweet_data_set_ipa(int (*tx)(void *, const uint8_t *, uint32_t), void *ctx, int qmap_version)
+{
+	sd_lock_init();
+	lck_mtx_lock(sd.lock);
+	sd.ipa_tx = tx;
+	sd.ipa_ctx = ctx;
+	sd.qmap = qmap_version == 5 ? QMAP_V5 : QMAP_V1;
+	lck_mtx_unlock(sd.lock);
+}
+
+static void
+sd_deliver(void *ctx, uint8_t mux, int command, const uint8_t *data, uint32_t length)
+{
+	(void)ctx;
+	if (command) {
+		uint8_t ack[64];
+		const uint32_t n = length <= sizeof ack - QMAP_HEADER ? qmap_command_ack(mux, data, length, ack, sizeof ack) : 0;
+		if (n && sd.ipa_tx) {
+			(void)sd.ipa_tx(sd.ipa_ctx, ack, n);
+		}
+		return;
+	}
+	uint8_t header[CELL_ETHER];
+	lck_mtx_lock(sd.lock);
+	const uint32_t made = cell_link_input_header(&sd.link, data, length, header);
+	lck_mtx_unlock(sd.lock);
+	if (made) {
+		sd_input(header, data, length);
+	}
+}
+
+void
+sweet_data_ipa_rx(const uint8_t *buf, uint32_t length)
+{
+	if (sd.lock == NULL || !sd.session_on) {
+		return;
+	}
+	/* one IPA receive thread: the counters are its own */
+	(void)qmap_deaggregate(sd.qmap, buf, length, 1u << sd.session.cfg.mux, sd_deliver, NULL, &sd.qmap_count);
+}
+
+/* ---- kern.sweet_qmi, root only ---- */
+static int
+sd_sysctl_qmi SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	static uint8_t in[QMI_RAW_REQUEST_HEADER + QMI_RAW_MAX];
+	uint8_t out[QMI_RAW_REPLY_HEADER + QMI_RAW_MAX];
+	QmiRawRequest r;
+	int status;
+
+	if (!sd.raw_on || !sd.attached) {
+		return ENOENT;
+	}
+	if (!kauth_cred_issuser(kauth_cred_get())) {
+		return EPERM;
+	}
+	if (req->newptr == USER_ADDR_NULL || req->oldptr == USER_ADDR_NULL || req->newlen > sizeof in) {
+		return EINVAL;
+	}
+	lck_mtx_lock(sd.lock);
+	if (sd.raw.state != 0) {
+		lck_mtx_unlock(sd.lock);
+		return EBUSY;
+	}
+	sd.raw.state = 5;           /* ours while the request is copied in */
+	lck_mtx_unlock(sd.lock);
+	const uint32_t inlen = (uint32_t)req->newlen;
+	int error = SYSCTL_IN(req, in, inlen);
+	if (!error) {
+		error = qmi_raw_parse(in, inlen, &r);
+	}
+	lck_mtx_lock(sd.lock);
+	if (error) {
+		sd.raw.state = 0;
+		lck_mtx_unlock(sd.lock);
+		printf("SWEET DATA: raw request refused (%d)\n", error);
+		return error;
+	}
+	memcpy(sd.raw.msg, r.msg, r.length);
+	sd.raw.len = r.length;
+	sd.raw.service = r.service;
+	sd.raw.client = r.client;
+	sd.raw.txn = sd.raw.next_txn;
+	sd.raw.next_txn = (uint16_t)(sd.raw.next_txn == 0xffff ? CELL_TXN_RAW : sd.raw.next_txn + 1);
+	sd.raw.message = (uint16_t)(r.msg[3] | r.msg[4] << 8);
+	sd.raw.msg[0] = QCOM_QMI_REQUEST;
+	sd.raw.msg[1] = (uint8_t)sd.raw.txn;
+	sd.raw.msg[2] = (uint8_t)(sd.raw.txn >> 8);
+	sd.raw.state = 1;
+	printf("SWEET DATA: raw request service %#x client %u message %#x\n", r.service, r.client, sd.raw.message);
+	struct timespec ts = {.tv_sec = r.timeout_ms / 1000, .tv_nsec = (long)(r.timeout_ms % 1000) * NSEC_PER_MSEC};
+	while (sd.raw.state == 1 || sd.raw.state == 2) {
+		if (msleep(&sd.raw, sd.lock, PZERO, "sweetqmi", &ts) == EWOULDBLOCK) {
+			break;
+		}
+	}
+	uint32_t n = 0;
+	if (sd.raw.state == 3 && sd.raw.reply_len) {
+		status = 0;
+		n = sd.raw.reply_len;
+		memcpy(out + QMI_RAW_REPLY_HEADER, sd.raw.reply, n);
+		sd.raw.state = 0;
+	} else if (sd.raw.state == 3) {
+		status = ENOENT;        /* the service is not there */
+		sd.raw.state = 0;
+	} else {
+		status = ETIMEDOUT;
+		sd.raw.state = sd.raw.state == 1 ? 0 : 4;   /* a late answer frees the slot */
+	}
+	lck_mtx_unlock(sd.lock);
+	for (unsigned i = 0; i < 4; ++i) {
+		out[i] = (uint8_t)((uint32_t)status >> 8 * i);
+		out[4 + i] = (uint8_t)(n >> 8 * i);
+	}
+	return SYSCTL_OUT(req, out, QMI_RAW_REPLY_HEADER + n);
+}
+
+/* The indication ring: for each kept indication seq (u32), service, client, length (u16), then the message. Root only. */
+static int
+sd_sysctl_ind SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	static uint8_t out[IND_RING * (8 + IND_MAX)];
+	uint32_t at = 0;
+
+	if (!sd.raw_on || !sd.attached) {
+		return ENOENT;
+	}
+	if (!kauth_cred_issuser(kauth_cred_get())) {
+		return EPERM;
+	}
+	lck_mtx_lock(sd.lock);
+	for (unsigned k = 0; k < IND_RING; ++k) {
+		const unsigned i = (sd.ind_seq + k) % IND_RING;
+		if (!sd.ind[i].seq) {
+			continue;
+		}
+		memcpy(out + at, &sd.ind[i].seq, 4);
+		out[at + 4] = sd.ind[i].service;
+		out[at + 5] = sd.ind[i].client;
+		out[at + 6] = (uint8_t)sd.ind[i].len;
+		out[at + 7] = (uint8_t)(sd.ind[i].len >> 8);
+		memcpy(out + at + 8, sd.ind[i].data, sd.ind[i].len);
+		at += 8 + sd.ind[i].len;
+	}
+	lck_mtx_unlock(sd.lock);
+	return SYSCTL_OUT(req, out, at);
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_qmi, CTLTYPE_OPAQUE | CTLFLAG_RW | CTLFLAG_LOCKED | CTLFLAG_MASKED, 0, 0, sd_sysctl_qmi, "S", "");
+SYSCTL_PROC(_kern, OID_AUTO, sweet_qmi_ind, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED | CTLFLAG_MASKED, 0, 0, sd_sysctl_ind, "S",
+    "");
+#endif /* ARM64_BOARD_CONFIG_SWEET */
--- /dev/null
+++ b/bsd/dev/data/sweet_data.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* The data agent's hooks for the modem runtime and the IPA driver (bsd/dev/data/sweet_data.c). */
+#ifndef SWEET_DATA_H
+#define SWEET_DATA_H
+#include <stdint.h>
+#include "../modem/QcomQrtr.h"
+
+/* Modem runtime, from its worker thread only. attach: after qcom_qrtr_init, before qcom_qrtr_start; 0 also when every data gate is
+ * off. poll: every worker iteration. stop: before the modem stops; keep polling until idle() or 5 s. */
+int sweet_data_attach(QcomQrtr *qr);
+void sweet_data_poll(QcomQrtr *qr, uint64_t now_ms);
+void sweet_data_stop(void);
+int sweet_data_idle(void);
+
+/* IPA driver. set_ipa: the transmit of one framed QMAP buffer on the AP->modem endpoint (0 when queued) and the QMAP version the
+ * endpoints use (1 or 5); call before the modem starts. ipa_rx: one completed receive buffer from the modem->AP endpoint, not from
+ * interrupt context. */
+void sweet_data_set_ipa(int (*tx)(void *ctx, const uint8_t *buf, uint32_t length), void *ctx, int qmap_version);
+void sweet_data_ipa_rx(const uint8_t *buf, uint32_t length);
+#endif
