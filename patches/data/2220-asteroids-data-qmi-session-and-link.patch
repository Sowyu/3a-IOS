+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* The data agent's hooks for the modem runtime and the IPA driver (bsd/dev/data/sweet_data.c). Without sweetdata=1 or sweetqmiraw=1
+ * attach registers nothing and every other hook returns at once; usim and ipa_ready only record a flag. One attach per boot. */
+#ifndef SWEET_DATA_H
+#define SWEET_DATA_H
+#include <stdint.h>
+#include "../modem/QcomQrtr.h"
+
+/* Modem runtime, from its worker thread only.
+ *   attach   after qcom_qrtr_init, before qcom_qrtr_start. Returns 0, also when every data gate is off.
+ *   poll     every worker iteration.
+ *   discovery after every QRTR control packet, before the next packet is dispatched (see below).
+ *   usim     1 once UIM card status shows the USIM application ready, 0 when that is lost.
+ *   stop     before the modem stops; then keep receiving and polling until idle() or 5 s have passed.
+ *   detach   after idle() (or the 5 s), before the QRTR object goes away. Nothing in this file touches it afterwards. */
+int sweet_data_attach(QcomQrtr *qr);
+void sweet_data_poll(QcomQrtr *qr, uint64_t now_ms);
+/* After every QRTR control packet (NEW_SERVER, DEL_SERVER, BYE), before the worker dispatches the next packet: brings the data
+ * side's service cache in line, so a removal is seen before any later reply from that service, even when the same endpoint is
+ * announced again in the same batch. Does nothing unless attached to this qr. */
+void sweet_data_discovery(QcomQrtr *qr);
+void sweet_data_usim(int ready);
+void sweet_data_stop(void);
+int sweet_data_idle(void);
+/* Worker thread, after stop: 0 when no WDS call or start is left unresolved (each was stopped, or reported disconnected, or data
+ * never ran), EINPROGRESS while
+ * cleanup runs, EIO when the 5 s deadline left a live handle or an unanswered start. Propagate EIO into the runtime's final error and
+ * still shut the modem down. The result stays valid after detach. */
+int sweet_data_cleanup(void);
+void sweet_data_detach(void);
+
+/* IPA driver, any thread except interrupt context.
+ *   set_ipa  once, before the modem starts: tx sends one framed QMAP buffer on the AP->modem endpoint and must copy it before it
+ *            returns (the buffer is on the caller's stack); it is never called with a data-agent lock held and must not call back into
+ *            this file. qmap_version is 1 or 5 as the endpoints are programmed; rx_buffer_bytes and max_datagrams bound one downlink
+ *            aggregate. The callback and its context must stay valid until the system goes down. Returns 0, or -1 when refused.
+ *   ipa_ready 1 once the IPA QMI handshake completed (modem completion 0x35) and both endpoints run, 0 when that is lost.
+ *   ipa_rx   one completed receive buffer from the modem->AP endpoint, length = the bytes the hardware wrote. One thread only. */
+int sweet_data_set_ipa(int (*tx)(void *ctx, const uint8_t *buf, uint32_t length), void *ctx, int qmap_version,
+                       uint32_t rx_buffer_bytes, uint32_t max_datagrams);
+void sweet_data_ipa_ready(int ready);
+void sweet_data_ipa_rx(const uint8_t *buf, uint32_t length);
+#endif
