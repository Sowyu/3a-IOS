+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* The data session over QMI, as a polled state machine with no transport of its own:
+ *   services present -> read-only DMS/NAS/WDS queries for the log -> wait for the owner's readiness barrier (USIM ready, IPA
+ *   handshake complete, real QMAP format and receive limits) -> DPM Open Port (the IPA endpoints) -> WDA Set Data Format (raw IP in
+ *   QMAP), verified -> DMS online (only when allowed) -> NAS registered and PS attached -> per IP family: WDS Bind Mux, Set IP Family,
+ *   Start Network (retried while the packet domain attaches) -> Get Current Settings for that family -> up.
+ * A Packet Service Status "disconnected" takes the family down and starts it again. cell_session_stop() and every failure end in
+ * STOPPING, which sends Stop Network for every live handle, catches starts still in flight, and allows nothing else; it ends in STOPPED
+ * or FAILED within 5 s. Requests carry transactions below 0x8000; the raw tool uses the rest.
+ * Client 0 talks to DMS, NAS, WDA, DPM and the IPv4 WDS call; client 1 is a second WDS client for the IPv6 call (one WDS client holds
+ * one call). The owner maps each client to one QRTR port. */
+#ifndef CELL_SESSION_H
+#define CELL_SESSION_H
+#include <stdint.h>
+#include "QmiData.h"
+#include "Qmap.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define CELL_TXN_RAW 0x8000u
+
+typedef enum {
+    CS_WAIT_READY, CS_DPM, CS_WDA, CS_WDA_VERIFY, CS_ONLINE, CS_WAIT_ONLINE_ALLOWED, CS_REGISTER, CS_CALLS, CS_STOPPING, CS_STOPPED,
+    CS_FAILED,
+} CellState;
+
+typedef enum {
+    CE_STATE,        /* arg: CellState */
+    CE_INFO,         /* text: revision, IMEI last 4, mode, profiles */
+    CE_SERVING,      /* data: NasServing */
+    CE_SIGNAL,       /* data: NasSignal */
+    CE_OPERATOR,     /* data: NasOperator */
+    CE_UP,           /* arg: family, data: WdsSettings */
+    CE_DOWN,         /* arg: family, data: WdsPacketStatus or null */
+    CE_ERROR,        /* arg: message id, text: what failed */
+} CellEvent;
+
+typedef struct {
+    /* Sends one QMI message from client (0 or 1) to service. Returns 0 when queued. */
+    int (*send)(void *context, unsigned client, uint8_t service, const uint8_t *msg, uint32_t length);
+    void (*event)(void *context, CellEvent event, uint32_t arg, const void *data, const char *text);
+    void *context;
+} CellSessionOps;
+
+typedef struct {
+    uint8_t allow_online;        /* sweetdataonline=1: may send DMS online */
+    uint8_t want_v4, want_v6;
+    const char *apn;             /* null: the modem's default profile */
+    uint8_t profile;             /* 3GPP profile index for Start Network, 0 for none */
+    uint8_t mux;                 /* QMAP mux id both calls are bound to */
+    uint32_t ep_interface;       /* embedded endpoint interface number (1, as ModemManager) */
+    uint32_t ipa_rx, ipa_tx;     /* IPA endpoint the modem receives on (our TX) and sends on (our RX) */
+} CellConfig;
+
+/* What the readiness barrier supplies: the format the IPA endpoints use and what one receive buffer holds. */
+typedef struct {
+    QmapVersion qmap;
+    uint32_t dl_max_datagrams, dl_max_size;
+} CellReady;
+
+#define CELL_PENDING 12u
+typedef struct {
+    uint8_t busy, client, service;
+    uint16_t txn, message;
+    uint64_t sent;
+} CellPending;
+
+typedef struct {
+    uint8_t family, client, bound, family_set, up, exhausted, drop;
+    uint8_t step_tries, settings_tries;
+    uint8_t start_unknown;       /* a start whose answer has not come, even past its reply deadline: it may still bring a handle */
+    uint16_t start_txn;
+    uint32_t handle, start_tries;
+    uint64_t next_start, next_try, start_sent, drop_since;
+    WdsSettings settings;
+} CellCall;
+
+typedef struct {
+    CellSessionOps ops;
+    CellConfig cfg;
+    CellReady ready;
+    CellState state;
+    uint8_t services;            /* bit per service present: 0 DMS, 1 NAS, 2 WDS, 3 WDA, 4 DPM */
+    uint8_t is_ready, info_sent, indications_sent, mode_known, mode, registered, online_sent, tries, failing, unresolved;
+    uint16_t next_txn;
+    uint64_t now, next_poll, state_since, backoff_until;
+    CellPending pending[CELL_PENDING];
+    CellCall call[2];            /* [0] IPv4 on client 0, [1] IPv6 on client 1 */
+    NasServing serving;
+} CellSession;
+
+void cell_session_init(CellSession *s, const CellConfig *cfg, const CellSessionOps *ops, uint64_t now_ms);
+/* A service appeared (present 1) or went away over QRTR. A service going away fails the session through cleanup. */
+void cell_session_service(CellSession *s, uint8_t service, int present);
+/* The readiness barrier: non-null when the USIM is ready and the IPA handshake completed; null when either is lost, which fails the
+ * session through cleanup. Nothing that changes modem state is sent before it. */
+void cell_session_ready(CellSession *s, const CellReady *ready);
+/* One QMI message that arrived for client. */
+void cell_session_receive(CellSession *s, unsigned client, uint8_t service, const uint8_t *msg, uint32_t length);
+/* Timers: retries, polling, start backoff. Call every 100 ms or so. */
+void cell_session_poll(CellSession *s, uint64_t now_ms);
+/* Stop Network for every live call and every start in flight. Done when cell_session_idle(). */
+void cell_session_stop(CellSession *s);
+/* True when nothing is live and the session will send nothing more: STOPPED, FAILED, or not past the readiness barrier. */
+int cell_session_idle(const CellSession *s);
+/* How cleanup ended, separately from why the session ended. PENDING while not idle; CLEAN when no tracked handle or unresolved start
+ * remains and the stop deadline never passed with one (a handle is retired by a successful Stop Network reply or by a valid
+ * "disconnected" packet service indication); UNRESOLVED when the 5 s deadline passed with a live handle or a start whose answer never
+ * came (its call may still be up in the modem). */
+typedef enum {CELL_CLEANUP_PENDING, CELL_CLEANUP_CLEAN, CELL_CLEANUP_UNRESOLVED} CellCleanup;
+CellCleanup cell_session_cleanup(const CellSession *s);
+const char *cell_state_name(CellState state);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
