+uint32_t dpm_open_port(uint8_t *buf, uint32_t cap, uint16_t txn, uint32_t endpoint_type, uint32_t interface, uint32_t rx_endpoint,
+                       uint32_t tx_endpoint);
+uint32_t dpm_close_port(uint8_t *buf, uint32_t cap, uint16_t txn);
+
