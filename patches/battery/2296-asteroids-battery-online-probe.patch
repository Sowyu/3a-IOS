+uint32_t battery_probe_request(uint8_t p[24]){
+ if(!p)return 0;
+ put32(p,32778);put32(p+4,1);put32(p+8,0x32);put32(p+12,0);put32(p+16,0);put32(p+20,0);
+ return battery_read_allowed(p,24)?24:0;
+}
+int battery_probe_receive(const uint8_t *p,uint32_t n,int32_t *online){
+ if(!p || n!=24 || get32(p)!=32778 || get32(p+4)!=1 || get32(p+8)!=0x32 || get32(p+12)!=0)return 0;
+ if(get32(p+20))return -1;
+ int32_t v=(int32_t)get32(p+16);if(v!=0 && v!=1)return -1;
+ if(online)*online=v;
+ return 1;
+}
