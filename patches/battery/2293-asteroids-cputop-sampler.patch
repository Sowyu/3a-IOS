+/* 2293 sweetcputop=N, 10..600 s: osfmk/kern/processor.c logs per-CPU busy and the top threads every N s. */
+extern void sweet_cputop_log(void);
+static unsigned cputop_s;
+static void cputop_thread(void *unused, wait_result_t result)
+{
+    (void)unused; (void)result;
+    for(;;){
+        sweet_cputop_log();
+        uint64_t deadline;
+        clock_interval_to_deadline(cputop_s, NSEC_PER_SEC, &deadline);
+        assert_wait_deadline(&cputop_s, THREAD_UNINT, deadline);
+        thread_block(THREAD_CONTINUE_NULL);
+    }
+}
 void sweet_battery_start(void)
 {
+    unsigned s=0;
+    if(PE_parse_boot_argn("sweetcputop",&s,sizeof(s)) && s>=10 && s<=600){
+        cputop_s=s;thread_t t=THREAD_NULL;
+        if(kernel_thread_start(cputop_thread,NULL,&t)==KERN_SUCCESS){thread_deallocate(t);printf("SWEET CPUTOP: every %u s\n",s);}
+    }
     if(!modem_gate(PE_boot_args(),"sweetbprobe"))return;
     thread_t thread=THREAD_NULL;
     kern_return_t rc=kernel_thread_start(battery_probe,NULL,&thread);
