+/*
+ * 2297: the ADSP worker calls sweet_battery_kick() when the percent, the cable or the charge state changed, so iOS
+ * hears it at once instead of on the next 5 s tick. The kick sets a flag and arms the timer for 1 ms; timerFired
+ * clears the flag before it polls and re-arms 1 ms if a kick landed during its poll, so none is lost.
+ */
+static IOTimerEventSource *volatile sweet_battery_kick_timer;
+static volatile int sweet_battery_kick_pending;
+extern "C" void sweet_battery_kick(void);
+extern "C" void
+sweet_battery_kick(void)
+{
+	IOTimerEventSource *t = __atomic_load_n(&sweet_battery_kick_timer, __ATOMIC_ACQUIRE);
+	if (t != NULL) {
+		__atomic_store_n(&sweet_battery_kick_pending, 1, __ATOMIC_RELEASE);
+		t->setTimeoutMS(1);
+	}
+}
