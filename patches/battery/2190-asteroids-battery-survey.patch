+#ifndef MODEM_GATE_H
+#define MODEM_GATE_H
+#include <stddef.h>
+/* Exact, single name=1 token. Bare, duplicate, malformed and numeric aliases fail closed. */
+static inline int modem_gate(const char *args,const char *name){
+    size_t n=0;while(name[n])n++;unsigned found=0;int enabled=0;
+    while(args && *args){
+        while(*args==' ' || *args=='\t')args++;
+        const char *end=args;while(*end && *end!=' ' && *end!='\t')end++;
+        size_t len=(size_t)(end-args),i=0;while(i<n && i<len && args[i]==name[i])i++;
+        if(i==n && (len==n || args[n]=='=')){found++;enabled=len==n+2 && args[n]=='=' && args[n+1]=='1';}
+        args=end;
+    }return found==1 && enabled;
+}
+#endif
