--- /dev/null
+++ b/bsd/dev/sweet_battery.c
@@ -0,0 +1,88 @@
+/* 2190: read-only ADSP resource survey. No PAS calls or outgoing messages.
+ * Protocol helpers copied from xnu-modem after 2178, originally UniXNU.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(BATTERY_HOST_TEST)
+#ifdef BATTERY_HOST_TEST
+#include "battery_host.h"
+#else
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+#include <machine/machine_routines.h>
+#endif
+#include "battery/QcomSmem.h"
+#include "battery/QcomSmp2p.h"
+#include "battery/QcomRpmh.h"
+#include "battery/ModemGate.h"
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void ml_io_unmap(vm_offset_t, vm_size_t);
+extern void sweet_log_sync(void);
+extern kern_return_t thread_terminate(thread_t);
+void sweet_battery_start(void);
+static uint8_t battery_db[0x20000];
+static void battery_probe(void *unused, wait_result_t result)
+{
+    (void)unused; (void)result;
+    uint64_t deadline;
+    clock_interval_to_deadline(30000, NSEC_PER_MSEC, &deadline);
+    assert_wait_deadline(battery_db, THREAD_UNINT, deadline);
+    thread_block(THREAD_CONTINUE_NULL);
+    printf("SWEET BATTERY: B1 read-only survey begin PAS1/PAS36 untouched\n");
+    sweet_log_sync();
+    vm_offset_t sm=ml_io_map(0x81d00000,0x200000);
+    vm_offset_t db=ml_io_map(0x81c60000,0x20000);
+    if (!sm || !db) {
+        printf("SWEET BATTERY: B1 mapping failed\n");
+        goto out;
+    }
+    QcomSmem mem={(volatile uint8_t *)sm,0x200000};
+    QcomSmemPartition part={0};
+    int rc=qcom_smem_partition(&mem,0,2,&part);
+    printf("SWEET BATTERY: B1 ADSP partition rc=%d offset=%#x bytes=%#x\n",rc,part.offset,part.size);
+    if (!rc) {
+        static const uint16_t ids[]={443,429,478,479,480};
+        for (unsigned i=0;i<sizeof(ids)/sizeof(ids[0]);i++) {
+            uint32_t offset=0,bytes=0;
+            int found=qcom_smem_find(&mem,&part,ids[i],&offset,&bytes);
+            printf("SWEET BATTERY: B1 item=%u rc=%d offset=%#x bytes=%u\n",ids[i],found,offset,bytes);
+            if (ids[i]==443 && !found && !(offset&3) && bytes>=QCOM_SMP2P_ITEM_BYTES) {
+                /* Snapshot the complete bounded item before parsing remote state. */
+                uint32_t snapshot[QCOM_SMP2P_ITEM_BYTES/4];
+                for(unsigned j=0;j<sizeof(snapshot)/4;j++)snapshot[j]=qcom_smem_read32(&mem,offset+4*j);
+                QcomSmp2p state={0};state.in=snapshot;state.local_pid=0;state.remote_pid=2;
+                int valid=qcom_smp2p_check_in(snapshot,0,2);
+                int index=valid ? -1 : qcom_smp2p_find_in(&state,"slave-kernel");
+                printf("SWEET BATTERY: B1 SMP2P valid=%d index=%d state=%#x\n",valid,index,qcom_smp2p_in_value(&state,index));
+            }
+        }
+    }
+    for(unsigned i=0;i<sizeof(battery_db);i+=4){
+        uint32_t value=*(volatile uint32_t *)(db+i);
+        memcpy(battery_db+i,&value,4);
+    }
+    static const char *const rails[]={"lcx.lvl","lmx.lvl","xo.lvl"};
+    for(unsigned i=0;i<3;i++) {
+        QcomRpmhResource resource={0};
+        int found=qcom_cmd_db_find(battery_db,sizeof(battery_db),rails[i],&resource);
+        printf("SWEET BATTERY: B1 resource=%s rc=%d address=%#x levels=%u aux=%u\n",rails[i],found,resource.address,resource.level_count,resource.aux_bytes);
+        if(!found)for(unsigned j=0;j<resource.level_count;j++)printf("SWEET BATTERY: B1 level %s %u=%u\n",rails[i],j,resource.levels[j]);
+    }
+    printf("SWEET BATTERY: B1 survey complete channel=PMIC_RTR_ADSP_APPS domain=msm/adsp/charger_pd no hardware writes\n");
+out:
+    if(db)ml_io_unmap(db,0x20000);
+    if(sm)ml_io_unmap(sm,0x200000);
+    sweet_log_sync();
+    thread_terminate(current_thread());
+}
+void sweet_battery_start(void)
+{
+    if(!modem_gate(PE_boot_args(),"sweetbprobe"))return;
+    thread_t thread=THREAD_NULL;
+    kern_return_t rc=kernel_thread_start(battery_probe,NULL,&thread);
+    if(rc==KERN_SUCCESS)thread_deallocate(thread);
+    else printf("SWEET BATTERY: B1 thread failed %d\n",rc);
+}
+#endif
