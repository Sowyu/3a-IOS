+/* B4 draft, a complete read cycle is published atomically to IOKit's timer. */
+#include <kern/locks.h>
+#include "BatterySnapshot.h"
+#include "BatteryRead.h"
+static LCK_GRP_DECLARE(battery_snapshot_group,"battery-snapshot");
+static LCK_MTX_DECLARE(battery_snapshot_mutex,&battery_snapshot_group);
+static BatterySnapshot battery_snapshot;
+static bool battery_snapshot_valid;
+static void battery_snapshot_clear(void){
+ lck_mtx_lock(&battery_snapshot_mutex);battery_snapshot_valid=false;lck_mtx_unlock(&battery_snapshot_mutex);
+}
+static void battery_snapshot_publish(const BatteryRead *b,uint64_t now){
+ if(!battery_read_valid(b)){battery_snapshot_clear();return;}
+ BatterySnapshot s={
+  .percent=(b->value[2]+50)/100,.millivolts=b->value[3]/1000,
+  .milliamps=-(b->value[4]/1000),.temperature=b->value[5],
+  .external=b->value[6]!=0,.charging=b->value[6]!=0 && b->value[0]==1,
+  .full=b->value[0]==4,.sampled_ms=now
+ };
+ lck_mtx_lock(&battery_snapshot_mutex);battery_snapshot=s;battery_snapshot_valid=true;lck_mtx_unlock(&battery_snapshot_mutex);
+}
+int sweet_adsp_battery_snapshot(BatterySnapshot *out){
+ if(!out)return 0;
+ uint64_t ns;absolutetime_to_nanoseconds(mach_absolute_time(),&ns);uint64_t now=ns/NSEC_PER_MSEC;
+ lck_mtx_lock(&battery_snapshot_mutex);
+ bool valid=battery_snapshot_valid && now>=battery_snapshot.sampled_ms && now-battery_snapshot.sampled_ms<=45000;
+ if(valid)*out=battery_snapshot;
+ lck_mtx_unlock(&battery_snapshot_mutex);return valid;
+}
