+#include "BatteryRead.h"
+/* Nothing qti_battery_charger: status, present, capacity in 0.01%, voltage uV,
+ * signed current uA, temperature in 0.01 C, USB online. See rootstock T38.
+ * No notification registration or SET packet can be constructed here.
+ */
+static const uint8_t properties[BatteryFields]={0,2,4,7,9,12,0};
+static uint32_t get32(const uint8_t *p){return (uint32_t)p[0]|(uint32_t)p[1]<<8|(uint32_t)p[2]<<16|(uint32_t)p[3]<<24;}
+static void put32(uint8_t *p,uint32_t v){for(unsigned i=0;i<4;i++)p[i]=(uint8_t)(v>>(8*i));}
+static unsigned opcode(unsigned field){return field==6?0x32:0x30;}
+int battery_read_allowed(const uint8_t *p,uint32_t n){
+ if(!p || n!=24 || get32(p)!=32778 || get32(p+4)!=1 || get32(p+12)!=0 || get32(p+20)!=0)return 0;
+ for(unsigned i=0;i<BatteryFields;i++)if(get32(p+8)==opcode(i) && get32(p+16)==properties[i])return 1;
+ return 0;
+}
+uint32_t battery_read_request(const BatteryRead *b,uint8_t p[24]){
+ if(!b || !p || b->failed || b->waiting || b->cursor>=BatteryFields)return 0;
+ put32(p,32778);put32(p+4,1);put32(p+8,opcode(b->cursor));put32(p+12,0);put32(p+16,properties[b->cursor]);put32(p+20,0);
+ return battery_read_allowed(p,24)?24:0;
+}
+int battery_read_sent(BatteryRead *b){
+ if(!b || b->failed || b->waiting || b->cursor>=BatteryFields)return -1;
+ b->waiting=1;return 0;
+}
+int battery_read_receive(BatteryRead *b,const uint8_t *p,uint32_t n){
+ if(!b || !p || b->failed || !b->waiting || b->cursor>=BatteryFields || n!=24)return 0;
+ if(get32(p)!=32778 || get32(p+4)!=1 || get32(p+8)!=opcode(b->cursor) || get32(p+12)!=properties[b->cursor])return 0;
+ if(get32(p+20)){b->failed=1;return -1;}
+ b->value[b->cursor++]=(int32_t)get32(p+16);b->waiting=0;return 1;
+}
+void battery_read_timeout(BatteryRead *b){if(b && b->waiting)b->failed=1;}
+int battery_read_valid(const BatteryRead *b){
+ if(!b || b->failed || b->waiting || b->cursor!=BatteryFields)return 0;
+ return b->value[0]>=1 && b->value[0]<=4 && b->value[1]==1 &&
+ b->value[2]>=0 && b->value[2]<=10000 && b->value[3]>=2500000 && b->value[3]<=5000000 &&
+ b->value[4]>=-20000000 && b->value[4]<=20000000 && b->value[5]>=-4000 && b->value[5]<=10000 &&
+ (b->value[6]==0 || b->value[6]==1);
+}
