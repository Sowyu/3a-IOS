+#ifndef BATTERY_READ_H
+#define BATTERY_READ_H
+#include <stdint.h>
+/* Fixed, read-only qti_battery_charger client. One request at a time.
+ * After timeout, close the transport before using a fresh client: this wire
+ * protocol has no transaction ID to distinguish a delayed old response.
+ */
+enum {BatteryFields=7};
+typedef struct {
+    int32_t value[BatteryFields];
+    unsigned cursor, waiting, failed;
+} BatteryRead;
+uint32_t battery_read_request(const BatteryRead *,uint8_t out[24]);
+int battery_read_allowed(const uint8_t *,uint32_t);
+int battery_read_sent(BatteryRead *);
+int battery_read_receive(BatteryRead *,const uint8_t *,uint32_t);
+void battery_read_timeout(BatteryRead *);
+int battery_read_valid(const BatteryRead *);
+#endif
