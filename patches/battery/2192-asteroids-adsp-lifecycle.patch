+ m.mutex=ml_io_map_unmappable(0x1f43000,0x1000,VM_WIMG_IO);
+ m.ipcc=ml_io_map_unmappable(0x405000,0x1000,VM_WIMG_IO);
+ m.qmpmem=ml_io_map_unmappable(0xc300000,0x400,VM_WIMG_IO);
+ m.rsc=ml_io_map_unmappable(0x17a20000,0x4000,VM_WIMG_IO);
