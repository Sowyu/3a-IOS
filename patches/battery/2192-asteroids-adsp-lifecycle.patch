+  if(!(m.state&2) && m_now()>ready){rc=ETIMEDOUT;break;}
+  m_sleep(2);
+ }
+ if(!rc && ((m.state&6)!=6 || (glink && !m.battery_up)))rc=ETIMEDOUT;
+out:
+ printf("SWEET BATTERY: B2 run end error=%d ready=%u handover=%u pmic=%u\n",rc,!!(m.state&2),!!(m.state&4),m.battery_up);
+ if(!adsp_cleanup())rc=EIO;
+ return rc;
+}
