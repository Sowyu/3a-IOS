+static int adsp_open_images(struct wl_fat *f){
+ int rc=sweet_ufs_part_size("modem_a",NULL,&adsp_partition_bytes);if(rc)return rc;
+ if((rc=fat_mount(f,"modem_a")))return rc;
+ m.images[0]=(struct adsp_image){.stem="adsp_dtb",.pas=36,.base=0x99280000,.bytes=0x80000,.meta_pa=0xe1400000};
+ m.images[1]=(struct adsp_image){.stem="adsp",.pas=1,.base=0x99300000,.bytes=0x2800000,.meta_pa=0xe1410000};
+ for(unsigned i=0;i<2;i++){
+  struct adsp_image *im=&m.images[i];char path[32];uint32_t cl;
+  snprintf(path,sizeof(path),"image/%s.mdt",im->stem);
+  if((rc=fat_open(f,path,&cl,&im->mdt_bytes)))return rc;
+  if(!im->mdt_bytes || im->mdt_bytes>META_MAX)return EINVAL;
