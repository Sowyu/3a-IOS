+ if(m.qmpmem)ml_io_unmap(m.qmpmem,0x400);if(m.ipcc)ml_io_unmap(m.ipcc,0x1000);
+ if(m.mutex)ml_io_unmap(m.mutex,0x1000);if(m.smem)ml_io_unmap(m.smem,M_SM_SIZE);
+ printf("SWEET BATTERY: B2 STOP verified; cleanup=ok; ADSP/XO floors retained until reset=%u\n",m.votes_owed);
