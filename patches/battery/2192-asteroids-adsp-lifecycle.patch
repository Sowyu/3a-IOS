+        }
+        uint8_t sum = 0;
+        for (unsigned j = 0; j < 11; j++) sum = (uint8_t)((sum >> 1) | (sum << 7)) + e[j];
+        bool match = (lfn && sum == checksum) || memcmp(e, want, 11) == 0;
+        lfn = false;
+        if (e[11] & 0x08) continue;
+        if (match) {
+			*cluster = le16(e + 26);
+			*size = le32(e + 28);
