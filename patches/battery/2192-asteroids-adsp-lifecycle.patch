+static int m_qsend_packet(void *context,const uint8_t *data,uint32_t length){
+    (void)context;if(length>512 || m.qcount==M_TX_COUNT){m.failed=true;return -1;}
+    unsigned i=(m.qhead+m.qcount)%M_TX_COUNT;m.queue[i].len=length;memcpy(m.queue[i].data,data,length);m.qcount++;return 0;
+}
