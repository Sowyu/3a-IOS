+/* "image/mba.mbn" style path, one directory level at a time. */
+static int
+fat_open(const struct wl_fat *f, const char *path, uint32_t *cluster, uint32_t *size)
+{
+	uint32_t cl = 0, nent = 0, sz = 0;
+	bool dir = true;
+	const char *p = path;
+	while (*p) {
+		const char *s = p;
+		while (*p && *p != '/') {
+			p++;
+		}
+		if (!dir) {
+			return ENOTDIR;
+		}
+		int err = fat_dir_load(f, cl, &nent);
+		if (err) {
+			return err;
+		}
+		err = fat_find(wl_dirbuf, nent, s, (size_t)(p - s), &cl, &sz, &dir);
+		if (err) {
+			return err;
+		}
+		if (dir && (cl < 2 || cl >= f->ncl + 2)) return EIO;
+		if (*p == '/') {
+			p++;
+		}
+	}
+	if (dir) return EISDIR;
+	int chain_error = fat_validate_file(f, cl, sz);
+	if (chain_error) return chain_error;
+	*cluster = cl;
+	*size = sz;
+	return 0;
+}
