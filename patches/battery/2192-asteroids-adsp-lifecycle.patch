+/* Copied from modem runtime after 2178, adapted only in battery draft. */
+static uint64_t m_now(void){uint64_t ns;absolutetime_to_nanoseconds(mach_absolute_time(),&ns);return ns/NSEC_PER_MSEC;}
+static void m_sleep(unsigned ms){uint64_t d;clock_interval_to_deadline(ms,NSEC_PER_MSEC,&d);assert_wait_deadline(&m,THREAD_UNINT,d);thread_block(THREAD_CONTINUE_NULL);}
+static uint32_t m_rd(vm_offset_t p,unsigned o){uint32_t v=*(volatile uint32_t *)(p+o);__asm__ volatile("dmb sy":::"memory");return v;}
+static void m_wr(vm_offset_t p,unsigned o,uint32_t v){__asm__ volatile("dmb sy":::"memory");*(volatile uint32_t *)(p+o)=v;__asm__ volatile("dsb sy":::"memory");}
+static void m_ring(unsigned client,unsigned signal){m_wr(m.ipcc,0x0c,client<<16|signal);}
+static void m_qkick(void *unused){(void)unused;m_ring(0,0);}
+static void m_gkick(void *unused){(void)unused;m_ring(3,0);}
+/* Preserve the original arguments and x6 session across interrupted calls. */
+static void m_smc_raw(uint64_t r[8]){
+    register uint64_t x0 __asm__("x0")=r[0],x1 __asm__("x1")=r[1],x2 __asm__("x2")=r[2],x3 __asm__("x3")=r[3];
+    register uint64_t x4 __asm__("x4")=r[4],x5 __asm__("x5")=r[5],x6 __asm__("x6")=r[6],x7 __asm__("x7")=r[7];
+    __asm__ volatile("smc #0":"+r"(x0),"+r"(x1),"+r"(x2),"+r"(x3),"+r"(x4),"+r"(x5),"+r"(x6),"+r"(x7)::"x8","x9","x10","x11","x12","x13","x14","x15","x16","x17","cc","memory");
+    r[0]=x0;r[1]=x1;r[2]=x2;r[3]=x3;r[4]=x4;r[5]=x5;r[6]=x6;r[7]=x7;
+}
+static int m_scm(uint32_t fn,uint32_t info,uint64_t a,uint64_t b,uint64_t c,uint64_t ext,uint64_t *result){
+    for(unsigned busy=0;busy<4;busy++){
+        uint64_t function=fn,token=0;bool retry=false;
+        for(unsigned resume=0;resume<256;resume++){
+            uint64_t r[8]={function,info,a,b,c,ext,token,0};m_smc_raw(r);
+            if((int64_t)r[0]==1){function=1;token=r[6];continue;}
+            if((int64_t)r[0]==-12){retry=true;break;}
+            *result=r[1];return (int)r[0];
+        }
+        if(!retry)return ETIMEDOUT;
+        m_sleep(30);
+    }
+    return ETIMEDOUT;
+}
+static int m_pas(unsigned pas,unsigned cmd,uint32_t info,uint64_t b,uint64_t c){
+    uint64_t result=~0ull;int rc=m_scm(qcom_scm_fn(2,cmd),info,pas,b,c,0,&result);
+    printf("SWEET BATTERY: PAS%u cmd=%u status=%d result=%lld\n",pas,cmd,rc,(long long)result);sweet_log_sync();
+    /* Linux maps unrecognized SCM transport failures to -EINVAL. Its modem
+     * decrypt-shutdown poll retries that class; ast151 returned raw -3145800.
+     * Keep raw status in the log, and never normalize a failure to success. */
+    if(cmd==6 && rc<0){
+        switch(rc){
+        case -1:return -EIO;
+        case -4:return -ENOTSUP;
+        case -5:return -ENOMEM;
+        case -12:return -EBUSY;
+        default:return -EINVAL;
+        }
+    }
+    return rc?rc:(int)result;
+}
+
+static int m_vote(bool on){
+    if(!on)return EINVAL; /* never lower inherited ADSP/XO votes in this bounded probe */
+    sweet_apps_rsc_lock();int chosen=-1,rc=ENODEV;unsigned base=0;
+    for(unsigned i=0;i<3;i++){
+        unsigned t=0xd00+i*0x2a0;
+        if(m_rd(m.rsc,t+0x28) && !m_rd(m.rsc,t+0x24) && !m_rd(m.rsc,t+0x2c) && !m_rd(m.rsc,t+0x20) && !(m_rd(m.rsc,0xd04)&(1u<<i))){chosen=i;base=t;break;}
+    }
+    if(chosen<0)goto out;
+    if(on)m.votes_owed=true;
+    uint32_t bit=1u<<chosen,irq=m_rd(m.rsc,0xd00);m_wr(m.rsc,0xd00,irq&~bit);
+    unsigned count=on?3:1,mask=(1u<<count)-1;
+    for(unsigned i=0;i<count;i++){
+        unsigned rail=on?i:1; /* only the modem-specific MSS vote can go to zero */
+        uint32_t addr=rail==2?m.xo_addr:m.rail_addr[rail];
+        uint32_t value=rail==2?3:(on?m.rail_index[rail]:0);
+        m_wr(m.rsc,base+0x34+i*24,0x10108);m_wr(m.rsc,base+0x38+i*24,addr);m_wr(m.rsc,base+0x3c+i*24,value);
+    }
+    /* Retain ADSP proxy floors and shared XO until the guarded devloop reset. */
+    if(on)m.xo_pinned=true;
+    m_wr(m.rsc,base+0x20,mask);m_wr(m.rsc,base+0x2c,mask);m_wr(m.rsc,base+0x24,1u<<16);m_wr(m.rsc,base+0x24,(1u<<16)|(1u<<24));
+    rc=ETIMEDOUT;
+    for(unsigned us=0;us<100000;us++){
+        bool done=m_rd(m.rsc,base+0x28)!=0;
+        for(unsigned i=0;i<count;i++)done &= (m_rd(m.rsc,base+0x40+i*24)&0x10100)==0x10100;
+        if(done){rc=0;break;}delay(1);
+    }
+    if(!rc){m_wr(m.rsc,base+0x24,0);m_wr(m.rsc,base+0x2c,0);m_wr(m.rsc,base+0x20,0);m_wr(m.rsc,0xd08,bit);m_wr(m.rsc,0xd00,(m_rd(m.rsc,0xd00)&~bit)|(irq&bit));}
+    if(rc==ETIMEDOUT)m.vote_uncertain=true;
+    /* On timeout retain the owned TCS exactly as it is. Never reprogram it. */
+out:sweet_apps_rsc_unlock();printf("SWEET BATTERY: RPMh on=%d tcs=%d error=%d\n",on,chosen,rc);return rc;
+}
+static int m_qwait(unsigned timeout){uint64_t end=m_now()+timeout;do{int st=qcom_qmp_step(&m.qp);if(st==QcomQmpOpen)return 0;if(st<0)return EIO;m_sleep(1);}while(m_now()<end);return ETIMEDOUT;}
+static int m_qsend(bool on){
+    if(m.qp.state!=QcomQmpOpen && m_qwait(1000))return EBUSY;
+    int rc=qcom_qmp_send(&m.qp,on?"{class: image, res: load_state, name: adsp, val: on}":"{class: image, res: load_state, name: adsp, val: off}");
+    return rc==QcomQmpSending?m_qwait(1000):EIO;
+}
+static int m_item(uint16_t id,uint32_t minimum,uint32_t *off,uint32_t *bytes){
+    int rc=qcom_smem_find(&m.sm,&m.part,id,off,bytes);
+    if(rc || *bytes<minimum || *off>M_SM_SIZE || *bytes>M_SM_SIZE-*off || (*off&3))return ENOENT;
+    return 0;
+}
+static int m_alloc(uint16_t id,uint32_t bytes,uint32_t *off){
+    bool locked=false;for(unsigned us=0;us<100000;us++){m_wr(m.mutex,0,1);if(m_rd(m.mutex,0)==1){locked=true;break;}delay(1);}
+    if(!locked)return EBUSY;
+    int rc=qcom_smem_alloc(&m.sm,&m.part,id,bytes);m_wr(m.mutex,0,0);
+    uint32_t actual=0;return rc!=QcomSmemOk && rc!=QcomSmemExists?EIO:m_item(id,bytes,off,&actual);
+}
+
+static void m_smp_poll(void){
+    uint32_t off,bytes;
+    if(m_item(443,QCOM_SMP2P_ITEM_BYTES,&off,&bytes))return;
+    m.sp.in=(volatile uint32_t *)(m.smem+off);
+    uint32_t value=0,changed=0;
+    if(qcom_smp2p_service(&m.sp,"slave-kernel",&value,&changed))m_ring(3,2);
+    if(changed){m.state=value;printf("SWEET BATTERY: SMP2P slave=%#x ready=%u handover=%u stop_ack=%u\n",value,!!(value&2),!!(value&4),!!(value&8));sweet_log_sync();}
+    if(value&1)m.fatal=true;
+}
