+int battery_msg_header(const uint8_t *p,uint32_t n,uint32_t *owner,uint32_t *type,uint32_t *opcode){
+ if(!p || n<12 || !owner || !type || !opcode)return 0;
+ *owner=get32(p);*type=get32(p+4);*opcode=get32(p+8);return 1;
+}
+int battery_notify_parse(const uint8_t *p,uint32_t n,uint32_t *code){
+ if(!p || n!=16 || get32(p)!=32778 || get32(p+4)!=2 || get32(p+8)!=7)return 0;
+ if(code)*code=get32(p+12);
+ return 1;
+}
