@@ -961,6 +1041,11 @@
 			}
 		}
 	}
+	/* 2298: keep the busiest thread alive past the unlock if it held 90% of the window. */
+	thread_t hog = ntop && top[0].d * 10 >= wall * 9 ? top[0].th : THREAD_NULL;
