 		/* Insertion into the six largest, kept sorted. */
@@ -947,6 +1026,7 @@
 				top[k] = top[k - 1];
 			}
 			top[at].tid = tid;
+			top[at].th = thread;
 			top[at].d = d;
 			top[at].pri = thread->base_pri;
