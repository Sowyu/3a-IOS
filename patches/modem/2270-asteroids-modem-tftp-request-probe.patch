diff --git a/bsd/dev/modem/ModemTftpProbe.h b/bsd/dev/modem/ModemTftpProbe.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/modem/ModemTftpProbe.h
@@ -0,0 +1,68 @@
+/* Read-only discovery probe. It never opens a file or accepts file data. */
+#ifndef MODEM_TFTP_PROBE_H
+#define MODEM_TFTP_PROBE_H
+#include "ModemGate.h"
+static int modem_tftp_probe_allowed(const char *args)
+{
+    static const char *const required[]={"sweetmtftpprobe","sweetmpss","sweetmglink","sweetmrmtfs","sweetmpdm","sweetmstop","sweetmho","sweetfbarm","sweetselftest"};
+    static const char *const forbidden[]={"sweetmsession","sweetdata","sweetdataonline","sweetqmiraw","sweetipa","sweetipafw","sweetipamap","sweetipaprobe","sweetmprobe","sweetmbcm"};
+    for(unsigned i=0;i<sizeof(required)/sizeof(required[0]);i++)
+        if(!modem_gate(args,required[i]))return 0;
+    for(unsigned i=0;i<sizeof(forbidden)/sizeof(forbidden[0]);i++)
+        if(modem_gate(args,forbidden[i]))return 0;
+    return modem_arg_is(args,"sweetdeadman","600");
+}
+
+typedef struct {
+    unsigned opcode, valid;
+    char path[128];
+} ModemTftpProbe;
+
+static int mtp_string(const uint8_t *data, unsigned size, unsigned *at,
+                      unsigned limit, unsigned *start, unsigned *length)
+{
+    *start=*at;
+    while(*at<size && data[*at]) {
+        if(*at-*start>=limit || data[*at]<32 || data[*at]>126)return 0;
+        ++*at;
+    }
+    if(*at==size || *at==*start)return 0;
+    *length=*at-*start;++*at;return 1;
+}
+
+static unsigned modem_tftp_probe(const uint8_t *data, unsigned size,
+                                 ModemTftpProbe *info, uint8_t *reply, unsigned capacity)
+{
+    static const uint8_t denied[]={0,5,0,2,'p','r','o','b','e',' ','o','n','l','y',0};
+    *info=(ModemTftpProbe){0};
+    if(!data || size<2)return 0;
+    info->opcode=(unsigned)data[0]<<8|data[1];
+    /* Do not answer DATA, ACK or ERROR, avoiding an error-response loop. */
+    if(info->opcode!=1 && info->opcode!=2)return 0;
+    unsigned at=2,path=0,pathlen=0,start=0,len=0;
+    int valid=size<=480 && mtp_string(data,size,&at,127,&path,&pathlen) &&
+              mtp_string(data,size,&at,15,&start,&len) && len==5;
+    static const char octet[]="octet";
+    for(unsigned i=0;valid && i<5;i++) {
+        unsigned c=data[start+i];if(c>='A' && c<='Z')c+='a'-'A';
+        if(c!=(unsigned)octet[i])valid=0;
+    }
+    unsigned options=0;
+    while(valid && at<size) {
+        if(++options>8 || !mtp_string(data,size,&at,24,&start,&len) ||
+           !mtp_string(data,size,&at,24,&start,&len))valid=0;
+    }
+    if(valid) {
+        info->valid=1;
+        for(unsigned i=0;i<pathlen;i++) {
+            unsigned c=data[path+i];
+            info->path[i]=((c>='a'&&c<='z')||(c>='A'&&c<='Z')||
+                (c>='0'&&c<='9')||c=='/'||c=='.'||c=='_'||c=='-')?(char)c:'_';
+        }
+    }
+    if(!reply || capacity<sizeof(denied))return 0;
+    for(unsigned i=0;i<sizeof(denied);i++)reply[i]=denied[i];
+    if(!valid)reply[3]=4;
+    return sizeof(denied);
+}
+#endif
