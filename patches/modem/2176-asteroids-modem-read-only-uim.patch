diff --git a/bsd/dev/modem/ModemUim.c b/bsd/dev/modem/ModemUim.c
--- /dev/null
+++ b/bsd/dev/modem/ModemUim.c
@@ -0,0 +1,58 @@
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(MODEM_PROTOCOL_HOST_TEST)
+/* Read-only QMI UIM 0x2f/0x47. Layout: libqmi data/qmi-service-uim.json. */
+#include "ModemUim.h"
+#include "QcomQrtr.h"
+static uint32_t u32(const uint8_t *p){return (uint32_t)p[0]|(uint32_t)p[1]<<8|(uint32_t)p[2]<<16|(uint32_t)p[3]<<24;}
+static int response(const uint8_t *p,uint32_t n,uint16_t txn,uint16_t id,QcomQmiMessage *m){
+ if(qcom_qmi_parse(p,n,m) || m->type!=QCOM_QMI_RESPONSE || m->message!=id || m->transaction!=txn)return -1;
+ uint32_t len=0;const uint8_t *r=qcom_qmi_tlv(m,2,&len);
+ if(!r || len!=4)return -1;
+ unsigned result=r[0]|r[1]<<8,error=r[2]|r[3]<<8;
+ if(result>1 || (!result && error) || (result && !error))return -1;
+ return error;
+}
+int modem_uim_status(const uint8_t *p,uint32_t n,uint16_t txn,ModemUimStatus *out){
+ *out=(ModemUimStatus){0};QcomQmiMessage m;int rc=response(p,n,txn,0x2f,&m);if(rc)return rc;
+ uint32_t len=0;const uint8_t *v=qcom_qmi_tlv(&m,0x10,&len);
+ if(!v || len<9 || v[8]>MODEM_UIM_CARDS)return -1;
+ ModemUimStatus s={0};s.count=v[8];uint32_t at=9;
+ for(unsigned i=0;i<s.count;i++){
+  if(len-at<6)return -1;
+  ModemUimCard *c=&s.card[i];c->state=v[at];c->error=v[at+4];c->apps=v[at+5];at+=6;
+  if(c->state>2 || c->apps>MODEM_UIM_APPS)return -1;
+  for(unsigned j=0;j<c->apps;j++){
+   if(len-at<7)return -1;
+   uint32_t aid=v[at+6];if(aid>32 || len-at<14+aid)return -1;
+   c->app[j].type=v[at];c->app[j].state=v[at+1];c->app[j].pin1=v[at+8+aid];at+=14+aid;
+  }
+ }
+ if(at!=len)return -1;*out=s;return 0;
+}
+int modem_uim_suffix(const uint8_t *p,uint32_t n,char out[5]){
+ for(unsigned i=0;i<5;i++)out[i]=0;
+ if(!n)return 0;
+ if(n>10)return -1;
+ char last[4]={0};unsigned digits=0;
+ for(unsigned i=0;i<2*n;i++){
+  unsigned v=(p[i/2]>>((i&1)*4))&15;
+  if(v==15 && i==2*n-1)break;
+  if(v>9)return -1;
+  last[digits%4]=(char)('0'+v);digits++;
+ }
+ if(digits<4)return -1;
+ for(unsigned i=0;i<4;i++)out[i]=last[(digits-4+i)%4];return 0;
+}
+int modem_uim_slots(const uint8_t *p,uint32_t n,uint16_t txn,ModemUimSlots *out){
+ *out=(ModemUimSlots){0};QcomQmiMessage m;int rc=response(p,n,txn,0x47,&m);if(rc)return rc;
+ uint32_t len=0;const uint8_t *v=qcom_qmi_tlv(&m,0x10,&len);
+ if(!v || !len || v[0]>MODEM_UIM_CARDS)return -1;
+ ModemUimSlots s={0};s.count=v[0];uint32_t at=1;
+ for(unsigned i=0;i<s.count;i++){
+  if(len-at<10)return -1;
+  ModemUimSlot *slot=&s.slot[i];slot->card=u32(v+at);slot->active=u32(v+at+4);slot->logical=v[at+8];uint32_t bytes=v[at+9];at+=10;
+  if(bytes>len-at || modem_uim_suffix(v+at,bytes,slot->suffix))return -1;at+=bytes;
+ }
+ if(at!=len)return -1;*out=s;return 0;
+}
+
+#endif
diff --git a/bsd/dev/modem/ModemUim.h b/bsd/dev/modem/ModemUim.h
--- /dev/null
+++ b/bsd/dev/modem/ModemUim.h
@@ -0,0 +1,18 @@
+#ifndef MODEM_UIM_H
+#define MODEM_UIM_H
+#include <stdint.h>
+#define MODEM_UIM_CARDS 4u
+#define MODEM_UIM_APPS 8u
+typedef struct {
+ uint8_t state, error, apps;
+ struct {uint8_t type,state,pin1;} app[MODEM_UIM_APPS];
+} ModemUimCard;
+typedef struct {uint8_t count;ModemUimCard card[MODEM_UIM_CARDS];} ModemUimStatus;
+typedef struct {uint32_t card,active;uint8_t logical;char suffix[5];} ModemUimSlot;
+typedef struct {uint8_t count;ModemUimSlot slot[MODEM_UIM_CARDS];} ModemUimSlots;
+/* Return 0 on complete success, positive QMI error, -1 malformed/wrong response.
+ * No raw identifier is copied into output. No requests change SIM state. */
+int modem_uim_status(const uint8_t *,uint32_t,uint16_t,ModemUimStatus *);
+int modem_uim_slots(const uint8_t *,uint32_t,uint16_t,ModemUimSlots *);
+int modem_uim_suffix(const uint8_t *,uint32_t,char[5]);
+#endif
