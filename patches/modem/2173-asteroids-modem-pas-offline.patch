+out:sweet_apps_rsc_unlock();printf("SWEET MODEM: RPMh on=%d tcs=%d error=%d\n",on,chosen,rc);return rc;
+}
+static int m_qwait(unsigned timeout){uint64_t end=m_now()+timeout;do{int st=qcom_qmp_step(&m.qp);if(st==QcomQmpOpen)return 0;if(st<0)return EIO;m_sleep(1);}while(m_now()<end);return ETIMEDOUT;}
