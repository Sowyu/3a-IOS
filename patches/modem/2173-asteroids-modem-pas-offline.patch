+        const uint8_t *iov=qcom_qmi_tlv(&m,3,&n);
+        ok=valid && r->window && dir && dir[0]<=1 && iov && n && n==1+12u*iov[0];
+        for(unsigned i=0;ok && i<iov[0];i++)ok=extent(r,id,iov+1+12*i);
+        if(ok)for(unsigned i=0;i<iov[0];i++){
+            const uint8_t *e=iov+1+12*i;uint32_t off=get32(e)*512,at=get32(e+4)-r->window_pa,len=get32(e+8)*512;
+            uint8_t *src=dir[0]?r->window+at:r->image[id]+off;
+            uint8_t *dst=dir[0]?r->image[id]+off:r->window+at;
+            for(uint32_t j=0;j<len;j++)dst[j]=src[j];
+            if(dir[0])r->writes++;else r->reads++;
