+    put16(out+5,len-7);return len;
+}
+
+#endif
diff --git a/bsd/dev/modem/ModemRmtfs.h b/bsd/dev/modem/ModemRmtfs.h
--- /dev/null
+++ b/bsd/dev/modem/ModemRmtfs.h
@@ -0,0 +1,13 @@
+/* RAM-only rmtfs. The owner preloads partition images using read-only storage.
+ * This module has no storage callback, allocator, or persistence operation. */
+#ifndef MODEM_RMTFS_H
+#define MODEM_RMTFS_H
+#include <stdint.h>
+typedef struct {
+    uint8_t *image[4], *window;
+    uint32_t bytes[4], window_bytes, window_pa, opened;
+    uint32_t reads, writes;
+} ModemRmtfs;
+/* Returns a QMI response length, or zero for malformed/non-request input. */
+uint32_t modem_rmtfs_request(ModemRmtfs *, const uint8_t *, uint32_t, uint8_t *, uint32_t);
