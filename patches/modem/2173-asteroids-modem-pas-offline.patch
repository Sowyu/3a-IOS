+static int m_vote(bool on){
+    sweet_apps_rsc_lock();int chosen=-1,rc=ENODEV;unsigned base=0;
+    for(unsigned i=0;i<3;i++){
+        unsigned t=0xd00+i*0x2a0;
+        if(m_rd(m.rsc,t+0x28) && !m_rd(m.rsc,t+0x24) && !m_rd(m.rsc,t+0x2c) && !m_rd(m.rsc,t+0x20) && !(m_rd(m.rsc,0xd04)&(1u<<i))){chosen=i;base=t;break;}
+    }
