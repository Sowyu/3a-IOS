+            if((int64_t)r[0]==-12){retry=true;break;}
+            *result=r[1];return (int)r[0];
+        }
+        if(!retry)return ETIMEDOUT;
+        m_sleep(30);
+    }
+    return ETIMEDOUT;
+}
