+    switch(m.message){
+    case 1:{
+        id=4;
+        uint32_t n=0;v=qcom_qmi_tlv(&m,1,&n);
+        for(unsigned i=0;v && i<4;i++)if(match(v,n,paths[i]))id=i;
+        ok=id<4 && r->image[id] && r->bytes[id];
+        if(ok){r->opened|=1u<<id;put32(opt,id);optlen=4;}break;
+    }
+    case 2:ok=valid;if(ok)r->opened&=~(1u<<id);break;
+    case 3:{
