+    if(qcom_smp2p_service(&m.sp,"slave-kernel",&value,&changed))m_ring(2,2);
+    if(changed){m.state=value;printf("SWEET MODEM: SMP2P slave=%#x ready=%u handover=%u stop_ack=%u\n",value,!!(value&2),!!(value&4),!!(value&8));sweet_log_sync();}
