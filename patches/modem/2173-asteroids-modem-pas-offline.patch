+    *(volatile uint32_t *)(p+128)=3;*(volatile uint32_t *)(p+132)=6;
+    if(share){*(volatile uint32_t *)(p+152)=15;*(volatile uint32_t *)(p+156)=6;}
+    volatile uint64_t *e=(volatile uint64_t *)(p+256);e[0]=share?4:8;e[1]=M_ARGS_PA+128;e[2]=share?48:24;e[3]=0;
+    __asm__ volatile("dsb sy":::"memory");uint64_t result=~0ull;
+    int rc=m_scm(0x42000c16,0x1117,M_ARGS_PA+64,16,M_ARGS_PA,M_ARGS_PA+256,&result);
