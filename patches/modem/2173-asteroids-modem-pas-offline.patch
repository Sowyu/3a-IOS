+    m.qmpmem=ml_io_map(0xc300000,0x400);m.rsc=ml_io_map(0x17a20000,0x4000);m.db=ml_io_map(0x81c60000,0x20000);
+    if(!m.smem || !m.mutex || !m.ipcc || !m.qmpmem || !m.rsc || !m.db)goto out;
+    m.sm=(QcomSmem){(volatile uint8_t *)m.smem,M_SM_SIZE};if(qcom_smem_partition(&m.sm,0,1,&m.part))goto out;
+    uint64_t supported=0;rc=m_scm(qcom_scm_fn(2,7),1,4,0,0,0,&supported);if(rc || supported!=1){rc=ENOTSUP;goto out;}
