+        if(qcom_cmd_db_find(dbcopy,sizeof(dbcopy),rails[i],&r) || !r.level_count || r.levels[r.level_count-1]<384 || qcom_rpmh_level_index(&r,384,&m.rail_index[i])){rc=EINVAL;goto out;}m.rail_addr[i]=r.address;}
