diff --git a/bsd/dev/modem/QcomQrtr.c b/bsd/dev/modem/QcomQrtr.c
--- /dev/null
+++ b/bsd/dev/modem/QcomQrtr.c
@@ -0,0 +1,237 @@
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(MODEM_PROTOCOL_HOST_TEST)
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "QcomQrtr.h"
+
+static uint16_t le16(const uint8_t *p) {return (uint16_t)(p[0] | (uint16_t)p[1] << 8);}
+static uint32_t le32(const uint8_t *p) {return (uint32_t)le16(p) | (uint32_t)le16(p + 2) << 16;}
+static void put16(uint8_t *p, uint32_t v) {p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8);}
+static void put32(uint8_t *p, uint32_t v) {put16(p, v); put16(p + 2, v >> 16);}
+
+#define CTRL_BYTES 20u  /* command and four words */
+#define MAX_PACKET 512u
+
+void qcom_qrtr_init(QcomQrtr *q, uint32_t local_node, QcomQrtrSend send, void *send_context)
+{
+    *q = (QcomQrtr){0};
+    q->local_node = local_node;
+    q->remote_node = QCOM_QRTR_NODE_BROADCAST;
+    q->send = send;
+    q->send_context = send_context;
+}
+
+static int emit(QcomQrtr *q, uint32_t type, uint32_t from_port, uint32_t node, uint32_t port, const uint8_t *data, uint32_t length)
+{
+    uint8_t packet[MAX_PACKET];
+    if (length > MAX_PACKET - QCOM_QRTR_HEADER || (!data && length)) return -1;
+    const uint32_t padded = (length + 3) & ~3u;
+    if (QCOM_QRTR_HEADER + padded > sizeof packet) return -1;
+    put32(packet, 1);
+    put32(packet + 4, type);
+    put32(packet + 8, q->local_node);
+    put32(packet + 12, from_port);
+    put32(packet + 16, 0);  /* confirm_rx: we never ask for flow control acks */
+    put32(packet + 20, length);
+    put32(packet + 24, node);
+    put32(packet + 28, port);
+    for (uint32_t i = 0; i < padded; ++i) packet[QCOM_QRTR_HEADER + i] = i < length ? data[i] : 0;
+    if (q->send(q->send_context, packet, QCOM_QRTR_HEADER + padded)) {q->tx_refused++; return -1;}
+    q->tx_packets++;
+    return 0;
+}
+
+static int control(QcomQrtr *q, uint32_t command, const uint32_t words[4])
+{
+    uint8_t pkt[CTRL_BYTES] = {0};
+    put32(pkt, command);
+    for (unsigned i = 0; words && i < 4; ++i) put32(pkt + 4 + 4 * i, words[i]);
+    return emit(q, command, QCOM_QRTR_PORT_CTRL, q->remote_node, QCOM_QRTR_PORT_CTRL, pkt, sizeof pkt);
+}
+
+static void announce(QcomQrtr *q, unsigned i)
+{
+    const uint32_t words[4] = {q->local[i].service, q->local[i].instance, q->local_node, q->local[i].port};
+    control(q, QCOM_QRTR_NEW_SERVER, words);
+}
+
+int qcom_qrtr_add_service(QcomQrtr *q, uint32_t service, uint32_t instance, uint32_t port, QcomQrtrReceive receive, void *context)
+{
+    if (!receive || q->local_count == QCOM_QRTR_MAX_LOCAL || port == QCOM_QRTR_PORT_CTRL) return -1;
+    const unsigned i = q->local_count++;
+    q->local[i].service = service; q->local[i].instance = instance; q->local[i].port = port;
+    q->local[i].receive = receive; q->local[i].context = context;
+    if (q->hello_received) announce(q, i);
+    return 0;
+}
+
+void qcom_qrtr_start(QcomQrtr *q)
+{
+    if (!control(q, QCOM_QRTR_HELLO, 0)) q->hello_sent = 1;
+}
+
+int qcom_qrtr_find_remote(const QcomQrtr *q, uint32_t service)
+{
+    for (uint32_t i = 0; i < q->remote_count; ++i) if (q->remote[i].service == service) return (int)i;
+    return -1;
+}
+
+static void remote_server(QcomQrtr *q, const uint8_t *w, int add)
+{
+    const uint32_t service = le32(w), instance = le32(w + 4), node = le32(w + 8), port = le32(w + 12);
+    if (!service && !instance && !node && !port) return;  /* the end of a listing */
+    for (uint32_t i = 0; i < q->remote_count; ++i) {
+        if (q->remote[i].node != node || q->remote[i].port != port) continue;
+        if (add) {q->remote[i].service = service; q->remote[i].instance = instance; return;}
+        q->remote[i] = q->remote[--q->remote_count];
+        return;
+    }
+    if (!add || q->remote_count == QCOM_QRTR_MAX_REMOTE) return;
+    q->remote[q->remote_count].service = service; q->remote[q->remote_count].instance = instance;
+    q->remote[q->remote_count].node = node; q->remote[q->remote_count].port = port;
+    q->remote_count++;
+}
+
+int qcom_qrtr_receive(QcomQrtr *q, const uint8_t *packet, uint32_t length)
+{
+    if (length < QCOM_QRTR_HEADER || le32(packet) != 1) {q->rx_bad++; return -1;}
+    const uint32_t type = le32(packet + 4), src_node = le32(packet + 8), src_port = le32(packet + 12);
+    const uint32_t confirm = le32(packet + 16), size = le32(packet + 20), dst_port = le32(packet + 28);
+    if (size > length - QCOM_QRTR_HEADER) {q->rx_bad++; return -1;}
+    const uint8_t *data = packet + QCOM_QRTR_HEADER;
+    q->rx_packets++;
+    if (type == QCOM_QRTR_DATA) {
+        q->rx_data++;
+        unsigned i = 0;
+        while (i < q->local_count && q->local[i].port != dst_port) ++i;
+        if (i < q->local_count) q->local[i].receive(q->local[i].context, q, dst_port, src_node, src_port, data, size);
+        else q->rx_unrouted++;
+        if (confirm) {  /* the sender waits for this before it sends more to the port */
+            const uint32_t words[4] = {src_node, src_port, 0, 0};
+            if (!control(q, QCOM_QRTR_RESUME_TX, words)) q->resumes_sent++;
+        }
+        return 0;
+    }
+    /* control packets carry their command again in the payload */
+    if (size < 4 || le32(data) != type) {q->rx_bad++; return -1;}
+    switch (type) {
+    case QCOM_QRTR_HELLO:
+        q->remote_node = src_node;
+        if (!q->hello_sent) qcom_qrtr_start(q);
+        q->hello_received = 1;
+        for (unsigned i = 0; i < q->local_count; ++i) announce(q, i);
+        break;
+    case QCOM_QRTR_NEW_SERVER:
+    case QCOM_QRTR_DEL_SERVER:
+        if (size >= CTRL_BYTES) remote_server(q, data + 4, type == QCOM_QRTR_NEW_SERVER);
+        break;
+    case QCOM_QRTR_BYE:
+        q->remote_count = 0;
+        q->hello_received = 0;
+        break;
+    default:  /* DEL_CLIENT, RESUME_TX (we never ask), PING, lookups (the remote keeps its own name service) */
+        break;
+    }
+    return 0;
+}
+
+int qcom_qrtr_send_data(QcomQrtr *q, uint32_t from_port, uint32_t node, uint32_t port, const uint8_t *data, uint32_t length)
+{
+    return emit(q, QCOM_QRTR_DATA, from_port, node, port, data, length);
+}
+
+/* ---- QMI ---- */
+int qcom_qmi_parse(const uint8_t *data, uint32_t length, QcomQmiMessage *m)
+{
+    if (length < QCOM_QMI_HEADER) return -1;
+    m->type = data[0];
+    m->transaction = le16(data + 1);
+    m->message = le16(data + 3);
+    m->length = le16(data + 5);
+    if (m->length != length - QCOM_QMI_HEADER ||
+        (m->type != QCOM_QMI_REQUEST && m->type != QCOM_QMI_RESPONSE && m->type != QCOM_QMI_INDICATION)) return -1;
+    for (uint32_t at = QCOM_QMI_HEADER; at < length;) {
+        if (length - at < 3) return -1;
+        const uint32_t bytes = le16(data + at + 1);
+        if (bytes > length - at - 3) return -1;
+        at += 3 + bytes;
+    }
+    m->tlvs = data + QCOM_QMI_HEADER;
+    return 0;
+}
+
+const uint8_t *qcom_qmi_tlv(const QcomQmiMessage *m, uint8_t type, uint32_t *size)
+{
+    for (uint32_t at = 0; at + 3 <= m->length;) {
+        const uint32_t n = le16(m->tlvs + at + 1);
+        if (n > m->length - at - 3) return 0;
+        if (m->tlvs[at] == type) {*size = n; return m->tlvs + at + 3;}
+        at += 3 + n;
+    }
+    return 0;
+}
+
+/* ---- the service locator ---- */
+#define NAME_MAX_ 64u
+#define LIST_MAX 32u
+
+static int same(const char *a, const uint8_t *b, uint32_t n)
+{
+    uint32_t i = 0;
+    for (; i < n && a[i]; ++i) if ((uint8_t)a[i] != b[i]) return 0;
+    return i == n && !a[i];
+}
+
+static int provides(const QcomPdDomain *d, const uint8_t *name, uint32_t n)
+{
+    if (same("tms/servreg", name, n)) return 1;
+    for (unsigned i = 0; d->services && d->services[i]; ++i) if (same(d->services[i], name, n)) return 1;
+    return 0;
+}
+
+uint32_t qcom_servloc_answer(const QcomPdDomain *domains, unsigned count, const uint8_t *request, uint32_t length, uint8_t *out,
+                             uint32_t capacity)
+{
+    QcomQmiMessage m;
+    uint32_t name_size = 0, offset_size = 0;
+    if (qcom_qmi_parse(request, length, &m) || m.type != QCOM_QMI_REQUEST || m.message != QCOM_SERVLOC_GET_DOMAIN_LIST) return 0;
+    const uint8_t *name = qcom_qmi_tlv(&m, 0x01, &name_size);
+    const uint8_t *skip = qcom_qmi_tlv(&m, 0x10, &offset_size);
+    if (!name || name_size > NAME_MAX_ || (skip && offset_size != 4)) return 0;
+    while (name_size && !name[name_size - 1]) --name_size;  /* a sender may count the terminating zero */
+    const uint32_t first = skip ? le32(skip) : 0;
+    if (capacity < QCOM_QMI_HEADER + 7 + 5 + 5 + 4) return 0;
+    uint8_t *p = out + QCOM_QMI_HEADER;
+    /* result: success, no error */
+    p[0] = 0x02; put16(p + 1, 4); put32(p + 3, 0); p += 7;
+    uint32_t total = 0, listed = 0;
+    uint8_t *list = p + 5 + 5, *entry = list + 4;
+    for (unsigned i = 0; i < count; ++i) {
+        if (!provides(&domains[i], name, name_size)) continue;
+        const uint32_t index = total++;
+        if (index < first || listed == LIST_MAX) continue;
+        uint32_t n = 0;
+        while (domains[i].domain[n] && n < NAME_MAX_) ++n;
+        if ((uint32_t)(entry - out) + 1 + n + 9 > capacity) return 0;
+        entry[0] = (uint8_t)n;
+        for (uint32_t b = 0; b < n; ++b) entry[1 + b] = (uint8_t)domains[i].domain[b];
+        entry += 1 + n;
+        put32(entry, domains[i].instance);  /* instance, then service data valid (no) and service data */
+        entry[4] = 0;
+        put32(entry + 5, 0);
+        entry += 9;
+        listed++;
+    }
+    /* total domains, the database revision, then the list (a one-byte count before its entries) */
+    p[0] = 0x10; put16(p + 1, 2); put16(p + 3, total); p += 5;
+    p[0] = 0x11; put16(p + 1, 2); put16(p + 3, 1); p += 5;
+    if (listed) {
+        p[0] = 0x12; put16(p + 1, (uint32_t)(entry - p - 3)); p[3] = (uint8_t)listed;
+        p = entry;
+    }
+    out[0] = QCOM_QMI_RESPONSE;
+    put16(out + 1, m.transaction);
+    put16(out + 3, m.message);
+    put16(out + 5, (uint32_t)(p - out - QCOM_QMI_HEADER));
+    return (uint32_t)(p - out);
+}
+
+#endif
diff --git a/bsd/dev/modem/QcomQrtr.h b/bsd/dev/modem/QcomQrtr.h
--- /dev/null
+++ b/bsd/dev/modem/QcomQrtr.h
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* The IPC router (QRTR, version 1 headers) on one link to one remote node, with the name service duties of this side: say hello, announce
+ * our services to the remote once it has said hello, answer flow control, and keep the list of the services the remote announces. Our
+ * services are ports with a receive callback. No allocation and no waiting: the owner feeds every received packet in and gives a send
+ * callback that queues one packet (it may refuse; the counters show it). */
+#ifndef QCOM_QRTR_H
+#define QCOM_QRTR_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QCOM_QRTR_HEADER 32u
+#define QCOM_QRTR_PORT_CTRL 0xfffffffeu
+#define QCOM_QRTR_NODE_BROADCAST 0xffffffffu
+#define QCOM_QRTR_MAX_LOCAL 4u
+#define QCOM_QRTR_MAX_REMOTE 32u
+
+enum {
+    QCOM_QRTR_DATA = 1, QCOM_QRTR_HELLO = 2, QCOM_QRTR_BYE = 3, QCOM_QRTR_NEW_SERVER = 4, QCOM_QRTR_DEL_SERVER = 5,
+    QCOM_QRTR_DEL_CLIENT = 6, QCOM_QRTR_RESUME_TX = 7, QCOM_QRTR_EXIT = 8, QCOM_QRTR_PING = 9, QCOM_QRTR_NEW_LOOKUP = 10,
+    QCOM_QRTR_DEL_LOOKUP = 11,
+};
+
+typedef struct QcomQrtr QcomQrtr;
+/* One packet of length bytes (header included); returns 0 when queued. */
+typedef int (*QcomQrtrSend)(void *context, const uint8_t *packet, uint32_t length);
+/* A data packet for one of our ports from node:port. */
+typedef void (*QcomQrtrReceive)(void *context, QcomQrtr *q, uint32_t port, uint32_t node, uint32_t from_port, const uint8_t *data,
+                                uint32_t length);
+
+struct QcomQrtr {
+    uint32_t local_node, remote_node;  /* remote_node: QCOM_QRTR_NODE_BROADCAST until the remote's hello */
+    uint8_t hello_sent, hello_received;
+    QcomQrtrSend send;
+    void *send_context;
+    struct {uint32_t service, instance, port; QcomQrtrReceive receive; void *context;} local[QCOM_QRTR_MAX_LOCAL];
+    uint32_t local_count;
+    struct {uint32_t service, instance, node, port;} remote[QCOM_QRTR_MAX_REMOTE];
+    uint32_t remote_count;
+    /* counters for the log */
+    uint32_t rx_packets, rx_data, rx_bad, rx_unrouted, tx_packets, tx_refused, resumes_sent;
+};
+
+void qcom_qrtr_init(QcomQrtr *q, uint32_t local_node, QcomQrtrSend send, void *send_context);
+/* Adds one of our services (instance as announced: version | instance << 8) on port; announced to the remote after its hello, or at
+ * once when that has been. Returns 0, or -1 when full. */
+int qcom_qrtr_add_service(QcomQrtr *q, uint32_t service, uint32_t instance, uint32_t port, QcomQrtrReceive receive, void *context);
+/* The link is up: says hello. */
+void qcom_qrtr_start(QcomQrtr *q);
+/* One received packet. Returns 0, or -1 when it was not a valid packet. */
+int qcom_qrtr_receive(QcomQrtr *q, const uint8_t *packet, uint32_t length);
+/* A data packet from our port to the remote's node:port. capacity bounds the packet built on the stack. Returns 0 when queued. */
+int qcom_qrtr_send_data(QcomQrtr *q, uint32_t from_port, uint32_t node, uint32_t port, const uint8_t *data, uint32_t length);
+/* Index of a remote service in the list, -1 when not announced. */
+int qcom_qrtr_find_remote(const QcomQrtr *q, uint32_t service);
+
+/* ---- QMI messages carried in data packets: a 7-byte header (type, transaction, message id, length) and TLVs ---- */
+#define QCOM_QMI_HEADER 7u
+enum {QCOM_QMI_REQUEST = 0, QCOM_QMI_RESPONSE = 2, QCOM_QMI_INDICATION = 4};
+typedef struct {uint8_t type; uint16_t transaction, message; const uint8_t *tlvs; uint32_t length;} QcomQmiMessage;
+int qcom_qmi_parse(const uint8_t *data, uint32_t length, QcomQmiMessage *m);
+/* The value of TLV type in m (length in *size), or null. */
+const uint8_t *qcom_qmi_tlv(const QcomQmiMessage *m, uint8_t type, uint32_t *size);
+
+/* ---- the service locator (service 64): which protection domains provide a service ---- */
+#define QCOM_SERVLOC_SERVICE 0x40u
+#define QCOM_SERVLOC_INSTANCE 0x101u  /* as announced: version 0x101, instance 0 */
+#define QCOM_SERVLOC_GET_DOMAIN_LIST 0x21u
+typedef struct {const char *domain; uint32_t instance; const char *const *services;} QcomPdDomain;
+/* Answers a locator request (a whole QMI message) into out; returns the answer's length, 0 when the request is not one to answer. Every
+ * domain provides "tms/servreg"; services lists the others. */
+uint32_t qcom_servloc_answer(const QcomPdDomain *domains, unsigned count, const uint8_t *request, uint32_t length, uint8_t *out,
+                             uint32_t capacity);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/modem/QcomSmp2p.c b/bsd/dev/modem/QcomSmp2p.c
--- /dev/null
+++ b/bsd/dev/modem/QcomSmp2p.c
@@ -0,0 +1,129 @@
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(MODEM_PROTOCOL_HOST_TEST)
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "QcomSmp2p.h"
+
+/* Word offsets: 0 magic, 1 version (bits 7:0) and features (31:8), 2 local pid (15:0) and remote pid (31:16), 3 total entries (15:0)
+ * and valid entries (31:16), 4 flags, then 5 words per entry: a 16-byte name and the value. */
+#define W_VERSION 1
+#define W_PIDS 2
+#define W_COUNTS 3
+#define W_FLAGS 4
+#define W_ENTRY(i) (5 + 5 * (i))
+
+static void barrier(void)
+{
+#if defined(__aarch64__) && defined(KERNEL)
+    __asm__ volatile("dmb oshst" ::: "memory");
+#endif
+}
+static int same_name(const volatile uint32_t *entry, const char *name)
+{
+    for (unsigned i = 0; i < 16; ++i) {
+        const char c = (char)(entry[i / 4] >> (8 * (i % 4)));
+        if (c != name[i]) return 0;
+        if (!c) return 1;
+    }
+    return name[16] == 0;
+}
+
+void qcom_smp2p_init_out(QcomSmp2p *s, volatile uint32_t *out, uint16_t local_pid, uint16_t remote_pid)
+{
+    *s = (QcomSmp2p){0};
+    s->out = out;
+    s->local_pid = local_pid;
+    s->remote_pid = remote_pid;
+    for (unsigned i = 0; i < QCOM_SMP2P_ITEM_BYTES / 4; ++i) out[i] = 0;
+    barrier();
+    out[0] = QCOM_SMP2P_MAGIC;
+    out[W_PIDS] = local_pid | (uint32_t)remote_pid << 16;
+    out[W_COUNTS] = QCOM_SMP2P_MAX_ENTRIES;
+    barrier();
+    out[W_VERSION] = QCOM_SMP2P_VERSION | QCOM_SMP2P_FEATURE_SSR_ACK << 8;
+    barrier();
+}
+
+int qcom_smp2p_add_entry(QcomSmp2p *s, const char *name)
+{
+    const uint32_t valid = s->out[W_COUNTS] >> 16;
+    if (valid >= QCOM_SMP2P_MAX_ENTRIES) return -1;
+    uint32_t words[4] = {0};
+    for (unsigned i = 0; i < 16 && name[i]; ++i) words[i / 4] |= (uint32_t)(uint8_t)name[i] << (8 * (i % 4));
+    for (unsigned i = 0; i < 4; ++i) s->out[W_ENTRY(valid) + i] = words[i];
+    s->out[W_ENTRY(valid) + 4] = 0;
+    barrier();
+    s->out[W_COUNTS] = QCOM_SMP2P_MAX_ENTRIES | (valid + 1) << 16;
+    barrier();
+    return (int)valid;
+}
+
+int qcom_smp2p_update(QcomSmp2p *s, int index, uint32_t mask, uint32_t value)
+{
+    if (!s || !s->out || index < 0 || index >= (int)QCOM_SMP2P_MAX_ENTRIES) return 0;
+    volatile uint32_t *v = &s->out[W_ENTRY(index) + 4];
+    const uint32_t old = *v, next = (old & ~mask) | (value & mask);
+    if (next == old) return 0;
+    *v = next;
+    barrier();
+    return 1;
+}
+
+uint32_t qcom_smp2p_out_value(const QcomSmp2p *s, int index) {return s && s->out && index >= 0 && index < (int)QCOM_SMP2P_MAX_ENTRIES ? s->out[W_ENTRY(index) + 4] : 0;}
+
+int qcom_smp2p_check_in(const volatile uint32_t *in, uint16_t local_pid, uint16_t remote_pid)
+{
+    if (!in || in[0] != QCOM_SMP2P_MAGIC) return -1;
+    if ((in[W_VERSION] & 0xff) != QCOM_SMP2P_VERSION) return -2;
+    /* The remote writes its own pid as local. */
+    if (in[W_PIDS] != (remote_pid | (uint32_t)local_pid << 16)) return -3;
+    const uint32_t counts = in[W_COUNTS];
+    if ((counts & 0xffff) > QCOM_SMP2P_MAX_ENTRIES || (counts >> 16) > (counts & 0xffff)) return -4;
+    return 0;
+}
+
+int qcom_smp2p_find_in(const QcomSmp2p *s, const char *name)
+{
+    if (!s->in) return -1;
+    const uint32_t valid = s->in[W_COUNTS] >> 16;
+    for (uint32_t i = 0; i < valid && i < QCOM_SMP2P_MAX_ENTRIES; ++i)
+        if (same_name(&s->in[W_ENTRY(i)], name)) return (int)i;
+    return -1;
+}
+
+uint32_t qcom_smp2p_in_value(const QcomSmp2p *s, int index) {return s && s->in && index >= 0 && index < (int)QCOM_SMP2P_MAX_ENTRIES ? s->in[W_ENTRY(index) + 4] : 0;}
+
+int qcom_smp2p_service(QcomSmp2p *s, const char *entry, uint32_t *value, uint32_t *changed)
+{
+    int ring = 0;
+    *value = 0;
+    *changed = 0;
+    if (qcom_smp2p_check_in(s->in, s->local_pid, s->remote_pid)) return 0;
+    if (!s->negotiated) {
+        const uint32_t ours = s->out[W_VERSION], theirs = s->in[W_VERSION];
+        if ((ours & 0xff) == (theirs & 0xff)) {
+            const uint32_t features = (ours >> 8) & (theirs >> 8);
+            if (features != ours >> 8) {s->out[W_VERSION] = (ours & 0xff) | features << 8; barrier(); ring = 1;}
+            s->ssr_ack_enabled = (features & QCOM_SMP2P_FEATURE_SSR_ACK) != 0;
+            s->negotiated = 1;
+        }
+    }
+    if (s->ssr_ack_enabled) {
+        const uint8_t done = (s->in[W_FLAGS] & QCOM_SMP2P_FLAG_RESTART_DONE) != 0;
+        if (done != s->ssr_acked) {
+            s->ssr_acked = done;
+            const uint32_t flags = s->out[W_FLAGS];
+            s->out[W_FLAGS] = done ? flags | QCOM_SMP2P_FLAG_RESTART_ACK : flags & ~QCOM_SMP2P_FLAG_RESTART_ACK;
+            barrier();
+            ring = 1;
+        }
+    }
+    const int index = qcom_smp2p_find_in(s, entry);
+    if (index >= 0) {
+        const uint32_t now = qcom_smp2p_in_value(s, index);
+        *value = now;
+        *changed = now ^ s->last[index];
+        s->last[index] = now;
+    }
+    return ring;
+}
+
+#endif
diff --git a/bsd/dev/modem/QcomSmp2p.h b/bsd/dev/modem/QcomSmp2p.h
--- /dev/null
+++ b/bsd/dev/modem/QcomSmp2p.h
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Shared memory point-to-point state (SMP2P): each side owns one SMEM item holding named 32-bit entries the other side watches; a change
+ * is signalled with a doorbell. This is the item layout and the bookkeeping for both directions: our outbound item (entries we set bits
+ * in) and the remote's inbound item (entries whose bit changes become events). Doorbells and SMEM placement belong to the caller. */
+#ifndef QCOM_SMP2P_H
+#define QCOM_SMP2P_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QCOM_SMP2P_MAGIC 0x504d5324u  /* "$SMP" */
+#define QCOM_SMP2P_VERSION 1u
+#define QCOM_SMP2P_FEATURE_SSR_ACK 1u
+#define QCOM_SMP2P_FLAG_RESTART_DONE 1u
+#define QCOM_SMP2P_FLAG_RESTART_ACK 2u
+#define QCOM_SMP2P_MAX_ENTRIES 16u
+#define QCOM_SMP2P_ITEM_BYTES (20u + 20u * QCOM_SMP2P_MAX_ENTRIES)
+
+/* The two items' storage: 32-bit aligned, possibly device memory. */
+typedef struct {
+    volatile uint32_t *out, *in;  /* in may be null until the remote has made it */
+    uint16_t local_pid, remote_pid;
+    uint8_t negotiated, ssr_ack_enabled, ssr_acked;
+    uint32_t last[QCOM_SMP2P_MAX_ENTRIES];  /* inbound values last seen, by inbound entry index */
+    uint32_t seen_entries;
+} QcomSmp2p;
+
+/* Writes a fresh outbound item (zeroes, header, then the version word last so the remote never sees a half-made item). */
+void qcom_smp2p_init_out(QcomSmp2p *s, volatile uint32_t *out, uint16_t local_pid, uint16_t remote_pid);
+/* Adds a named outbound entry and returns its index, or -1 when full. */
+int qcom_smp2p_add_entry(QcomSmp2p *s, const char *name);
+/* Sets the bits in mask of outbound entry index to value; returns 1 when the value changed (ring the doorbell). */
+int qcom_smp2p_update(QcomSmp2p *s, int index, uint32_t mask, uint32_t value);
+uint32_t qcom_smp2p_out_value(const QcomSmp2p *s, int index);
+
+/* Validates an inbound item (magic, version, the pids seen from the other side); 0 when usable. */
+int qcom_smp2p_check_in(const volatile uint32_t *in, uint16_t local_pid, uint16_t remote_pid);
+/* Index of the named inbound entry, -1 when the remote has not added it. */
+int qcom_smp2p_find_in(const QcomSmp2p *s, const char *name);
+uint32_t qcom_smp2p_in_value(const QcomSmp2p *s, int index);
+
+/* Called on every doorbell from the remote. Agrees on the features once, answers a restart with the restart ack flag, and reports the
+ * bits of the named inbound entry that changed since the last call (changed) and its current value (value). Returns 1 when our item
+ * changed so the remote has to be rung. */
+int qcom_smp2p_service(QcomSmp2p *s, const char *entry, uint32_t *value, uint32_t *changed);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/modem/QcomQmp.c b/bsd/dev/modem/QcomQmp.c
--- /dev/null
+++ b/bsd/dev/modem/QcomQmp.c
@@ -0,0 +1,106 @@
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(MODEM_PROTOCOL_HOST_TEST)
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "QcomQmp.h"
+
+/* Descriptor words (byte offset / 4): magic, version, features; the AOP's link state, its ack, channel state, its ack, mailbox size and
+ * offset; then the same six for our side. */
+#define MAGIC 0x4d41494cu
+#define D_MAGIC 0
+#define D_VERSION 1
+#define D_UCORE_LINK 3
+#define D_UCORE_LINK_ACK 4
+#define D_UCORE_CH 5
+#define D_UCORE_CH_ACK 6
+#define D_MCORE_LINK 9
+#define D_MCORE_LINK_ACK 10
+#define D_MCORE_CH 11
+#define D_MCORE_CH_ACK 12
+#define D_MCORE_SIZE 13
+#define D_MCORE_OFFSET 14
+#define UP 0x0000ffffu
+
+static void barrier(void)
+{
+#if defined(__aarch64__) && defined(KERNEL)
+    __asm__ volatile("dsb sy" ::: "memory");
+#endif
+}
+static void kick(QcomQmp *q) {barrier(); if (q->kick) q->kick(q->context);}
+
+void qcom_qmp_init(QcomQmp *q, volatile uint32_t *ram, uint32_t ram_bytes, void (*k)(void *), void *context)
+{
+    *q = (QcomQmp){ram, ram_bytes, 0, 0, QcomQmpIdle, k, context};
+}
+
+int qcom_qmp_step(QcomQmp *q)
+{
+    if (!q || !q->ram || q->ram_bytes < 0x3c) return QcomQmpBadDescriptor;
+    volatile uint32_t *r = q->ram;
+    switch (q->state) {
+    case QcomQmpIdle: {
+        if (r[D_MAGIC] != MAGIC || r[D_VERSION] != 1) return q->state = QcomQmpBadDescriptor;
+        const uint32_t box = r[D_MCORE_OFFSET], size = r[D_MCORE_SIZE];
+        if ((box & 3) || size < QCOM_QMP_MESSAGE + 4 || box < 0x3c || box > q->ram_bytes || size > q->ram_bytes - box)
+            return q->state = QcomQmpBadDescriptor;
+        q->box = box;
+        q->box_size = size;
+        /* A channel a boot stage left open is used as it is. */
+        if (r[D_MCORE_LINK] == UP && r[D_MCORE_LINK_ACK] == UP && r[D_MCORE_CH] == UP && r[D_UCORE_CH] == UP && r[D_MCORE_CH_ACK] == UP)
+            return q->state = QcomQmpOpen;
+        r[D_UCORE_LINK_ACK] = r[D_UCORE_LINK];
+        r[D_MCORE_LINK] = UP;
+        kick(q);
+        q->state = QcomQmpLinkWait;
+    }
+        /* fall through: the ack may already be there */
+    case QcomQmpLinkWait:
+        if (r[D_MCORE_LINK_ACK] != UP) return q->state;
+        r[D_MCORE_CH] = UP;
+        kick(q);
+        q->state = QcomQmpChannelWait;
+        /* fall through */
+    case QcomQmpChannelWait:
+        if (r[D_UCORE_CH] != UP) return q->state;
+        r[D_UCORE_CH_ACK] = UP;
+        kick(q);
+        q->state = QcomQmpAckWait;
+        /* fall through */
+    case QcomQmpAckWait:
+        if (r[D_MCORE_CH_ACK] != UP) return q->state;
+        return q->state = QcomQmpOpen;
+    case QcomQmpSending:
+        if (r[q->box / 4] != 0) return q->state;
+        return q->state = QcomQmpOpen;
+    default:
+        return q->state;
+    }
+}
+
+int qcom_qmp_send(QcomQmp *q, const char *text)
+{
+    if (q->state != QcomQmpOpen) return QcomQmpBusy;
+    uint32_t words[QCOM_QMP_MESSAGE / 4] = {0};
+    unsigned n = 0;
+    while (text[n]) {
+        if (n >= QCOM_QMP_MESSAGE - 1) return QcomQmpTooLong;
+        words[n / 4] |= (uint32_t)(uint8_t)text[n] << (8 * (n % 4));
+        ++n;
+    }
+    volatile uint32_t *r = q->ram;
+    if (r[q->box / 4] != 0) return QcomQmpBusy;
+    for (unsigned i = 0; i < QCOM_QMP_MESSAGE / 4; ++i) r[q->box / 4 + 1 + i] = words[i];
+    barrier();
+    r[q->box / 4] = QCOM_QMP_MESSAGE;
+    kick(q);
+    return q->state = QcomQmpSending;
+}
+
+void qcom_qmp_abandon(QcomQmp *q)
+{
+    if (q->state != QcomQmpSending) return;
+    q->ram[q->box / 4] = 0;
+    barrier();
+    q->state = QcomQmpOpen;
+}
+
+#endif
diff --git a/bsd/dev/modem/QcomQmp.h b/bsd/dev/modem/QcomQmp.h
--- /dev/null
+++ b/bsd/dev/modem/QcomQmp.h
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* The AOSS QMP mailbox: a message RAM shared with the always-on processor, a link and channel handshake, then one text message at a
+ * time ("{class: image, res: load_state, name: adsp, val: on}"). Written as a state machine stepped on each doorbell from the AOP (or a
+ * timer): qcom_qmp_step never waits, it returns what it is waiting for and the owner calls it again when the AOP rings or the deadline
+ * passes. Ringing the AOP is the owner's kick callback. */
+#ifndef QCOM_QMP_H
+#define QCOM_QMP_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QCOM_QMP_MESSAGE 0x64u  /* message length the AOP takes (padded with zeroes) */
+
+enum {
+    QcomQmpIdle = 0,         /* closed, nothing started */
+    QcomQmpLinkWait = 1,     /* our link is up, waiting for the AOP's ack */
+    QcomQmpChannelWait = 2,  /* our channel is up, waiting for the AOP's channel */
+    QcomQmpAckWait = 3,      /* the AOP's channel acked, waiting for its ack of ours */
+    QcomQmpOpen = 4,
+    QcomQmpSending = 5,      /* a message is in the mailbox, waiting for the AOP to take it */
+    QcomQmpBadDescriptor = -1,
+    QcomQmpBusy = -2,
+    QcomQmpTooLong = -3,
+};
+
+typedef struct {
+    volatile uint32_t *ram;  /* the message RAM (0x400 bytes on SM8550) */
+    uint32_t ram_bytes;
+    uint32_t box, box_size;  /* our mailbox inside it */
+    int state;
+    void (*kick)(void *context);
+    void *context;
+} QcomQmp;
+
+void qcom_qmp_init(QcomQmp *q, volatile uint32_t *ram, uint32_t ram_bytes, void (*kick)(void *), void *context);
+/* Advances the handshake or the pending send; returns the state reached. */
+int qcom_qmp_step(QcomQmp *q);
+/* Puts a message in the mailbox once the channel is open (QcomQmpSending), QcomQmpBusy otherwise. */
+int qcom_qmp_send(QcomQmp *q, const char *text);
+/* Gives up a send the AOP did not take before the owner's deadline: the mailbox is cleared. */
+void qcom_qmp_abandon(QcomQmp *q);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/modem/QcomRpmh.c b/bsd/dev/modem/QcomRpmh.c
--- /dev/null
+++ b/bsd/dev/modem/QcomRpmh.c
@@ -0,0 +1,98 @@
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(MODEM_PROTOCOL_HOST_TEST)
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* From UniXNU-sheng package/QcomRpmh.c (BSD-2-Clause-Patent), unchanged; asteroids uses it for the touch rails. */
+#include "QcomRpmh.h"
+
+static uint16_t le16(const uint8_t *p) {return (uint16_t)(p[0] | (uint16_t)p[1] << 8);}
+static uint32_t le32(const uint8_t *p) {return (uint32_t)le16(p) | (uint32_t)le16(p + 2) << 16;}
+static int fits(size_t at, size_t length, size_t size) {return at <= size && length <= size - at;}
+
+/* Header: u32 version, u32 magic, 8 slave records of 16 bytes (u16 id, header offset, data offset, entry count, version, reserved[3]),
+ * u32 checksum, u32 reserved, then the data area the offsets count from (byte 144). Entries are 24 bytes: an 8-byte id, two u32
+ * priorities, u32 address, u16 aux length, u16 aux offset. */
+int qcom_cmd_db_find(const uint8_t *db, size_t bytes, const char *name, QcomRpmhResource *out)
+{
+    if (!db || !name || !out) return QcomRpmhArgument;
+    if (bytes < 144 || le32(db + 4) != QCOM_CMD_DB_MAGIC) return QcomRpmhNoDb;
+    char id[8] = {0};
+    for (unsigned i = 0; i < 8 && name[i]; ++i) id[i] = name[i];
+    for (unsigned s = 0; s < 8; ++s) {
+        const uint8_t *slave = db + 8 + 16 * s;
+        if (!le16(slave)) break;
+        const size_t heads = 144u + le16(slave + 2), data = 144u + le16(slave + 4), count = le16(slave + 6);
+        if (!fits(heads, count * 24, bytes)) return QcomRpmhCorrupt;
+        for (size_t e = 0; e < count; ++e) {
+            const uint8_t *entry = db + heads + 24 * e;
+            unsigned same = 1;
+            for (unsigned i = 0; i < 8 && same; ++i) same = entry[i] == (uint8_t)id[i];
+            if (!same) continue;
+            QcomRpmhResource r = {0};
+            r.address = le32(entry + 16);
+            const size_t length = le16(entry + 20), at = data + le16(entry + 22);
+            if (!r.address || !fits(at, length, bytes)) return QcomRpmhCorrupt;
+            for (size_t l = 0; l + 1 < length && r.level_count < QCOM_RPMH_MAX_LEVELS; l += 2) {
+                const uint16_t level = le16(db + at + l);
+                if (r.level_count && !level) break;  /* the list is zero padded */
+                r.levels[r.level_count++] = level;
+            }
+            *out = r;
+            return QcomRpmhOk;
+        }
+    }
+    return QcomRpmhMissing;
+}
+
+int qcom_rpmh_level_index(const QcomRpmhResource *r, uint32_t level, uint32_t *index)
+{
+    if (!r->level_count) return QcomRpmhNoLevel;
+    if (!level) {*index = 0; return QcomRpmhOk;}
+    for (unsigned i = 0; i < r->level_count; ++i)
+        if (r->levels[i] >= level) {*index = i; return QcomRpmhOk;}
+    *index = r->level_count - 1;
+    return QcomRpmhOk;
+}
+
+QcomRscLayout qcom_rsc_layout(uint32_t drv_id)
+{
+    if (((drv_id >> 16) & 0xff) >= 3) return (QcomRscLayout){672, 24, 0x04, 0x08, 0x20, 0x24, 0x28, 0x2c, 0x34, 0x38, 0x3c};
+    return (QcomRscLayout){672, 20, 0x04, 0x08, 0x10, 0x14, 0x18, 0x1c, 0x30, 0x34, 0x38};
+}
+
+#define MSGID_WRITE_RESPONSE (8u | 1u << 8 | 1u << 16)  /* 4-byte payload code, response requested, write */
+#define CONTROL_ACTIVE_MODE (1u << 16)
+#define CONTROL_TRIGGER (1u << 24)
+
+unsigned qcom_rpmh_active_request(const QcomRscLayout *l, unsigned tcs, const uint32_t *addresses, const uint32_t *values, unsigned count,
+                                  QcomRpmhWrite *w, unsigned capacity)
+{
+    if (!count || count > 4 || capacity < 3 * count + 6) return 0;
+    const uint32_t base = l->tcs_stride * tcs;
+    unsigned n = 0;
+    /* The control register is cleared before the TCS is reprogrammed, then set to active mode and only after that triggered. */
+    w[n++] = (QcomRpmhWrite){base + l->control, 0};
+    w[n++] = (QcomRpmhWrite){l->irq_clear, 1u << tcs};
+    for (unsigned c = 0; c < count; ++c) {
+        const uint32_t cmd = base + l->cmd_stride * c;
+        w[n++] = (QcomRpmhWrite){cmd + l->cmd_msgid, MSGID_WRITE_RESPONSE};
+        w[n++] = (QcomRpmhWrite){cmd + l->cmd_addr, addresses[c]};
+        w[n++] = (QcomRpmhWrite){cmd + l->cmd_data, values[c]};
+    }
+    const uint32_t mask = (1u << count) - 1;
+    w[n++] = (QcomRpmhWrite){base + l->wait_for_cmpl, mask};
+    w[n++] = (QcomRpmhWrite){base + l->cmd_enable, mask};
+    w[n++] = (QcomRpmhWrite){base + l->control, CONTROL_ACTIVE_MODE};
+    w[n++] = (QcomRpmhWrite){base + l->control, CONTROL_ACTIVE_MODE | CONTROL_TRIGGER};
+    return n;
+}
+
+unsigned qcom_rpmh_finish(const QcomRscLayout *l, unsigned tcs, QcomRpmhWrite *w, unsigned capacity)
+{
+    if (capacity < 3) return 0;
+    const uint32_t base = l->tcs_stride * tcs;
+    w[0] = (QcomRpmhWrite){l->irq_clear, 1u << tcs};
+    w[1] = (QcomRpmhWrite){base + l->control, 0};
+    w[2] = (QcomRpmhWrite){base + l->cmd_enable, 0};
+    return 3;
+}
+
+#endif
diff --git a/bsd/dev/modem/QcomRpmh.h b/bsd/dev/modem/QcomRpmh.h
--- /dev/null
+++ b/bsd/dev/modem/QcomRpmh.h
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* From UniXNU-sheng package/QcomRpmh.h (BSD-2-Clause-Patent), unchanged. */
+/* RPMh for a remote processor's proxy votes: find a resource in the AOP command database (cmd-db) and turn a level into the index the
+ * ARC resource takes, and describe the register writes of one active-only request in a TCS of the application processor's RSC, for
+ * both register layouts (the RSC's major version 3 moved the TCS registers). Nothing here touches hardware: the owner applies the
+ * writes and waits for the TCS done interrupt. */
+#ifndef QCOM_RPMH_H
+#define QCOM_RPMH_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QCOM_CMD_DB_MAGIC 0x0c0330dbu
+#define QCOM_RPMH_MAX_LEVELS 16u
+
+typedef struct {
+    uint32_t address;
+    uint16_t levels[QCOM_RPMH_MAX_LEVELS];
+    unsigned level_count;
+} QcomRpmhResource;
+
+enum {QcomRpmhOk = 0, QcomRpmhNoDb = -1, QcomRpmhMissing = -2, QcomRpmhCorrupt = -3, QcomRpmhNoLevel = -4, QcomRpmhArgument = -5};
+
+/* Looks name (up to 8 characters) up in a copy of the command database; levels are the ARC's voltage levels (aux data) when it has
+ * them. */
+int qcom_cmd_db_find(const uint8_t *db, size_t bytes, const char *name, QcomRpmhResource *out);
+/* The ARC level index for a request of at least level (the highest index when level is above all of them; 0 turns the vote off). */
+int qcom_rpmh_level_index(const QcomRpmhResource *r, uint32_t level, uint32_t *index);
+
+typedef struct {uint32_t offset, value;} QcomRpmhWrite;
+
+/* The register layout of an RSC DRV; offsets are relative to the TCS block (DRV base + tcs-offset). */
+typedef struct {
+    uint32_t tcs_stride, cmd_stride, irq_status, irq_clear, wait_for_cmpl, control, status, cmd_enable, cmd_msgid, cmd_addr, cmd_data;
+} QcomRscLayout;
+
+/* The layout for a DRV whose id register reads drv_id (major version in bits 23:16). */
+QcomRscLayout qcom_rsc_layout(uint32_t drv_id);
+/* The writes of an active request of count (<= 4) data commands in TCS tcs, in order, ending with the trigger. Returns the number of
+ * writes, 0 on bad arguments. */
+unsigned qcom_rpmh_active_request(const QcomRscLayout *l, unsigned tcs, const uint32_t *addresses, const uint32_t *values, unsigned count,
+                                  QcomRpmhWrite *writes, unsigned capacity);
+/* The writes that return the TCS to idle after its done interrupt. */
+unsigned qcom_rpmh_finish(const QcomRscLayout *l, unsigned tcs, QcomRpmhWrite *writes, unsigned capacity);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/modem/QcomScm.h b/bsd/dev/modem/QcomScm.h
--- /dev/null
+++ b/bsd/dev/modem/QcomScm.h
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Secure channel manager calls of the peripheral authentication service (PAS) in the SMCCC convention: the function id (standard call,
+ * SMC64, SiP owner, service 2) and the argument-type word in x1. The SMC itself lives in the kernel glue; these encoders are what the
+ * host tests check. */
+#ifndef QCOM_SCM_H
+#define QCOM_SCM_H
+#include <stdint.h>
+
+#define QCOM_SCM_SVC_PIL 0x02u
+#define QCOM_SCM_PAS_INIT_IMAGE 0x01u
+#define QCOM_SCM_PAS_MEM_SETUP 0x02u
+#define QCOM_SCM_PAS_AUTH_AND_RESET 0x05u
+#define QCOM_SCM_PAS_SHUTDOWN 0x06u
+#define QCOM_SCM_PAS_IS_SUPPORTED 0x07u
+#define QCOM_SCM_VAL 0u
+#define QCOM_SCM_RO 1u
+#define QCOM_SCM_RW 2u
+#define QCOM_SCM_INTERRUPTED 1    /* x0 of a call the secure world wants resumed (x6 carries its session) */
+#define QCOM_SCM_V2_EBUSY (-12)   /* busy: retry after a pause */
+
+static inline uint32_t qcom_scm_fn(uint32_t svc, uint32_t cmd)
+{
+    return (1u << 30) /* SMC64 */ | (2u << 24) /* SiP */ | ((svc & 0xff) << 8) | (cmd & 0xff);
+}
+/* Argument count in bits 3:0, the type of argument i in bits 5+2i:4+2i. */
+static inline uint32_t qcom_scm_args(unsigned count, unsigned t0, unsigned t1, unsigned t2)
+{
+    return (count & 0xf) | (t0 & 3) << 4 | (t1 & 3) << 6 | (t2 & 3) << 8;
+}
+
+/* IPCC (the inter-processor doorbells): a doorbell id is client << 16 | signal. */
+#define QCOM_IPCC_SEND 0x0cu
+#define QCOM_IPCC_RECV_ID 0x10u
+#define QCOM_IPCC_RECV_ENABLE 0x14u
+#define QCOM_IPCC_RECV_DISABLE 0x18u
+#define QCOM_IPCC_RECV_CLEAR 0x1cu
+#define QCOM_IPCC_NONE 0xffffffffu
+#define QCOM_IPCC_CLIENT_AOP 0u
+#define QCOM_IPCC_CLIENT_LPASS 3u
+#define QCOM_IPCC_SIGNAL_GLINK_QMP 0u
+#define QCOM_IPCC_SIGNAL_SMP2P 2u
+static inline uint32_t qcom_ipcc_id(uint32_t client, uint32_t signal) {return client << 16 | (signal & 0xffff);}
+
+#endif
