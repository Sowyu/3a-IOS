+}
diff --git a/bsd/dev/modem/ModemGate.h b/bsd/dev/modem/ModemGate.h
--- /dev/null
+++ b/bsd/dev/modem/ModemGate.h
@@ -0,0 +1,15 @@
+#ifndef MODEM_GATE_H
+#define MODEM_GATE_H
+#include <stddef.h>
+/* Exact, single name=1 token. Bare, duplicate, malformed and numeric aliases fail closed. */
+static inline int modem_gate(const char *args,const char *name){
+    size_t n=0;while(name[n])n++;unsigned found=0;int enabled=0;
+    while(args && *args){
+        while(*args==' ' || *args=='\t')args++;
+        const char *end=args;while(*end && *end!=' ' && *end!='\t')end++;
+        size_t len=(size_t)(end-args),i=0;while(i<n && i<len && args[i]==name[i])i++;
+        if(i==n && (len==n || args[n]=='=')){found++;enabled=len==n+2 && args[n]=='=' && args[n+1]=='1';}
+        args=end;
+    }return found==1 && enabled;
+}
+#endif
diff --git a/bsd/dev/modem/ModemRmtfs.c b/bsd/dev/modem/ModemRmtfs.c
--- /dev/null
+++ b/bsd/dev/modem/ModemRmtfs.c
@@ -0,0 +1,68 @@
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(MODEM_PROTOCOL_HOST_TEST)
+#include "ModemRmtfs.h"
+#include "QcomQrtr.h"
+static uint32_t get32(const uint8_t *p){return (uint32_t)p[0]|(uint32_t)p[1]<<8|(uint32_t)p[2]<<16|(uint32_t)p[3]<<24;}
+static void put16(uint8_t *p,uint32_t v){p[0]=v;p[1]=v>>8;}
+static void put32(uint8_t *p,uint32_t v){put16(p,v);put16(p+2,v>>16);}
+static int match(const uint8_t *v,uint32_t n,const char *s){
+    uint32_t len=0;while(s[len])len++;
+    if(n==len+1 && !v[len])n--;
+    if(n!=len)return 0;
+    for(uint32_t i=0;i<n;i++)if(v[i]!=(uint8_t)s[i])return 0;
+    return 1;
+}
+static const uint8_t *field(const QcomQmiMessage *m,uint8_t type,uint32_t size){
+    uint32_t n=0;const uint8_t *p=qcom_qmi_tlv(m,type,&n);return p && n==size?p:0;
+}
+static int extent(const ModemRmtfs *r,uint32_t id,const uint8_t *v){
+    uint64_t off=(uint64_t)get32(v)*512,pa=get32(v+4),n=(uint64_t)get32(v+8)*512;
+    return pa>=r->window_pa && pa-r->window_pa<=r->window_bytes && n<=r->window_bytes-(pa-r->window_pa) &&
+        off<=r->bytes[id] && n<=r->bytes[id]-off;
+}
+uint32_t modem_rmtfs_request(ModemRmtfs *r,const uint8_t *data,uint32_t size,uint8_t *out,uint32_t cap){
+    QcomQmiMessage m;if(!r || !out || cap<25 || qcom_qmi_parse(data,size,&m) || m.type!=QCOM_QMI_REQUEST)return 0;
+    static const char *const paths[]={"/boot/modem_fs1","/boot/modem_fs2","/boot/modem_fsc","/boot/modem_fsg"};
+    uint32_t id=4,optlen=0;uint8_t opt[8]={0};int ok=0;
+    const uint8_t *v=field(&m,1,4);
+    if(v)id=get32(v);
