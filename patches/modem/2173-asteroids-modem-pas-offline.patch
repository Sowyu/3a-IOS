+    int rc=qcom_qmp_send(&m.qp,on?"{class: image, res: load_state, name: modem, val: on}":"{class: image, res: load_state, name: modem, val: off}");
+    return rc==QcomQmpSending?m_qwait(1000):EIO;
+}
+static int m_item(uint16_t id,uint32_t minimum,uint32_t *off,uint32_t *bytes){
+    int rc=qcom_smem_find(&m.sm,&m.part,id,off,bytes);
+    if(rc || *bytes<minimum || *off>M_SM_SIZE || *bytes>M_SM_SIZE-*off || (*off&3))return ENOENT;
+    return 0;
+}
+static int m_alloc(uint16_t id,uint32_t bytes,uint32_t *off){
+    bool locked=false;for(unsigned us=0;us<100000;us++){m_wr(m.mutex,0,1);if(m_rd(m.mutex,0)==1){locked=true;break;}delay(1);}
+    if(!locked)return EBUSY;
