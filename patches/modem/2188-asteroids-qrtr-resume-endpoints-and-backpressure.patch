+/* Linux qrtr_send_resume_tx reverses the packet endpoints and identifies the
+ * receiving client in the payload. A control-port broadcast cannot unblock it. */
+int qcom_qrtr_poll(QcomQrtr *q)
+{
+    if(q->resume_failed)return -1;
+    while(q->resume_count){
+        uint8_t data[CTRL_BYTES]={0};
+        put32(data,QCOM_QRTR_RESUME_TX);put32(data+4,q->local_node);put32(data+8,q->resume[0].local_port);
+        if(emit(q,QCOM_QRTR_RESUME_TX,q->resume[0].local_port,q->resume[0].node,q->resume[0].port,data,sizeof(data)))break;
+        q->resumes_sent++;q->resume[0]=q->resume[--q->resume_count];
+    }
+    return 0;
+}
+static int resume_tx(QcomQrtr *q,uint32_t node,uint32_t port,uint32_t local_port)
+{
+    for(unsigned i=0;i<q->resume_count;i++)
+        if(q->resume[i].node==node && q->resume[i].port==port && q->resume[i].local_port==local_port)return qcom_qrtr_poll(q);
+    if(q->resume_count==QCOM_QRTR_MAX_RESUMES){q->resume_failed=1;return -1;}
+    unsigned i=q->resume_count++;
+    q->resume[i].node=node;q->resume[i].port=port;q->resume[i].local_port=local_port;
+    return qcom_qrtr_poll(q);
+}
