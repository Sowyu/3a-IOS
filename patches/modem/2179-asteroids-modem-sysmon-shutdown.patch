+/* SSCTL v2 instance 0x12 is the modem sysmon endpoint in the volcano DT
+ * driver. This fixed client only requests shutdown, never online mode. */
+static void m_shutdown_receive(void *ctx,QcomQrtr *qr,uint32_t port,uint32_t node,uint32_t from,const uint8_t *data,uint32_t len){
+    (void)ctx;(void)qr;(void)port;
+    if(!m.shutdown_sent || node!=m.shutdown_node || from!=m.shutdown_port)return;
+    QcomQmiMessage msg;if(qcom_qmi_parse(data,len,&msg) || msg.message!=0x21)return;
+    if(msg.type==QCOM_QMI_INDICATION && msg.length==0){m.shutdown_ind=true;return;}
+    if(msg.type!=QCOM_QMI_RESPONSE || msg.transaction!=1)return;
+    /* Exactly one standard result TLV. Reject duplicates and trailing fields. */
+    if(msg.length!=7 || msg.tlvs[0]!=2 || le16(msg.tlvs+1)!=4)return;
+    uint16_t result=le16(msg.tlvs+3),error=le16(msg.tlvs+5);
+    printf("SWEET MODEM: SSCTL shutdown response result=%u error=%u\n",result,error);
+    m.shutdown_response=result==0 && error==0;
 }
