+static bool m_shutdown_request(void){
+    if(!m.sysmon || !m.started || !m.qr_started || m.fatal || m.failed)return false;
+    int index=-1;
+    for(unsigned i=0;i<m.qr.remote_count;i++)if(m.qr.remote[i].service==43 &&
+        (m.qr.remote[i].instance==0x1202 || m.qr.remote[i].instance==1)){
+        index=(int)i;break;
+    }
+    if(index<0){printf("SWEET MODEM: SSCTL shutdown service missing; using stop bit\n");return false;}
+    m.shutdown_node=m.qr.remote[index].node;m.shutdown_port=m.qr.remote[index].port;
+    m_smp_poll();
+    if(m.state&0x80){printf("SWEET MODEM: SSCTL stale shutdown ack; using stop bit\n");return false;}
+    m.shutdown_response=false;m.shutdown_ind=false;
+    const uint8_t req[7]={0,1,0,0x21,0,0,0};
+    if(qcom_qrtr_send_data(&m.qr,0x4003,m.shutdown_node,m.shutdown_port,req,sizeof(req)))return false;
+    m.shutdown_sent=true;
+    printf("SWEET MODEM: SSCTL shutdown request node=%u port=%u\n",m.shutdown_node,m.shutdown_port);
+    /* Continue servicing RAM-backed rmtfs while the modem flushes its state.
+     * A response alone is not shutdown completion. DT shutdown-ack is bit 7. */
+    uint64_t end=m_now()+10000;
+    do{
+        m_smp_poll();m_ipc_poll();
+        if(m.shutdown_response && (m.shutdown_ind || (m.state&0x80)))break;
+        if(m.fatal || m.failed)break;m_sleep(2);
+    }while(m_now()<end);
+    bool acked=m.shutdown_response && (m.shutdown_ind || (m.state&0x80));
+    printf("SWEET MODEM: SSCTL shutdown response=%u indication=%u shutdown_ack=%u accepted=%u\n",
+        m.shutdown_response,m.shutdown_ind,!!(m.state&0x80),acked);
+    sweet_log_sync();return acked;
