+/* Fixed volcano crypto-to-DDR bandwidth floor for a bounded development boot.
+ * Source tables: Nothing sm7635/v/mr volcano.c, icc-rpmh.c and bcm-voter.c.
+ * No MMIO here. The caller owns RSC arbitration and completion/retention. */
+#ifndef MODEM_BCM_H
+#define MODEM_BCM_H
+#include "QcomRpmh.h"
+#define MODEM_BCM_COUNT 7u
+typedef struct {uint32_t address,data;unsigned vcd,wait,resource;} ModemBcmCommand;
+static const char *const modem_bcm_names[MODEM_BCM_COUNT]={"CE0","SN3","SN0","SH1","SH0","MC0","ACV"};
+static inline int modem_bcm_prepare(const uint8_t *db,size_t bytes,ModemBcmCommand *out,size_t capacity){
+    if(!out || capacity<MODEM_BCM_COUNT)return -1;
+    /* Corresponding node bus widths/channels. Enable-mask resources use zero. */
+    static const unsigned bus[]={8,16,16,0,16,4,0},channels[]={1,1,1,0,2,2,0};
+    /* Measured read-only in ast157. Refuse a changed firmware resource map. */
+    static const uint32_t address[]={0x50034,0x5001c,0x50010,0x50008,0x50004,0x50000,0x50068};
+    static const uint32_t units[]={7935,530000,530000,4200000,4200000,1600000,1};
+    static const unsigned widths[]={8,8,16,32,32,8,0},vcds[]={6,3,3,1,1,0,12};
+    ModemBcmCommand c[MODEM_BCM_COUNT];
+    for(unsigned i=0;i<MODEM_BCM_COUNT;i++){
+        QcomRpmhResource r={0};if(qcom_cmd_db_find(db,bytes,modem_bcm_names[i],&r))return -2;
+        if(r.aux_version!=0x1000 || r.slave_id!=5 || (r.address>>16)!=5 || (r.address&3) || r.aux_bytes!=8)return -3;
+        const uint8_t *a=r.aux_prefix;
+        uint32_t unit=(uint32_t)a[0]|(uint32_t)a[1]<<8|(uint32_t)a[2]<<16|(uint32_t)a[3]<<24;
+        unsigned width=a[4]|a[5]<<8,vcd=a[6];
+        if(r.address!=address[i] || unit!=units[i] || width!=widths[i] || vcd!=vcds[i] || a[7])return -4;
+        for(unsigned j=0;j<i;j++)if(c[j].address==r.address)return -5;
+        uint32_t vote;
+        if(bus[i]){
+            /* Match the vendor UINT_MAX kB/s request, then require saturation
+             * before pinning a shared floor. Never lower inherited rate votes. */
+            uint64_t avg=(uint64_t)UINT32_MAX*width/(bus[i]*channels[i]);
+            uint64_t peak=(uint64_t)UINT32_MAX*width/bus[i];
+            if(avg*1000/unit<0x3fff || peak*1000/unit<0x3fff)return -6;
+            vote=0x0fffffffu;
+        }else{
+            /* ACV has legal enable/performance bits 1|2. Retain both until reset,
+             * since this isolated driver cannot restore an inherited APPS vote. */
+            vote=i==6?3:1;
+        }
+        c[i]=(ModemBcmCommand){r.address,0x20000000u|vote,vcd,0,i};
+    }
+    for(unsigned i=1;i<MODEM_BCM_COUNT;i++){
+        ModemBcmCommand v=c[i];unsigned j=i;
+        while(j && c[j-1].vcd>v.vcd){c[j]=c[j-1];j--;}c[j]=v;
+    }
+    for(unsigned i=0;i<MODEM_BCM_COUNT;i++){
+        c[i].wait=i+1==MODEM_BCM_COUNT || c[i].vcd!=c[i+1].vcd;
+        if(c[i].wait)c[i].data|=0x40000000u;
+    }
+    for(unsigned i=0;i<MODEM_BCM_COUNT;i++)out[i]=c[i];
+    return 0;
+}
+#endif
