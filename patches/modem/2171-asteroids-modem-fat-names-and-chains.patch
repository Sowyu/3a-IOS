+/* A file must occupy exactly its required chain, ending at EOC. */
+static int
+fat_validate_file(const struct wl_fat *f, uint32_t cl, uint32_t size)
+{
+    static uint8_t seen[8192];
+    memset(seen, 0, sizeof(seen));
+    uint64_t count = ((uint64_t)size + f->cl_bytes - 1) / f->cl_bytes;
+    if (!count) return cl == 0 ? 0 : EIO;
+    if (count > f->ncl) return EIO;
+    for (uint64_t i = 0; i < count; i++) {
+        if (cl < 2 || cl >= f->ncl + 2 || cl >= 0xfff0 || (seen[cl / 8] & (1u << (cl % 8)))) return EIO;
+        seen[cl / 8] |= 1u << (cl % 8);
+        cl = fat_next(f, cl);
+    }
+    return cl >= 0xfff8 ? 0 : EIO;
 }
 
