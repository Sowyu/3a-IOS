 /* Only plain 8.3 names (all firmware files here are); long names never match. */
+/* modem names fit one VFAT slot; reject longer names rather than guess aliases. */
+static bool
+fat_lfn_match(const uint8_t *e, const char *name, size_t n)
+{
+    static const uint8_t at[13] = {1,3,5,7,9,14,16,18,20,22,24,28,30};
+    if (e[0] != 0x41 || e[12] || le16(e + 26) || n > 13) return false;
+    for (unsigned i = 0; i < 13; i++) {
+        uint32_t c = le16(e + at[i]);
+        if (i < n) {
+            uint8_t want = (uint8_t)name[i];
+            if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+            if (want >= 'A' && want <= 'Z') want += 'a' - 'A';
+            if (c != want) return false;
+        } else if (c != (i == n ? 0 : 0xffff)) return false;
+    }
+    return true;
+}
