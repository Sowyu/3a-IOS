+/*
+ * 2130: sweetappmetal=<executable> gives one top-level app in /Applications the Chlorophyll inject. Off without the boot-arg.
+ * The name has to match the last path component exactly; nested extensions and XPC services never match (sweet_ui_exec_path).
+ */
+static int
+sweet_appmetal_match(const char *path)
+{
+	static char name[32];
+	static int state = -1;
+	if (state < 0) {
+		state = PE_parse_boot_argn("sweetappmetal", name, sizeof(name)) && name[0] != '\0';
+	}
+	if (!state || strncmp(path, "/Applications/", 14) || !sweet_ui_exec_path(path)) {
+		return 0;
+	}
+	const char *base = strrchr(path, '/');
+	return base != NULL && !strcmp(base + 1, name);
+}
