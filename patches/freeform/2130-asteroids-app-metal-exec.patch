+/*
+ * 2130: sweetappmetal=Freeform inserts the Chlorophyll inject into exactly /Applications/Freeform.app/Freeform, the trial of
+ * plans/freeform. Off without the boot-arg, and every other value is refused. With 2058's sweetsb=1 as well, Freeform gets one
+ * variable listing both, sweetsb first. The match is the exec path string and the vnode's own path, so another bundle, a
+ * helper of the same name or a symlink to another file does not match.
+ */
+#define SWEET_APPMETAL_PATH "/Applications/Freeform.app/Freeform"
+static const char sweet_insert_app[] = "DYLD_INSERT_LIBRARIES=/usr/local/lib/bgmtl/bgmtl-inject.dylib";
+static const char sweet_insert_both[] = "DYLD_INSERT_LIBRARIES=/usr/local/lib/sweetsb.dylib:/usr/local/lib/bgmtl/bgmtl-inject.dylib";
+/* a refused insertion is renamed in place to this, the same length, so no string or pointer moves after extraction */
+#define SWEET_APPMETAL_DENIED "SWEET_APPMETAL_DENIED="
+_Static_assert(sizeof(SWEET_APPMETAL_DENIED) == sizeof("DYLD_INSERT_LIBRARIES="), "2130 renames in place");
+
+static int
+sweet_appmetal_enabled(void)
+{
+	static int state = -1;
+	if (state < 0) {
+		char name[16] = "";
+		state = PE_parse_boot_argn("sweetappmetal", name, sizeof(name)) && !strcmp(name, "Freeform");
+		if (!state && name[0] != '\0') {
+			printf("SWEET EXEC: appmetal: sweetappmetal=%s refused, only Freeform is supported\n", name);
+		}
+	}
+	return state;
+}
+
+/*
+ * An inherited variable that this patch writes, stripped so children of Freeform do not inherit the inject. Only with the
+ * feature on: on a boot without sweetappmetal=Freeform this patch wrote nothing, so it strips nothing either.
+ */
+static int
+sweet_appmetal_own(const char *s)
+{
+	const size_t d = sizeof(SWEET_APPMETAL_DENIED) - 1;
+	if (!sweet_appmetal_enabled()) {
+		return 0;
+	}
+	if (!strcmp(s, sweet_insert_app) || !strcmp(s, sweet_insert_both)) {
+		return 1;
+	}
+	return !strncmp(s, SWEET_APPMETAL_DENIED, d) && (!strcmp(s + d, sweet_insert_app + d) || !strcmp(s + d, sweet_insert_both + d));
+}
+
+static int
+sweet_appmetal_match(struct image_params *imgp)
+{
+	char real[64];
+	int len = sizeof(real);
+	if (!sweet_appmetal_enabled() || strcmp(imgp->ip_strings + strlen(EXECUTABLE_KEY), SWEET_APPMETAL_PATH)) {
+		return 0;
+	}
+	/* the file actually being executed: ENOSPC for a longer path, which is not ours either */
+	return imgp->ip_vp != NULLVP && vn_getpath(imgp->ip_vp, real, &len) == 0 && !strcmp(real, SWEET_APPMETAL_PATH);
+}
+
+/* Our insertion among the extracted environment strings, or NULL. With the feature on an inherited copy was stripped. */
+static char *
+sweet_appmetal_inserted(struct image_params *imgp)
+{
+	if (!sweet_appmetal_enabled() || imgp->ip_endargv == NULL || imgp->ip_endenvv == NULL) {
+		return NULL;
+	}
+	for (char *s = imgp->ip_endargv; s < imgp->ip_endenvv; s += strlen(s) + 1) {
+		if (!strcmp(s, sweet_insert_app) || !strcmp(s, sweet_insert_both)) {
+			return s;
+		}
+	}
+	return NULL;
+}
+
+/*
+ * After exec_handle_sugid, before the strings are copied out: what extraction could not know yet. A set-id or MAC credential
+ * change, a restricted, hardened or library-validated signature, or a privileged code-signing flag loses the insertion,
+ * sweetsb.dylib included when the variable lists both. This port's AMFI stand-in lets dyld honour DYLD_* for every arm64e
+ * process (sweet_amfi.c), so dyld would not drop it for us.
+ */
+static void
+sweet_appmetal_check(struct image_params *imgp, proc_t p, char *s, int mac_transition)
+{
+	const uint32_t cs = imgp->ip_csflags;
+	const char *why = proc_issetugid(p) ? "set-id credentials" :
+	    mac_transition ? "a MAC label transition" :
+	    (imgp->ip_origvattr->va_mode & (VSUID | VSGID)) ? "a set-id file" :
+	    (cs & CS_RESTRICT) ? "a restricted signature" :
+	    (cs & CS_RUNTIME) ? "the hardened runtime" :
+	    (cs & (CS_REQUIRE_LV | CS_FORCED_LV)) ? "library validation" :
+	    (cs & (CS_INSTALLER | CS_DATAVAULT_CONTROLLER | CS_NVRAM_UNRESTRICTED)) ? "privileged code-signing flags" : NULL;
+	if (why == NULL) {
+		printf("SWEET EXEC: appmetal inject for %s\n", SWEET_APPMETAL_PATH);
+		return;
+	}
+	memcpy(s, SWEET_APPMETAL_DENIED, sizeof(SWEET_APPMETAL_DENIED) - 1);
+	printf("SWEET EXEC: appmetal inject refused for %s: %s\n", SWEET_APPMETAL_PATH, why);
+}
